title: [+ cat_coalition_disp +], to kickstart Parlament budget negotiations
subtitle: [? if president_gender = "m": President?][? if president_gender = "f": Presidenta?] [+ president +] is looking [? if budget_postponed_trigger: , again, ?]to pass a budget for this year [+ year +].
new-page: true
on-arrival: {!
    Q.budget_postponed_trigger = false;
    Q.coming_from_parlament = false;
    Q.budget_parlament_trigger = false;
    Q.budget_year_attempted = Q.year;
    var party = Q.economy_minister_party;
    if (party == "jxsi") party = Q.jxsi_formation_num > 50 ? "erc" : "cdc";
    if (party == "jxcat") party = Q.jxcat_leader_party == "erc" ? "erc" : "cdc";
    var right = ["ciu", "cdc", "dl", "pdcat", "junts", "unio", "ppc", "cs", "vox"].includes(party);
    var cap = right ? Math.min(Q.social_spending_cap, Math.max(-2,
        Q.education_spending, Q.healthcare_spending, Q.public_salary_level)) : Math.min(3, Q.social_spending_cap + 1);
    var tax = right ? Q.tax_policy_level : Math.min(2, Q.tax_policy_level + 2);
    function prepared(id) {
        var law = (Q.active_mods || {})[id];
        if (!law || !law.active || law.def.colour != "gray") return false;
        if (id == "territory_water2") return Q.territory_water == 1;
        if (id == "territory_water3") return Q.territory_water == 2;
        if (id == "territory_tmobilitat2") return Q.territory_tmobilitat == 1;
        if (id == "territory_rail2") return Q.territory_tmobilitat == 2;
        if (id == "vp_digital3_proposal") {
            var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
            return Q.vp_digital_level == 2 && Q.vp_digital_prepared && !Q.cat_caretaker_gov &&
                controlledParties.includes(Q.vicepresident_party) && Q.parlament_digital_passed && ["generalitat", "catalonia"].includes(Q.cybersecurity_agency_scope) && (Q.active_mods || {}).digital_agency_core && Q.active_mods.digital_agency_core.active;
        }
        if (id == "healthcare_universal_proposal") {
            var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
            return Q.healthcare_universal_level == 1 && Q.healthcare_universal_introduced &&
                !Q.cat_caretaker_gov && controlledParties.includes(Q.health_minister_party);
        }
        if (id == "bnl_icf_proposal") {
            var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
            return Q.bnl_icf_level == 1 && ["guarantees", "cooperative"].includes(Q.bnl_icf_prepared_branch) &&
                !Q.cat_caretaker_gov && controlledParties.includes(Q.bnl_minister_party) && controlledParties.includes(Q.economy_minister_party);
        }
        return true;
    }
    var projects = {
        county:prepared("territory_county_roads") && !["cup", "ppc", "cs"].includes(party),
        b40:prepared("territory_b40") && right,
        metro1:prepared("territory_metro1") && !["ppc", "cs", "cup"].includes(party),
        metro2:prepared("territory_metro2") && !right,
        water2:prepared("territory_water2"),
        water3:prepared("territory_water3") && !right,
        tmobilitat2:prepared("territory_tmobilitat2") && !right,
        rail1:prepared("territory_rail1"),
        rail2:prepared("territory_rail2") && !right
    };
    projects.icf = prepared("bnl_icf_proposal") && (Q.bnl_icf_prepared_branch == "guarantees" || !right);
    projects.digital = prepared("vp_digital3_proposal");
    projects.universal = prepared("healthcare_universal_proposal");
    var taxPromised = false;
    for (var record of Q.coalition_policy_commitments || []) {
        if (record.scope != "cabinet" || !["pending_budget", "applied"].includes(record.status)) continue;
        if (record.kind == "social_spending_cap") cap = Math.max(cap, record.target);
        if (record.kind == "tax_policy_level") {
            tax = Math.max(tax, Math.min(2, Q.tax_policy_level + 2, record.target));
            taxPromised = true;
        }
    }
    // Prefer a restrained tax package, but seek revenue when inherited finances require it.
    if (right) {
        var yields = [-3, -2, -1, 0, 1];
        var costs = (projects.county ? 1 : 0) + (projects.b40 ? 2 : 0) + (projects.metro1 ? 2 : 0) + (projects.metro2 ? 1 : 0) +
            (projects.water2 ? 1 : 0) + (projects.water3 ? 2 : 0) + (projects.tmobilitat2 ? 2 : 0) + (projects.rail1 ? 1 : 0) + (projects.rail2 ? 2 : 0) + (projects.icf ? 2 : 0) + (projects.digital ? 1 : 0) + (projects.universal ? 1 : 0);
        var bestMargin = -Infinity;
        var minimumTax = tax;
        for (var candidate = Math.max(-2, Q.tax_policy_level - 2); candidate <= Math.min(2, Q.tax_policy_level + 2); candidate++) {
            if (candidate < minimumTax || party == "ciu" && candidate >= 2 && !taxPromised) continue;
            var margin = Q.generalitat_surplus + yields[candidate + 2] - yields[Q.tax_policy_level + 2] -
                2 * (cap - Q.social_spending_cap) - costs;
            if (margin > bestMargin) { tax = candidate; bestMargin = margin; }
            if (margin >= 0) break;
        }
    }
    Q.budget_draft_origin = {author:"npc", proposer_party:Q.economy_minister_party, proposer_policy_party:party,
        year:Q.year, tax_policy_level:tax, social_spending_cap:cap,
        enacted_tax_policy_level:Q.tax_policy_level, enacted_social_spending_cap:Q.social_spending_cap,
        surplus_at_draft:Q.generalitat_surplus, projects:Object.assign({}, projects)};
    Q.budget_draft = {tax_policy_level:tax, social_spending_cap:cap, projects:projects};
!}
view-if: budget_parlament_trigger or budget_postponed_trigger
tags: event
role: event
go-to: parlament_budget
