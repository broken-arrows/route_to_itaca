title: Unfulfilled Roadmap to Independence!
new-page: true
tags: event
view-if: broken_roadmap_trigger
face-image: img/events/nay.webp
go-to: erc_broken if player_party = "erc"; cup_broken if player_party = "cup"
on-arrival: {!
    if (Q.player_in_jxsi || Q.player_in_jxcat) {
        this.achieve("junts_pel_bluf");
    }
    Q.broken_roadmap_trigger = false;
    Q.broken_roadmap_expires_countdown = 12;
    if (!Q.countdowns.includes("broken_roadmap_expires")) Q.countdowns.push("broken_roadmap_expires");

!}
role: event

= Unfulfilled Roadmap to Independence

Our promise to follow a [+ player_roadmap : roadmap +] roadmap to Independence, and fulfil it by [+ roadmap_year +] can now only be considered broken. Needless to say, this is highly disappointing for many in our party, but specially for the voters that have trusted us this far. 

@erc_broken
on-arrival: {!
    Q.roadmap_year = 0;
    Q.erc_civic_dissent += 15;
    Q.erc_core_dissent += 3;

    for (var c of Q.parlament_constituencies) {
        for (var d of Q.parlament_demographics) {
            var suffix = "_parlament_" + c + "_" + d + "_support";
            var ercCarrier = "erc";
            for (var list of ["jxsi", "jxcat"]) {
                if (Q["erc_in_" + list] && Q[list + suffix] > 0) ercCarrier = list;
            }
            var ciuCarrier = ercCarrier != "erc" ? ercCarrier : Q.parlament_current_ciu;
            // A shared roadmap costs the joint ballot 12% once, not two penalties.
            var ercLoss = 0.12 * (Q[ercCarrier + suffix] || 0);
            var ciuLoss = ciuCarrier == ercCarrier ? 0 : 0.09 * (Q[ciuCarrier + suffix] || 0);
            var amount = ercLoss + ciuLoss;
            Q[ercCarrier + suffix] = (Q[ercCarrier + suffix] || 0) - ercLoss;
            Q[ciuCarrier + suffix] = (Q[ciuCarrier + suffix] || 0) - ciuLoss;

            Q["abstain_parlament_" + c + "_" + d + "_support"] += 0.8*amount;
            Q["fnc_parlament_" + c + "_" + d + "_support"] += 0.05*amount;
            if (!((ciuCarrier == "jxsi" || ciuCarrier == "jxcat") && Q["cup_in_" + ciuCarrier])) {
                Q["cup_parlament_" + c + "_" + d + "_support"] += 0.15*amount;
            } else {
                Q["fnc_parlament_" + c + "_" + d + "_support"] += 0.05*amount;
                Q["abstain_parlament_" + c + "_" + d + "_support"] += 0.1*amount;
            }
        }
    }
    Q.independence_trust = 0.5*Q.independence_trust;
    G.spaSupportInject(Q, "abstain", "catalunya", 3, "erc");
    var congresoCiu = Q[Q.parlament_current_ciu + "_congreso_catalunya_support"] > 0
        ? Q.parlament_current_ciu : "ciu";
    G.spaSupportInject(Q, "abstain", "catalunya", 3, congresoCiu);

    // TODO: Local votes transfer, probably the most hardcore consequence
!}

Gaining their confidence back is going to be an uphill battle, and we are set to struggle against other pro-independence parties. 


@cup_broken
# TODO: CUP consequences for a broken roadmap
