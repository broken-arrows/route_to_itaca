title: Local Elections - [+ next_local_election_month : month +] [+ next_local_election_year +]
tags: election
view-if: year = next_local_election_year and month = next_local_election_month and (week = next_local_election_week or not rubicon)
new-page: true
set-bg: img/salo_de_cent.jpg
go-to: election_algorithm.local_elections
set-jump: local_elections.post_election
role: event

@post_election
new-page: true
on-arrival: {!
    Q.next_local_election_year = Q.year + 4;
    Q.next_local_election_time = Q.time + 48;
    // Persist the actual playthrough date for chart annotations, once per event.
    if (!Array.isArray(Q.election_history_events)) Q.election_history_events = [];
    var historyDate = new Date(Q.year, Q.month - 1, (Q.week || 1) * 7).toISOString();
    if (!Q.election_history_events.some(function (event) { return event.type === "local-election" && event.date === historyDate; })) {
        Q.election_history_events.push({ date: historyDate, type: "local-election", label: G.englishText(G.text("Local Election")) });
    }
!}
on-display: {!
    const data = [];
    if (Q.cup_local_barcelona_s) {
        data.push({
            "id": "cup",
            "legend": "CUP",
            "name": "CUP",
            "seats": Q.cup_local_barcelona_s,
        });
    }
    if (Q.primaries_local_barcelona_s) {
        data.push({
            "id": "primaries",
            "legend": "Primàries",
            "name": "Primàries",
            "seats": Q.primaries_local_barcelona_s,
        });
    }
    if (Q.bcomu_local_barcelona_s) {
        data.push({
            "id": "bcomu",
            "legend": "BComú",
            "name": "BComú",
            "seats": Q.bcomu_local_barcelona_s,
        });
    }
    if (Q.icv_local_barcelona_s) {
        data.push({
            "id": "icv",
            "legend": "ICV-EUiA",
            "name": "ICV-EUiA",
            "seats": Q.icv_local_barcelona_s,
        });
    }
    if (Q.erc_local_barcelona_s) {
        data.push({
            "id": "erc",
            "legend": "ERC",
            "name": "ERC",
            "seats": Q.erc_local_barcelona_s,
        });
    }
    if (Q.psc_local_barcelona_s) {
        data.push({
            "id": "psc",
            "legend": "PSC",
            "name": "PSC",
            "seats": Q.psc_local_barcelona_s,
        });
    }
    if (Q.cs_local_barcelona_s) {
        data.push({
            "id": "cs",
            "legend": "Cs",
            "name": "Cs",
            "seats": Q.cs_local_barcelona_s,
        });
    }
    if (Q.jxsi_local_barcelona_s) {
        data.push({
            "id": "jxsi",
            "legend": "JxSí",
            "name": "JxSí",
            "seats": Q.jxsi_local_barcelona_s,
        });
    }
    if (Q.jxcat_local_barcelona_s) {
        data.push({
            "id": "jxcat",
            "legend": "JxCat",
            "name": "JxCat",
            "seats": Q.jxcat_local_barcelona_s,
        });
    }
    if (Q.junts_local_barcelona_s) {
        data.push({
            "id": "junts",
            "legend": "Junts",
            "name": "Junts",
            "seats": Q.junts_local_barcelona_s,
        });
    }
    if (Q.cdc_local_barcelona_s) {
        data.push({
            "id": "cdc",
            "legend": "CDC",
            "name": "CDC",
            "seats": Q.cdc_local_barcelona_s,
        });
    }
    if (Q.ciu_local_barcelona_s) {
        data.push({
            "id": "ciu",
            "legend": "CiU",
            "name": "CiU",
            "seats": Q.ciu_local_barcelona_s,
        });
    }
    if (Q.pdcat_local_barcelona_s) {
        data.push({
            "id": "pdcat",
            "legend": "PDeCAT",
            "name": "PDeCAT",
            "seats": Q.pdcat_local_barcelona_s,
        });
    }
    if (Q.unio_local_barcelona_s) {
        data.push({
            "id": "unio",
            "legend": "UDC",
            "name": "UDC",
            "seats": Q.unio_local_barcelona_s,
        });
    }
    if (Q.dl_local_barcelona_s) {
        data.push({
            "id": "dl",
            "legend": "DL",
            "name": "DL",
            "seats": Q.dl_local_barcelona_s,
        });
    }
    if (Q.pp_local_barcelona_s) {
        data.push({
            "id": "pp",
            "legend": "PP",
            "name": "PP",
            "seats": Q.pp_local_barcelona_s,
        });
    }
    if (Q.fnc_local_barcelona_s) {
        data.push({
            "id": "fnc",
            "legend": "FNC",
            "name": "FNC",
            "seats": Q.fnc_local_barcelona_s,
        });
    }
    if (Q.pxc_local_barcelona_s) {
        data.push({
            "id": "pxc",
            "legend": "PxC",
            "name": "PxC",
            "seats": Q.pxc_local_barcelona_s,
        });
    }
    if (Q.vox_local_barcelona_s) {
        data.push({
            "id": "vox",
            "legend": "Vox",
            "name": "Vox",
            "seats": Q.vox_local_barcelona_s,
        });
    }

    Q.election_simulation_local_hemicycle = {
        seats: data.map(function (party) {
            return { party: party.id, seats: party.seats, colour: party.id };
        }),
        majority: Q.barcelona_s_majority,
        highlightedParty: (Q.player_in_jxsi && Q.jxsi_in_local) ? "jxsi"
            : ((Q.player_in_jxcat && Q.jxcat_in_local) ? "jxcat" : Q.player_party),
    };

    // TODO: Actual BCN govt formation, etc
    Q.local_barcelona_wp = "bcomu";
!}

