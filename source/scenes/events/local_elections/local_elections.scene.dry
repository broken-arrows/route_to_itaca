width: [+ jxcat_local_rb_pct +]%; height: 2em; background-color: var(--jxcat); color: white; text-align: center; font-weight: bold;;'>[+ jxcat_local_rb_pct+]%</td>?][? if junts_local_rb_pct > 0:<td style='overflow:hidden; white-space: nowrap; width: [+ junts_local_rb_pct +]%; height: 2em; background-color: var(--junts); color: white; text-align: center; font-weight: bold;'>[+ junts_local_rb_pct+]%</td>?][? if cup_local_rb_pct > 0:<td style='overflow:hidden; white-space: nowrap; width: [+ cup_local_rb_pct +]%; height: 2em; background-color: var(--cup); color: var(--text-color); text-align: center; font-weight: bold;'>[+ cup_local_rb_pct+]%</td>?][? if pp_local_rb_pct > 0:<td style='overflow:hidden; white-space: nowrap; width: [+ pp_local_rb_pct +]%; height: 2em; background-color: var(--pp); color: white; text-align: center; font-weight: bold;'>[+ pp_local_rb_pct+]%</td>?][? if comuns_local_rb_pct > 0:<td style='overflow:hidden; white-space: nowrap; width: [+ comuns_local_rb_pct +]%; height: 2em; [? if parlament_current_icv = "icv": background-color: var(--icv)?][? if parlament_current_icv = "csqp": background-color: var(--csqp)?][? if parlament_current_icv = "cecp": background-color: var(--cecp)?][? if parlament_current_icv = "ecp": background-color: var(--ecp)?]; color: white; text-align: center; font-weight: bold;'>[+ comuns_local_rb_pct+]%</td>?][? if others_local_rb_pct > 0:<td style='overflow:hidden; white-space: nowrap; width: [+ others_local_rb_pct +]%; height: 2em; background-color: var(--txt); color: white; text-align: center; font-weight: bold; border-radius: 0 3px 3px 0;'>[+ others_local_rb_pct+]%</td>?]</tr> 
<tr>[? if psc_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ psc_local_rb_pct +]%'>psc</td>?][? if erc_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ erc_local_rb_pct +]%'>erc</td>?][? if cs_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ cs_local_rb_pct +]%'>cs</td>?][? if ciu_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ ciu_local_rb_pct +]%'>ciu</td>?][? if cdc_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ cdc_local_rb_pct +]%'>cdc</td>?][? if jxsi_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ jxsi_local_rb_pct +]%'>jxsi</td>?][? if dl_local_rb_pct > 0: <td style=' white-space: nowrap; width: [+ dl_local_rb_pct +]%'>dl</td>?][? if pdcat_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ pdcat_local_rb_pct +]%'>pdcat</td>?][? if jxcat_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ jxcat_local_rb_pct +]%'>jxcat</td>?][? if junts_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ junts_local_rb_pct +]%'>junts</td>?][? if cup_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ cup_local_rb_pct +]%'>cup</td>?][? if pp_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ pp_local_rb_pct +]%'>pp</td>?][? if comuns_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ comuns_local_rb_pct +]%'>[? if parlament_current_icv = "icv" : ICV-... ?][? if parlament_current_icv != "icv" : [+ parlament_current_icv +]?]</td>?][? if others_local_rb_pct > 0: <td style='white-space: nowrap; width: [+ others_local_rb_pct +]%; color: var(--txt); text-align: right; font-style: italic; font-size: 0.75em;'>others</td>?]</tr>
{!</table>!}

