title: resolve coalition
on-arrival: {!
    var rawCabinet = Array.isArray(Q.cat_coalition) ? Q.cat_coalition : [];
    var rawSupport = Array.isArray(Q.cat_coalition_support) ? Q.cat_coalition_support : [];
    var rawAbstain = Array.isArray(Q.cat_coalition_abstain) ? Q.cat_coalition_abstain : [];
    var uniqueParties = function (parties) {
        return parties.filter(function (party, index) {
            return party && parties.indexOf(party) == index;
        });
    };
    var cabinet = uniqueParties(rawCabinet);
    var support = uniqueParties(rawSupport).filter(function (party) {
        return cabinet.indexOf(party) < 0;
    });
    var abstain = uniqueParties(rawAbstain).filter(function (party) {
        return cabinet.indexOf(party) < 0 && support.indexOf(party) < 0;
    });

    Q.parlament_coalition_resolution_errors = [];
    var resolutionError = function (message) {
        Q.parlament_coalition_resolution_errors.push(message);
        console.error("Coalition resolution: " + message);
    };
    for (var overlapParty of uniqueParties(rawSupport.concat(rawAbstain))) {
        if (rawCabinet.indexOf(overlapParty) >= 0 || (rawSupport.indexOf(overlapParty) >= 0 && rawAbstain.indexOf(overlapParty) >= 0)) {
            resolutionError(overlapParty + " appeared in more than one parliamentary role");
        }
    }

    Q.cat_coalition = cabinet;
    Q.cat_coalition_support = support;
    Q.cat_coalition_abstain = abstain;

    Q.erc_in_gob = cabinet.indexOf("erc") >= 0;
    Q.erc_supporting = Q.erc_in_gob || support.indexOf("erc") >= 0;
    Q.cup_in_gob = cabinet.indexOf("cup") >= 0;
    Q.cup_supporting = Q.cup_in_gob || support.indexOf("cup") >= 0;
    Q.jxsi_in_gob = cabinet.indexOf("jxsi") >= 0;
    Q.jxcat_in_gob = cabinet.indexOf("jxcat") >= 0;

    var playerList = Q.player_in_jxsi ? "jxsi" :
        Q.player_in_jxcat ? "jxcat" : Q.player_party;
    var playerInCabinet = cabinet.indexOf(Q.player_party) >= 0 ||
        cabinet.indexOf(playerList) >= 0;
    var playerSupports = support.indexOf(Q.player_party) >= 0 ||
        support.indexOf(playerList) >= 0;
    if (playerInCabinet) {
        Q.position_disp = "Generalitat";
    } else if (playerSupports) {
        Q.position_disp = "<span style='font-style: italic'>Government Support</span>";
    } else {
        Q.position_disp = "<span style='font-style: italic'>Opposition</span>";
    }

    if (cabinet.indexOf(Q.parlament_coalition_proposal_president) < 0) {
        resolutionError("the proposed President does not belong to the formal cabinet");
    }
    for (var cabinetParty of cabinet) {
        if (!(Q[cabinetParty + "_parlament_s"] > 0)) {
            resolutionError(cabinetParty + " has no parliamentary seats but appears in the cabinet");
        }
    }
    if (!Q.speaker_party || !Q.speaker || !Q.speaker_gender) {
        resolutionError("the Speaker was not fully settled before government resolution");
    }
    var ministryKeys = ["vp", "economy", "interior", "health", "education", "territory", "foreign", "bnl"];
    for (var ministryKey of ministryKeys) {
        var ministryParty = Q["parlament_coalition_proposal_" + ministryKey];
        if (ministryParty && cabinet.indexOf(ministryParty) < 0) {
            resolutionError(ministryParty + " holds " + ministryKey + " despite remaining outside the cabinet");
        }
    }
    Q.parlament_coalition_resolution_valid = Q.parlament_coalition_resolution_errors.length == 0;

    Q.president_party = Q.parlament_coalition_proposal_president;
    Q.president_gender = Q.parlament_coalition_proposal_president_gender;
    Q.president = Q.parlament_coalition_proposal_president_name;
    
    Q.vicepresident_party = Q.parlament_coalition_proposal_vp;
    Q.vicepresident = Q.parlament_coalition_proposal_vp_name;
    Q.vicepresident_gender = Q.parlament_coalition_proposal_vp_gender;
    
    Q.economy_minister_party = Q.parlament_coalition_proposal_economy;
    Q.economy_minister = Q.parlament_coalition_proposal_economy_name;
    Q.economy_minister_gender = Q.parlament_coalition_proposal_economy_gender;

    Q.interior_minister_party = Q.parlament_coalition_proposal_interior;
    Q.interior_minister = Q.parlament_coalition_proposal_interior_name;
    Q.interior_minister_gender = Q.parlament_coalition_proposal_interior_gender;

    Q.health_minister_party = Q.parlament_coalition_proposal_health;
    Q.health_minister = Q.parlament_coalition_proposal_health_name;
    Q.health_minister_gender = Q.parlament_coalition_proposal_health_gender;

    Q.education_minister_party = Q.parlament_coalition_proposal_education;
    Q.education_minister = Q.parlament_coalition_proposal_education_name;
    Q.education_minister_gender = Q.parlament_coalition_proposal_education_gender;

    Q.territory_minister_party = Q.parlament_coalition_proposal_territory;
    Q.territory_minister = Q.parlament_coalition_proposal_territory_name;
    Q.territory_minister_gender = Q.parlament_coalition_proposal_territory_gender;

    Q.foreign_minister_party = Q.parlament_coalition_proposal_foreign;
    Q.foreign_minister = Q.parlament_coalition_proposal_foreign_name;
    Q.foreign_minister_gender = Q.parlament_coalition_proposal_foreign_gender;

    Q.bnl_minister_party = Q.parlament_coalition_proposal_bnl;
    Q.bnl_minister = Q.parlament_coalition_proposal_bnl_name;
    Q.bnl_minister_gender = Q.parlament_coalition_proposal_bnl_gender;

    Q.cat_caretaker_gov = false;
    Q.parlament_repeat_election = false;

    Q.historical_event = "We have a new government in the Generalitat! President " + Q.president + " will lead a " + Q.cat_coalition_disp + " for this legislature.";

    if (playerInCabinet) {
        Q.burdens_done = 0;
        Q.burdens_start_countdown = 1;
        if (!Q.countdowns.includes("burdens_start")) Q.countdowns.push("burdens_start");
        if (!Q.government_budget || Q.government_budget < 1) Q.government_budget = 1;
    }
    if (Q.jxsi_parlament_s > 0 && !Q.countdowns.includes("jxcat_formation")) {
        Q.jxcat_formation_countdown = 6;
        Q.countdowns.push("jxcat_formation");
    }

    // Accepted policy clauses belong to this government/support agreement.
    for (var previous of Q.coalition_policy_commitments || [])
        G.deactivateLaw(Q, "coalition_pending_" + previous.kind, undefined, true);
    Q.coalition_policy_commitments = [];
    if (Q.parlament_coalition_policy_accepted) {
        var commitments = [
            {selected: Q.parlament_coalition_policy_cap, kind: "social_spending_cap", target: Q.parlament_coalition_policy_cap_target, title: "Raise on the social spending cap", icon: "img/economy_icon.svg"},
            {selected: Q.parlament_coalition_policy_education, kind: "education_spending", spending: true, target: Q.parlament_coalition_policy_education_target, title: "Education spending increase", icon: "img/education_icon.svg"},
            {selected: Q.parlament_coalition_policy_health, kind: "healthcare_spending", spending: true, target: Q.parlament_coalition_policy_health_target, title: "Health spending increase", icon: "img/health_icon.svg"},
            {selected: Q.parlament_coalition_policy_pay, kind: "public_salary_level", spending: true, target: Q.parlament_coalition_policy_pay_target, title: "Public salaries increase", icon: "img/economy_icon.svg"},
            {selected: Q.parlament_coalition_policy_tax, kind: "tax_progressivity", target: Q.parlament_coalition_policy_tax_target, title: "More progressive tax scheme", icon: "img/people_icon.svg"}
        ];
        commitments.forEach(function (item) {
            if (!item.selected) return;
            if ((item.kind == "education_spending" || item.kind == "healthcare_spending") && !(Q[item.kind] >= -2 && Q[item.kind] < 2 && item.target == Q[item.kind] + 1)) return;
            var cap = typeof Q.social_spending_cap == "number" ? Q.social_spending_cap : Q.parlament_coalition_policy_effective_cap;
            var allowed = item.spending && typeof cap == "number" && cap >= item.target && (item.kind != "public_salary_level" || Q.public_salary_raise_allowed);
            var record = {kind: item.kind, target: item.target, scope: "cabinet", signatories: ["erc", Q.parlament_current_ciu], status: allowed ? "applied" : "pending_budget"};
            Q.coalition_policy_commitments.push(record);
            if (allowed) {
                Q[item.kind] = item.target;
                Q.parlament_coalition_policy_policy_applied = true;
            } else {
                G.registerLaw(Q, {
                    id: "coalition_pending_" + item.kind,
                    title: item.title,
                    icon: item.icon,
                    colour: "gray",
                    description: item.kind == "social_spending_cap"
                        ? "Parties of the current government coalition have taken the commitment to increase the social spending cap in the next budget negotiations."
                        : item.spending
                            ? "Pending budget approval: this extra spending package is conditional on an increase in the social spending cap."
                            : "Parties of the current government coalition have taken the commitment to implement a more progressive tax package in the next budget negotiations.",
                    targets: {}
                });
            }
        });
        Q.parlament_coalition_policy_accepted = false;
    }
    Q.budget_failed_times = 0;
!}
call: generalitat_setpolicy
go-to: post_event
