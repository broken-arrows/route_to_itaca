title: Parlament Elections - [+ next_election_month : month +] [+ next_election_year +]
tags: election
view-if: year = next_election_year and month = next_election_month and (week = next_election_week or not rubicon)
new-page: true
set-bg: img/parlament_de_catalunya.jpg
go-to: election_algorithm.cat_parlament
set-jump: parlament_election.post_election
role: event

@post_election
new-page: true
on-arrival: {!
    Q.next_election_year = Q.year + 4;
    Q.next_election_time = Q.time + 48;
    
    // edge case for 2012
    if (Q.player_party == "cup" && Q.cup_parlament_s > 0 && Q.year == 2012) {
        G.setText(Q, "position_disp", G.text("<span style='font-style: italic'>Opposition</span>"));
    } 
    if ((Q.player_party == "cup" && Q.cup_parlament_s <= 0 && !Q.cup_in_jxsi && !Q.cup_in_jxcat) || (Q.player_party == "erc" && Q.erc_parlament_s <= 0 && !Q.erc_in_jxsi && !Q.erc_in_jxcat)) {
        Q.game_over_trigger = true;
    }
    if (Q.fnc_parlament_s > 0) {
        this.achieve('josep_maria');
    }
    // Persist the actual playthrough date for chart annotations, once per event.
    if (!Array.isArray(Q.election_history_events)) Q.election_history_events = [];
    var historyDate = new Date(Q.year, Q.month - 1, (Q.week || 1) * 7).toISOString();
    if (!Q.election_history_events.some(function (event) { return event.type === "parlament-election" && event.date === historyDate; })) {
        Q.election_history_events.push({ date: historyDate, type: "parlament-election", label: G.englishText(G.text("Parlament Election")) });
    }
!}
on-display: {!
    const data = [];

    if (Q.si_parlament_s) {
        data.push({
            "id": "si",
            "legend": "SI",
            "name": "SI",
