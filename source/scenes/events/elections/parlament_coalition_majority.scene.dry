title: [+ parlament_coalition_majority_party +] <span class="generalitat-coalition" data-parties="[+ parlament_coalition_majority_party +]" data-summary="Majority government - [+ parlament_coalition_majority_s +]/[+ parlament_s_majority +]"><span style="color: var(--[+ parlament_coalition_majority_party +]); font-style: italic;">Majority Government</span></span>
view-if: parlament_coalition_option_majority_visible
choose-if: parlament_coalition_majority_s >= parlament_s_majority
subtitle: [? if parlament_coalition_majority_party == player_party: We won an absolute majority, we can govern on our own! ?][? if parlament_coalition_majority_party != player_party: [+ parlament_coalition_majority_party +] holds an absolute majority and will govern alone.?]
on-arrival: {!
    var mp = Q.parlament_coalition_majority_party;

    Q.erc_in_gob = false;
    Q.erc_supporting = false;
    Q.cup_in_gob = false;
    Q.cup_supporting = false;
    Q.cat_coalition_dissent = 0;
    Q.month_actions += 1;

    Q.cat_coalition = [mp];
    Q.cat_coalition_support = [];
    Q.cat_coalition_abstain = [];
    G.setText(Q, "cat_coalition_disp", "{party} {government}", {
        party: mp,
        government: G.governmentTooltipText("generalitat", Q.cat_coalition, G.text("Majority government - {seats}/{majority}", {
            seats: Q.parlament_coalition_majority_s,
            majority: Q.parlament_s_majority
        }), G.text("<span style='color: var(--{party}); font-style: italic;'>Majority Government</span>", {
            party: mp
        }))
    });

    Q.parlament_coalition_proposal_president = mp;
    Q.parlament_coalition_proposal_vp = mp;
    Q.parlament_coalition_proposal_economy = mp;
    Q.parlament_coalition_proposal_interior = mp;
    Q.parlament_coalition_proposal_health = mp;
    Q.parlament_coalition_proposal_education = mp;
    Q.parlament_coalition_proposal_foreign = mp;
    Q.parlament_coalition_proposal_territory = mp;
    Q.parlament_coalition_proposal_bnl = mp;

    // Speaker from the governing party (established second-figure names where known)
    Q.speaker_party = mp;
    switch (mp) {
        case "erc":
            if (Q.year < 2016) {
                Q.speaker = "Anna Simó";
                Q.speaker_gender = "f";
            } else {
                Q.speaker = "Roger Torrent";
                Q.speaker_gender = "m";
            }
            break;
        case "ciu":
            Q.speaker = "Núria de Gispert";
            Q.speaker_gender = "f";
            break;
        case "cdc":
        case "dl":
            Q.speaker = "Carles Campuzano";
            Q.speaker_gender = "m";
            break;
        case "pdcat":
            Q.speaker = "Lluís Corominas";
            Q.speaker_gender = "m";
            break;
        case "jxsi":
            Q.speaker = "Carme Forcadell";
            Q.speaker_gender = "f";
            break;
        case "jxcat":
        case "junts":
            if (Q.junts_leader != "Laura Borràs") {
                Q.speaker = "Laura Borràs";
                Q.speaker_gender = "f";
            } else {
                Q.speaker = "Albert Batet";
                Q.speaker_gender = "m";
            }
            break;
        case "psc":
            Q.speaker = "Eva Granados";
            Q.speaker_gender = "f";
            break;
        case Q.parlament_current_icv:
            Q.speaker = Q.parlament_current_icv_leader == "Lluís Rabell" ? "Dolors Camats" : "Lluís Rabell";
            Q.speaker_gender = Q.parlament_current_icv_leader == "Lluís Rabell" ? "f" : "m";
            break;
        case "cs":
            Q.speaker = "José María Espejo-Saavedra";
            Q.speaker_gender = "m";
            break;
        case "ppc":
            Q.speaker = "Enric Millo";
            Q.speaker_gender = "m";
            break;
        case "cup":
            Q.speaker = Q.year < 2017 ? "Julià de Jòdar" : "Vidal Aragonés";
            Q.speaker_gender = "m";
            break;
        case "unio":
            Q.speaker = "Ramon Espadaler";
            Q.speaker_gender = "m";
            break;
        default:
            Q.speaker = Q[mp + "_leader"];
            Q.speaker_gender = Q[mp + "_leader_gender"] || "m";
    }

    if (mp == Q.player_party) {
        G.setText(Q, "position_disp", G.text("Generalitat"));
        if (mp == "erc") { Q.erc_in_gob = true; Q.erc_supporting = true; }
        else if (mp == "cup") { Q.cup_in_gob = true; Q.cup_supporting = true; }
    } else {
        G.setText(Q, "position_disp", G.text("<span style='font-style: italic'>Opposition</span>"));
    }

    // A unionist single-party government inflames the movement and erodes trust in the process
    if (mp == "cs" || mp == "ppc" || mp == "psc" || mp == "vox") {
        Q.independence_movement += 10;
        Q.independence_trust -= 15;
    }
!}
go-to: parlament_coalition_setnames
set-jump: display_government

[? if parlament_coalition_majority_party == player_party: We have secured an absolute majority and will govern alone. ?][? if parlament_coalition_majority_party != player_party: [+ parlament_coalition_majority_party +] secured an absolute majority and will govern alone. ?] The Speaker of the House will be [+ speaker +] ([+ speaker_party +]).

@display_government

- @parlament_coalition_resolve: A new government is formed.
