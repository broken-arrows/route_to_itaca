@form
on-arrival: {!
    Q.erc_in_gob = false;
    Q.erc_supporting = false;
    Q.cup_in_gob = false;
    Q.cup_supporting = false;
    Q.cat_coalition_dissent = 0;
    Q.position_disp = "<span style='font-style: italic'>Opposition</span>";
    Q.month_actions += 1;
    Q.independence_movement += 10;
    Q.independence_trust -= 15;

    var variant = Q.parlament_unionist_variant;
    var president = "cs";
    var vicePresident = "cs";
    var cabinet = ["cs"];
    var support = [];
    var abstain = [];
    var displayName = "<span style='color: var(--cs); font-style: italic;'>Moderation</span> Government";

    if (variant == "psc_cs_mod") {
        president = "psc"; vicePresident = "psc"; cabinet = ["psc"]; support = ["cs"];
    } else if (variant == "cs_psc_unio_mod") {
        support = ["psc", "unio"];
    } else if (variant == "psc_cs_unio_mod") {
        president = "psc"; vicePresident = "psc"; cabinet = ["psc"]; support = ["cs", "unio"];
    } else if (variant == "psc_cs_unio_ppc_abst") {
        president = "psc"; vicePresident = "psc"; cabinet = ["psc"]; support = ["cs", "unio"]; abstain = ["ppc"];
    } else if (variant == "cs_ppc") {
        support = ["ppc"]; displayName = "<span style='color: var(--ppc); font-style: italic;'>Constitutionalist</span> Pact";
    } else if (variant == "cs_ppc_psc_abst") {
        support = ["ppc"]; abstain = ["psc"]; displayName = "Unity Pact";
    } else if (variant == "cs_psc_ppc_sup") {
        support = ["psc", "ppc"]; displayName = "Grand Unity Pact";
    } else if (variant == "psc_cs_ppc_abst") {
        president = "psc"; vicePresident = "psc"; cabinet = ["psc"]; support = ["cs"]; abstain = ["ppc"]; displayName = "Unity Pact";
    } else if (variant == "psc_cs_ppc_sup") {
        president = "psc"; vicePresident = "psc"; cabinet = ["psc"]; support = ["cs", "ppc"]; displayName = "Grand Unity Pact";
    } else if (variant == "ppc_cs") {
        president = "ppc"; vicePresident = "cs"; cabinet = ["ppc", "cs"]; displayName = "<span style='color: var(--ppc); font-style: italic;'>Constitutionalist</span> Government";
    } else if (variant == "cs_ppc_vox") {
        president = Q.cs_parlament_s >= Q.ppc_parlament_s ? "cs" : "ppc";
        vicePresident = president == "cs" ? "ppc" : "cs";
        cabinet = [president, vicePresident]; support = ["vox"];
        displayName = "<span style='color: var(--cs); font-style: italic;'>Right</span>-<span style='color: var(--vox); font-style: italic;'>Union</span> Coalition";
    } else if (variant == "ppc_cs_psc_abst") {
        president = "ppc"; vicePresident = "cs"; cabinet = ["ppc", "cs"]; abstain = ["psc"]; displayName = "Unity Pact";
    } else if (variant == "ppc_cs_psc_sup") {
        president = "ppc"; vicePresident = "cs"; cabinet = ["ppc", "cs"]; support = ["psc"]; displayName = "Grand Unity Pact";
    } else if (variant == "cs_ppc_psc_vox_abst") {
        president = Q.cs_parlament_s >= Q.ppc_parlament_s ? "cs" : "ppc";
        vicePresident = president == "cs" ? "ppc" : "cs";
        cabinet = [president, vicePresident]; support = ["psc"]; abstain = ["vox"]; displayName = "Unthinkably Grand Coalition";
    } else if (variant == "cs_ppc_vox_psc_abst") {
        president = Q.cs_parlament_s >= Q.ppc_parlament_s ? "cs" : "ppc";
        vicePresident = president == "cs" ? "ppc" : "cs";
        cabinet = [president, vicePresident]; support = ["vox"]; abstain = ["psc"]; displayName = "Unthinkable Unity Pact";
    } else if (variant == "cs_ppc_vox_psc_sup") {
        president = Q.cs_parlament_s >= Q.ppc_parlament_s ? "cs" : "ppc";
        vicePresident = president == "cs" ? "ppc" : "cs";
        cabinet = [president, vicePresident]; support = ["vox", "psc"]; displayName = "Salvation Government";
    } else if (variant == "cs_emergency") {
        support = [];
        if (Q.psc_parlament_s > 0) support.push("psc");
        if (Q.cs_parlament_s + Q.psc_parlament_s < Q.parlament_s_majority && Q.ppc_parlament_s > 0) support.push("ppc");
        if (Q.cs_parlament_s + Q.psc_parlament_s + Q.ppc_parlament_s < Q.parlament_s_majority) support.push(Q.parlament_current_icv);
        displayName = "Unthinkably Grand Coalition";
    } else if (variant == "ciu_unio") {
        president = Q.parlament_current_ciu; vicePresident = "unio";
        cabinet = [president, "unio"]; displayName = "CiU 2.0 - Back Together";
    }

    Q.cat_coalition = cabinet;
    Q.cat_coalition_support = support;
    Q.cat_coalition_abstain = abstain;
    var governmentSeats = 0;
    for (var ci = 0; ci < cabinet.length; ci++) governmentSeats += Q[cabinet[ci] + "_parlament_s"] || 0;
    Q.cat_coalition_disp = G.governmentTooltip("generalitat", Q.cat_coalition, (governmentSeats >= Q.parlament_s_majority ? "Majority government - " : "Minority government - ") + governmentSeats + "/" + Q.parlament_s_majority, displayName);

    Q.parlament_coalition_proposal_president = president;
    Q.parlament_coalition_proposal_vp = vicePresident;
    Q.parlament_coalition_proposal_economy = president;
    Q.parlament_coalition_proposal_interior = president;
    Q.parlament_coalition_proposal_foreign = president;
    Q.parlament_coalition_proposal_health = president;
    Q.parlament_coalition_proposal_education = president;
    Q.parlament_coalition_proposal_territory = president;
    Q.parlament_coalition_proposal_bnl = president;

    if (cabinet.length > 1 && variant != "ciu_unio") {
        Q.parlament_coalition_proposal_health = vicePresident;
        Q.parlament_coalition_proposal_education = vicePresident;
        Q.parlament_coalition_proposal_territory = vicePresident;
        var juniorLeverage = (Q[vicePresident + "_parlament_s"] / governmentSeats) * 55;
        if (juniorLeverage > 20) Q.parlament_coalition_proposal_bnl = vicePresident;
    }

    if (variant == "ciu_unio") {
        Q.speaker_party = "unio";
        Q.speaker = "Ramon Espadaler";
        Q.speaker_gender = "m";
    } else if (cabinet.length > 1) {
        Q.speaker_party = vicePresident;
        Q.speaker = Q[vicePresident + "_leader"];
        Q.speaker_gender = Q[vicePresident + "_leader_gender"];
    } else if (president == "cs") {
        Q.speaker_party = "cs";
        Q.speaker = "Carlos Carrizosa";
        Q.speaker_gender = "m";
    } else if (president == "psc") {
        Q.speaker_party = "psc";
        Q.speaker = "Eva Granados";
        Q.speaker_gender = "f";
    } else {
        Q.speaker_party = president;
        Q.speaker = Q[president + "_leader"];
        Q.speaker_gender = Q[president + "_leader_gender"];
    }
!}
go-to: parlament_coalition_setnames
set-jump: display_government

The necessary parties have agreed to the investiture of a [+ cat_coalition_disp +]. The Speaker of the House will be [+ speaker +] ([+ speaker_party +]).

@display_government

- @parlament_coalition_resolve: We can only hope this does not last long...
