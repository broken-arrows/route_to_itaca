@cs_ppc_vox
title: [? if cs_parlament_s > ppc_parlament_s: Cs-led ?][? if cs_parlament_s <= ppc_parlament_s: PPC-Cs ?]<span class="generalitat-coalition" data-parties="[? if cs_parlament_s > ppc_parlament_s: cs?][? if cs_parlament_s <= ppc_parlament_s: ppc cs?]" data-summary="Minority government with [? if cs_parlament_s > ppc_parlament_s: PPC and ?]Vox support"><span style="color: var(--cs); font-style: italic;">Right</span>-<span style="color: var(--vox); font-style: italic;">Union</span> Coalition</span> with [? if cs_parlament_s > ppc_parlament_s: PPC and ?]Vox support
view-if: parlament_coalition_option_cs_ppc_vox_visible
