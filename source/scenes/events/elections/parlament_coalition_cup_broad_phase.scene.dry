unavailable-subtitle: [? if parlament_coalition_concessions_social: The commitment is already included.?][? if parlament_coalition_leverage < 5: We lack enough leverage.?]
on-arrival: {!
    Q.parlament_coalition_changes = true;
    Q.parlament_coalition_concessions = true;
    Q.parlament_coalition_concessions_social = 1;
    Q.parlament_coalition_concessions_social_text = "The cabinet commits to reverse austerity and expand social spending.";
    Q.parlament_coalition_leverage -= 5;
!}
go-to: phase_text

@indy
title: Demand a stronger independence commitment
choose-if: erc_roadmap < 0
unavailable-subtitle: [? if cup_broad_kind = "new_popular_front" or cup_broad_kind = "minority_left_tripartite": The PSC will not accept a stronger independence commitment in this cabinet.?][? if cup_broad_kind = "republican" or cup_broad_kind = "popular_unity": The current [+ parlament_current_icv +] leadership will not accept an independence demand beyond the roadmap already agreed.?]
go-to: phase_text

@push
title: Press for further concessions
view-if: cup_broad_coalition_phase < 3
choose-if: parlament_coalition_push < cup_broad_coalition_phase and cup_broad_coalition_phase < 3
unavailable-subtitle: We cannot push any further this round.
on-arrival: {!
    Q.parlament_coalition_push += 1;
    Q.parlament_coalition_leverage += 4;
    Q.cup_relations -= Q.cup_broad_coalition_phase == 1 ? 4 : 2;
    Q[Q.parlament_current_icv + "_relations"] -= 2;
!}
go-to: phase_text

@send
title: [? if player_party = parlament_coalition_leader and cup_broad_coalition_phase = 1: Submit the opening proposal?][? if not (player_party = parlament_coalition_leader and cup_broad_coalition_phase = 1): Send the counter-proposal?]
view-if: parlament_coalition_changes
on-arrival: {!
    var playerInCabinet = Q.player_party == "erc" || (Q.player_party == "cup" && Q.cup_broad_kind == "popular_unity");
    var earlyRound = Q.cup_broad_coalition_phase <= 2;

    Q.cup_broad_reject_pressure = Q.parlament_coalition_push >= Q.cup_broad_coalition_phase;
    Q.cup_broad_reject_erc_positions = false;
    Q.cup_broad_reject_psc_positions = false;
    Q.cup_broad_reject_psc_cup_power = false;
    Q.cup_broad_reject_comuns_positions = false;
    Q.cup_broad_reject_cup_share = false;

    if (playerInCabinet) {
        if (Q.player_party == "cup" && Q.cup_broad_kind == "popular_unity") {
            Q.cup_broad_reject_erc_positions =
                (earlyRound && Q.cup_broad_expected_vp == "erc" && Q.parlament_coalition_proposal_vp != "erc") ||
                (earlyRound && Q.cup_broad_expected_economy == "erc" && Q.parlament_coalition_proposal_economy != "erc") ||
                (Q.cup_broad_coalition_phase == 1 && Q.cup_broad_expected_interior == "erc" && Q.parlament_coalition_proposal_interior != "erc");
        }

        if (Q.player_party == "erc" && (Q.cup_broad_kind == "new_popular_front" || Q.cup_broad_kind == "minority_left_tripartite")) {
            Q.cup_broad_reject_psc_positions =
                (earlyRound && Q.cup_broad_expected_vp == "psc" && Q.parlament_coalition_proposal_vp != "psc") ||
                (Q.cup_broad_coalition_phase == 1 && Q.cup_broad_expected_economy == "psc" && Q.parlament_coalition_proposal_economy != "psc") ||
                (earlyRound && Q.cup_broad_expected_interior == "psc" && Q.parlament_coalition_proposal_interior != "psc");
            Q.cup_broad_reject_psc_cup_power = Q.parlament_coalition_proposal_interior == "cup" || Q.parlament_coalition_proposal_economy == "cup";
        }

        Q.cup_broad_reject_comuns_positions =
            (earlyRound && Q.cup_broad_expected_vp == Q.parlament_current_icv && Q.parlament_coalition_proposal_vp != Q.parlament_current_icv) ||
            (earlyRound && Q.cup_broad_expected_bnl == Q.parlament_current_icv && Q.parlament_coalition_proposal_bnl != Q.parlament_current_icv) ||
            (earlyRound && Q.cup_broad_expected_health == Q.parlament_current_icv && Q.parlament_coalition_proposal_health != Q.parlament_current_icv);

        if (Q.player_party == "erc" && Q.cup_broad_kind == "popular_unity") {
            var cupMinistries = 0;
            var ministries = ["interior", "economy", "foreign", "health", "education", "territory", "bnl"];
            for (var i = 0; i < ministries.length; i++) {
                if (Q["parlament_coalition_proposal_" + ministries[i]] == "cup") {
                    cupMinistries += 1;
                }
            }
            Q.cup_broad_reject_cup_share = cupMinistries < 2;
        }
    }

    Q.parlament_coalition_proposal_accept = !Q.cup_broad_reject_pressure &&
        !Q.cup_broad_reject_erc_positions &&
        !Q.cup_broad_reject_psc_positions &&
        !Q.cup_broad_reject_psc_cup_power &&
        !Q.cup_broad_reject_comuns_positions &&
        !Q.cup_broad_reject_cup_share;
!}
go-to: accepted if parlament_coalition_proposal_accept; next_phase if not parlament_coalition_proposal_accept

@accept
title: Accept the current proposal
choose-if: not parlament_coalition_changes
unavailable-subtitle: Our changes require the other parties' approval first.
go-to: accepted

@accepted
on-arrival: {!
    Q.cup_broad_coalition_phase = 0;
    if (Q.cup_broad_kind == "republican") {
        Q.cat_coalition = ["erc", Q.parlament_current_icv];
    }
    if (Q.cup_broad_kind == "popular_unity" && Q.parlament_coalition_leader == "erc") {
        Q.cat_coalition = ["erc", Q.parlament_current_icv, "cup"];
    }
    if (Q.cup_broad_kind == "popular_unity" && Q.parlament_coalition_leader == Q.parlament_current_icv) {
        Q.cat_coalition = [Q.parlament_current_icv, "erc", "cup"];
    }
    if (Q.cup_broad_kind == "popular_unity" && Q.parlament_coalition_leader == "cup") {
        Q.cat_coalition = ["cup", "erc", Q.parlament_current_icv];
    }
    if (Q.cup_broad_kind == "new_popular_front" || Q.cup_broad_kind == "minority_left_tripartite") {
        Q.cat_coalition = ["erc", "psc", Q.parlament_current_icv];
    }
    Q.cat_coalition_support = (Q.cup_broad_kind == "republican" || Q.cup_broad_kind == "new_popular_front") ? ["cup"] : [];
    Q.cat_coalition_abstain = Q.cup_broad_kind == "minority_left_tripartite" ? ["cup"] : [];
    var comunsStyle = "color: var(--" + Q.parlament_current_icv + "); font-style: italic;";
    var label = "";
    if (Q.cup_broad_kind == "republican") {
        label = "<span style='color: var(--erc); font-style: italic;'>Republican</span> <span style='" + comunsStyle + "'>Government</span>";
    } else if (Q.cup_broad_kind == "popular_unity") {
        label = "<span style='color: var(--erc); font-style: italic;'>Popular</span> <span style='" + comunsStyle + "'>Unity</span> <span style='color: var(--cup); font-style: italic;'>Coalition</span>";
    } else if (Q.cup_broad_kind == "new_popular_front") {
        label = "<span style='color: var(--erc); font-style: italic;'>New</span> <span style='color: var(--psc); font-style: italic;'>Popular</span> <span style='" + comunsStyle + "'>Front</span>";
    } else {
        label = "<span style='color: var(--erc); font-style: italic;'>Minority Left</span> <span style='" + comunsStyle + "'>Tri</span><span style='color: var(--psc); font-style: italic;'>partite</span>";
    }
    var governmentSeats = Q.cat_coalition.reduce(function (total, party) {
        return total + (Q[party + "_parlament_s"] || 0);
    }, 0);
    var summary = (governmentSeats >= Q.parlament_s_majority ? "Majority government - " : "Minority government - ") + governmentSeats + "/" + Q.parlament_s_majority;
    Q.cat_coalition_disp = G.governmentTooltip("generalitat", Q.cat_coalition, summary, label);
    Q.erc_in_gob = true;
    Q.erc_supporting = true;
    Q.cup_in_gob = Q.cup_broad_kind == "popular_unity";
    Q.cup_supporting = Q.cup_broad_kind != "minority_left_tripartite";
    Q.cat_coalition_dissent = 0;
    Q.position_disp = Q.player_party == "cup" && !Q.cup_in_gob ? (Q.cup_supporting ? "<span style='font-style: italic'>Government Support</span>" : "<span style='font-style: italic'>Opposition</span>") : "Generalitat";
!}

The parties have reached an agreement to form a [+ cat_coalition_disp +]. [? if cup_broad_kind = "republican" or cup_broad_kind = "new_popular_front": The CUP will support it from outside government.?][? if cup_broad_kind = "minority_left_tripartite": The CUP will abstain and remain in opposition.?]

- @parlament_coalition_resolve: A new government is formed

@next_phase
go-to: new_elections if cup_broad_coalition_phase >= 3; wait if cup_broad_coalition_phase < 3

@wait
on-arrival: {!
    Q.cup_broad_coalition_phase += 1;
    Q.month_actions += 1;
    Q.social_dissent += 2;
!}

[? if player_party = parlament_coalition_leader and cup_broad_coalition_phase = 2: The other parties have rejected our proposal.?][? if not (player_party = parlament_coalition_leader and cup_broad_coalition_phase = 2): The other parties have rejected our counter-proposal.?] [? if cup_broad_reject_erc_positions: ERC considers the proposed balance of government powers inadequate.?][? if cup_broad_reject_psc_positions: The PSC is not satisfied with the distribution of high-responsibility ministries.?][? if cup_broad_reject_psc_cup_power: The PSC considers the ministries assigned to the CUP unacceptable.?][? if cup_broad_reject_comuns_positions: [+ parlament_current_icv +] does not believe the proposal gives it sufficient influence over the government's social programme.?][? if cup_broad_reject_cup_share: The CUP does not believe the proposed cabinet gives it sufficient weight in government.?] The negotiating teams will have to reconvene in a month's time.

- @post_event: And so, time passes...

@new_elections
on-arrival: {!
    Q.parlament_repeat_election = true;
    Q.cup_broad_coalition_phase = 0;
    Q.cup_relations -= 5;
    Q[Q.parlament_current_icv + "_relations"] -= 3;
    Q.snap_blame = Q.player_party;
    Q.snap_counterparty = Q.player_party == "cup"
        ? (Q.parlament_coalition_leader == "cup" ? "erc" : Q.parlament_coalition_leader)
        : "cup";
    Q.snap_severity = 0.12;
!}
call: snap_election

Three rounds have ended without agreement... [? if cup_broad_reject_erc_positions: ERC would not accept the proposed government-power balance.?][? if cup_broad_reject_psc_positions: The PSC remained dissatisfied with the distribution of high-responsibility ministries.?][? if cup_broad_reject_psc_cup_power: The PSC maintained its objection to the powers assigned to the CUP.?][? if cup_broad_reject_comuns_positions: [+ parlament_current_icv +] did not believe the proposal gave it sufficient influence over the government's social programme.?][? if cup_broad_reject_cup_share: The CUP did not believe the proposed cabinet gave it sufficient weight in government.?] The investiture deadline has expired, forcing a repeat election.

- @post_event
