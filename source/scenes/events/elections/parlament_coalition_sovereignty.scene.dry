- @post_event.make_a_wish

@next_round
go-to: failed if parlament_coalition_sovereignty_phase >= 3; wait if parlament_coalition_sovereignty_phase < 3

@wait
on-arrival: {!
    var policies = ["education", "health", "pay", "tax", "cap"];
    Q.parlament_coalition_sovereignty_last_terms = policies.filter(function (p) { return Q['parlament_coalition_policy_' + p]; }).map(function (p) {
      return { policy: p, target: Q['parlament_coalition_policy_' + p + '_target'] };
    });
    Q.parlament_coalition_sovereignty_phase += 1;
    Q.coalition_phase_timer = 1;
    Q.month_actions += 1;
    Q.independence_trust -= 4;

    // TODO: Author Rubicon-specific stuffs
    // TODO: Add programme-credibility events separately from the candidate dispute.
!}

The parties have not reached an agreement. [+ parlament_coalition_sovereignty_reject_reasons +]

[? if parlament_coalition_policy_reject_reasons: [+ parlament_coalition_policy_reject_reasons +]?]

- @post_event: The delegations will have reconvene again...

@accepted
on-arrival: {!
    Q.parlament_coalition_sovereignty_can_form = Q.parlament_coalition_sovereignty_phase > 0 && Q.parlament_coalition_proposal_accept && Q.coalition_phase_timer <= 0;
    if (Q.parlament_coalition_sovereignty_can_form) {
        Q.parlament_coalition_policy_accepted = true;
        Q.parlament_coalition_policy_scope = Q.parlament_coalition_sovereignty_kind == "government" ? "cabinet" : "external_support"; // WIP: check: is this even consumed by anyone?
        Q.cat_coalition = Q.parlament_coalition_sovereignty_cabinet.slice();
        Q.cat_coalition_support = Q.parlament_coalition_sovereignty_kind == "government" ? [] : ["cup"];
        Q.cat_coalition_abstain = [];
        Q.cat_coalition_dissent = 0;
        G.setText(Q, "cat_coalition_disp", G.governmentTooltipText("generalitat", Q.cat_coalition, (Q.parlament_coalition_cabinet_seats >= Q.parlament_s_majority ? G.text("Majority government - {seats}/{majority}", {
            seats: String(Q.parlament_coalition_cabinet_seats),
            majority: String(Q.parlament_s_majority)
        }) : G.text("Minority government - {seats}/{majority}", {
            seats: String(Q.parlament_coalition_cabinet_seats),
            majority: String(Q.parlament_s_majority)
        })), (Q.parlament_coalition_sovereignty_kind == "government" ? G.text("<span style=\"color: var(--erc); font-style: italic;\">National</span> <span style=\"color: var(--{party}); font-style: italic;\">Concentration</span> <span style=\"color: #b8a12b; font-style: italic;\">government</span>", {
            party: String(Q.parlament_current_ciu)
        }) : (Q.jxsi_formed && !Q.jxsi_dissolved ? G.text("<span style='color: var(--jxsi); font-style: italic;'>Sovereignty government</span>") : (Q.jxcat_formed && !Q.jxcat_dissolved ? G.text("<span style='color: var(--{jxcat_colour}); font-style: italic;'>Sovereignty government</span>", {
            jxcat_colour: "jxcat"
        }) : (Q.erc_parlament_s > Q[Q.parlament_current_ciu + "_parlament_s"] ? G.text("<span style='color: var(--erc); font-style: italic;'>Sovereignty</span> <span style='color: var(--{party}); font-style: italic;'>government</span>", {
            party: String(Q.parlament_current_ciu)
        }) : G.text("<span style='color: var(--{party}); font-style: italic;'>Sovereignty</span> <span style='color: var(--erc); font-style: italic;'>government</span>", {
            party: String(Q.parlament_current_ciu)
        })))))));
        if (Q.parlament_coalition_sovereignty_deadline > Q.year && Q.roadmap_year > Q.parlament_coalition_sovereignty_deadline) Q.roadmap_year = Q.parlament_coalition_sovereignty_deadline;
        if (Q.parlament_coalition_concessions_indy) {
            var signatories = Q.cat_coalition.concat(Q.cat_coalition_support);
            var roadmap = Math.max.apply(null, signatories.map(function (p) { return Q[p + "_roadmap"] || 0; }));
            for (var party of signatories) Q[party + "_roadmap"] = roadmap;
            // Constituents share their list's undertaking.
            for (var list of ["jxsi", "jxcat"]) {
                if (Q.cat_coalition.indexOf(list) >= 0) {
                    for (var constituent of ["erc", "cdc", "dl", "pdcat", "junts"]) {
                        if (Q[constituent + "_in_" + list]) Q[constituent + "_roadmap"] = roadmap;
                    }
                }
            }
        }
        Q.parlament_coalition_sovereignty_phase = 0;
        Q.coalition_phase_timer = 0;
        Q.independence_trust += 5;
    }
!}
go-to: names if parlament_coalition_sovereignty_can_form; post_event if not parlament_coalition_sovereignty_can_form

@names
go-to: parlament_coalition_setnames
set-jump: formed
new-page: true

= A new government in the Generalitat

Pro-independence parties have agreed to form a [+ cat_coalition_disp +]!

@formed

- @parlament_coalition_resolve: A new government is formed!

@failed
on-arrival: {!
    if (Q.parlament_coalition_sovereignty_phase > 0) {
        if (Q.player_party == "erc" && Q.parlament_coalition_sovereignty_kind == "jxsi" &&
            (Q.player_in_jxsi || Q.erc_in_jxsi) && Q.parlament_coalition_sovereignty_phase >= 3 &&
            Q.parlament_coalition_proposal_president_name == "Artur Mas" &&
            Q.parlament_coalition_sovereignty_mas_pressure > 0 &&
            !(Q.parlament_coalition_sovereignty_ciu_pressure > 0) &&
            (Q.parlament_coalition_sovereignty_assembly_result == "veto" || Q.parlament_coalition_sovereignty_assembly_result == "tie")) {
            this.achieve("mas_o_marc");
        }
        if (Q.parlament_coalition_proposal_president_name == "Artur Mas" || Q.parlament_coalition_proposal_president_name == "Neus Munté") {
            Q.parlament_coalition_mas_veto_failures = (Q.parlament_coalition_mas_veto_failures || 0) + 1;
        }
        Q.parlament_repeat_election = true;
        Q.parlament_coalition_sovereignty_phase = 0;
        Q.coalition_phase_timer = 0;
        Q.erc_relations -= 5;
        Q.cup_relations -= 5;
        Q.independence_trust -= 10;
        Q.snap_blame = Q.player_party;
        Q.snap_counterparty = Q.player_party == "cup" ? "erc" : "cup";
        Q.snap_severity = 0.14;
    }
!}
call: snap_election

Negotiations have collapsed. [+ parlament_coalition_sovereignty_reject_reasons +] Now there's only one answer: for the people to vote again.

- @continue: This is highly disheartening...

@continue
go-to: post_event

@initialize
on-arrival: {!
    Q.parlament_coalition_sovereignty_prepared_round = 0;
    Q.parlament_coalition_sovereignty_withdrawal = false;
    Q.parlament_coalition_sovereignty_ciu_pressure = 0;
    Q.parlament_coalition_sovereignty_brokerage = false;
    Q.parlament_coalition_sovereignty_assembly_result = '';
    Q.parlament_coalition_sovereignty_assembly_yes = 0;
    Q.parlament_coalition_sovereignty_assembly_round = 0;
    Q.parlament_coalition_sovereignty_assembly_campaign = 0;
    Q.parlament_coalition_sovereignty_assembly_terms = [];
    Q.parlament_coalition_sovereignty_last_terms = [];
    Q.parlament_coalition_sovereignty_replacement_needed = false;
    Q.parlament_coalition_sovereignty_dispute_round = 0;
    Q.parlament_coalition_sovereignty_mas_pressure = 0;
    Q.parlament_coalition_sovereignty_feud = 0;
    Q.parlament_coalition_sovereignty_mediation_round = 0;
    Q.parlament_coalition_sovereignty_banos_departure = false;
    Q.parlament_coalition_sovereignty_deadline = 0;
    Q.parlament_coalition_sovereignty_reject_reasons = "";
    Q.parlament_coalition_push = 0;
    Q.parlament_coalition_push_round = 0;
    Q.parlament_coalition_sovereignty_assembly_deadline = 0;
    Q.parlament_coalition_sovereignty_nominee = "";
!}
