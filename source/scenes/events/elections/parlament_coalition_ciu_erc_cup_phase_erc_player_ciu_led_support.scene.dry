title: [+ parlament_current_ciu +]-ERC <span class="generalitat-coalition" data-parties="[+ parlament_current_ciu +] erc" data-summary="[? if parlament_current_ciu_s + erc_parlament_s >= parlament_s_majority: Majority government?][? if parlament_current_ciu_s + erc_parlament_s < parlament_s_majority: Minority government?] - [+ parlament_current_ciu_s + erc_parlament_s +]/[+ parlament_s_majority +]"><span style="color: var(--[+ parlament_current_ciu +]); font-style: italic;">Sovereignty</span> <span style="color: var(--erc); font-style: italic;">government</span></span> with CUP support negotiations
subtitle: [? if parlament_coalition_sovereignty_phase = 1: The first round of negotiations begins in earnest.?][? if parlament_coalition_sovereignty_phase = 2: The parties return for the second round of negotiations.?][? if parlament_coalition_sovereignty_phase = 3: The third and final round of negotiations begins.?]
tags: event
role: event
new-page: true
view-if: parlament_coalition_sovereignty_phase > 0 and parlament_coalition_sovereignty_kind = "support" and player_party = "erc" and parlament_coalition_leader = parlament_current_ciu and coalition_phase_timer <= 0
call: parlament_coalition_sovereignty_replacement.check
set-jump: prepare
go-to: parlament_coalition_sovereignty_replacement if parlament_coalition_sovereignty_replacement_needed; prepare if not parlament_coalition_sovereignty_replacement_needed

@prepare
on-arrival: {!
    Q.parlament_coalition_changes = false;
    Q.parlament_coalition_concessions_indy = 0;
    Q.parlament_coalition_sovereignty_deadline = 0;
    Q.parlament_coalition_proposal_president = Q.parlament_coalition_leader;
    var offices = ["vp", "interior", "economy", "foreign", "health", "education", "territory", "bnl"];
    for (var office of offices) Q["parlament_coalition_proposal_" + office] = Q.parlament_coalition_leader;
    Q.parlament_coalition_sovereignty_expected_vp = Q.parlament_coalition_follower;
    if (Q.parlament_coalition_sovereignty_kind == "government" && Q.cup_parlament_s > Q[Q.parlament_coalition_sovereignty_expected_vp + "_parlament_s"]) Q.parlament_coalition_sovereignty_expected_vp = "cup";
    Q.parlament_coalition_proposal_vp = Q.parlament_coalition_sovereignty_expected_vp;
    Q.parlament_coalition_proposal_economy = Q.parlament_current_ciu;
    Q.parlament_coalition_proposal_interior = Q.parlament_coalition_sovereignty_phase >= 2 ? "erc" : Q.parlament_current_ciu;
    Q.parlament_coalition_proposal_foreign = "erc";
    Q.parlament_coalition_proposal_health = "erc";


    for (var office of offices) {
        Q["parlament_coalition_proposal_" + office + "_name"] = null;
        Q["parlament_coalition_proposal_" + office + "_gender"] = null;
    }
    Q.parlament_coalition_leverage = Math.max(15, Q[Q.player_party + "_parlament_s"] * 55 / Math.max(1, Q.parlament_coalition_support_seats)) + (Q.parlament_coalition_sovereignty_phase - 1) * 4 - (Q.speaker_party == Q.player_party ? 5 : 0);
    Q.parlament_coalition_leverage += Q.parlament_coalition_sovereignty_mas_pressure * 2;
!}
call: parlament_coalition_fiscal_policies.initialize
go-to: redistribute

@phase_text
new-page: true
go-to: parlament_coalition_setnames
set-jump: choices

[? if parlament_coalition_sovereignty_phase = 1: Negotiations with [+ parlament_current_ciu +] and the CUP for the formation of a [+ parlament_current_ciu +]-ERC <span class="generalitat-coalition" data-parties="[+ parlament_current_ciu +] erc" data-summary="[? if parlament_current_ciu_s + erc_parlament_s >= parlament_s_majority: Majority government?][? if parlament_current_ciu_s + erc_parlament_s < parlament_s_majority: Minority government?] - [+ parlament_current_ciu_s + erc_parlament_s +]/[+ parlament_s_majority +]"><span style="color: var(--[+ parlament_current_ciu +]); font-style: italic;">Sovereignty</span> <span style="color: var(--erc); font-style: italic;">government</span></span> with CUP support are about to start. [+ parlament_current_ciu +] has presented its initial proposal: ?]
[? if parlament_coalition_sovereignty_phase != 1: Our partners have rejected our previous counter-proposal. [? if parlament_coalition_sovereignty_reject_reasons: [+ parlament_coalition_sovereignty_reject_reasons +] ?]The ball is on our side now to prepare a new counter-proposal.?]

@choices
call: parlament_coalition_sovereignty_replacement.check
go-to: parlament_coalition_fiscal_policies.summary
set-jump: choices_menu

@choices_menu

[? if parlament_coalition_sovereignty_deadline: **Roadmap deadline:** We are to fulfill the agreed Roadmap by [+ parlament_coalition_sovereignty_deadline +].?]

[? if parlament_coalition_concessions_indy: **Independence commitment:** A more ambitious path towards independence will be pursued by this new government.?]

- @ministries
- @policies
- @submit
- @accept
- @candidate_impasse

@policies
title: Negotiate policy commitments
call: parlament_coalition_fiscal_policies
set-jump: policies

- @deadline
- @roadmap
- #fiscal_concessions
- @push_policies
- @phase_text: Move to other matters

@deadline
title: [? if parlament_coalition_sovereignty_deadline: Withdraw the shorter roadmap deadline?][? if not parlament_coalition_sovereignty_deadline: Commit to fulfilling the roadmap by [+ year + 2 +]?]
view-if: parlament_coalition_sovereignty_deadline > 0 or roadmap_year > year + 2
choose-if: parlament_coalition_sovereignty_deadline > 0 or (roadmap_year > year + 2 and parlament_coalition_leverage >= 5)
unavailable-subtitle: We lack the leverage to bring the deadline forward.
on-arrival: {!
    if (Q.parlament_coalition_sovereignty_deadline) {
        Q.parlament_coalition_sovereignty_deadline = 0;
        Q.parlament_coalition_leverage += 5;
    } else if (Q.roadmap_year > Q.year + 2 && Q.parlament_coalition_leverage >= 5) {
        Q.parlament_coalition_sovereignty_deadline = Q.year + 2;
        Q.parlament_coalition_leverage -= 5;
    }
    Q.parlament_coalition_changes = true;
!}
go-to: policies

@roadmap
title: Include a stronger independence roadmap
choose-if: not parlament_coalition_concessions_indy and parlament_coalition_leverage >= 5
unavailable-subtitle: [? if parlament_coalition_concessions_indy: We have already committed to this. ?][? if parlament_coalition_leverage < 5: We lack the leverage to push for this. ?]
on-arrival: {!
    Q.parlament_coalition_concessions_indy = 1;
    Q.parlament_coalition_policy_indy_demanded = true;
    Q.parlament_coalition_changes = true;
    Q.parlament_coalition_leverage -= 5;
!}
go-to: policies

@push
title: Push for more leverage
choose-if: parlament_coalition_sovereignty_phase < 3 and parlament_coalition_push < parlament_coalition_sovereignty_phase
unavailable-subtitle: [? if parlament_coalition_sovereignty_phase >= 3: This is the final round; there is no further room to push. ?][? if parlament_coalition_push >= parlament_coalition_sovereignty_phase: We have already pushed for more leverage in this round. ?]
on-arrival: {!
    Q.parlament_coalition_changes = true;
    Q.parlament_coalition_push += 1;
    Q.parlament_coalition_leverage += 4;
    Q[Q.player_party == "erc" ? "cup_relations" : "erc_relations"] -= 3;
!}
go-to: phase_text

@submit
title: Send this counter-proposal
on-arrival: {!
    var reasons = [];
    var ministries = ["interior", "economy", "foreign", "health", "education", "territory", "bnl"];
    var counts = {};
    for (var office of ["vp"].concat(ministries)) {
        var holder = Q["parlament_coalition_proposal_" + office];
        if (Q.parlament_coalition_sovereignty_cabinet.indexOf(holder) < 0) reasons.push("Some cabinet posts are still unassigned or have been given to a party outside the government.");
        if (office != "vp") counts[holder] = (counts[holder] || 0) + 1;
    }

    if (Q.coalition_phase_timer > 0) reasons.push("We must wait for the next round of negotiations before sending another proposal.");
    if (Q.parlament_coalition_leverage < 0) reasons.push("We are asking for more concessions than our negotiating leverage allows.");
    if (Q.parlament_coalition_proposal_economy == "cup") reasons.push(Q.parlament_current_ciu + " will not accept a government that gives the CUP control of the Economy Ministry.");
    if (Q.parlament_coalition_proposal_economy != Q.parlament_current_ciu && Q.parlament_coalition_proposal_economy != "erc") reasons.push(Q.parlament_current_ciu + " insists that the Economy Ministry stay with them.");
    if (Q.parlament_coalition_proposal_interior == "erc" && Q.parlament_coalition_sovereignty_phase < 2) reasons.push(Q.parlament_current_ciu + " seems unwilling to hand the Interior Ministry to ERC.");
    if (Q.parlament_coalition_proposal_interior == "cup" && Q.parlament_coalition_sovereignty_phase < 3) reasons.push(Q.parlament_current_ciu + " seems unwilling to hand the Interior Ministry to the CUP.");
    if (!(counts[Q.parlament_current_ciu] >= 1)) reasons.push(Q.parlament_current_ciu + " expects to hold more ministries in this new government to come.");
    if (Q.player_party != "erc" && !(counts.erc >= 1)) reasons.push("ERC expects to hold more ministries in this new government to come.");

    if (Q.parlament_coalition_sovereignty_phase < 3 && Q.parlament_coalition_sovereignty_expected_vp != Q.player_party && Q.parlament_coalition_proposal_vp != Q.parlament_coalition_sovereignty_expected_vp) reasons.push(Q.parlament_coalition_sovereignty_expected_vp + " is insisting that they should get the Vice-Presidency.");
    var policies = ["education", "health", "pay", "tax", "cap"].filter(function (p) { return Q["parlament_coalition_policy_" + p]; }).length;
    if (!Q.parlament_coalition_concessions_indy) reasons.push("The CUP is demanding that we take independence more seriously. Without such an agreement in writing, they will hardly support our coalition proposal.");
    if (!(policies > 0)) reasons.push("The CUP expects a higher level of social commitment from the new government.");
    Q.parlament_coalition_sovereignty_reject_reasons = reasons.filter(function (r, i) { return reasons.indexOf(r) == i; }).join(" ");
    Q.parlament_coalition_proposal_accept = reasons.length == 0;
!}
call: parlament_coalition_sovereignty_replacement.check
go-to: parlament_coalition_sovereignty_replacement.evaluate

@ministries
title: Negotiate the cabinet composition

- @vp
- @interior
- @economy
- @foreign
- @health
- @education
- @territory
- @bnl
- @push_ministries
- @redistribute: Move to other matters

@redistribute
on-arrival: {!
    var cabinet = Q.parlament_coalition_sovereignty_kind == "government" ? [Q.parlament_current_ciu, "erc", "cup"] : [Q.parlament_current_ciu, "erc"];
    var partners = cabinet.filter(function (party) { return party != Q.player_party; });
    var costs = { vp: 20, interior: 10, economy: 10, foreign: 6, health: 7, education: 7, territory: 5, bnl: 5 };
    var preferences = {};
    preferences[Q.parlament_current_ciu] = ["economy", "interior", "territory", "foreign", "health", "education", "bnl"];
    preferences.erc = ["foreign", "economy", "education", "health", "interior", "territory", "bnl"];
    preferences.cup = ["bnl", "health", "education", "territory", "interior", "foreign", "economy"];
    var remaining = {};
    for (var party of partners) {
        var seats = party == Q.parlament_current_ciu ? Q.parlament_current_ciu_s : Q[party + "_parlament_s"];
        remaining[party] = (seats || 0) * 55 / Math.max(1, Q.parlament_coalition_support_seats) - 3 + Q.parlament_coalition_sovereignty_phase;
        if (Q.speaker_party == party) remaining[party] -= 5;
    }
    // Keep the player's claims; the partners negotiate every other post afresh.
    if (Q.parlament_coalition_proposal_vp != Q.player_party) {
        var expected = Q.parlament_coalition_sovereignty_expected_vp;
        var holder = partners.indexOf(expected) >= 0 ? expected : partners[0];
        if (partners.indexOf(expected) < 0) {
            for (var party of partners) if (remaining[party] > remaining[holder]) holder = party;
        }
        Q.parlament_coalition_proposal_vp = holder;
        remaining[holder] -= costs.vp;
    }
    var empty = Object.keys(costs).filter(function (office) { return office != "vp" && Q["parlament_coalition_proposal_" + office] != Q.player_party; });
    function eligible(party, office) {
        if (office == "economy" && party == "cup") return false;
        if (office == "interior" && party == "cup" && Q.parlament_coalition_sovereignty_phase < 3) return false;
        if (office == "interior" && party == "erc" && Q.parlament_coalition_sovereignty_phase < 2) return false;
        return true;
    }
    while (empty.length) {
        var contenders = partners.filter(function (party) { return empty.some(function (office) { return eligible(party, office); }); });
        var holder = contenders[0];
        for (var party of contenders) if (remaining[party] > remaining[holder]) holder = party;
        var preferred = preferences[holder].filter(function (office) { return empty.indexOf(office) >= 0 && eligible(holder, office); });
        var affordable = preferred.filter(function (office) { return remaining[holder] >= costs[office]; });
        var office = affordable.length ? affordable[0] : preferred[0];
        Q["parlament_coalition_proposal_" + office] = holder;
        remaining[holder] -= costs[office];
        empty = empty.filter(function (position) { return position != office; });
    }
!}
go-to: phase_text

@vp
title: [? if parlament_coalition_proposal_vp != player_party: Demand the Vice-Presidency?][? if parlament_coalition_proposal_vp = player_party: Give up the Vice-Presidency?]
choose-if: parlament_coalition_proposal_vp = player_party or parlament_coalition_leverage >= 20
unavailable-subtitle: We lack enough leverage to demand the Vice-Presidency.
on-arrival: {!
    Q.parlament_coalition_changes = true;
    if (Q.parlament_coalition_proposal_vp == Q.player_party) {
        Q.parlament_coalition_proposal_vp = null;
        Q.parlament_coalition_leverage += 20;
    } else {
        Q.parlament_coalition_proposal_vp = Q.player_party;
        Q.parlament_coalition_leverage -= 20;
    }
!}
go-to: ministries

