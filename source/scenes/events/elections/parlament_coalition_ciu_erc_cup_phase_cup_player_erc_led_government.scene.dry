title: ERC-[+ parlament_current_ciu +]-CUP <span class="generalitat-coalition" data-parties="erc [+ parlament_current_ciu +] cup" data-summary="[? if parlament_current_ciu_s + erc_parlament_s + cup_parlament_s >= parlament_s_majority: Majority government?][? if parlament_current_ciu_s + erc_parlament_s + cup_parlament_s < parlament_s_majority: Minority government?] - [+ parlament_current_ciu_s + erc_parlament_s + cup_parlament_s +]/[+ parlament_s_majority +]"><span style="color: var(--erc); font-style: italic;">National</span> <span style="color: var(--[+ parlament_current_ciu +]); font-style: italic;">Concentration</span> <span style="color: #b8a12b; font-style: italic;">government</span></span> negotiations
subtitle: [? if parlament_coalition_sovereignty_phase = 1: The first round of negotiations begins in earnest.?][? if parlament_coalition_sovereignty_phase = 2: The parties return for the second round of negotiations.?][? if parlament_coalition_sovereignty_phase = 3: The third and final round of negotiations begins.?]
tags: event
role: event
new-page: true
view-if: parlament_coalition_sovereignty_phase > 0 and parlament_coalition_sovereignty_kind = "government" and player_party = "cup" and parlament_coalition_leader = "erc" and coalition_phase_timer <= 0 and not parlament_coalition_sovereignty_replacement_needed
go-to: prepare

@prepare
on-arrival: {!
    if (Q.parlament_coalition_sovereignty_prepared_round === Q.parlament_coalition_sovereignty_phase) return;

    Q.parlament_coalition_changes = false;
    Q.parlament_coalition_concessions_indy = 0;
    Q.parlament_coalition_sovereignty_deadline = 0;
    Q.parlament_coalition_proposal_president = Q.parlament_coalition_leader;
    var offices = ["vp", "interior", "economy", "foreign", "health", "education", "territory", "bnl"];
    for (var office of offices) Q["parlament_coalition_proposal_" + office] = Q.parlament_coalition_leader;
    Q.parlament_coalition_sovereignty_expected_vp = Q.parlament_coalition_follower;
    if (Q.parlament_coalition_sovereignty_kind == "government" && Q.cup_parlament_s > Q[Q.parlament_coalition_sovereignty_expected_vp + "_parlament_s"]) Q.parlament_coalition_sovereignty_expected_vp = "cup";
    Q.parlament_coalition_proposal_vp = Q.parlament_coalition_sovereignty_expected_vp;
    Q.parlament_coalition_proposal_economy = "erc";
    Q.parlament_coalition_proposal_interior = Q.parlament_coalition_sovereignty_phase >= 2 ? "erc" : Q.parlament_current_ciu;
    Q.parlament_coalition_proposal_foreign = "erc";
    Q.parlament_coalition_proposal_health = "erc";
    Q.parlament_coalition_proposal_education = Q.parlament_current_ciu;
    Q.parlament_coalition_proposal_bnl = "cup";
    Q.parlament_coalition_proposal_territory = "cup";
    if (Q.parlament_coalition_sovereignty_phase == 3) Q.parlament_coalition_proposal_interior = "cup";

    for (var office of offices) {
        Q["parlament_coalition_proposal_" + office + "_name"] = null;
        Q["parlament_coalition_proposal_" + office + "_gender"] = null;
    }
!}
call: parlament_coalition_sovereignty_offer.prepare
go-to: redistribute

@phase_text
new-page: true
go-to: parlament_coalition_setnames
set-jump: choices

[? if parlament_coalition_sovereignty_phase = 1: Negotiations with ERC and [+ parlament_current_ciu +] for the formation of an ERC-[+ parlament_current_ciu +]-CUP <span class="generalitat-coalition" data-parties="erc [+ parlament_current_ciu +] cup" data-summary="[? if parlament_current_ciu_s + erc_parlament_s + cup_parlament_s >= parlament_s_majority: Majority government?][? if parlament_current_ciu_s + erc_parlament_s + cup_parlament_s < parlament_s_majority: Minority government?] - [+ parlament_current_ciu_s + erc_parlament_s + cup_parlament_s +]/[+ parlament_s_majority +]"><span style="color: var(--erc); font-style: italic;">National</span> <span style="color: var(--[+ parlament_current_ciu +]); font-style: italic;">Concentration</span> <span style="color: #b8a12b; font-style: italic;">government</span></span> are about to start. ERC has presented its initial proposal for us to join the cabinet: ?]
[? if parlament_coalition_sovereignty_phase != 1: The previous round ended without agreement. [? if parlament_coalition_sovereignty_reject_reasons: [+ parlament_coalition_sovereignty_reject_reasons +] ?]The parties now return to negotiations with the following proposal:?]

@choices
call: parlament_coalition_sovereignty_replacement.check
go-to: parlament_coalition_fiscal_policies.summary
set-jump: choices_menu

@choices_menu

 - The new government will pursue a Roadmap of [? if parlament_current_ciu = "ciu": [? if not parlament_coalition_concessions_indy: [+ erc_roadmap : roadmap +]?][? if parlament_coalition_concessions_indy: [? if ciu_roadmap >= erc_roadmap and ciu_roadmap >= cup_roadmap: [+ ciu_roadmap : roadmap +]?][? if erc_roadmap > ciu_roadmap and erc_roadmap >= cup_roadmap: [+ erc_roadmap : roadmap +]?][? if cup_roadmap > ciu_roadmap and cup_roadmap > erc_roadmap: [+ cup_roadmap : roadmap +]?]?]?][? if parlament_current_ciu = "cdc": [? if not parlament_coalition_concessions_indy: [+ erc_roadmap : roadmap +]?][? if parlament_coalition_concessions_indy: [? if cdc_roadmap >= erc_roadmap and cdc_roadmap >= cup_roadmap: [+ cdc_roadmap : roadmap +]?][? if erc_roadmap > cdc_roadmap and erc_roadmap >= cup_roadmap: [+ erc_roadmap : roadmap +]?][? if cup_roadmap > cdc_roadmap and cup_roadmap > erc_roadmap: [+ cup_roadmap : roadmap +]?]?]?][? if parlament_current_ciu = "dl": [? if not parlament_coalition_concessions_indy: [+ erc_roadmap : roadmap +]?][? if parlament_coalition_concessions_indy: [? if dl_roadmap >= erc_roadmap and dl_roadmap >= cup_roadmap: [+ dl_roadmap : roadmap +]?][? if erc_roadmap > dl_roadmap and erc_roadmap >= cup_roadmap: [+ erc_roadmap : roadmap +]?][? if cup_roadmap > dl_roadmap and cup_roadmap > erc_roadmap: [+ cup_roadmap : roadmap +]?]?]?][? if parlament_current_ciu = "pdcat": [? if not parlament_coalition_concessions_indy: [+ erc_roadmap : roadmap +]?][? if parlament_coalition_concessions_indy: [? if pdcat_roadmap >= erc_roadmap and pdcat_roadmap >= cup_roadmap: [+ pdcat_roadmap : roadmap +]?][? if erc_roadmap > pdcat_roadmap and erc_roadmap >= cup_roadmap: [+ erc_roadmap : roadmap +]?][? if cup_roadmap > pdcat_roadmap and cup_roadmap > erc_roadmap: [+ cup_roadmap : roadmap +]?]?]?][? if parlament_current_ciu = "junts": [? if not parlament_coalition_concessions_indy: [+ erc_roadmap : roadmap +]?][? if parlament_coalition_concessions_indy: [? if junts_roadmap >= erc_roadmap and junts_roadmap >= cup_roadmap: [+ junts_roadmap : roadmap +]?][? if erc_roadmap > junts_roadmap and erc_roadmap >= cup_roadmap: [+ erc_roadmap : roadmap +]?][? if cup_roadmap > junts_roadmap and cup_roadmap > erc_roadmap: [+ cup_roadmap : roadmap +]?]?]?][? if parlament_current_ciu = "jxcat": [? if not parlament_coalition_concessions_indy: [+ erc_roadmap : roadmap +]?][? if parlament_coalition_concessions_indy: [? if jxcat_roadmap >= erc_roadmap and jxcat_roadmap >= cup_roadmap: [+ jxcat_roadmap : roadmap +]?][? if erc_roadmap > jxcat_roadmap and erc_roadmap >= cup_roadmap: [+ erc_roadmap : roadmap +]?][? if cup_roadmap > jxcat_roadmap and cup_roadmap > erc_roadmap: [+ cup_roadmap : roadmap +]?]?]?], to be fulfilled by [? if not parlament_coalition_sovereignty_deadline: [+ roadmap_year +]?][? if parlament_coalition_sovereignty_deadline: [+ parlament_coalition_sovereignty_deadline +]?].

[? if parlament_coalition_sovereignty_withdrawal: - Artur Mas must step down.?]

- @ministries
- @policies
- @submit
- @accept
- @withdrawal

@policies
title: Negotiate policy commitments
call: parlament_coalition_fiscal_policies
set-jump: policies

- @deadline
- @roadmap
- #fiscal_concessions
- @push_policies
- @phase_text: Move to other matters

@deadline
title: [? if parlament_coalition_sovereignty_deadline: Withdraw the shorter roadmap deadline?][? if not parlament_coalition_sovereignty_deadline: Commit to fulfilling the roadmap by [+ year + 2 +]?]
view-if: parlament_coalition_sovereignty_deadline > 0 or roadmap_year > year + 2
choose-if: parlament_coalition_sovereignty_deadline > 0 or (roadmap_year > year + 2)
on-arrival: {!
    if (Q.parlament_coalition_sovereignty_deadline) {
        Q.parlament_coalition_sovereignty_deadline = 0;
        Q.parlament_coalition_leverage += 5;
    } else if (Q.roadmap_year > Q.year + 2) {
        Q.parlament_coalition_sovereignty_deadline = Q.year + 2;
        Q.parlament_coalition_leverage -= 5;
    }
    Q.parlament_coalition_changes = true;
!}
go-to: policies

@roadmap
title: [? if parlament_coalition_concessions_indy: Withdraw the stronger roadmap commitment?][? if not parlament_coalition_concessions_indy: Commit all signatories to the strongest proposed independence roadmap?]
choose-if: parlament_coalition_concessions_indy or parlament_coalition_leverage >= 5 or player_party = "cup"
unavailable-subtitle: We lack the leverage to secure a stronger roadmap.
on-arrival: {!
    var taking = !Q.parlament_coalition_concessions_indy;
    Q.parlament_coalition_concessions_indy = taking ? 1 : 0;
    Q.parlament_coalition_policy_indy_demanded = taking;
    Q.parlament_coalition_changes = true;
    Q.parlament_coalition_leverage += taking ? -5 : 5;
!}
go-to: policies

@push
title: Push for more leverage
choose-if: parlament_coalition_sovereignty_phase < 3 and (parlament_coalition_push < parlament_coalition_sovereignty_phase and parlament_coalition_push_round < parlament_coalition_sovereignty_phase)
unavailable-subtitle: [? if parlament_coalition_sovereignty_phase >= 3: This is the final round; there is no further room to push. ?][? if (parlament_coalition_push >= parlament_coalition_sovereignty_phase or parlament_coalition_push_round >= parlament_coalition_sovereignty_phase): We have already pushed for more leverage in this round. ?]
on-arrival: {!
    Q.parlament_coalition_changes = true;
    Q.parlament_coalition_push_round = Q.parlament_coalition_sovereignty_phase;
    Q.parlament_coalition_push += 1;
    Q.parlament_coalition_leverage += 4;
    Q[Q.player_party == "erc" ? "cup_relations" : "erc_relations"] -= 3;
!}
go-to: phase_text

@submit
title: Send this counter-proposal
view-if: parlament_coalition_changes or parlament_coalition_sovereignty_candidate_reason
subtitle: [? if parlament_coalition_sovereignty_phase = 3: This is the final round. If any partner refuses, negotiations will end without an agreement.?]
on-arrival: {!
    var reasons = [];
    var ministries = ["interior", "economy", "foreign", "health", "education", "territory", "bnl"];
    var counts = {};
    for (var office of ["vp"].concat(ministries)) {
        var holder = Q["parlament_coalition_proposal_" + office];
        if (Q.parlament_coalition_sovereignty_cabinet.indexOf(holder) < 0) reasons.push("Some cabinet posts are still unassigned or have been given to a party outside the government.");
        if (office != "vp") counts[holder] = (counts[holder] || 0) + 1;
    }

    if (Q.coalition_phase_timer > 0) reasons.push("We must wait for the next round of negotiations before sending another proposal.");
    if (Q.parlament_coalition_leverage < 0) reasons.push("ERC is unwilling to accept the full package of concessions we are demanding.");
    if (Q.parlament_coalition_proposal_economy == "cup") reasons.push(Q.parlament_current_ciu + " will not accept a government that gives the CUP control of the Economy Ministry.");
    if (Q.parlament_coalition_proposal_economy != Q.parlament_current_ciu && Q.parlament_coalition_proposal_economy != "erc") reasons.push(Q.parlament_current_ciu + " insists that the Economy Ministry stay with them.");
    if (Q.parlament_coalition_proposal_interior == "erc" && Q.parlament_coalition_sovereignty_phase < 2) reasons.push(Q.parlament_current_ciu + " seems unwilling to hand the Interior Ministry to ERC.");
    if (Q.parlament_coalition_proposal_interior == "cup" && Q.parlament_coalition_sovereignty_phase < 3) reasons.push(Q.parlament_current_ciu + " seems unwilling to hand the Interior Ministry to the CUP.");
    if (!(counts[Q.parlament_current_ciu] >= 1)) reasons.push("The convergents expect to hold at least one ministry in the new government.");
    if (Q.player_party != "erc" && !(counts.erc >= 1)) reasons.push("ERC expects to hold more ministries in this new government to come.");

    if (Q.parlament_coalition_sovereignty_phase < 3 && Q.parlament_coalition_sovereignty_expected_vp != Q.player_party && Q.parlament_coalition_proposal_vp != Q.parlament_coalition_sovereignty_expected_vp) reasons.push(Q.parlament_coalition_sovereignty_expected_vp + " is insisting that they should get the Vice-Presidency.");
    if (Q.player_party != "cup" && !(counts.cup >= 2)) reasons.push("The CUP expects to hold more ministries in this new government to come.");
    Q.parlament_coalition_sovereignty_reject_reasons = reasons.filter(function (r, i) { return reasons.indexOf(r) == i; }).join(" ");
    Q.parlament_coalition_proposal_accept = reasons.length == 0;
!}
call: parlament_coalition_sovereignty_replacement.check
go-to: parlament_coalition_sovereignty_replacement.evaluate

@ministries
title: Negotiate the cabinet composition

We can demand or give up our own posts. Posts we do not claim will be distributed between the other two parties according to their leverage and portfolio preferences. Both partners must accept the cabinet and its commitments.

- @vp
- @interior
- @economy
- @foreign
- @health
- @education
- @territory
- @bnl
- @push_ministries
- @redistribute: Move to other matters

@redistribute
on-arrival: {!
    var cabinet = Q.parlament_coalition_sovereignty_kind == "government" ? [Q.parlament_current_ciu, "erc", "cup"] : [Q.parlament_current_ciu, "erc"];
    var partners = cabinet.filter(function (party) { return party != Q.player_party; });
    var costs = { vp: 20, interior: 10, economy: 10, foreign: 6, health: 7, education: 7, territory: 5, bnl: 5 };
    var preferences = {};
    preferences[Q.parlament_current_ciu] = ["economy", "interior", "territory", "foreign", "health", "education", "bnl"];
    preferences.erc = ["foreign", "economy", "education", "health", "interior", "territory", "bnl"];
    preferences.cup = ["bnl", "health", "education", "territory", "interior", "foreign", "economy"];
    var remaining = {};
    for (var party of partners) {
        var seats = party == Q.parlament_current_ciu ? Q.parlament_current_ciu_s : Q[party + "_parlament_s"];
        remaining[party] = (seats || 0) * 55 / Math.max(1, Q.parlament_coalition_support_seats) - 3 + Q.parlament_coalition_sovereignty_phase;
        if (Q.speaker_party == party) remaining[party] -= 5;
    }
    // Keep the player's claims; the partners negotiate every other post afresh.
    if (Q.parlament_coalition_proposal_vp != Q.player_party) {
        var expected = Q.parlament_coalition_sovereignty_expected_vp;
        var holder = partners.indexOf(expected) >= 0 ? expected : partners[0];
        if (partners.indexOf(expected) < 0) {
            for (var party of partners) if (remaining[party] > remaining[holder]) holder = party;
        }
        Q.parlament_coalition_proposal_vp = holder;
        remaining[holder] -= costs.vp;
    }
    var empty = Object.keys(costs).filter(function (office) { return office != "vp" && Q["parlament_coalition_proposal_" + office] != Q.player_party; });
    function eligible(party, office) {
        if (office == "economy" && party == "cup") return false;
        if (office == "interior" && party == "cup" && Q.parlament_coalition_sovereignty_phase < 3) return false;
        if (office == "interior" && party == "erc" && Q.parlament_coalition_sovereignty_phase < 2) return false;
        return true;
    }
    while (empty.length) {
        var contenders = partners.filter(function (party) { return empty.some(function (office) { return eligible(party, office); }); });
        var holder = contenders[0];
        for (var party of contenders) if (remaining[party] > remaining[holder]) holder = party;
        var preferred = preferences[holder].filter(function (office) { return empty.indexOf(office) >= 0 && eligible(holder, office); });
        var affordable = preferred.filter(function (office) { return remaining[holder] >= costs[office]; });
        var office = affordable.length ? affordable[0] : preferred[0];
        Q["parlament_coalition_proposal_" + office] = holder;
        remaining[holder] -= costs[office];
        empty = empty.filter(function (position) { return position != office; });
    }
!}
go-to: phase_text

@vp
title: [? if parlament_coalition_proposal_vp != player_party: Demand the Vice-Presidency?][? if parlament_coalition_proposal_vp = player_party: Give up the Vice-Presidency?]
choose-if: true
on-arrival: {!
    Q.parlament_coalition_changes = true;
    if (Q.parlament_coalition_proposal_vp == Q.player_party) {
        Q.parlament_coalition_proposal_vp = null;
        Q.parlament_coalition_leverage += 20;
    } else {
        Q.parlament_coalition_proposal_vp = Q.player_party;
        Q.parlament_coalition_leverage -= 20;
    }
!}
