title: [? if left_tripartite_coalition_phase = 1: Opening proposal for the ?][? if left_tripartite_coalition_phase = 2: Revised proposal for the ?][? if left_tripartite_coalition_phase = 3: Final proposal for the ?]<span class="generalitat-coalition" data-parties="erc psc [+ parlament_current_icv +]" data-summary="Majority government - [+ parlament_coalition_erc_psc_icv_s +]/[+ parlament_s_majority +]"><span style="color: var(--erc); font-style: italic;">Left</span> <span style="color: [? if parlament_current_icv = 'icv': var(--icv)?][? if parlament_current_icv = 'csqp': var(--csqp)?][? if parlament_current_icv = 'cecp': var(--cecp)?][? if parlament_current_icv = 'ecp': var(--ecp)?]; font-style: italic;">Tri</span><span style="color: var(--psc); font-style: italic;">partite</span></span>
subtitle: [? if left_tripartite_coalition_phase = 1: ERC presents its opening cabinet proposal to the PSC and [+ parlament_current_icv +].?][? if left_tripartite_coalition_phase = 2: <span style="color: var(--erc); font-style: italic;">Left</span> <span style="color: [? if parlament_current_icv = 'icv': var(--icv)?][? if parlament_current_icv = 'csqp': var(--csqp)?][? if parlament_current_icv = 'cecp': var(--cecp)?][? if parlament_current_icv = 'ecp': var(--ecp)?]; font-style: italic;">Tri</span><span style='color: var(--psc); font-style: italic;'>partite</span> negotiations advance.?][? if left_tripartite_coalition_phase = 3: This is set to be the final round of <span style="color: var(--erc); font-style: italic;">Left</span> <span style="color: [? if parlament_current_icv = 'icv': var(--icv)?][? if parlament_current_icv = 'csqp': var(--csqp)?][? if parlament_current_icv = 'cecp': var(--cecp)?][? if parlament_current_icv = 'ecp': var(--ecp)?]; font-style: italic;">Tri</span><span style='color: var(--psc); font-style: italic;'>partite</span> negotiations.?]
tags: event
new-page: true
view-if: left_tripartite_coalition_phase != 0 and player_party == "erc"
on-arrival: {!
    Q.parlament_coalition_changes = false;
    Q.left_tripartite_reject_push = false;
    Q.left_tripartite_reject_vp = false;
    Q.left_tripartite_reject_psc_economy = false;
    Q.left_tripartite_reject_psc_interior = false;
    Q.left_tripartite_reject_comuns_bnl = false;
    Q.left_tripartite_reject_comuns_health = false;
    Q.left_tripartite_reject_first_round_power = false;

    Q.parlament_coalition_leverage = (Q.erc_parlament_s / Q.parlament_coalition_erc_psc_icv_s)*55;
    if (Q.speaker_party == "erc") {
        Q.parlament_coalition_leverage -= 10;
    }

    if (Q.psc_relations < 50 && Q.left_tripartite_coalition_phase == 1) {
        Q.parlament_coalition_leverage -= 50-Q.psc_relations;
    }
    if (Q.parlament_current_icv_relations <= 55 && Q.left_tripartite_coalition_phase == 1) {
        Q.parlament_coalition_leverage -= 50-Q.parlament_current_icv_relations;
    }
    
    Q.parlament_coalition_leverage += Q.left_tripartite_coalition_phase*4 - 4;

    Q.parlament_coalition_proposal_president = "erc";
    Q.left_tripartite_expected_vp = Q.psc_parlament_s >= Q.parlament_current_icv_s ? "psc" : Q.parlament_current_icv;
    var psc_offer_budget = (Q.psc_parlament_s / Q.parlament_coalition_erc_psc_icv_s) * 55;
    var comuns_offer_budget = (Q.parlament_current_icv_s / Q.parlament_coalition_erc_psc_icv_s) * 55;
    if (Q.speaker_party == "psc") psc_offer_budget -= 10;
    if (Q.speaker_party == Q.parlament_current_icv) comuns_offer_budget -= 10;
    if (Q.left_tripartite_expected_vp == "psc") psc_offer_budget -= 20;
    if (Q.left_tripartite_expected_vp == Q.parlament_current_icv) comuns_offer_budget -= 20;
    Q.left_tripartite_psc_interior_plausible = psc_offer_budget >= 10;
    Q.left_tripartite_psc_economy_plausible = psc_offer_budget >= 20;
    Q.left_tripartite_comuns_bnl_plausible = comuns_offer_budget >= 5;
    Q.left_tripartite_comuns_health_plausible = comuns_offer_budget >= 12;
!}
go-to: phase_text
role: event

@phase_text
new-page: true
go-to: parlament_coalition_setnames
set-jump: choices

[? if left_tripartite_coalition_phase = 1: As the leading party, we are expected to bring forward a government proposal to our discussions with the PSC and [+ parlament_current_icv +]. [? if parlament_coalition_changes: The current proposal is: ?] ?][? if left_tripartite_coalition_phase > 1: The PSC and [+ parlament_current_icv +] have answered our previous proposal with a counter-proposal. [? if parlament_coalition_changes: After our amendments, the proposal is: ?] ?]

@choices

- @changes
- @send_back
- @accept

@changes
title: [? if left_tripartite_coalition_phase = 1 and not parlament_coalition_changes: Propose a government composition?][? if left_tripartite_coalition_phase > 1 or parlament_coalition_changes: Revise the government composition?]

[? if not parlament_coalition_changes: We can try to propose a different distribution of ministries, but there's no guarantee that it will be accepted. ?]

- @vp
- @economy
- @health
- @education
- @interior
- @foreign
- @territory
- @bnl
- @push_leverage_positions
- @go_back: Review the current proposal

@go_back
on-arrival: {!
    var psc_leverage = (Q.psc_parlament_s / Q.parlament_coalition_erc_psc_icv_s)*55 - 3 + Q.left_tripartite_coalition_phase;
    var icv_leverage = (Q.parlament_current_icv_s / Q.parlament_coalition_erc_psc_icv_s)*55 - 3 + Q.left_tripartite_coalition_phase;

    // the partner holding the Speaker has spent capital there, so less pull on ministries
    if (Q.speaker_party == "psc") psc_leverage -= 10;
    if (Q.speaker_party == Q.parlament_current_icv) icv_leverage -= 10;

    var empty_positions = [];
    if (Q.parlament_coalition_proposal_vp != "erc") {
        Q.parlament_coalition_proposal_vp = Q.left_tripartite_expected_vp;
    }
    if (Q.parlament_coalition_proposal_vp == "psc") psc_leverage -= 20;
    if (Q.parlament_coalition_proposal_vp == Q.parlament_current_icv) icv_leverage -= 20;
    switch (Q.parlament_coalition_proposal_economy) {
        case null:
            empty_positions.push("economy");
            break;
        case "psc":
            psc_leverage -= 10;
            break;
        case Q.parlament_current_icv:
            icv_leverage -= 10;
            break;
        default:
            break;
    }
    switch (Q.parlament_coalition_proposal_interior) {
        case null:
            empty_positions.push("interior");
            break;
        case "psc":
            psc_leverage -= 10;
            break;
        case Q.parlament_current_icv:
            icv_leverage -= 10;
            break;
        default:
            break;
    }
    switch (Q.parlament_coalition_proposal_foreign) {
        case null:
            empty_positions.push("foreign");
            break;
        case "psc":
            psc_leverage -= 6;
            break;
        case Q.parlament_current_icv:
            icv_leverage -= 6;
            break;
        default:
            break;
    }
    switch (Q.parlament_coalition_proposal_health) {
        case null:
            empty_positions.push("health");
            break;
        case "psc":
            psc_leverage -= 7;
            break;
        case Q.parlament_current_icv:
            icv_leverage -= 7;
            break;
        default:
            break;
    }
    switch (Q.parlament_coalition_proposal_education) {
        case null:
            empty_positions.push("education");
            break;
        case "psc":
            psc_leverage -= 7;
            break;
        case Q.parlament_current_icv:
            icv_leverage -= 7;
            break;
        default:
            break;
    }
    switch (Q.parlament_coalition_proposal_territory) {
        case null:
            empty_positions.push("territory");
            break;
        case "psc":
            psc_leverage -= 5;
            break;
        case Q.parlament_current_icv:
            icv_leverage -= 5;
            break;
        default:
            break;
    }
    switch (Q.parlament_coalition_proposal_bnl) {
        case null:
            empty_positions.push("bnl");
            break;
        case "psc":
            psc_leverage -= 5;
            break;
        case Q.parlament_current_icv:
            icv_leverage -= 5;
            break;
        default:
            break;
    }

    while (empty_positions.length !== 0) {
        let random_pos = empty_positions[Math.floor(Math.random()*empty_positions.length)];
        if (psc_leverage >= icv_leverage) {
            if (empty_positions.includes("interior") && psc_leverage >= 10) {
                Q.parlament_coalition_proposal_interior = "psc";
                psc_leverage -= 10;
                empty_positions = empty_positions.filter(pos => pos != "interior");
            } else if (empty_positions.includes("economy") && psc_leverage >= 10) {
                Q.parlament_coalition_proposal_economy = "psc";
                psc_leverage -= 10;
                empty_positions = empty_positions.filter(pos => pos != "economy");
            } else if (empty_positions.includes("health") && psc_leverage >= 7) {
                Q.parlament_coalition_proposal_health= "psc";
                psc_leverage -= 7;
                empty_positions = empty_positions.filter(pos => pos != "health");
            } else {
                Q["parlament_coalition_proposal_" + random_pos] = "psc";
                psc_leverage -= 7; // weighted equally, whatever
                empty_positions = empty_positions.filter(pos => pos != random_pos);
            }
        } else {
            if (empty_positions.includes("health") && icv_leverage >= 7) {
                Q.parlament_coalition_proposal_health = Q.parlament_current_icv;
                icv_leverage -= 7;
                empty_positions = empty_positions.filter(pos => pos != "health");
            } else if (empty_positions.includes("bnl") && icv_leverage >= 5) {
                Q.parlament_coalition_proposal_bnl = Q.parlament_current_icv;
                icv_leverage -= 5;
                empty_positions = empty_positions.filter(pos => pos != "bnl");
            } else if (empty_positions.includes("education") && icv_leverage >= 7) {
                Q.parlament_coalition_proposal_education = Q.parlament_current_icv;
                icv_leverage -= 7;
                empty_positions = empty_positions.filter(pos => pos != "education");
            } else if (empty_positions.includes("territory") && icv_leverage >= 5) {
                Q.parlament_coalition_proposal_territory = Q.parlament_current_icv;
                icv_leverage -= 5;
                empty_positions = empty_positions.filter(pos => pos != "territory");
            } else {
                Q["parlament_coalition_proposal_" + random_pos] = Q.parlament_current_icv;
                icv_leverage -= 7; // weighted equally, whatever
                empty_positions = empty_positions.filter(pos => pos != random_pos);
            }
        }
    }
!}
go-to:phase_text

@vp
title: [? if parlament_coalition_proposal_vp != "erc": Take the Vice-Presidency ?][? if parlament_coalition_proposal_vp = "erc": Give up the Vice-Presidency ?]
choose-if: (parlament_coalition_proposal_vp != "erc" and parlament_coalition_leverage >= 10 and (parlament_coalition_proposal_interior = "erc" or parlament_coalition_proposal_economy = "erc" or parlament_coalition_proposal_health = "erc" or parlament_coalition_proposal_education = "erc" or parlament_coalition_proposal_foreign = "erc" or parlament_coalition_proposal_territory = "erc" or parlament_coalition_proposal_bnl = "erc")) or (parlament_coalition_proposal_vp = "erc")
unavailable-subtitle: [? if parlament_coalition_leverage < 10: We don't have enough leverage to take the Vice-Presidency. ?][? if parlament_coalition_leverage >= 10: It's not possible for us to take *only* the Vice-Presidency. ?]
on-arrival: {!
    Q.parlament_coalition_changes = true;
    if (Q.parlament_coalition_proposal_vp != "erc") {
        Q.parlament_coalition_proposal_vp = "erc";
        Q.parlament_coalition_leverage -= 20;
    } else {
        Q.parlament_coalition_proposal_vp = null;
        Q.parlament_coalition_leverage += 20;
    }
!}
