title: Artur Mas steps aside
subtitle: [+ parlament_coalition_leader +]'s candidate, to leave the political frontline
new-page: true
face-image: img/events/pas_al_costat.webp
tags: event
role: event
view-if: parlament_coalition_sovereignty_phase = 3 and coalition_phase_timer <= 0 and parlament_coalition_sovereignty_replacement_needed and parlament_coalition_proposal_president_name = "Artur Mas"
call: parlament_coalition_sovereignty_replacement.check

= ​Artur Mas steps aside

In the very last moments before the very last hail-mary negotiations with the CUP to form a [+ parlament_coalition_leader +]-led government, Artur Mas is making a surprise press conference. In it, he announces his willingness to "step aside" [? if parlament_coalition_sovereignty_kind = "jxsi" or parlament_coalition_sovereignty_kind = "jxcat": for the good of the unity list.?][? if parlament_coalition_sovereignty_kind != "jxsi" and parlament_coalition_sovereignty_kind != "jxcat": to make an agreement between [+ parlament_current_ciu +], ERC and the CUP possible.?] In a clear win for the CUP, the doors are open now for an alternative leadership for the new government.

- @puigdemont
- @munte
- @romeva

@puigdemont
title: Carles Puigdemont becomes the candidate
choose-if: parlament_coalition_sovereignty_replacement_needed
subtitle: This is the preferred option of [+ parlament_current_ciu +].
on-arrival: {!
    Q.independence_trust += 5;
    Q.parlament_coalition_sovereignty_nominee = "Carles Puigdemont";
!}
go-to: nominate

@munte
title: Neus Munté becomes the candidate
choose-if: parlament_coalition_sovereignty_replacement_needed and parlament_coalition_sovereignty_munte_available
subtitle: Certain sectors in ERC and the CUP believe her to be the obvious replacement, even as she is more of a continuity candidate.
unavailable-subtitle: [? if not parlament_coalition_sovereignty_replacement_needed: A replacement nomination is not possible at this stage. ?][? if parlament_coalition_sovereignty_replacement_needed: [+ parlament_coalition_sovereignty_munte_reasons +]?]
on-arrival: {!
    Q.independence_trust -= 5;
    Q.parlament_coalition_sovereignty_nominee = "Neus Munté";
!}
go-to: nominate

@romeva
title: Can Raül Romeva be the compromise candidate
choose-if: parlament_coalition_sovereignty_replacement_needed and parlament_coalition_sovereignty_romeva_available
subtitle: Spend one party resource. Requires prior brokerage, sufficient ERC-CUP electoral weight and working relations with the partners.
unavailable-subtitle: [? if not parlament_coalition_sovereignty_replacement_needed: A replacement nomination is not possible at this stage. ?][? if parlament_coalition_sovereignty_replacement_needed: [+ parlament_coalition_sovereignty_romeva_reasons +]?]
on-arrival: {!
    Q.parlament_coalition_sovereignty_nominee = "Raül Romeva";
!}
go-to: nominate

@check
on-arrival: {!
    // Keep native English eligibility/dedup logic and capture each reason once.
    function reasonList(text) {
        var values = text.map(function (recipe) {
            return G.englishText(recipe);
        });
        values.text = text;
        return values;
    }
    function addReason(values, recipe) {
        values.text.push(recipe);
        return values.push(G.englishText(recipe));
    }
    function n(value) { return Number(value) || 0; }
    function clamp(value, lo, hi) { return Math.max(lo, Math.min(hi, value)); }
    function cupContinuityReasons() {
      var reasons = reasonList([]);
      if (Q.rubicon) addReason(reasons, G.text('TODO: do we even need this for rubcion?'));
      if (Q.parlament_coalition_sovereignty_assembly_result !== 'tie') addReason(reasons, G.text('The results of the CUP\'s assembly rule out a candidate so similar to Artur Mas.'));
      if (n(Q[Q.parlament_current_ciu + '_relations']) < 65) addReason(reasons, G.text("We don't have good enough relations with {party}.", {
          party: String(Q.parlament_current_ciu)
      }));
      if (n(Q.erc_relations) < 65) addReason(reasons, G.text('We don\'t have good enough relations with ERC.'));
      if (n(Q.cup_poblelliure_strength) <= n(Q.cup_endavant_strength) + 20) addReason(reasons, G.text('Poble Lliure does not have enough strength to push for this option.'));
      if (n(Q.cup_poblelliure_dissent) > 20) addReason(reasons, G.text('Poble Lliure\'s dissent is too high to reach such an agreement.'));
      if (n(Q.cup_thirdsector_dissent) > 20) addReason(reasons, G.text('The Third Sector\'s dissent is too high to reach such an agreement.'));
      return reasons;
    }
    function candidateApproval(Q, candidate) {
    if (Q.rubicon) return false;
    var result = Q.parlament_coalition_sovereignty_assembly_result;
    if (candidate === 'Artur Mas' && result === 'approve') return true;
    if (Q.player_party === 'cup') {
      if (candidate === 'Artur Mas') return false;
      return cupContinuityReasons().length === 0;
    }
    var repeat = Math.min(15, n(Q.parlament_coalition_mas_veto_failures) * 5);
    var margin = candidate === 'Artur Mas' ? 10 + (Q.president === 'Artur Mas' ? 5 : 0) : 20;
    return Q.cup_faction === 'Poble Lliure' && n(Q.cup_poblelliure_strength) > n(Q.cup_endavant_strength) + margin + repeat &&
      n(Q.cup_relations) >= (candidate === 'Artur Mas' ? 60 : 65) &&
      (candidate !== 'Artur Mas' || n(Q.parlament_coalition_sovereignty_mas_pressure) >= 2) &&
      (!result || (candidate === 'Artur Mas' ? result === 'approve' : result !== 'veto'));
    }
    var list = Q.parlament_coalition_sovereignty_kind;
    var erc = n(Q.erc_parlament_s), ciu = n(Q[Q.parlament_current_ciu + '_parlament_s']);
    if (list === 'jxsi' || list === 'jxcat') {
      var share = clamp(n(Q[list + '_formation_num']) || 50, 0, 100) / 100;
      erc = n(Q[list + '_parlament_s']) * share;
      ciu = n(Q[list + '_parlament_s']) * (1 - share);
    }
    var relations = n(Q[Q.parlament_current_ciu + '_relations']);
    var pressureEnough = n(Q.parlament_coalition_sovereignty_ciu_pressure) >= (relations >= 60 ? 2 : 3);
    var munteReasons = Q.player_party === 'erc' ? pressureEnough ? reasonList([]) : reasonList([G.text("{party} is.", { party: String(Q.parlament_current_ciu) })]) : cupContinuityReasons();
    G.setText(Q, "parlament_coalition_sovereignty_munte_reasons", G.joinText(munteReasons.text, ' '));
    Q.parlament_coalition_sovereignty_munte_available = munteReasons.length === 0;
    var romevaReasons = reasonList([]);
    if (list === 'jxsi' || list === 'jxcat') {
      if (erc + n(Q.cup_parlament_s) < ciu) addReason(romevaReasons, G.text("ERC and the CUP lack the political support to push {party} towards this option.", {
          party: String(Q.parlament_current_ciu)
      }));
      if (relations < 55) addReason(romevaReasons, G.text("We don't have good enough relations with {party} .", {
          party: String(Q.parlament_current_ciu)
      }));
      if (Q.player_party === 'cup' && n(Q.erc_relations) < 60) addReason(romevaReasons, G.text('We don\'t have good enough relations with ERC.'));
    } else {
      if (erc + n(Q.cup_parlament_s) <= ciu) addReason(romevaReasons, G.text("ERC and the CUP lack the political support to push {party} towards this option.", {
          party: String(Q.parlament_current_ciu)
      }));
      if (relations <= 65) addReason(romevaReasons, G.text("We don't have good enough relations with {party}.", {
          party: String(Q.parlament_current_ciu)
      }));
      if (Q.player_party === 'cup' && n(Q.erc_relations) <= 65) addReason(romevaReasons, G.text('We don\'t have good enough relations with ERC.'));
      if (Q.player_party === 'erc' && n(Q.cup_relations) <= 65) addReason(romevaReasons, G.text('We don\'t have good enough relations with the CUP.'));
    }
    if (!Q.parlament_coalition_sovereignty_brokerage) addReason(romevaReasons, G.text('We have not built enough support for such an option to take off.'));
    if (n(Q.party_resources) < 1) addReason(romevaReasons, G.text('Not enough resources.'));
    G.setText(Q, "parlament_coalition_sovereignty_romeva_reasons", G.joinText(romevaReasons.text, ' '));
    Q.parlament_coalition_sovereignty_romeva_available = romevaReasons.length === 0;
    var policies = ["education", "health", "pay", "tax", "cap"];
    G.setText(Q, "parlament_coalition_sovereignty_candidate_reason", (function () {
        var name = Q.parlament_coalition_proposal_president_name;
        if (name === 'Artur Mas' && Q.parlament_coalition_sovereignty_withdrawal) return G.literalText("");
        if (['Artur Mas', 'Neus Munté'].indexOf(name) < 0) return G.literalText("");
        if (!candidateApproval(Q, name)) {
            var result = Q.parlament_coalition_sovereignty_assembly_result;
            var continuity = name === 'Neus Munté';
            if (Q.rubicon) return G.text("The CUP will not support an exceptional investiture of {name} under the current proposal.", {
                name: String(name),
                candidate_gender: Q.parlament_coalition_proposal_president_gender
            });
            if (Q.player_party === 'cup' && name === 'Artur Mas') {
                var partner = {
                    jxsi: 'JxSí',
                    jxcat: 'JxCat',
                    ciu: 'CiU',
                    cdc: 'CDC',
                    dl: 'DL',
                    pdcat: 'PDeCAT',
                    junts: 'Junts'
                } [list === 'jxsi' || list === 'jxcat' ? list : Q.parlament_current_ciu] || Q.parlament_current_ciu;
                var mandate = (result === 'veto' ? G.text("The CUP's National Assembly has voted against the investiture of Artur Mas. ") : (result === 'tie' ? G.text("The CUP's National Assembly tie can hardly be read as an endorsemet of Artur Mas, much less under these conditions. ") : G.text("Until the party membershipe votes on wether to authorize such an exceptional investiture, our veto to Artur Mas remains in place.")));
                return G.text("{mandate}{partner} is unwilling to withdraw Artur Mas as the presidential candidate.", {
                    mandate: mandate,
                    partner: String(partner)
                });
            }
            if (result === 'veto') return (continuity ? G.text('The CUP\'s assembly has rejected Artur Mas, and the party will not accept Neus Munté as an exchange token, citing she is just more of the same CDC.') : G.text('The CUP\'s assembly has voted against the investiture of Artur Mas.'));
            if (result === 'tie') return (continuity ? G.text('Despite the exceptional tie in the CUP\'s assembly, the party seems unwilling to endorse Neus Munté as an exchange token, citing she is just more of the same CDC.') : G.text('The CUP\'s assembly ended in a tie, which hadrly seems to facilitate the investiture of Artur Mas.'));
            if (Q.player_party === 'cup') return G.text('We have no assembly mandate to support Neus Munté as an alternative to Artur Mas.');
            return (continuity ? G.text('While some within the CUP may see Neus Munté as a viable alternative to Artur Mas, many still see her as more CDC.') : G.text('The CUP maintains its veto of Artur Mas and it does not look like an exception will be made despite the offered terms.'));
        }
        var count = policies.filter(function (p) {
            return Q['parlament_coalition_policy_' + p];
        }).length;
        var deadline = n(Q.parlament_coalition_sovereignty_deadline) || n(Q.roadmap_year);
        var reasons = reasonList([]);
        if (count < (name === 'Neus Munté' ? 3 : 2))(addReason(reasons, G.text("The CUP expects a broader set of social commitments before making an exception for {name}.", {
            name: String(name),
            parlament_coalition_proposal_president_gender: Q.parlament_coalition_proposal_president_gender
        })));
        if (deadline <= n(Q.year))(addReason(reasons, G.text("The CUP needs a future roadmap deadline to make an exception for {name}.", {
            name: String(name),
            parlament_coalition_proposal_president_gender: Q.parlament_coalition_proposal_president_gender
        })));
        if (deadline > n(Q.year) + 2)(addReason(reasons, G.text("The CUP expects the agreed roadmap to be fulfilled within the next two years before making an exception for {name}.", {
            name: String(name),
            parlament_coalition_proposal_president_gender: Q.parlament_coalition_proposal_president_gender
        })));
        if (reasons.length) return (Q.player_party === 'cup' ? (Q.parlament_coalition_sovereignty_assembly_result === 'approve' ? G.text("This proposal does not satisfy the party-assembly voted conditions for an exceptional investiture. {reasons}", {
            reasons: G.joinText(reasons.text, ' ')
        }) : G.text("This proposal does not satisfy our conditions for an exceptional investiture. {reasons}", {
            reasons: G.joinText(reasons.text, ' ')
        })) : G.text("{reasons}", {
            reasons: G.joinText(reasons.text, ' ')
        }));
        if (Q.parlament_coalition_sovereignty_assembly_result) {
            if ((Q.parlament_coalition_sovereignty_assembly_terms || []).some(function (term) {
                    return term.policy === "indy";
                }) && !Q.parlament_coalition_concessions_indy)(addReason(reasons, G.text("The new proposal weakens the independence commitments previously offered and voted by the CUP\'s assembly.")));
            var weakened = (Q.parlament_coalition_sovereignty_assembly_terms || []).some(function (term) {
                return term.policy !== 'indy' && (!Q['parlament_coalition_policy_' + term.policy] || n(Q['parlament_coalition_policy_' + term.policy + '_target']) < n(term.target));
            });
            if (weakened)(addReason(reasons, G.text('The new proposal weakens social commitments previously offered and voted by the CUP\'s assembly.')));
            if (deadline > n(Q.parlament_coalition_sovereignty_assembly_deadline))(addReason(reasons, G.text('The new proposal pushes the roadmap deadline past what was promised and voted by the CUP\'s assembly.')));
        }
        return (reasons.length && Q.player_party === 'cup' ? G.text("This proposal goes against what the party's National Assembly agreed.{reasons}", {
            reasons: G.joinText(reasons.text, ' ')
        }) : G.text("{reasons}", {
            reasons: G.joinText(reasons.text, ' ')
        }));
    })());

!}

@nominate
call: parlament_coalition_sovereignty_replacement.check
go-to: commit

@commit
on-arrival: {!
    var name = Q.parlament_coalition_sovereignty_nominee;
    if (Q.parlament_coalition_proposal_president_name !== "Artur Mas" || !Q.parlament_coalition_sovereignty_replacement_needed || (name === 'Neus Munté' && !Q.parlament_coalition_sovereignty_munte_available) || (name === 'Raül Romeva' && !Q.parlament_coalition_sovereignty_romeva_available) || ['Neus Munté', 'Raül Romeva', 'Carles Puigdemont'].indexOf(name) < 0) return false;
    if (name === 'Raül Romeva') Q.party_resources -= 1;
    Q.parlament_coalition_proposal_president_name = name;
    Q.parlament_coalition_proposal_president_gender = name === 'Neus Munté' ? 'f' : 'm';
    Q.parlament_coalition_mas_retired = true;
    if (Q.player_party == "cup" && !Q.cup_in_jxsi && !Q.player_in_jxsi) {
      this.achieve("paperera_de_la_historia");
    }
    var leader = name === 'Raül Romeva' ? 'Carles Puigdemont' : name;
    ['ciu', 'cdc', 'dl', 'pdcat', 'junts'].forEach(function (party) {
      if (Q[party + '_leader'] === 'Artur Mas' || party === Q.parlament_current_ciu) {
        Q[party + '_leader'] = leader;
        Q[party + '_leader_gender'] = leader === 'Neus Munté' ? 'f' : 'm';
      }
    });
    if (Q.parlament_coalition_sovereignty_kind === 'jxsi' || Q.parlament_coalition_sovereignty_kind === 'jxcat') {
      Q[Q.parlament_coalition_sovereignty_kind + '_leader'] = name;
      Q[Q.parlament_coalition_sovereignty_kind + '_leader_gender'] = Q.parlament_coalition_proposal_president_gender;
    }
    Q.parlament_current_ciu_leader = Q[Q.parlament_current_ciu + '_leader'];
    Q.parlament_coalition_sovereignty_replacement_needed = false;
    Q.parlament_coalition_sovereignty_withdrawal = false;
    return true;
!}
go-to: post_event

@evaluate
on-arrival: {!
    var reason = Q.parlament_coalition_sovereignty_candidate_reason;
    if (Q.parlament_coalition_sovereignty_withdrawal && Q.parlament_coalition_proposal_president_name === "Artur Mas") {
        Q.parlament_coalition_proposal_accept = false;
        G.setText(Q, "parlament_coalition_sovereignty_reject_reasons", G.joinText([G.getText(Q, "parlament_coalition_sovereignty_reject_reasons"), G.text(" {party} is unwilling to withdraw Artur Mas.", {
            party: String(Q.parlament_current_ciu)
        })]));
    }
    if (reason) {
        Q.parlament_coalition_proposal_accept = false;
        G.setText(Q, "parlament_coalition_sovereignty_reject_reasons", G.joinText([G.getText(Q, "parlament_coalition_sovereignty_reject_reasons"), G.text("{separator}{reason}", {
            separator: Q.parlament_coalition_sovereignty_reject_reasons ? " " : "",
            reason: G.getText(Q, "parlament_coalition_sovereignty_candidate_reason")
        })]));
    }
!}
call: parlament_coalition_fiscal_policies.evaluate
go-to: parlament_coalition_sovereignty.accepted if parlament_coalition_proposal_accept; parlament_coalition_sovereignty.next_round if not parlament_coalition_proposal_accept
