@erc_player_ciu_led_government
title: [+ parlament_current_ciu +]-ERC-CUP <span class="generalitat-coalition" data-parties="[+ parlament_current_ciu +] erc cup" data-summary="[? if parlament_current_ciu_s + erc_parlament_s + cup_parlament_s >= parlament_s_majority: Majority government?][? if parlament_current_ciu_s + erc_parlament_s + cup_parlament_s < parlament_s_majority: Minority government?] - [+ parlament_current_ciu_s + erc_parlament_s + cup_parlament_s +]/[+ parlament_s_majority +]"><span style="color: var(--[+ parlament_current_ciu +]); font-style: italic;">National</span> <span style="color: var(--erc); font-style: italic;">Concentration</span> <span style="color: var(--cup); font-style: italic;">government</span></span>
view-if: parlament_coalition_option_ciu_erc_cup_gov_visible and parlament_current_ciu_s >= erc_parlament_s and player_party == "erc" and (parlament_current_ciu != "jxcat" or not erc_in_jxcat)
choose-if: parlament_coalition_sovereignty_triple_government_available
unavailable-subtitle: [? if parlament_current_ciu_s + erc_parlament_s + cup_parlament_s < parlament_s_majority: Not enough parliamentary support. ?] [+ parlament_coalition_sovereignty_triple_trust_reasons +] [+ parlament_coalition_sovereignty_cup_cabinet_reasons +]
subtitle: True National Unity? [? if parlament_coalition_sovereignty_cup_cabinet_cost = 1: Pushing the CUP to join into the negotiations will take some effort, though. \[-1 resources\] ?]
on-arrival: {!
    Q.party_resources -= Q.parlament_coalition_sovereignty_cup_cabinet_cost;
    Q.parlament_coalition_sovereignty_kind = "government";
    Q.parlament_coalition_sovereignty_phase = 1;
    Q.parlament_coalition_leader = Q.parlament_current_ciu;
    Q.parlament_coalition_follower = "erc";
    Q.parlament_coalition_sovereignty_cabinet = [Q.parlament_current_ciu, "erc", "cup"];
    Q.parlament_coalition_cabinet_seats = Q.parlament_coalition_sovereignty_cabinet.reduce(function (n, p) { return n + Q[p + "_parlament_s"]; }, 0);
    Q.parlament_coalition_support_seats = Q.parlament_coalition_cabinet_seats + 0;
    Q.parlament_coalition_proposal_president = Q.parlament_coalition_leader;
    Q.parlament_coalition_proposal_president_name = Q[Q.parlament_coalition_proposal_president + "_leader"];
    Q.parlament_coalition_proposal_president_gender = Q[Q.parlament_coalition_proposal_president + "_leader_gender"];


    if (!(Q.cup_endavant_strength + Q.cup_poblelliure_strength + Q.cup_thirdsector_strength > 0)) {
        Q.cup_endavant_strength = 35;
        Q.cup_poblelliure_strength = 35;
        Q.cup_thirdsector_strength = 20;
        Q.cup_endavant_dissent = 15;
        Q.cup_poblelliure_dissent = 15;
        Q.cup_thirdsector_dissent = 10;
    }
    Q.coalition_phase_timer = 1;
    Q.month_actions += 1;
!}
call: parlament_coalition_sovereignty.initialize

