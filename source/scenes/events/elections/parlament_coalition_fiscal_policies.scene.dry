title: Propose Policy Commitments
new-page: true
on-arrival: {!
    Q.parlament_coalition_concessions = Q.parlament_coalition_policy_cap || Q.parlament_coalition_policy_education || Q.parlament_coalition_policy_health || Q.parlament_coalition_policy_pay || Q.parlament_coalition_policy_tax || Q.parlament_coalition_policy_indy_demanded;
!}

You should not see this text. If you do, please report a bug! (and make a wish!)

@spending_cap
tags: fiscal_concessions
title: [? if parlament_coalition_policy_cap: Withdraw demand to raise the social spending cap?][? if not parlament_coalition_policy_cap: Demand a higher social spending cap?]
view-if: parlament_coalition_policy_cap or (social_spending_cap >= -2 and social_spending_cap < 3)
choose-if: parlament_coalition_policy_cap or (parlament_coalition_policy_cap_target = social_spending_cap + 1 and parlament_coalition_policy_cap_target <= 3 and parlament_coalition_leverage >= parlament_coalition_policy_spending_cost)
subtitle: A raise of the social spending cap gives us more options to invest in things like Education, Health and other public investments.
unavailable-subtitle: [? if parlament_coalition_policy_cap_target > 3: There is no longer a cap! ?][? if parlament_coalition_leverage < parlament_coalition_policy_spending_cost: We don't have enough leverage to propose more concessions. ?]
on-arrival: {!
    var taking = !Q.parlament_coalition_policy_cap;
    var canDemand = Q.social_spending_cap >= -2 && Q.social_spending_cap < 3
        && Q.parlament_coalition_policy_cap_target === Q.social_spending_cap + 1
        && Q.parlament_coalition_leverage >= Q.parlament_coalition_policy_spending_cost;
    if (!taking || canDemand) {
        Q.parlament_coalition_policy_cap = taking;
        Q.parlament_coalition_leverage += taking ? -Q.parlament_coalition_policy_spending_cost : Q.parlament_coalition_policy_spending_cost;
    }
!}
go-to: jumpScene

