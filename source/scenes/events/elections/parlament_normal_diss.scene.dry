title: Incoming Parlament election
subtitle: President [+ president +] sets the new election date for two months from now.
face-image: img/events/snapelection.jpg
new-page: true
tags: event
view-if: (next_election_year = year and next_election_month = month - 2 and next_election_week = week) or (next_election_year = year + 1 and ((next_election_month = 2 and month = 12) or (next_election_month = 1 and month = 11)) and next_election_week = week) and next_election_event_trigger
on-arrival: {!
    Q.cat_coalition_disp_old = Q.cat_coalition_disp;
    var caretakerGovernmentSeats = Q.cat_coalition.reduce(function (total, party) {
        return total + (Q[party + "_parlament_s"] || 0);
    }, 0);
    Q.cat_coalition_disp = Q.president_party + " " + G.governmentTooltip("generalitat", Q.cat_coalition, (caretakerGovernmentSeats >= Q.parlament_s_majority ? "Majority government - " : "Minority government - ") + caretakerGovernmentSeats + "/" + Q.parlament_s_majority, "<span style=\"font-style:italic;\">caretaker gov.</span>");
    Q.cat_caretaker_gov = true;
    Q.cup_leadership_timer = 1;

    if (Q[Q.player_party + "_in_gob"] && !(Q.president_party == Q.player_party)) {
        Q.position_disp = "<span style='font-style: italic'>Government Support</span>";
    }

    G.deactivateLaw(Q, "generalitat_concession_social", undefined, true);

    console.info("Set new election date for ", Q.next_election_month, Q.next_election_year, ", week", Q.next_election_week)

    Q.next_election_event_trigger = 0;
    Q.next_election_event_countdown = 2;
    if (!Q.countdowns.includes("next_election_event")) Q.countdowns.push("next_election_event");
!}
role: event

= New Parlament elections called!

After four years, this term has come to an end. President [+ president +] has dissolved the Parlament, and the next elections will be held in two months time, on [+ next_election_month : month +], [+ next_election_year +].

Until then, the functions of the Generalitat will be limited, and handled by a [+ cat_coalition_disp +].

- @post_event: May this be our chance!
