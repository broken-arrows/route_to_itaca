title: parlament coalition
new-page: true
on-arrival: {!
    // Post-election happenings
    const clean_boost_parties = ["pxc", "fnc", "vox", "pdcat", "cup", "si", "unio"];
    for (var p of clean_boost_parties) {
        if (Q[p + "_parlament_s"] > 0 && Q[p + "_parlament_s"] < 5 && !Q[p + "_parlament_boosted_postelection"]) {
            for (var c of Q.parlament_constituencies) {
                for (var d of Q.parlament_demographics) {
                    Q[p + "_parlament_" + c + "_" + d + "_support"] = 1.25*Q[p + "_parlament_" + c + "_" + d + "_support"];
                }
            }
            Q[p + "_parlament_boosted_postelection"] = true;
        } else if (Q[p + "_parlament_s"] <= 0) {
            for (var c of Q.parlament_constituencies) {
                for (var d of Q.parlament_demographics) {
                    if (Q[p + "_parlament_" + c + "_" + d + "_support"] < 0.25) {
                        Q[p + "_parlament_" + c + "_" + d + "_support"] = 0;
                    } else {
                        Q[p + "_parlament_" + c + "_" + d + "_support"] = 0.1*Q[p + "_parlament_" + c + "_" + d + "_support"];
                    }
                }
            }
        }
    }

    // Reset stuffs
    Q.parlament_coalition_leverage = 0;
    Q.parlament_coalition_concessions = false;
    Q.parlament_coalition_changes = false;
    Q.parlament_coalition_concessions_social = 0;
    Q.parlament_coalition_concessions_indy = 0;
    Q.parlament_coalition_push = 0;

    Q.ciu_erc_coalition_phase = 0;
    Q.ciu_min_coalition_phase = 0;
    Q.left_tripartite_coalition_phase = 0;
    Q.erc_min_coalition_phase = 0;
    Q.erc_ciu_coalition_phase = 0;
    Q.erc_cup_coalition_phase = 0;
    Q.psc_tripartite_coalition_phase = 0;
    Q.alternative_tripartite_coalition_phase = 0;
    Q.progressist_erc_abstention_phase = 0;
    Q.republican_coalition_phase = 0;
    Q.left_indy_front_coalition_phase = 0;
    Q.cup_support_coalition_kind = "";
    Q.cup_support_coalition_phase = 0;
    Q.cup_broad_kind = "";
    Q.cup_broad_coalition_phase = 0;
    Q.parlament_coalition_cabinet_seats = 0;
    Q.parlament_coalition_support_seats = 0;
    Q.parlament_coalition_leader = "";
    Q.parlament_coalition_follower = "";
    Q.pdcat_external_support = false;
    Q.parlament_current_ciu_roadmap = 0;
    Q.parlament_coalition_pdcat_support_s = 0;
    Q.parlament_coalition_pdcat_support_resolved = false;

    Q.parlament_coalition_proposal_president = null;
    Q.parlament_coalition_proposal_vp = null;
    Q.parlament_coalition_proposal_economy = null;
    Q.parlament_coalition_proposal_health = null;
    Q.parlament_coalition_proposal_education = null;
    Q.parlament_coalition_proposal_interior = null;
    Q.parlament_coalition_proposal_foreign = null;
    Q.parlament_coalition_proposal_bnl = null;
    Q.parlament_coalition_proposal_territory = null;

    Q.parlament_coalition_no_possible_majority = false;
    Q.parlament_coalition_erc_critical = false;
    Q.parlament_coalition_cup_critical = false;

    // set changing party names
    if (Q.ciu_parlament_s > 0) {
        Q.parlament_current_ciu = "ciu";
        Q.parlament_current_ciu_s = Q.ciu_parlament_s;
        Q.parlament_current_ciu_leader = Q.ciu_leader;
    } else if (Q.cdc_parlament_s > 0) {
        Q.parlament_current_ciu = "cdc";
        Q.parlament_current_ciu_s = Q.cdc_parlament_s;
        Q.parlament_current_ciu_leader = Q.cdc_leader;
    } else if (Q.dl_parlament_s > 0) {
        Q.parlament_current_ciu = "dl";
        Q.parlament_current_ciu_s = Q.dl_parlament_s;
        Q.parlament_current_ciu_leader = Q.dl_leader;
    } else if (Q.jxcat_parlament_s > 0 && !Q.erc_in_jxcat) {
        Q.parlament_current_ciu = "jxcat";
        Q.parlament_current_ciu_s = Q.jxcat_parlament_s;
        Q.parlament_current_ciu_leader = Q.jxcat_leader;
    } else if (Q.pdcat_parlament_s > 0 && !Q.pdcat_split) {
        Q.parlament_current_ciu = "pdcat";
        Q.parlament_current_ciu_s = Q.pdcat_parlament_s;
        Q.parlament_current_ciu_leader = Q.pdcat_leader;
    } else {
        Q.parlament_current_ciu = "junts";
        Q.parlament_current_ciu_s = Q.junts_parlament_s;
        Q.parlament_current_ciu_leader = Q.junts_leader;
    }
    if (Q.icv_parlament_s > 0) {
        Q.parlament_current_icv = "icv";
        Q.parlament_current_icv_s = Q.icv_parlament_s;
        Q.parlament_current_icv_leader = Q.icv_leader;
        Q.parlament_current_icv_relations = Q.icv_relations;
    } else if (Q.csqp_parlament_s > 0) {
        Q.parlament_current_icv = "csqp";
        Q.parlament_current_icv_s = Q.csqp_parlament_s;
        Q.parlament_current_icv_leader = Q.csqp_leader;
        Q.parlament_current_icv_relations = Q.csqp_relations;
    } else if (Q.cecp_parlament_s > 0) {
        Q.parlament_current_icv = "cecp";
        Q.parlament_current_icv_s = Q.cecp_parlament_s;
        Q.parlament_current_icv_leader = Q.cecp_leader;
        Q.parlament_current_icv_relations = Q.cecp_relations;
    } else {
        Q.parlament_current_icv = "ecp";
        Q.parlament_current_icv_s = Q.ecp_parlament_s;
        Q.parlament_current_icv_leader = Q.ecp_leader;
        Q.parlament_current_icv_relations = Q.ecp_relations;
    }

    // Coalition seat totals
    Q.parlament_coalition_ciu_erc_s = (Q[Q.parlament_current_ciu + "_parlament_s"] > Q.erc_parlament_s) ? Q[Q.parlament_current_ciu + "_parlament_s"] + Q.erc_parlament_s : 0;
    Q.parlament_coalition_erc_ciu_s = (Q[Q.parlament_current_ciu + "_parlament_s"] < Q.erc_parlament_s) ? Q[Q.parlament_current_ciu + "_parlament_s"] + Q.erc_parlament_s : 0;
    Q.parlament_coalition_ciu_erc_cup_s = (Q[Q.parlament_current_ciu + "_parlament_s"] > Q.erc_parlament_s) ? Q[Q.parlament_current_ciu + "_parlament_s"] + Q.erc_parlament_s + Q.cup_parlament_s : 0;
    Q.parlament_coalition_erc_ciu_cup_s = (Q[Q.parlament_current_ciu + "_parlament_s"] < Q.erc_parlament_s) ? Q[Q.parlament_current_ciu + "_parlament_s"] + Q.erc_parlament_s + Q.cup_parlament_s : 0;
    Q.parlament_coalition_jxsi_cup_s = (Q.jxsi_parlament_s > 0) ? Q.jxsi_parlament_s + Q.cup_parlament_s : 0;
    Q.parlament_coalition_erc_cup_s = Q.erc_parlament_s + Q.cup_parlament_s;
    var current_icv_seats = Q[Q.parlament_current_icv + "_parlament_s"];
    var left_tripartite_seats = Q.psc_parlament_s + Q.erc_parlament_s + current_icv_seats;
    Q.parlament_coalition_psc_erc_icv_s = (Q.psc_parlament_s >= Q.erc_parlament_s && Q.psc_parlament_s >= current_icv_seats) ? left_tripartite_seats : 0;
    Q.parlament_coalition_erc_psc_icv_s = (Q.erc_parlament_s > Q.psc_parlament_s && Q.erc_parlament_s >= current_icv_seats) ? left_tripartite_seats : 0;
    Q.parlament_coalition_icv_psc_erc_s = (current_icv_seats > Q.psc_parlament_s && current_icv_seats > Q.erc_parlament_s) ? left_tripartite_seats : 0;
    Q.parlament_coalition_psc_icv_s = Q.psc_parlament_s + Q[Q.parlament_current_icv + "_parlament_s"];
    Q.parlament_coalition_icv_psc_s = (current_icv_seats > Q.psc_parlament_s) ? Q.parlament_coalition_psc_icv_s : 0;
    Q.parlament_coalition_erc_icv_cup_s = Q.erc_parlament_s + Q[Q.parlament_current_icv + "_parlament_s"] + Q.cup_parlament_s;
    Q.parlament_coalition_cs_ppc_s = (Q.cs_parlament_s > Q.ppc_parlament_s) ? Q.cs_parlament_s + Q.ppc_parlament_s : 0;
    Q.parlament_coalition_ppc_cs_s = (Q.cs_parlament_s <= Q.ppc_parlament_s) ? Q.cs_parlament_s + Q.ppc_parlament_s : 0;
    Q.parlament_coalition_cs_ppc_vox_s = (Q.vox_parlament_s > 0) ? Q.cs_parlament_s + Q.ppc_parlament_s + Q.vox_parlament_s : 0;
    Q.parlament_coalition_cs_psc_ppc_s = (Q.psc_parlament_s < Q.cs_parlament_s) ? Q.cs_parlament_s + Q.psc_parlament_s + Q.ppc_parlament_s : 0;
    Q.parlament_coalition_psc_cs_ppc_s = (Q.psc_parlament_s > Q.cs_parlament_s) ? Q.cs_parlament_s + Q.psc_parlament_s + Q.ppc_parlament_s : 0;
    Q.parlament_coalition_cs_psc_ppc_vox_s = (Q.vox_parlament_s > 0) ? Q.cs_parlament_s + Q.psc_parlament_s + Q.ppc_parlament_s + Q.vox_parlament_s : 0;
    Q.parlament_coalition_ciu_erc_pdcat_s = (Q[Q.parlament_current_ciu + "_parlament_s"] > Q.erc_parlament_s && Q.pdcat_split && Q.pdcat_parlament_s > 0) ? Q[Q.parlament_current_ciu + "_parlament_s"] + Q.erc_parlament_s + Q.pdcat_parlament_s : 0;
    Q.parlament_coalition_cs_psc_unio_s = (Q.unio_parlament_s > 0 && Q.cs_parlament_s > Q.psc_parlament_s) ? Q.cs_parlament_s + Q.psc_parlament_s + Q.unio_parlament_s : 0;
    Q.parlament_coalition_psc_cs_unio_s = (Q.unio_parlament_s > 0 && Q.psc_parlament_s > Q.cs_parlament_s) ? Q.cs_parlament_s + Q.psc_parlament_s + Q.unio_parlament_s : 0;
    Q.parlament_coalition_ciu_ppc_unio_s = (Q[Q.parlament_current_ciu + "_parlament_s"] + Q.ppc_parlament_s + Q.unio_parlament_s > 40 && Q[Q.parlament_current_ciu + "_parlament_s"] < Q.parlament_s_majority) ? Q[Q.parlament_current_ciu + "_parlament_s"] + Q.ppc_parlament_s + Q.unio_parlament_s : 0;
    Q.parlament_coalition_erc_psc_icv_cup_s = (Q.erc_parlament_s > Q.psc_parlament_s && Q.cup_parlament_s > 0) ? Q.erc_parlament_s + Q.psc_parlament_s + Q[Q.parlament_current_icv + "_parlament_s"] + Q.cup_parlament_s : 0;

    // Single-party absolute majority (with 135 seats at most one party can clear it)
    Q.parlament_coalition_majority_party = null;
    Q.parlament_coalition_majority_s = 0;
    for (var mp of Q.parties) {
        if (Q[mp + "_parlament_s"] >= Q.parlament_s_majority) {
            Q.parlament_coalition_majority_party = mp;
            Q.parlament_coalition_majority_s = Q[mp + "_parlament_s"];
        }
    }

    // Political availability is derived after every widget family has been built
    Q.parlament_coalition_no_possible_majority = false;

    // Alias-aware seat lookup, mirroring the widget's own resolver
    var PARL_ALIAS = {
        ciu_alias:      Q.parlament_current_ciu,
        icv_alias:      Q.parlament_current_icv,
        majority_alias: Q.parlament_coalition_majority_party
    };
    var sP = function (p) { return +Q[(PARL_ALIAS[p] || p) + "_parlament_s"] || 0; };

    // Near-miss gate, applied HER
    var majP = Q.parlament_s_majority || 68;
    var NEAR = 20;
    var barSeats = function (cond, members) {
        if (!cond) return 0;
        var yes = 0, abst = 0, raw = 0;
        for (var bmi = 0; bmi < members.length; bmi++) {
            var bv = sP(members[bmi].party);
            raw += bv;
            if (members[bmi].type === "abstain") abst += bv; else yes += bv;
        }
        return (Math.floor(yes + abst / 2) >= majP - NEAR) ? raw : 0;
    };

    // TODO: Revisit PSC leadership gates after the completed coalition families have had a balance/playtesting pass.

    var comunsLeader = Q.parlament_current_icv_leader;
    var comunsEmergencyLeaderOk = false;
    if (comunsLeader != "Arcadi Oliveres") {
        comunsEmergencyLeaderOk = (
            comunsLeader == "Joan Coscubiela" ||
            comunsLeader == "Jéssica Albiach" ||
            Q.parlament_repeat_election
        );
    }
    Q.parlament_comuns_emergency_leader_ok = comunsEmergencyLeaderOk;

    // Minimum viable PSC-Comuns emergency package. 
    var progressiveSeats = sP("psc") + sP("icv_alias");
    Q.parlament_coalition_psc_icv_erc_abst_available = (
        progressiveSeats < majP && Math.floor(progressiveSeats + sP("erc") / 2) >= majP
    );
    var leftEmergencyMembers = [
        { party: "psc", type: "government" },
        { party: "icv_alias", type: "government" }
    ];
    var leftEmergencyYes = progressiveSeats;
    var leftEmergencyTier = null;
    if (progressiveSeats < majP && sP("cs") > 0) {
        leftEmergencyMembers.push({ party: "cs", type: "support" });
        leftEmergencyYes += sP("cs");
        leftEmergencyTier = "cs";
        if (leftEmergencyYes < majP && sP("ppc") > 0) {
            leftEmergencyMembers.push({ party: "ppc", type: "support" });
            leftEmergencyYes += sP("ppc");
            leftEmergencyTier = "ppc";
        }
        if (leftEmergencyYes < majP && sP("unio") > 0) {
            leftEmergencyMembers.push({ party: "unio", type: "support" });
            leftEmergencyYes += sP("unio");
            leftEmergencyTier = "unio";
        }
        if (leftEmergencyYes < majP && sP("vox") > 0 && Math.floor(leftEmergencyYes + sP("vox") / 2) >= majP) {
            leftEmergencyMembers.push({ party: "vox", type: "abstain" });
            leftEmergencyTier = "vox";
        }
    }
    var leftEmergencyInvests = leftEmergencyYes >= majP || (
        leftEmergencyTier == "vox" && Math.floor(leftEmergencyYes + sP("vox") / 2) >= majP
    );
    Q.parlament_unthinkable_left_tier = leftEmergencyTier;
    Q.parlament_unthinkable_left_psc_leads = leftEmergencyTier == "ppc" || leftEmergencyTier == "unio" || leftEmergencyTier == "vox";
    Q.parlament_emergency_psc_icv_available = progressiveSeats > 0 && progressiveSeats < majP && leftEmergencyTier && leftEmergencyInvests;
    Q.parlament_emergency_psc_icv_use_cs = leftEmergencyMembers.some(function (member) { return member.party == "cs"; });
    Q.parlament_emergency_psc_icv_use_ppc = leftEmergencyMembers.some(function (member) { return member.party == "ppc"; });
    Q.parlament_emergency_psc_icv_use_unio = leftEmergencyMembers.some(function (member) { return member.party == "unio"; });
    Q.parlament_emergency_psc_icv_use_vox = leftEmergencyMembers.some(function (member) { return member.party == "vox"; });
    Q.parlament_coalition_unthinkable_left_s = Q.parlament_emergency_psc_icv_available
        ? leftEmergencyMembers.reduce(function (sum, member) { return sum + sP(member.party); }, 0)
        : 0;

    // A Cs minority becomes an unthinkably broad pact only when PSC and PPC still fall short and eligible Comuns support is arithmetically required.
    var csEmergencyWithoutComuns = sP("cs") + sP("psc") + sP("ppc");
    var csEmergencyMembers = [ { party: "cs", type: "government" } ];
    if (sP("psc") > 0) csEmergencyMembers.push({ party: "psc", type: "support" });
    if (sP("ppc") > 0) csEmergencyMembers.push({ party: "ppc", type: "support" });
    csEmergencyMembers.push({ party: "icv_alias", type: "support" });
    Q.parlament_coalition_unthinkable_cs_s = (
        sP("icv_alias") > 0 &&
        sP("cs") > sP("psc") && sP("cs") >= sP("ppc") && sP("cs") > sP("icv_alias") &&
        csEmergencyWithoutComuns < majP && csEmergencyWithoutComuns + sP("icv_alias") >= majP
    ) ? csEmergencyWithoutComuns + sP("icv_alias") : 0;
    Q.parlament_coalition_cs_emergency_s = (
        Q.cat_spa_relations < 40 && comunsEmergencyLeaderOk
    ) ? Q.parlament_coalition_unthinkable_cs_s : 0;

    // CUP cabinet/support routing. A player-controlled CUP may choose either path; AI CUP joins cabinet on roadmap alignment or exceptional trust.
    Q.parlament_cup_can_join_erc_government = (
        Q.erc_roadmap > 0 &&
        (Q.player_party == "cup" || Q.cup_roadmap == Q.erc_roadmap || Q.cup_relations > 65)
    );
    Q.parlament_erc_cup_government_available = (
        Q.erc_parlament_s + Q.cup_parlament_s >= majP &&
        Q.parlament_cup_can_join_erc_government
    );
    Q.parlament_erc_cup_support_available = (
        Q.erc_roadmap > 0 && Q.erc_parlament_s > Q.cup_parlament_s &&
        Q.erc_parlament_s > 40 && Q.erc_parlament_s < majP &&
        Q.erc_parlament_s + Q.cup_parlament_s >= majP &&
        (Q.player_party == "cup" || !Q.parlament_cup_can_join_erc_government)
    );

    // Hard roadmap limits for ERC-Comuns-CUP arrangements. Relations/resources can open talks only inside these ideological bounds.
    var comunsCupRoadmapOk = false;
    if (comunsLeader == "Arcadi Oliveres" || comunsLeader == "Jaume Asens") {
        comunsCupRoadmapOk = Q.erc_roadmap <= 2;
    } else if (comunsLeader == "Xavier Domènech") {
        comunsCupRoadmapOk = Q.erc_roadmap <= 1 || (Q.erc_roadmap == 2 && Q.parlament_current_icv_relations > 65);
    } else {
        comunsCupRoadmapOk = Q.erc_roadmap <= 1;
    }
    Q.parlament_comuns_cup_compatible = (
        Q.erc_roadmap > 0 && Q.erc_roadmap < 3 && comunsCupRoadmapOk &&
        (Q.parlament_current_icv_relations > 40 || Q.party_resources > 1)
    );
    Q.parlament_republican_available = (
        Q.parlament_comuns_cup_compatible && Q.erc_parlament_s >= current_icv_seats &&
        Q.erc_parlament_s + current_icv_seats < majP &&
        Q.erc_parlament_s + current_icv_seats + Q.cup_parlament_s >= majP &&
        (Q.player_party == "cup" || !Q.parlament_cup_can_join_erc_government)
    );
    Q.parlament_popular_unity_available = (
        Q.parlament_comuns_cup_compatible &&
        Q.erc_parlament_s + current_icv_seats + Q.cup_parlament_s >= majP &&
        Q.parlament_cup_can_join_erc_government
    );
    var cupExtendedTripartiteSeats = Q.erc_parlament_s + Q.psc_parlament_s + current_icv_seats;
    Q.parlament_new_popular_front_available = (
        Q.erc_roadmap > 0 && Q.psc_leader == "Montserrat Tura" &&
        Q.erc_parlament_s > Q.psc_parlament_s && Q.erc_parlament_s > current_icv_seats &&
        cupExtendedTripartiteSeats < majP && cupExtendedTripartiteSeats + Q.cup_parlament_s >= majP &&
        (Q.player_party == "cup" || !Q.parlament_cup_can_join_erc_government)
    );
    Q.parlament_minority_left_tripartite_available = (
        Q.erc_roadmap > 0 && (Q.psc_leader == "Montserrat Tura" || Q.psc_leader == "Àngel Ros") &&
        Q.erc_parlament_s > Q.psc_parlament_s && Q.erc_parlament_s > current_icv_seats &&
        cupExtendedTripartiteSeats < majP && Math.floor(cupExtendedTripartiteSeats + Q.cup_parlament_s / 2) >= majP &&
        (Q.player_party == "cup" || !Q.parlament_cup_can_join_erc_government)
    );

    Q.parlament_pdcat_support_available = (
        Q.pdcat_split && Q.pdcat_parlament_s > 0 &&
        Q.parlament_current_ciu_s + Q.erc_parlament_s < majP &&
        Q.parlament_current_ciu_s + Q.erc_parlament_s + Q.pdcat_parlament_s >= majP &&
        Q.pdcat_roadmap >= Math.max(Q.erc_roadmap, Q[Q.parlament_current_ciu + "_roadmap"])
    );

    // In display order!
    var PARL_BARS = [
        { label: "Single-Party Majority Government", seatsVar: "parlament_coalition_majority_s",
          members: [ { party: "majority_alias", type: "government" } ] },

        { label: Q.parlament_current_ciu + " minority Government", seatsVar: "parlament_coalition_ciu_erc_s",
          members: [ { party: "ciu_alias", type: "government" }, { party: "erc", type: "support" } ] },

        { label: Q.parlament_current_ciu + " minority Government", seatsVar: "parlament_coalition_ciu_ppc_unio_s",
          members: [ { party: "ciu_alias", type: "government" }, { party: "ppc", type: "support" },
                     { party: "unio", type: "support" } ] },

        { label: Q.parlament_current_ciu + " minority Government", key: "ciu_ppc_pdcat_unio",
          cond: sP("ciu_alias") > 40 && sP("ciu_alias") < majP && Q.pdcat_split && sP("pdcat") > 0,
          members: [ { party: "ciu_alias", type: "government" }, { party: "ppc", type: "support" },
                     { party: "pdcat", type: "support" }, { party: "unio", type: "support" } ] },

        { label: "JxSí minority Government", key: "jxsi_min_cup",
          cond: sP("jxsi") > 40 && sP("jxsi") < majP,
          members: [ { party: "jxsi", type: "government" }, { party: "cup", type: "support" } ] },

        { label: "National Concentration Government", key: "jxsi_cup_gov",
          cond: sP("cup") > 0 && sP("jxsi") < majP && sP("jxsi") > 0,
          members: [ { party: "jxsi", type: "government" }, { party: "cup", type: "government" } ] },

        { label: "JxCat minority Government", key: "jxcat_cup",
          cond: sP("cup") > 0 && sP("jxcat") < majP && Q.erc_in_jxcat,
          members: [ { party: "jxcat", type: "government" }, { party: "cup", type: "support" } ] },

        { label: "National Concentration Government", key: "jxcat_cup_gov",
          cond: sP("cup") > 0 && sP("jxcat") < majP && Q.erc_in_jxcat,
          members: [ { party: "jxcat", type: "government" }, { party: "cup", type: "government" } ] },

        { label: "ERC minority Government", key: "erc_min_cup",
          cond: sP("erc") > 40 && sP("erc") < majP,
          members: [ { party: "erc", type: "government" }, { party: "cup", type: "support" } ] },

        { label: "Sovereignty Government", seatsVar: "parlament_coalition_ciu_erc_s",
          members: [ { party: "ciu_alias", type: "government" }, { party: "erc", type: "government" } ] },

        { label: "Sovereignty Government", key: "ciu_erc_cup_sup",
          cond: sP("ciu_alias") >= sP("erc") && sP("cup") > 0 && sP("ciu_alias") + sP("erc") < majP && sP("erc") > 0,
          members: [ { party: "ciu_alias", type: "government" }, { party: "erc", type: "government" },
                     { party: "cup", type: "support" } ] },

        { label: "Sovereignty Government", seatsVar: "parlament_coalition_erc_ciu_s",
          members: [ { party: "erc", type: "government" }, { party: "ciu_alias", type: "government" } ] },

        { label: "Sovereignty Government", key: "erc_ciu_cup_sup",
          cond: sP("erc") > sP("ciu_alias") && sP("cup") > 0 && sP("ciu_alias") + sP("erc") < majP && sP("ciu_alias") > 0,
          members: [ { party: "erc", type: "government" }, { party: "ciu_alias", type: "government" },
                     { party: "cup", type: "support" } ] },

        { label: "Left-Independence Government", key: "erc_cup_gov",
          cond: sP("erc") > 0 && sP("cup") > 0,
          members: [ { party: "erc", type: "government" }, { party: "cup", type: "government" } ] },

        { label: "Soft-Sovereignty Government", key: "ciu_erc_pdcat_sup",
          cond: sP("ciu_alias") >= sP("erc") && sP("pdcat") > 0 && Q.pdcat_split,
          members: [ { party: "ciu_alias", type: "government" }, { party: "erc", type: "government" },
                     { party: "pdcat", type: "support" } ] },

        { label: "New Tripartite", seatsVar: "parlament_coalition_psc_erc_icv_s",
          members: [ { party: "psc", type: "government" }, { party: "erc", type: "government" },
                     { party: "icv_alias", type: "government" } ] },

        { label: "Left Tripartite", seatsVar: "parlament_coalition_erc_psc_icv_s",
          members: [ { party: "erc", type: "government" }, { party: "psc", type: "government" },
                     { party: "icv_alias", type: "government" } ] },

        { label: "Alternative Tripartite", seatsVar: "parlament_coalition_icv_psc_erc_s",
          members: [ { party: "icv_alias", type: "government" }, { party: "psc", type: "government" },
                     { party: "erc", type: "government" } ] },

        { label: "Progressive Government", seatsVar: "parlament_coalition_psc_icv_s",
          members: [ { party: "psc", type: "government" }, { party: "icv_alias", type: "government" } ] },

        { label: "Progressive Government", key: "psc_icv_erc_abst",
          cond: Q.parlament_coalition_psc_icv_erc_abst_available,
          members: [ { party: "psc", type: "government" }, { party: "icv_alias", type: "government" },
                     { party: "erc", type: "abstain" } ] },

        { label: "Republican Government", key: "erc_icv_cup_sup",
          cond: sP("erc") >= sP("icv_alias") && sP("icv_alias") > 0 && sP("cup") > 0,
          members: [ { party: "erc", type: "government" }, { party: "icv_alias", type: "government" },
                     { party: "cup", type: "support" } ] },

        { label: "Popular Unity Coalition", key: "erc_icv_cup_gov",
          cond: sP("erc") > 0 && sP("icv_alias") > 0 && sP("cup") > 0,
          members: [ { party: "erc", type: "government" }, { party: "icv_alias", type: "government" },
                     { party: "cup", type: "government" } ] },

        { label: "New Popular Front", key: "erc_psc_icv_cup_sup",
          cond: sP("erc") > sP("psc") && sP("icv_alias") > 0 && sP("cup") > 0 && sP("psc") > 0 && Q.psc_leader == "Montserrat Tura",
          members: [ { party: "erc", type: "government" }, { party: "psc", type: "government" },
                     { party: "icv_alias", type: "government" }, { party: "cup", type: "support" } ] },

        { label: "Minority Left Tripartite", key: "erc_psc_icv_cup_abst",
          cond: sP("erc") > sP("psc") && sP("icv_alias") > 0 && sP("cup") > 0 && sP("psc") > 0 && (Q.psc_leader == "Montserrat Tura" || Q.psc_leader == "Àngel Ros"),
          members: [ { party: "erc", type: "government" }, { party: "psc", type: "government" },
                     { party: "icv_alias", type: "government" }, { party: "cup", type: "abstain" } ] },

        { label: "PSC-led Moderation Government", key: "psc_cs_mod",
          cond: sP("psc") > sP("cs") && sP("cs") > 0,
          members: [ { party: "psc", type: "government" }, { party: "cs", type: "support" } ] },

        { label: "Moderation Government", key: "cs_psc_unio_mod",
          cond: sP("unio") > 0 && sP("cs") > sP("psc"),
          members: [ { party: "cs", type: "government" }, { party: "psc", type: "support" },
                     { party: "unio", type: "support" } ] },

        { label: "Moderation Government", key: "psc_cs_unio_mod",
          cond: sP("unio") > 0 && sP("psc") > sP("cs"),
          members: [ { party: "psc", type: "government" }, { party: "cs", type: "support" },
                     { party: "unio", type: "support" } ] },

        { label: "Moderation Government", key: "psc_cs_unio_ppc_abst",
          cond: sP("unio") > 0 && sP("psc") > sP("cs"),
          members: [ { party: "psc", type: "government" }, { party: "cs", type: "support" },
                     { party: "unio", type: "support" }, { party: "ppc", type: "abstain" } ] },

        { label: "CiU 2.0 - Back Together", key: "ciu_unio",
          cond: sP("unio") > 0 && Q[Q.parlament_current_ciu + "_roadmap"] == 0 &&
                (Q.parlament_current_ciu == "ciu" || Q.parlament_current_ciu == "cdc" ||
                 Q.parlament_current_ciu == "dl" || Q.parlament_current_ciu == "pdcat" ||
                 Q.parlament_current_ciu == "junts") &&
                sP("ciu_alias") + sP("unio") > 50,
          members: [ { party: "ciu_alias", type: "government" }, { party: "unio", type: "government" } ] },

        { label: "Cs-led Constitutionalist Pact", seatsVar: "parlament_coalition_cs_ppc_s",
          members: [ { party: "cs", type: "government" }, { party: "ppc", type: "support" } ] },

        { label: "Cs-led Unity Pact", key: "cs_ppc_psc_abst",
          cond: sP("cs") > sP("psc") && sP("ppc") > 0 && sP("cs") + sP("ppc") + sP("psc") / 2 < majP,
          members: [ { party: "cs", type: "government" }, { party: "ppc", type: "support" },
                     { party: "psc", type: "abstain" } ] },

        { label: "Cs-led Grand Unity Pact", key: "cs_psc_ppc_sup",
          cond: sP("cs") > sP("psc") && sP("ppc") > 0 && sP("cs") + sP("ppc") + sP("psc") / 2 < majP,
          members: [ { party: "cs", type: "government" }, { party: "psc", type: "support" },
                     { party: "ppc", type: "support" } ] },

        { label: "PSC-led Unity Pact", key: "psc_cs_ppc_abst",
          cond: sP("psc") > sP("cs") && sP("ppc") > 0,
          members: [ { party: "psc", type: "government" }, { party: "cs", type: "support" },
                     { party: "ppc", type: "abstain" } ] },

        { label: "PSC-led Grand Unity Pact", key: "psc_cs_ppc_sup",
          cond: sP("psc") > sP("cs") && sP("ppc") > 0,
          members: [ { party: "psc", type: "government" }, { party: "cs", type: "support" },
                     { party: "ppc", type: "support" } ] },

        { label: "Constitutionalist Government", seatsVar: "parlament_coalition_ppc_cs_s",
          members: [ { party: "ppc", type: "government" }, { party: "cs", type: "government" } ] },

        { label: "Right-Union Coalition", seatsVar: "parlament_coalition_cs_ppc_vox_s",
          members: [ { party: "cs", type: "government" }, { party: "ppc", type: "government" },
                     { party: "vox", type: "support" } ] },

        { label: "Unity Pact", key: "ppc_cs_psc_abst",
          cond: sP("ppc") > sP("cs") && sP("cs") > 0 && sP("cs") + sP("ppc") + sP("psc") / 2 < majP,
          members: [ { party: "cs", type: "government" }, { party: "ppc", type: "government" },
                     { party: "psc", type: "abstain" } ] },

        { label: "Grand Unity Pact", key: "ppc_cs_psc_sup",
          cond: sP("ppc") > sP("cs") && sP("cs") > 0 && sP("cs") + sP("ppc") + sP("psc") < majP,
          members: [ { party: "cs", type: "government" }, { party: "ppc", type: "government" },
                     { party: "psc", type: "support" } ] },

        { label: "Unthinkably Grand Coalition", key: "cs_ppc_psc_vox_abst",
          cond: sP("vox") > 0 && sP("cs") > 0 && sP("psc") > 0 && sP("ppc") > 0 && sP("cs") + sP("ppc") + sP("vox") / 2 + sP("psc") < majP,
          members: [ { party: "cs", type: "government" }, { party: "ppc", type: "government" },
                     { party: "psc", type: "support" }, { party: "vox", type: "abstain" } ] },

        { label: "Unthinkable Unity Pact", key: "cs_ppc_vox_psc_abst",
          cond: sP("vox") > 0 && sP("cs") > 0 && sP("psc") > 0 && sP("ppc") > 0 && sP("cs") + sP("ppc") + sP("vox") + sP("psc") / 2 >= majP,
          members: [ { party: "cs", type: "government" }, { party: "ppc", type: "government" },
                     { party: "vox", type: "support" }, { party: "psc", type: "abstain" } ] },

        { label: "Salvation Government", key: "cs_ppc_vox_psc_sup",
          cond: sP("vox") > 0 && sP("cs") > 0 && sP("psc") > 0 && sP("ppc") > 0 && sP("cs") + sP("ppc") + sP("vox") + sP("psc") >= majP,
          members: [ { party: "cs", type: "government" }, { party: "ppc", type: "government" },
                     { party: "vox", type: "support" }, { party: "psc", type: "support" } ] }
    ];

    if (Q.parlament_coalition_unthinkable_left_s > 0) {
        PARL_BARS.push({
            label: "Unthinkably Grand Coalition",
            seatsVar: "parlament_coalition_unthinkable_left_s",
            members: leftEmergencyMembers
        });
    }
    if (Q.parlament_coalition_cs_emergency_s > 0) {
        PARL_BARS.push({
            label: "Unthinkably Grand Coalition",
            seatsVar: "parlament_coalition_cs_emergency_s",
            members: csEmergencyMembers
        });
    }

    var parlCoalitions = [];
    for (var pbi = 0; pbi < PARL_BARS.length; pbi++) {
        var pb = PARL_BARS[pbi];
        var pbVar = pb.seatsVar;
        if (!pbVar) {
            pbVar = "parlament_coalition_" + pb.key + "_s";
            Q[pbVar] = barSeats(pb.cond, pb.members);
        }
        parlCoalitions.push({ label: pb.label, seatsVar: pbVar, members: pb.members });
    }

    // Political availability drives the repeat-election choice
    var liveCiuRoadmap = +Q[Q.parlament_current_ciu + "_roadmap"] || 0;
    var liveCiuRelations = +Q[Q.parlament_current_ciu + "_relations"] || 0;
    var ciuErcArithmetic = Q.parlament_current_ciu_s + Q.erc_parlament_s >= majP;
    var ciuErcAvailable = ciuErcArithmetic && liveCiuRoadmap != 0 && (
        (Q.player_party == "erc" && liveCiuRelations > 30) ||
        (Q.player_party == "cup" && (liveCiuRelations > 40 || Q.erc_relations > 40 || Q.parlament_current_ciu_s > 40))
    );
    var ciuRightAvailable = Q.parlament_coalition_ciu_ppc_unio_s >= majP && liveCiuRoadmap == 0 && Q.cat_spa_relations > 50;

    var pscTripartiteAvailable = false;
    if (Q.player_party == "erc") {
        pscTripartiteAvailable = Q.parlament_coalition_psc_erc_icv_s >= majP &&
            (Q.psc_relations > 55 || ((Q.psc_leader == "Montserrat Tura" || Q.psc_leader == "Àngel Ros" || Q.party_resources > 1) && Q.psc_relations > 40)) &&
            (Q.parlament_current_icv_relations > 55 || ((comunsLeader == "Arcadi Oliveres" || Q.party_resources > 1) && Q.parlament_current_icv_relations > 40));
    } else {
        pscTripartiteAvailable = Q.parlament_coalition_psc_erc_icv_s >= majP &&
            (Q.erc_roadmap < 1 || Q.erc_relations > 55 || (Q.erc_relations > 40 && Q.party_resources > 1));
    }
    var ercTripartiteAvailable = false;
    if (Q.player_party == "erc") {
        ercTripartiteAvailable = Q.parlament_coalition_erc_psc_icv_s >= majP &&
            (Q.parlament_current_icv_relations > 55 || ((comunsLeader == "Arcadi Oliveres" || Q.party_resources > 1) && Q.parlament_current_icv_relations > 40)) &&
            (Q.psc_relations > 55 || ((Q.psc_leader == "Montserrat Tura" || Q.psc_leader == "Àngel Ros" || Q.party_resources > 1) && Q.psc_relations > 40));
    } else {
        ercTripartiteAvailable = Q.parlament_coalition_erc_psc_icv_s >= majP &&
            (Q.psc_relations >= 55 || (Q.psc_relations > 40 && Q.party_resources >= 1) ||
             (Q.erc_roadmap < 2 && (Q.psc_leader == "Montserrat Tura" || Q.psc_leader == "Àngel Ros")) || Q.erc_roadmap < 1);
    }
    var alternativeTripartiteAvailable = Q.parlament_coalition_icv_psc_erc_s >= majP &&
        Q.psc_relations > 40 && (Q.player_party == "erc" ? Q.parlament_current_icv_relations > 40 : Q.erc_relations > 40);

    var ercCabinetAvailable = ciuErcAvailable || pscTripartiteAvailable || ercTripartiteAvailable ||
        alternativeTripartiteAvailable || Q.parlament_erc_cup_government_available ||
        Q.parlament_popular_unity_available || Q.parlament_new_popular_front_available ||
        Q.parlament_minority_left_tripartite_available || Q.parlament_pdcat_support_available;
    Q.parlament_ai_erc_better_available = ercCabinetAvailable;
    Q.parlament_progressive_erc_abstention_ai_available = Q.erc_roadmap <= 1 &&
        !ercCabinetAvailable && Q.parlament_coalition_psc_icv_erc_abst_available;
    var ercAbstentionAvailable = (
        (Q.player_party == "erc" && Q.parlament_coalition_psc_icv_erc_abst_available && Q.parlament_current_icv_relations > 40 && Q.psc_relations > 40) ||
        (Q.player_party == "cup" && Q.parlament_progressive_erc_abstention_ai_available)
    );

    var emergencyLeftErcAllows = Q.player_party == "erc" || Q.erc_roadmap > 1 ||
        (!ercCabinetAvailable && !Q.parlament_coalition_psc_icv_erc_abst_available);
    Q.parlament_emergency_psc_icv_politically_available = Q.parlament_emergency_psc_icv_available &&
        Q.cat_spa_relations < 40 && comunsEmergencyLeaderOk && emergencyLeftErcAllows;

    var unionistAvailable =
        (Q.parlament_coalition_psc_cs_mod_s > 0 && Q.psc_parlament_s + Q.cs_parlament_s >= majP) ||
        (Q.parlament_coalition_cs_psc_unio_mod_s > 0 && Q.cs_parlament_s + Q.psc_parlament_s + Q.unio_parlament_s >= majP) ||
        (Q.parlament_coalition_psc_cs_unio_mod_s > 0 && Q.psc_parlament_s + Q.cs_parlament_s + Q.unio_parlament_s >= majP) ||
        (Q.parlament_coalition_psc_cs_unio_ppc_abst_s > 0 && Math.floor(Q.psc_parlament_s + Q.cs_parlament_s + Q.unio_parlament_s + Q.ppc_parlament_s / 2) >= majP) ||
        (Q.parlament_coalition_cs_ppc_s > 0 && Q.cs_parlament_s + Q.ppc_parlament_s >= majP) ||
        (Q.parlament_coalition_cs_ppc_psc_abst_s > 0 && Math.floor(Q.cs_parlament_s + Q.ppc_parlament_s + Q.psc_parlament_s / 2) >= majP) ||
        (Q.parlament_coalition_cs_psc_ppc_sup_s > 0 && Q.cs_parlament_s + Q.psc_parlament_s + Q.ppc_parlament_s >= majP) ||
        (Q.parlament_coalition_psc_cs_ppc_abst_s > 0 && Math.floor(Q.psc_parlament_s + Q.cs_parlament_s + Q.ppc_parlament_s / 2) >= majP) ||
        (Q.parlament_coalition_psc_cs_ppc_sup_s > 0 && Q.psc_parlament_s + Q.cs_parlament_s + Q.ppc_parlament_s >= majP) ||
        (Q.parlament_coalition_ppc_cs_s > 0 && Q.ppc_parlament_s + Q.cs_parlament_s >= majP) ||
        (Q.parlament_coalition_cs_ppc_vox_s > 0 && Q.cs_parlament_s + Q.ppc_parlament_s + Q.vox_parlament_s >= majP) ||
        (Q.parlament_coalition_ppc_cs_psc_abst_s > 0 && Math.floor(Q.ppc_parlament_s + Q.cs_parlament_s + Q.psc_parlament_s / 2) >= majP) ||
        (Q.parlament_coalition_ppc_cs_psc_sup_s > 0 && Q.ppc_parlament_s + Q.cs_parlament_s + Q.psc_parlament_s >= majP) ||
        (Q.parlament_coalition_cs_ppc_psc_vox_abst_s > 0 && Math.floor(Q.cs_parlament_s + Q.ppc_parlament_s + Q.psc_parlament_s + Q.vox_parlament_s / 2) >= majP) ||
        (Q.parlament_coalition_cs_ppc_vox_psc_abst_s > 0 && Math.floor(Q.cs_parlament_s + Q.ppc_parlament_s + Q.vox_parlament_s + Q.psc_parlament_s / 2) >= majP) ||
        (Q.parlament_coalition_cs_ppc_vox_psc_sup_s > 0 && Q.cs_parlament_s + Q.ppc_parlament_s + Q.vox_parlament_s + Q.psc_parlament_s >= majP) ||
        Q.parlament_coalition_cs_emergency_s >= majP || Q.parlament_coalition_ciu_unio_s >= majP;

    Q.parlament_coalition_has_working_majority =
        Q.parlament_coalition_majority_s >= majP || ciuErcAvailable || ciuRightAvailable ||
        pscTripartiteAvailable || ercTripartiteAvailable || alternativeTripartiteAvailable ||
        Q.parlament_coalition_psc_icv_s >= majP || ercAbstentionAvailable ||
        Q.parlament_emergency_psc_icv_politically_available || unionistAvailable ||
        Q.parlament_erc_cup_government_available || Q.parlament_erc_cup_support_available ||
        Q.parlament_republican_available || Q.parlament_popular_unity_available ||
        Q.parlament_new_popular_front_available || Q.parlament_minority_left_tripartite_available ||
        Q.parlament_pdcat_support_available;
    Q.parlament_coalition_no_possible_majority = !Q.parlament_coalition_has_working_majority;

    Q.parlament_coalition_config = {
        totalSeats:    135,
        majoritySeats: majP,
        seatsKey:      "{party}_parlament_s",
        partyAliases:  PARL_ALIAS,
        coalitions:    parlCoalitions
    };

!}

= Coalitions and Negotiations

Given the election results, different coalition arithmetics can be imagined. Now might be the time to make a decision on which direction should the government formation negotiations take.

{!<div id="parlament-coalition-widget" data-widget="coalitions" data-props='{"configFrom":"parlament_coalition_config"}'></div>!}

[? if parlament_current_ciu_s > 40 and parlament_coalition_ciu_erc_s > parlament_s_majority : [+ parlament_current_ciu_leader +] is asking for [? if player_party = "erc" : our?][?if player_party != "erc" : ERC's ?] support to form a [+ parlament_current_ciu +] <span class="generalitat-coalition" data-parties="[+ parlament_current_ciu +]" data-summary="Minority government - [+ parlament_current_ciu_s +]/[+ parlament_s_majority +]"><span style="font-style: italic;color: [? if parlament_current_ciu = 'ciu': var(--ciu)?][? if parlament_current_ciu = 'cdc': var(--cdc)?][? if parlament_current_ciu = 'dl': var(--dl)?][? if parlament_current_ciu = 'pdcat': var(--pdcat)?][? if parlament_current_ciu = 'jxcat': var(--jxcat)?][? if parlament_current_ciu = 'junts': var(--junts)?]">minority government</span></span>. [? if player_party = "erc" : Some policy concessions are expected to be negotiated in exchange. There's always the alternative to propose a different arithmetic, but given the results that may hinder our leverage. ?] ?]

