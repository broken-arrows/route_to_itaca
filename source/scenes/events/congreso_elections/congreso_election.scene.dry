title: Congreso Elections - [+ next_spanish_election_month : month +] [+ next_spanish_election_year +]
tags: election
view-if: year = next_spanish_election_year and month = next_spanish_election_month and (week = next_spanish_election_week or not rubicon)
new-page: true
set-bg: img/congreso.jpg
on-arrival: {!
G.reconcileCongresoLineup(Q);
var congreso_size = 0;
for (var constituency of Q.congreso_constituencies) {
    congreso_size += Q.congreso_seats[constituency];
}
Q.congreso_s_majority = Math.floor(congreso_size/2) + 1;
!}
go-to: election_algorithm.esp_congreso
set-jump: congreso_election.post_election
role: event

@post_election
new-page: true
on-arrival: {!
    Q.next_spanish_election_year += 4;
    Q.next_spanish_election_time += 48;

    // Persist the actual playthrough date for chart annotations, once per event.
    if (!Array.isArray(Q.election_history_events)) Q.election_history_events = [];
    var historyDate = new Date(Q.year, Q.month - 1, (Q.week || 1) * 7).toISOString();
    if (!Q.election_history_events.some(function (event) { return event.type === "congreso-election" && event.date === historyDate; })) {
        Q.election_history_events.push({ date: historyDate, type: "congreso-election", label: G.englishText(G.text("Congreso Election")) });
    }
!}
on-display: {!
