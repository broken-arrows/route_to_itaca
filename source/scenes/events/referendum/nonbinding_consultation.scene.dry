title: Catalonia Votes on Independence
subtitle: The non-binding consultation calls millions to the polls
face-image: img/events/9n.jpg
new-page: true
tags: event
view-if: consultation_day_trigger
max-visits: 1
on-arrival: {!
    var ciuParties = ["ciu", "cdc", "dl", "pdcat", "jxcat", "junts"];
    var cooperatingParties = ciuParties.concat("jxsi", "erc", "cup");
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    Q.consultation_preparation = 0;
    for (var ministry of ["health", "education"]) {
        var owner = Q[ministry + "_minister_party"];
        var affiliation = ["jxsi", "jxcat"].includes(owner) && Q[ministry + "_minister_affiliation"];
        var npcPreparation = !ciuParties.includes(affiliation || owner) &&
            !controlledParties.includes(owner) && cooperatingParties.includes(owner) ? 1 : 0;
        // Keep completed work through minister changes and count the allowance at most once.
        Q.consultation_preparation += Math.max(Q["consultation_" + ministry + "_preparations"] || 0, npcPreparation);
    }
    for (var area of ["rb", "interior"]) {
        var holdings = cooperatingParties.reduce(function (total, party) {
            return total + (Q[party + "_local_" + area + "_pct"] || 0);
        }, 0);
        Q.consultation_preparation += holdings >= 50 ? 2 : holdings >= 25 ? 1 : 0;
    }
    if (cooperatingParties.includes(Q.local_barcelona_wp)) Q.consultation_preparation += 2;
    else if (["icv", "csqp", "cecp", "ecp", "bcomu", "comuns"].includes(Q.local_barcelona_wp)) Q.consultation_preparation += 1;
    Q.consultation_happened = true;
    Q.consultation_pending = false;
    Q.roadmap_year = 0;
    if (Q.consultation_preparation >= 4) {
        // Responsibility belongs to the officials who actually held the vote.
        if (!Q.consultation_officials) {
            Q.consultation_officials = ["president", "vicepresident", "education_minister"].map(function (office) {
                return { office: office, name: Q[office], party: Q[office + "_party"],
                    affiliation: Q[office + "_affiliation"] || null, gender: Q[office + "_gender"] };
            });
            Q.consultation_trial_countdown = 18;
            if (!Q.countdowns.includes("consultation_trial")) Q.countdowns.push("consultation_trial");
        }
        this.achieve("calcotada");
        Q.burdens_done += 1;
        Q.consultation_year = Q.year;
        Q.consultation_month = Q.month;
    }
    // Persist the actual playthrough date for chart annotations, once per event.
    if (!Array.isArray(Q.election_history_events)) Q.election_history_events = [];
    var historyDate = new Date(Q.year, Q.month - 1, (Q.week || 1) * 7).toISOString();
    if (Q.consultation_preparation >= 4 && !Q.election_history_events.some(function (event) { return event.type === "consultation" && event.date === historyDate; })) {
        Q.election_history_events.push({ date: historyDate, type: "consultation", label: G.englishText(G.text("Non-binding consultation")) });
    }
!}
go-to: failure if consultation_preparation < 4
role: event

= Participative process of [+ month : month +] [+ year +]


[? if consultation_preparation < 4: Despite all the best efforts of the [+ cat_coalition_disp +], there will be no results to celebrate today. In a mixture of boycott by local authorities, poor planning by different ministries, and a myriad other factors, fact is that too few suitable voting places were secured. In a last-second decision, [? if president_gender = "m": President ?][? if president_gender = "f": Presidenta ?][+ president +] has announced the "indefinite postponement" of the vote, blaming the blocking and lack of understanding of local authorities and the Spanish government. ?]

[? if consultation_preparation < 4: This is, of course, unlikely to convince many, as [? if president_gender = "m": he ?][? if president_gender = "f": she ?] has effectively and nonetheless left volunteers, would-be voters, and basically the totality of the pro-independence movement hanging and deeply disappointed. ?]

[? if consultation_preparation >= 4: Today, all Catalan residents 16 and over have been called to vote on the non-binding consulation on the political future of Catalonia. Participation is not easy to predict as, following the ruling of the Constitutional Court against the law allowing this consultation, PP[? if vox_parlament_s > 0: , Cs, and Vox?] [? if not vox_parlament_s > 0: and Cs ?]have announced a complete boicot of the consultation. [? if psc_leader == "Àngel Ros" or psc_leader == "Montserrat Tura": The PSC, while not thrilled by the idea of this consultation without an agreement, is at least somewhat supporting.?][? if not (psc_leader == "Àngel Ros" or psc_leader == "Montserrat Tura"): The PSC is not thrilled by the idea of this consultation without an agreement and has taken an ambivalent position, neither boicotting nor openly calling for participating in it, in yet another impossible balancing act.?] [? if icv_parlament_s > 0: ICV-EUiA?][? if csqp_parlament_s > 0: CSQP?][? if cecp_parlament_s > 0: CECP?][? if ecp_parlament_s > 0: ECP?] is calling their voters to make their voice heard[? if consultation_question = 2: , while officially supporting a vote for the Yes/No option?]. All pro-independence party naturally are enthusiastic about seeing the results.?]

- @failure
- @direct
- @double
- @convoluted


@direct
title: Do you want Catalonia to become an independent state in the form of a republic?
view-if: consultation_preparation >= 4 and consultation_question = 1
on-arrival: {!
    Q.consultation_yes = 0;
    Q.consultation_abst = 0;
    Q.consultation_no = 0;

    for (var constituency of Q.parlament_constituencies) {
        for (var demo of Q.parlament_demographics) {
            Q.consultation_yes += (Q["ciu_parlament_" + constituency + "_" + demo + "_support"] * 0.9 + Q["cdc_parlament_" + constituency + "_" + demo + "_support"] + Q["dl_parlament_" + constituency + "_" + demo + "_support"] + Q["pdcat_parlament_" + constituency + "_" + demo + "_support"] + Q["jxcat_parlament_" + constituency + "_" + demo + "_support"] + Q["junts_parlament_" + constituency + "_" + demo + "_support"] + Q["jxsi_parlament_" + constituency + "_" + demo + "_support"] + Q["erc_parlament_" + constituency + "_" + demo + "_support"] + Q["cup_parlament_" + constituency + "_" + demo + "_support"] + Q["fnc_parlament_" + constituency + "_" + demo + "_support"] + (Q["icv_parlament_" + constituency + "_" + demo + "_support"] + Q["csqp_parlament_" + constituency + "_" + demo + "_support"]) * 0.4 + Q["cecp_parlament_" + constituency + "_" + demo + "_support"] * 0.1) * Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
            Q.consultation_no += (Q["ciu_parlament_" + constituency + "_" + demo + "_support"] * 0.1 + Q["unio_parlament_" + constituency + "_" + demo + "_support"] + (Q["icv_parlament_" + constituency + "_" + demo + "_support"] + Q["csqp_parlament_" + constituency + "_" + demo + "_support"]) * 0.4 + Q["cecp_parlament_" + constituency + "_" + demo + "_support"] * 0.6) * Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
            Q.consultation_abst += ((Q["icv_parlament_" + constituency + "_" + demo + "_support"] + Q["csqp_parlament_" + constituency + "_" + demo + "_support"]) * 0.2 +  Q["cecp_parlament_" + constituency + "_" + demo + "_support"] * 0.3 +  Q["ppc_parlament_" + constituency + "_" + demo + "_support"] + Q["cs_parlament_" + constituency + "_" + demo + "_support"] + Q["vox_parlament_" + constituency + "_" + demo + "_support"] + Q["abstain_parlament_" + constituency + "_" + demo + "_support"]) * Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
            switch (Q.psc_leader) {
                case "Àngel Ros":
                    Q.consultation_abst += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.4)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_no += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.4)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_yes += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.2)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    break;
                case "Montserrat Tura":
                    Q.consultation_abst += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.3)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_no += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.4)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_yes += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.3)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    break;
                default:
                    Q.consultation_abst += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.85)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_no += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.1)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_yes += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.05)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    break;
            }            
        }
    }
    Q.consultation_yes = Math.ceil(Q.consultation_yes);
    Q.consultation_abst = Math.ceil(Q.consultation_abst);
    Q.consultation_no = Math.ceil(Q.consultation_no);

    if (Q.consultation_preparation < 6) {
        for (var option of ["yes", "no"]) {
            var ballots = Q["consultation_" + option];
            Q["consultation_" + option] = Math.floor(ballots * 0.8);
            Q.consultation_abst += ballots - Q["consultation_" + option];
        }
    }

    Q.consultation_total_votes = Q.consultation_no + Q.consultation_yes;
    Q.consultation_participation_pc = Math.round((Q.consultation_total_votes/ (Q.consultation_total_votes + Q.consultation_abst)) * 1000) / 10;
    Q.consultation_yes_pc = Math.round((Q.consultation_yes / Q.consultation_total_votes) * 1000) / 10;
    Q.consultation_no_pc = Math.round((Q.consultation_no / Q.consultation_total_votes) * 1000) / 10;

    // Add thousands notation
    Q.consultation_yes = Q.consultation_yes.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    Q.consultation_no = Q.consultation_no.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
!}

**Do you want Catalonia to become an independent state in the form of a republic?**

{!<div data-widget="result-bars" data-props='{"rows":[{"label":"YES","shareFrom":"consultation_yes_pc","valueFrom":"consultation_yes","colour":"#008000"},{"label":"NO","shareFrom":"consultation_no_pc","valueFrom":"consultation_no","colour":"#c30000"},{"label":"Turnout","shareFrom":"consultation_participation_pc","colour":"#696969"}]}'></div>!}

- @after
- @troubled
- @after_no

@double
title: Do you want Catalonia to become a state? In case of affirmative answer, do you want this state to become independent?
view-if: consultation_preparation >= 4 and consultation_question = 2
on-arrival: {!
    Q.consultation_yes = 0;
    Q.consultation_yesno = 0;
    Q.consultation_abst = 0;
    Q.consultation_no = 0;

    for (var constituency of Q.parlament_constituencies) {
        for (var demo of Q.parlament_demographics) {
            Q.consultation_yes += (Q["ciu_parlament_" + constituency + "_" + demo + "_support"] * 0.9 + Q["cdc_parlament_" + constituency + "_" + demo + "_support"] + Q["dl_parlament_" + constituency + "_" + demo + "_support"] + Q["pdcat_parlament_" + constituency + "_" + demo + "_support"] + Q["jxcat_parlament_" + constituency + "_" + demo + "_support"] + Q["junts_parlament_" + constituency + "_" + demo + "_support"] + Q["jxsi_parlament_" + constituency + "_" + demo + "_support"] + Q["erc_parlament_" + constituency + "_" + demo + "_support"] + Q["cup_parlament_" + constituency + "_" + demo + "_support"] + Q["fnc_parlament_" + constituency + "_" + demo + "_support"] + (Q["icv_parlament_" + constituency + "_" + demo + "_support"] + Q["csqp_parlament_" + constituency + "_" + demo + "_support"]) * 0.4 + Q["cecp_parlament_" + constituency + "_" + demo + "_support"] * 0.1) * Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
            Q.consultation_yesno += (Q["ciu_parlament_" + constituency + "_" + demo + "_support"] * 0.1 + Q["unio_parlament_" + constituency + "_" + demo + "_support"] + (Q["icv_parlament_" + constituency + "_" + demo + "_support"] + Q["csqp_parlament_" + constituency + "_" + demo + "_support"]) * 0.4 + Q["cecp_parlament_" + constituency + "_" + demo + "_support"] * 0.6) * Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
            Q.consultation_no += ((Q["icv_parlament_" + constituency + "_" + demo + "_support"] + Q["csqp_parlament_" + constituency + "_" + demo + "_support"]) * 0.1 + Q["cecp_parlament_" + constituency + "_" + demo + "_support"] * 0.1) * Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
            Q.consultation_abst += ((Q["icv_parlament_" + constituency + "_" + demo + "_support"] + Q["csqp_parlament_" + constituency + "_" + demo + "_support"]) * 0.1 + Q["cecp_parlament_" + constituency + "_" + demo + "_support"] * 0.2 +  Q["ppc_parlament_" + constituency + "_" + demo + "_support"] + Q["cs_parlament_" + constituency + "_" + demo + "_support"] + Q["vox_parlament_" + constituency + "_" + demo + "_support"] + Q["abstain_parlament_" + constituency + "_" + demo + "_support"]) * Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
            switch (Q.psc_leader) {
                case "Àngel Ros":
                    Q.consultation_abst += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.4)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_no += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.2)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_yesno += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.2)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_yes += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.2)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    break;
                case "Montserrat Tura":
                    Q.consultation_abst += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.3)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_no += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.1)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_yesno += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.3)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_yes += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.3)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    break;
                default:
                    Q.consultation_abst += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.75)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_no += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.1)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_yesno += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.1)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    Q.consultation_yes += (Q["psc_parlament_" + constituency + "_" + demo + "_support"] * 0.05)* Q["parlament_" + constituency + "_" + demo + "_pop"]/100;
                    break;
            }
        }
    }
    
    Q.consultation_yes = Math.ceil(Q.consultation_yes);
    Q.consultation_yesno = Math.ceil(Q.consultation_yesno);
    Q.consultation_abst = Math.ceil(Q.consultation_abst);
    Q.consultation_no = Math.ceil(Q.consultation_no);

    if (Q.consultation_preparation < 6) {
        for (var option of ["yes", "yesno", "no"]) {
            var ballots = Q["consultation_" + option];
            Q["consultation_" + option] = Math.floor(ballots * 0.8);
            Q.consultation_abst += ballots - Q["consultation_" + option];
        }
    }

    Q.consultation_total_votes = Q.consultation_no + Q.consultation_yes + Q.consultation_yesno;
    Q.consultation_participation_pc = Math.round((Q.consultation_total_votes/ (Q.consultation_total_votes + Q.consultation_abst)) * 1000) / 10;
    Q.consultation_yes_pc = Math.round((Q.consultation_yes / Q.consultation_total_votes) * 1000) / 10;
    Q.consultation_yesno_pc = Math.round((Q.consultation_yesno / Q.consultation_total_votes) * 1000) / 10;
    Q.consultation_no_pc = Math.round((Q.consultation_no / Q.consultation_total_votes) * 1000) / 10;

    // Add thousands notation
    Q.consultation_yes = Q.consultation_yes.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    Q.consultation_yesno = Q.consultation_yesno.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    Q.consultation_no = Q.consultation_no.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
!}

**Do you want Catalonia to become a state?**

**In case of affirmative answer, do you want this state to become independent?**

