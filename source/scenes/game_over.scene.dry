title: Game Over
new-page: true
set-bg: img/3rd_October_2017.jpg
go-to: eg_menu
on-arrival: {!
    this.achieve('game_completed');

    if (Q.psoe_barons_revolted && !Q.psoe_sanchez_president_ever) {
      this.achieve('barones')
    }
    if (!Q.ni_un_paper_failed) {
      // TODO: Actual way for this to fail
      this.achieve("ni_un_paper");
    }
!}

= End

@eg_menu

- #endings
- @end_game: End game.

@end_temp
title: WIP ending cards
view-if: not end_temp_seen
on-arrival: end_temp_seen = 1
tags: endings
go-to: eg_menu
role: ending

Thanks for playing around! Ending cards are wip!

@achievements_this_playthrough
title: Playthrough Achievements
view-if: achievement_game_completed == 1 and not achievements_this_playthrough_seen
on-arrival: achievements_this_playthrough_seen = 1
tags: endings
go-to: eg_menu
role: ending

