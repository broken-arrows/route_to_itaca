title: Communications
new-page: true
view-if: erc_media_timer <= 0 and player_party = "erc"
on-arrival: erc_media_timer += 6; month_actions += 1 if not erc_advisor_action or difficulty >= 0
card-image: img/erc/media.jpg
face-image: img/erc/media.jpg
tags: erc_party jxsi_party jxcat_party
role: card-party

= Communications and Media

What should be our strategy for all our party media and communication efforts?

- @donations
- @campaign
- @ideological
- @social_media_1
- @social_media_2
- @social_media_3
- @social_media_4
- @unofficial
- @root: We do not need to touch anything communications-related at the moment.
- view-if: not last_advisor_action
- @easy_discard
- @cancel_advisor_action

@donations
title: We could use a fundraising campaign.
subtitle: This may have mixed effects depending on the public, but it would certainly help with our finances.
on-arrival: {!
    var target = "erc";
    var targetCongreso = "erc";
    var targetLocal = "erc";
    if (Q.erc_in_jxsi) {
        target = "jxsi";
        if (Q.jxsi_in_congreso) {
            targetCongreso = "jxsi";
        }
        if (Q.jxsi_in_local) {
            targetLocal = "jxsi";
        }
    } else if (Q.erc_in_jxcat) {
        target = "jxcat";
        if (Q.jxcat_in_congreso) {
            targetCongreso = "jxcat";
        }
        if (Q.jxcat_in_local) {
            targetLocal = "jxcat";
        }
    }

    Q.party_resources += 1;
    Q.erc_left_dissent += 10;
    Q.erc_core_dissent += 10;
    var mediaEfficiency = Math.max(0, Math.min(1, 1 - Q.erc_dissent / 100));
    for (var c of Q.parlament_constituencies) {
        for (var d of ["unemployed", "ind"]) {
            G.cardSupportTransfer(Q, { contest: "parlament", to: "abstain", from: target, amount: 0.3, maxDonorFraction: 0.5, constituencies: [c], demographics: [d] });
            G.cardSupportTransfer(Q, { contest: "parlament", to: "federal_left", from: target, amount: 0.2, maxDonorFraction: 0.5, constituencies: [c], demographics: [d] });
        }
        var middleGain = (c == "tarragona" ? 0.7 : 1.0) * mediaEfficiency;
        G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "ciu", amount: middleGain * 0.6, maxDonorFraction: 0.5, constituencies: [c], demographics: ["middle"] });
        G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "psc", amount: middleGain * 0.2, maxDonorFraction: 0.5, constituencies: [c], demographics: ["middle"] });
        G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: middleGain * 0.2, maxDonorFraction: 0.5, constituencies: [c], demographics: ["middle"] });
        G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "ciu", amount: 0.25 * mediaEfficiency, maxDonorFraction: 0.5, constituencies: [c], demographics: ["buss"] });
        G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "psc", amount: 0.15 * mediaEfficiency, maxDonorFraction: 0.5, constituencies: [c], demographics: ["buss"] });
    }
    G.cardSupportTransfer(Q, { contest: "congreso", to: "abstain", from: targetCongreso, amount: 0.15, maxDonorFraction: 0.5, constituencies: ["catalunya"] });
    G.cardSupportTransfer(Q, { contest: "congreso", to: targetCongreso, from: "ciu", amount: 0.2 * mediaEfficiency, maxDonorFraction: 0.5, constituencies: ["catalunya"] });
    G.cardSupportTransfer(Q, { contest: "barcelona", to: "bcomu", from: targetLocal, amount: 0.1, maxDonorFraction: 0.5 });
    G.cardSupportTransfer(Q, { contest: "barcelona", to: targetLocal, from: "ciu", amount: 0.15 * mediaEfficiency, maxDonorFraction: 0.5 });
    G.cardSupportTransfer(Q, { contest: "barcelona", to: targetLocal, from: "psc", amount: 0.15 * mediaEfficiency, maxDonorFraction: 0.5 });
!}

We are definitely bringing more funds, but the Left faction and the Republican Core are not specially happy about using this strategy. 

@campaign
title: The purpose of party media is to get more ERC seats.
subtitle: Party media will focus on the electoral campaigning.
on-arrival: {!
    var target = "erc";
    var targetCongreso = "erc";
    var targetLocal = "erc";
    if (Q.erc_in_jxsi) {
        target = "jxsi";
        if (Q.jxsi_in_congreso) {
            targetCongreso = "jxsi";
        }
        if (Q.jxsi_in_local) {
            targetLocal = "jxsi";
        }
    } else if (Q.erc_in_jxcat) {
        target = "jxcat";
        if (Q.jxcat_in_congreso) {
            targetCongreso = "jxcat";
        }
        if (Q.jxcat_in_local) {
            targetLocal = "jxcat";
        }
    }

    Q.erc_campaign_media += 1;
    var campaignEfficiency = Math.max(0, Math.min(1, 1 - Q.erc_dissent / 100));
    if (Q.broken_roadmap) campaignEfficiency *= 0.3;
    for (var c of ["girona", "lleida", "tarragona"]) {
        for (var d of ["middle", "buss", "rural"]) {
            G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "ciu", amount: 0.45 * campaignEfficiency, maxDonorFraction: 0.5, constituencies: [c], demographics: [d] });
            G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: 0.15 * campaignEfficiency, maxDonorFraction: 0.5, constituencies: [c], demographics: [d] });
            G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "psc", amount: 0.1 * campaignEfficiency, maxDonorFraction: 0.5, constituencies: [c], demographics: [d] });
        }
        for (var d of ["ind", "young"]) {
            G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "ciu", amount: 0.2 * campaignEfficiency, maxDonorFraction: 0.5, constituencies: [c], demographics: [d] });
            G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: 0.15 * campaignEfficiency, maxDonorFraction: 0.5, constituencies: [c], demographics: [d] });
        }
    }
    G.cardSupportTransfer(Q, { contest: "congreso", to: targetCongreso, from: "ciu", amount: 0.3 * campaignEfficiency, maxDonorFraction: 0.5, constituencies: ["catalunya"] });
    G.cardSupportTransfer(Q, { contest: "congreso", to: targetCongreso, from: "abstain", amount: 0.15 * campaignEfficiency, maxDonorFraction: 0.5, constituencies: ["catalunya"] });
    G.cardSupportTransfer(Q, { contest: "congreso", to: targetCongreso, from: "psoe", amount: 0.1 * campaignEfficiency, maxDonorFraction: 0.5, constituencies: ["catalunya"] });
    Q.erc_interior_mod = Q.erc_interior_mod + 0.5 * campaignEfficiency;
!}

This strategy mostly reaches our traditional voter strongholds outside urban Barcelona, who are already familiar with our party's message. Hopefully someone new has been reached as well. 

@ideological
title: Our media should display the diversity of views within the party.
subtitle: There will be debate and discussion spaces for all factions to express themselves.
on-arrival: erc_left_dissent -=6; erc_core_dissent -=6; erc_civic_dissent -=6; erc_pragmatic_dissent -=6;

This represents a deviation of what our party media has been doing in the last few decades, but it does help in calming some intra-party tensions.

@social_media_1
title: We need to modernize our media presence, let's get into this social media thing!
subtitle: [? if not erc_advisor_action: \[-2 resources\] ?]
choose-if: (erc_advisor_action or party_resources >= 2)
unavailable-subtitle: Not enough resources
view-if: social_media = 0
on-arrival: {!
    var target = "erc";
    var targetCongreso = "erc";
    var targetLocal = "erc";
    if (Q.erc_in_jxsi) {
        target = "jxsi";
        if (Q.jxsi_in_congreso) {
            targetCongreso = "jxsi";
        }
        if (Q.jxsi_in_local) {
            targetLocal = "jxsi";
        }
    } else if (Q.erc_in_jxcat) {
        target = "jxcat";
        if (Q.jxcat_in_congreso) {
            targetCongreso = "jxcat";
        }
        if (Q.jxcat_in_local) {
            targetLocal = "jxcat";
        }
    }

    if (!Q.erc_advisor_action) Q.party_resources -= 2;
    Q.social_media = 1;
    Q.erc_pragmatic_dissent += 10;
    Q.erc_core_dissent += 5;
    var socialEfficiency = Math.max(0, Math.min(1, 1 - Q.erc_dissent / 100));
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: 0.2 * socialEfficiency, maxDonorFraction: 0.5, constituencies: "all", demographics: ["young"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "federal_left", amount: 0.15 * socialEfficiency, maxDonorFraction: 0.5, constituencies: "all", demographics: ["young"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "psc", amount: 0.4 * socialEfficiency, maxDonorFraction: 0.5, constituencies: "all", demographics: ["middle"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "federal_left", amount: 0.3 * socialEfficiency, maxDonorFraction: 0.5, constituencies: "all", demographics: ["middle"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: 0.3 * socialEfficiency, maxDonorFraction: 0.5, constituencies: "all", demographics: ["middle"] });
    G.cardSupportTransfer(Q, { contest: "congreso", to: targetCongreso, from: "abstain", amount: 0.2 * socialEfficiency, maxDonorFraction: 0.5, constituencies: ["catalunya"] });
    G.cardSupportTransfer(Q, { contest: "barcelona", to: targetLocal, from: "bcomu", amount: 0.15 * socialEfficiency, maxDonorFraction: 0.5 });
    G.cardSupportTransfer(Q, { contest: "barcelona", to: targetLocal, from: "psc", amount: 0.15 * socialEfficiency, maxDonorFraction: 0.5 });
!}

Our newly expanded social media presence is reaching new and specially younger audiences, but we're still not particularly good at it. It's unclear how much of an electoral effect this has, which does not please some of our more pragmatically-minded and core members.

@social_media_2
title: Our social media presence is still raw, we need to put some more effort into it.
subtitle:  [? if not erc_advisor_action: \[-1 resources\] ?]
choose-if: (erc_advisor_action or party_resources >= 1)
unavailable-subtitle: Not enough resources
view-if: social_media = 1
on-arrival: {!
    var target = "erc";
    var targetCongreso = "erc";
    var targetLocal = "erc";
    if (Q.erc_in_jxsi) {
        target = "jxsi";
        if (Q.jxsi_in_congreso) {
            targetCongreso = "jxsi";
        }
        if (Q.jxsi_in_local) {
            targetLocal = "jxsi";
        }
    } else if (Q.erc_in_jxcat) {
        target = "jxcat";
        if (Q.jxcat_in_congreso) {
            targetCongreso = "jxcat";
        }
        if (Q.jxcat_in_local) {
            targetLocal = "jxcat";
        }
    }

    if (!Q.erc_advisor_action) Q.party_resources -= 1;
    Q.social_media = 2;
    var socialEfficiency = Math.max(0, Math.min(1, 1 - Q.erc_dissent / 100));
    var youngReach = (0.6 + 0.3 * Q.gabriel_rufian_advisor) * socialEfficiency;
    var middleReach = (0.5 + 0.2 * Q.sergi_sabria_advisor) * socialEfficiency;
    var indyCredibility = Q.broken_roadmap ? 0.25 : 1;
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: youngReach * 0.6, maxDonorFraction: 0.5, constituencies: "all", demographics: ["young"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "federal_left", amount: youngReach * 0.4, maxDonorFraction: 0.5, constituencies: "all", demographics: ["young"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "psc", amount: middleReach * 0.5, maxDonorFraction: 0.5, constituencies: "all", demographics: ["middle"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "federal_left", amount: middleReach * 0.3, maxDonorFraction: 0.5, constituencies: "all", demographics: ["middle"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: middleReach * 0.2, maxDonorFraction: 0.5, constituencies: "all", demographics: ["middle"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "ciu", amount: 0.35 * socialEfficiency * indyCredibility, maxDonorFraction: 0.5, constituencies: "all", demographics: ["ind"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: 0.25 * socialEfficiency * indyCredibility, maxDonorFraction: 0.5, constituencies: "all", demographics: ["ind"] });
    G.cardSupportTransfer(Q, { contest: "congreso", to: targetCongreso, from: "abstain", amount: 0.3 * socialEfficiency, maxDonorFraction: 0.5, constituencies: ["catalunya"] });
    G.cardSupportTransfer(Q, { contest: "congreso", to: targetCongreso, from: "federal_left", amount: 0.15 * socialEfficiency, maxDonorFraction: 0.5, constituencies: ["catalunya"] });
    G.cardSupportTransfer(Q, { contest: "barcelona", to: targetLocal, from: "bcomu", amount: 0.25 * socialEfficiency, maxDonorFraction: 0.5 });
    G.cardSupportTransfer(Q, { contest: "barcelona", to: targetLocal, from: "psc", amount: 0.2 * socialEfficiency, maxDonorFraction: 0.5 });
!}

We're getting better at this thing. Our local ERC branches are playing the Twitter game, while targeted ads on Instagram and Facebook are reaching a wider and more diverse audience than even imagined.

@social_media_3
title: Our social media could still use some love and a more modern approach.
subtitle: We are playing the right game, but we're far from being the best at it.
view-if: social_media = 2 and year >= 2015
on-arrival: {!
    var target = "erc";
    var targetCongreso = "erc";
    var targetLocal = "erc";
    if (Q.erc_in_jxsi) {
        target = "jxsi";
        if (Q.jxsi_in_congreso) {
            targetCongreso = "jxsi";
        }
        if (Q.jxsi_in_local) {
            targetLocal = "jxsi";
        }
    } else if (Q.erc_in_jxcat) {
        target = "jxcat";
        if (Q.jxcat_in_congreso) {
            targetCongreso = "jxcat";
        }
        if (Q.jxcat_in_local) {
            targetLocal = "jxcat";
        }
    }

    Q.social_media = 3;
    var socialEfficiency = Math.max(0, Math.min(1, 1 - Q.erc_dissent / 100));
    var youngReach = (1.4 + 0.3 * Q.gabriel_rufian_advisor) * socialEfficiency;
    var middleReach = (0.8 + 0.2 * Q.sergi_sabria_advisor) * socialEfficiency;
    var indyCredibility = Q.broken_roadmap ? 0.25 : 1;
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: youngReach * 0.55, maxDonorFraction: 0.5, constituencies: "all", demographics: ["young"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "federal_left", amount: youngReach * 0.3, maxDonorFraction: 0.5, constituencies: "all", demographics: ["young"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "psc", amount: youngReach * 0.15, maxDonorFraction: 0.5, constituencies: "all", demographics: ["young"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "psc", amount: middleReach * 0.45, maxDonorFraction: 0.5, constituencies: "all", demographics: ["middle"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "federal_left", amount: middleReach * 0.3, maxDonorFraction: 0.5, constituencies: "all", demographics: ["middle"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: middleReach * 0.25, maxDonorFraction: 0.5, constituencies: "all", demographics: ["middle"] });
    for (var c of Q.parlament_constituencies) {
        var indyReach = (c == "girona" || c == "lleida" ? 1.0 : 0.65) * socialEfficiency * indyCredibility;
        G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "ciu", amount: indyReach * 0.6, maxDonorFraction: 0.5, constituencies: [c], demographics: ["ind"] });
        G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: indyReach * 0.4, maxDonorFraction: 0.5, constituencies: [c], demographics: ["ind"] });
    }
    // A mature presence helps the nearby ecosystem, but all gains still have a source.
    var relevant_demos = ["young", "middle", "ind"];
    var cupEcosystem = 0.2 * Math.max(0, Math.min(1, Q.cup_relations / 100));
    var ciuEcosystem = 0.15 * Math.max(0, Math.min(1, (Number(Q[Q.parlament_current_ciu + "_relations"]) || 0) / 100));
    var leftEcosystem = 0.2 * Math.max(0, Math.min(1, (Number(Q[Q.parlament_current_icv + "_relations"]) || 0) / 100));
    if (!Q.cup_in_jxsi && !Q.cup_in_jxcat) G.cardSupportTransfer(Q, { contest: "parlament", to: "cup", from: "abstain", amount: cupEcosystem, maxDonorFraction: 0.5, constituencies: "all", demographics: relevant_demos });
    if (!Q.erc_in_jxsi && !Q.erc_in_jxcat) G.cardSupportTransfer(Q, { contest: "parlament", to: "ciu", from: "abstain", amount: ciuEcosystem, maxDonorFraction: 0.5, constituencies: "all", demographics: relevant_demos });
    G.cardSupportTransfer(Q, { contest: "parlament", to: "federal_left", from: "abstain", amount: leftEcosystem, maxDonorFraction: 0.5, constituencies: "all", demographics: relevant_demos });

    G.cardSupportTransfer(Q, { contest: "congreso", to: targetCongreso, from: "abstain", amount: 0.45 * socialEfficiency, maxDonorFraction: 0.5, constituencies: ["catalunya"] });
    G.cardSupportTransfer(Q, { contest: "congreso", to: targetCongreso, from: "federal_left", amount: 0.2 * socialEfficiency, maxDonorFraction: 0.5, constituencies: ["catalunya"] });
    G.cardSupportTransfer(Q, { contest: "barcelona", to: targetLocal, from: "bcomu", amount: 0.35 * socialEfficiency, maxDonorFraction: 0.5 });
    G.cardSupportTransfer(Q, { contest: "barcelona", to: targetLocal, from: "psc", amount: 0.25 * socialEfficiency, maxDonorFraction: 0.5 });
!}

Our social media is now a fully integrated and essential part of our communication strategy. Stories, lives, and all sorts of content are buzzing every day, and it seems that is benefiting not only us, but in general the whole pro-independence and left-wing ecosystem. 

@social_media_4
title: What are the latest social media trends? We need to be on top of them.
subtitle: [? if not erc_advisor_action: \[-1 resources\] ?]
choose-if: (erc_advisor_action or party_resources >= 1)
unavailable-subtitle: Not enough resources
view-if: social_media >= 3 and year >= 2016
on-arrival: {!
    var target = "erc";
    var targetCongreso = "erc";
    var targetLocal = "erc";
    if (Q.erc_in_jxsi) {
        target = "jxsi";
        if (Q.jxsi_in_congreso) {
            targetCongreso = "jxsi";
        }
        if (Q.jxsi_in_local) {
            targetLocal = "jxsi";
        }
    } else if (Q.erc_in_jxcat) {
        target = "jxcat";
        if (Q.jxcat_in_congreso) {
            targetCongreso = "jxcat";
        }
        if (Q.jxcat_in_local) {
            targetLocal = "jxcat";
        }
    }

    if (!Q.erc_advisor_action) Q.party_resources -= 1; 
    Q.social_media = 4;
    var socialEfficiency = Math.max(0, Math.min(1, 1 - Q.erc_dissent / 100));
    var repeatedReach = 0.35 * socialEfficiency;
    var indyCredibility = Q.broken_roadmap ? 0.25 : 1;
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: repeatedReach, maxDonorFraction: 0.5, constituencies: "all", demographics: ["young"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "federal_left", amount: repeatedReach * 0.5, maxDonorFraction: 0.5, constituencies: "all", demographics: ["young"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "psc", amount: repeatedReach * 0.5, maxDonorFraction: 0.5, constituencies: "all", demographics: ["middle"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: repeatedReach * 0.5, maxDonorFraction: 0.5, constituencies: "all", demographics: ["middle"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "ciu", amount: repeatedReach * indyCredibility, maxDonorFraction: 0.5, constituencies: "all", demographics: ["ind"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: target, from: "abstain", amount: repeatedReach * 0.5 * indyCredibility, maxDonorFraction: 0.5, constituencies: "all", demographics: ["ind"] });
    var ecosystemReach = 0.05;
    if (!Q.cup_in_jxsi && !Q.cup_in_jxcat) G.cardSupportTransfer(Q, { contest: "parlament", to: "cup", from: "abstain", amount: ecosystemReach * Math.max(0, Math.min(1, Q.cup_relations / 100)), maxDonorFraction: 0.5, constituencies: "all", demographics: ["young", "middle", "ind"] });
    G.cardSupportTransfer(Q, { contest: "parlament", to: "federal_left", from: "abstain", amount: ecosystemReach * Math.max(0, Math.min(1, (Number(Q[Q.parlament_current_icv + "_relations"]) || 0) / 100)), maxDonorFraction: 0.5, constituencies: "all", demographics: ["young", "middle", "ind"] });
    G.cardSupportTransfer(Q, { contest: "congreso", to: targetCongreso, from: "abstain", amount: 0.15 * socialEfficiency, maxDonorFraction: 0.5, constituencies: ["catalunya"] });
    G.cardSupportTransfer(Q, { contest: "barcelona", to: targetLocal, from: "bcomu", amount: 0.1 * socialEfficiency, maxDonorFraction: 0.5 });
    G.cardSupportTransfer(Q, { contest: "barcelona", to: targetLocal, from: "psc", amount: 0.1 * socialEfficiency, maxDonorFraction: 0.5 });
!}

Continuing to invest in social media ensures we stay relevant and keep up with the fast-paced landscape of online communication. It is, however, harder to stand out as what we're doing is starting to become what's expected.

@unofficial
title: Commission an unofficial PR campaign
subtitle: This may have unintended consequences. [? if not erc_advisor_action: \[-1 resources\] ?]
view-if: sergi_sabria_advisor
choose-if: not erc_bside_pending and (erc_advisor_action or party_resources >= 1)
unavailable-subtitle: [? if erc_bside_pending: Another unofficial campaign is still unfolding. ?][? if party_resources < 1: Not enough resources. ?]

Sergi Sabrià has been architecting the necessary network within the party's organizations to carry out... *less glamurous* campaigns that ultimately should generate some sympathy for our party. What should be their focus?

- @bside_barcelona: Local elections
- @bside_parlament: Parlament elections
- @bside_congreso: Congreso elections
- @cancel_advisor_action

@bside_barcelona
on-arrival: erc_bside_contest = "barcelona"
go-to: bside_method

@bside_parlament
on-arrival: erc_bside_contest = "parlament"
go-to: bside_method

@bside_congreso
on-arrival: erc_bside_contest = "congreso"
go-to: bside_method

@bside_method

What should this unofficial work towards?

- @bside_attack_left
- @bside_attack_national
- @bside_provocation
- @cancel_advisor_action

@bside_attack_left
title: Launch an unbranded attack targetting [+ parlament_current_icv +]
view-if: {! return !!Q.sergi_sabria_advisor && !Q.erc_bside_pending && ["barcelona","parlament","congreso"].includes(Q.erc_bside_contest); !}
choose-if: sergi_sabria_advisor and not erc_bside_pending and (erc_bside_contest = "barcelona" or erc_bside_contest = "parlament" or erc_bside_contest = "congreso") and (erc_advisor_action or party_resources >= 1)
unavailable-subtitle: Not enough resources.
subtitle: [? if not erc_advisor_action: \[-1 resources\] ?]
on-arrival: {!
    if (!Q.erc_advisor_action) Q.party_resources -= 1;
    
    var contest = Q.erc_bside_contest;
    var target = "federal_left";
    var success = G.random(Q) < 0.6;
    Q.erc_bside_pending = {months:2, exposed:G.random(Q) < 0.25, provocation:false, contest:contest};
    if (success) {
        var transfer = {contest:contest, to:"erc", from:target, amount:0.6, maxDonorFraction:0.5};
        if (contest === "parlament") {
            transfer.constituencies = "all";
            transfer.demographics = ["young", "middle", "ind"];
        } else if (contest === "congreso") {
            transfer.constituencies = ["catalunya"];
        }
        G.cardSupportTransfer(Q, transfer);
        transfer.to = contest === "barcelona" ? "psc" : "abstain";
        transfer.amount = 0.4;
        G.cardSupportTransfer(Q, transfer);
    }
    Q.erc_bside_contest = null;
!}

