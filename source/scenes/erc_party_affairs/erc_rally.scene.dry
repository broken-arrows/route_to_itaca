title: Political Rally
new-page: true
is-card: true
tags: erc_party
view-if: erc_rally_timer <= 0 and (year > 2012 or month >= 9)
on-arrival: month_actions += 1; erc_rally_timer = 6 if next_election_time - time > 6 and not (year == 2012); erc_rally_timer = 2 if (year == 2012) or (next_election_time - time <= 6)
card-image: img/erc/rally.png
face-image: img/erc/rally.png
role: card-party

= Political Rally

Mass rallies, protests, and student strikes are a common feature of left and pro-independence parties and civic organizations. ERC is no stranger to these, specially in politically charged times like now. What should these focus on at the current moment?

- @independence: The struggle for Catalan independence and self-determination.
- @welfare: Política Social - the maintenance and expansion of social welfare programs.
- @reform: Democratization, republicanism, and the fight for a new system for the Spanish state.
- @far_right: Holding the line against the far right, Spanish nationalism, and all the political heirs to Franco's regime.
- @local: A mixture of various local and national concerns that resonate most with the audience.
- @easy_discard

@independence
on-arrival: {!
    Q.erc_civic_dissent -= 5;
    Q.erc_civic_strength += 5;
    var effectiveness = Math.max(0, 1-Q.erc_dissent/100);
    if (Q.broken_roadmap) {
        Q.independence_movement += 1;
        for (var c of Q.parlament_constituencies) {
            for (var d of ["middle", "young", "rural"]) {
                G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"abstain", amount:0.12*effectiveness, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
                G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"ciu", amount:0.08*effectiveness, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
                G.cardSupportTransfer(Q, {contest:"parlament", to:"cup", from:"abstain", amount:0.15*effectiveness, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
            }
        }
        G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"abstain", amount:0.15*effectiveness, maxDonorFraction:0.5, constituencies:["catalunya"]});
        G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"ciu", amount:0.1*effectiveness, maxDonorFraction:0.5, constituencies:["catalunya"]});
        G.cardSupportTransfer(Q, {contest:"congreso", to:"cup", from:"abstain", amount:0.15*effectiveness, maxDonorFraction:0.5, constituencies:["catalunya"]});
        G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"ciu", amount:0.15*effectiveness, maxDonorFraction:0.5});
        G.cardSupportTransfer(Q, {contest:"barcelona", to:"cup", from:"ciu", amount:0.15*effectiveness, maxDonorFraction:0.5});
        Q.erc_interior_mod = (Q.erc_interior_mod) + 0.15*effectiveness;
    } else {
        Q.independence_movement += 5;
        var profile;
        switch (Q.erc_roadmap) {
            default:
                profile = {middle:0.5, young:0.25, rural:0.25};
                break;
            case 1:
                profile = {ind:0.25, middle:0.75, young:0.5, rural:0.5};
                break;
            case 2:
                profile = {ind:0.15, middle:0.75, young:0.75, rural:0.75};
                break;
            case 3:
                profile = {middle:0.5, young:1, rural:1};
                break;
        }
        for (var c of Q.parlament_constituencies) {
            for (var d in profile) {
                var amount = profile[d]*effectiveness;
                G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"abstain", amount:amount*0.55, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
                G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"ciu", amount:amount*0.45, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
            }
        }
        G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"abstain", amount:0.5*effectiveness, maxDonorFraction:0.5, constituencies:["catalunya"]});
        G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"ciu", amount:0.4*effectiveness, maxDonorFraction:0.5, constituencies:["catalunya"]});
        G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"ciu", amount:0.45*effectiveness, maxDonorFraction:0.5});
        Q.erc_interior_mod = (Q.erc_interior_mod) + 0.6*effectiveness;
    }
!}

Rallying around independence and building a new state is the core of ERC, and also serves as a foundation to talk about all it can achieve regarding other issues, from social welfare to a new democracy. [? if broken_roadmap: The fact that we've not fulfilled our Roadmap to Independence makes our appeal much less effective, while the CUP captures some of the renewed pro-independence enthusiasm. ?][? if not broken_roadmap and erc_roadmap = 1: Our current Roadmap to Independence focuses on reaching an agreement with the central government. This is hard to believe as achievable, but does seem to sway more on-the-fence people. ?][? if not broken_roadmap and erc_roadmap = 2: Our current Roadmap to Independence focuses on a more generic push for independence, open to opportunities as they arise, be it for agreement or for unilateral action. While not the most clear, people seem willing to at least give it a chance for now. ?][? if not broken_roadmap and erc_roadmap = 3: Our current Roadmap to Independence focuses on unilateral action. Ambitious and hardcore-sounding, it is loved by hardliners, but it may be hard to digest by those on the fence. ?]


@welfare
on-arrival: {!
    Q.erc_left_dissent -= 5;
    Q.erc_left_strength += 5;
    Q.erc_pragmatic_dissent -= 3;
    Q.erc_pragmatic_strength += 3;
    var effectiveness = Math.max(0, 1-Q.erc_dissent/100);
    var credibility = Q.burdens_broken && (Q.erc_supporting || Q.erc_in_gob) ? 0.3 : 1;
    var profile = {unemployed:1.2, young:0.8, ind:0.5};
    for (var c of Q.parlament_constituencies) {
        for (var d in profile) {
            var amount = profile[d]*effectiveness*credibility;
            G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"abstain", amount:amount*0.45, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
            G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"psc", amount:amount*0.3, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
            G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"federal_left", amount:amount*0.25, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
        }
    }
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"abstain", amount:0.45*effectiveness*credibility, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"psoe", amount:0.3*effectiveness*credibility, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"federal_left", amount:0.25*effectiveness*credibility, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"psc", amount:0.35*effectiveness*credibility, maxDonorFraction:0.5});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"federal_left", amount:0.3*effectiveness*credibility, maxDonorFraction:0.5});
    Q.erc_redbelt_mod = Q.erc_redbelt_mod + 0.3*effectiveness*credibility;
!} 

The focus on social welfare is something ERC has always championed, and does resonate with workers and the youth. [? if (erc_supporting or erc_in_gob) and not burdens_broken: Meeting the commitments we assumed in government makes the appeal credible. ?][? if burdens_broken and (erc_supporting or erc_in_gob): However, having broken the commitments we took on when entering the Generalitat makes the rally much less convincing. ?]

@reform
on-arrival: {!
    Q.erc_left_dissent -= 3;
    Q.erc_left_strength += 3;
    Q.erc_core_dissent -= 2;
    Q.erc_core_strength += 2;

    if (Q.erc_in_gob || Q.erc_supporting) {
        Q.independence_trust -= 10;
    }
    var sum_left_spain = 0;
    var sum_psoe_spain = 0;
    for (var c of Q.congreso_constituencies) {
        for (var p of Q.congreso_parties_left) {
            sum_left_spain += Q[p + "_congreso_" + c + "_support"] || 0;
        }
        sum_psoe_spain += Q["psoe_congreso_" + c + "_support"] || 0;
    }
    var viable = sum_left_spain >= 0.95*sum_psoe_spain;
    var effectiveness = Math.max(0, 1-Q.erc_dissent/100);
    var profile = viable ? {ind:0.8, middle:0.5, young:0.6} : {ind:0.4, middle:0.2, young:0.3};
    if (viable) {
        Q.erc_pragmatic_dissent -= 2;
    } else {
        Q.erc_pragmatic_dissent += 2;
    }
    for (var c of Q.parlament_constituencies) {
        for (var d in profile) {
            var amount = profile[d]*effectiveness;
            G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"federal_left", amount:amount*0.5, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
            G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"psc", amount:amount*0.3, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
            G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"abstain", amount:amount*0.2, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
        }
    }
    var congressAmount = (viable ? 0.9 : 0.45)*effectiveness;
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"psoe", amount:congressAmount*0.45, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"federal_left", amount:congressAmount*0.35, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"abstain", amount:congressAmount*0.2, maxDonorFraction:0.5, constituencies:["catalunya"]});
!}

Republicanism is in the very name of ERC, and we have a longstanding fame of battling in the Congreso grounds for true radical transformation for Spain. Nonetheless, the idea of "saving Spain from itself" is not always popular with everyone, unless a true leftist alternative to the PSOE-PP duopoly manages to become a viable and believable option.

@far_right
on-arrival: {!
    Q.erc_left_dissent -= 5;
    Q.erc_left_strength += 5;
    Q.erc_core_dissent -= 3;
    Q.erc_core_strength += 3;
    var effectiveness = Math.max(0, 1-Q.erc_dissent/100);
    var threat = !((Q.vox_congreso_s || 0) < 10 && !Q.pxc_parlament_s && !Q.fnc_parlament_s);
    var scale = threat ? 1 : 0.5;
    var profile = {middle:0.8, young:0.4, ind:0.4};
    for (var c of Q.parlament_constituencies) {
        for (var d in profile) {
            var amount = profile[d]*scale*effectiveness;
            G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"abstain", amount:amount*0.55, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
            G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"federal_left", amount:amount*0.25, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
            G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"psc", amount:amount*0.2, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
        }
    }
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"abstain", amount:0.5*scale*effectiveness, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"federal_left", amount:0.3*scale*effectiveness, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"psc", amount:0.4*scale*effectiveness, maxDonorFraction:0.5});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"federal_left", amount:0.3*scale*effectiveness, maxDonorFraction:0.5});
    Q.erc_redbelt_mod = Q.erc_redbelt_mod + 0.3*scale*effectiveness;
!}

[? if vox_congreso_s < 10 and (not pxc_parlament_s and not fnc_parlament_s): The far-right is hardly seen as a threat now, but it's always good to remain vigilant, even if voters don't really follow along that much. ?][? if vox_congreso_s > 0: With VOX having seats in the Congreso now, some are starting to worry about a new rise of the far-right, and like our positioning. ?][? if pxc_parlament_s > 0 or fnc_parlament_s > 0: With [? if pxc_parlament_s > 0 : PxC ?][? if fnc_parlament_s > 0 : the FNC ?] now having entered the Parlament, this positioning is seen as quite necessary by many! ?]

@local
on-arrival: {!
    var effectiveness = Math.max(0, 1-Q.erc_dissent/100);
    var profile = {middle:0.75, young:0.25, rural:0.5};
    for (var c of Q.parlament_constituencies) {
        for (var d in profile) {
            var amount = profile[d]*effectiveness;
            G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"psc", amount:amount*0.4, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
            G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"federal_left", amount:amount*0.35, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
            G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"ciu", amount:amount*0.25, maxDonorFraction:0.5, constituencies:[c], demographics:[d]});
        }
    }
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"psc", amount:0.5*effectiveness, maxDonorFraction:0.5});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"federal_left", amount:0.3*effectiveness, maxDonorFraction:0.5});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"ciu", amount:0.2*effectiveness, maxDonorFraction:0.5});
    Q.erc_redbelt_mod = Q.erc_redbelt_mod + 0.2*effectiveness;
    Q.erc_interior_mod = Q.erc_interior_mod + 0.4*effectiveness;
!}

Our speakers have gauged the mood and are speaking to the issues that seem to most affect the people in this moment.
