title: Campaigning
new-page: true
view-if: not rubicon or erc_campaigning_timer <= 0
on-arrival: month_actions += 1 if not erc_advisor_action or difficulty >= 0; erc_campaigning_timer = 2 if rubicon
max-visits: 36
card-image: img/erc/campaign.jpeg
face-image: img/erc/campaign.jpeg
frequency: 100
tags: erc_party
role: card-party

= Campaigning

Whether or not we are in an electoral campaign, the party is always trying to broaden its voter base. Who should we focus our campaign efforts on?

# TBD: add as part of the card's action?
# - @territorial_networks
# - @barcelona_province

- @workers: The industrial working class, including factory workers, construction workers, and service workers.
- @redbelt: The working class in the metropolitan area of Barcelona, the traditional stronghold of the PSC.
- @middle: The middle working class of professionals, public employees, and highly qualified workers.
- @business: Small business owners and the self-employed.
- @rural: Rural workers and small farmers from rural Catalonia.
- @retirees: Retirees and the elderly.
- @unemployed: The unemployed.
- @union_networks
- @barcelona_networks
- @rural_networks
- @local_election: Focus our resources on the upcoming local elections.
- @congreso_election: Focus our resources on the upcoming Congreso election.
- @root: We either don't want to or cannot campaign right now.
- view-if: not last_advisor_action
- @easy_discard
- @cancel_advisor_action

@workers
subtitle: [? if not erc_advisor_action: \[-1 resources\] ?]
choose-if: (erc_advisor_action or party_resources >= 1)
unavailable-subtitle: Not enough resources.
on-arrival: {!
    var effectiveness = Math.max(0, 1-Q.erc_dissent/100);
    var credibility = Q.burdens_broken && (Q.erc_supporting || Q.erc_in_gob) ? 0.3 : 1;
    var weights = {barcelona:0.3, girona:1.8, lleida:1.8, tarragona:0.6};
    for (var c of Q.parlament_constituencies) {
        var amount = weights[c]*effectiveness*credibility;
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"psc", amount:amount*0.5, maxDonorFraction:0.5, constituencies:[c], demographics:["ind"]});
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"federal_left", amount:amount*0.3, maxDonorFraction:0.5, constituencies:[c], demographics:["ind"]});
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"abstain", amount:amount*0.2, maxDonorFraction:0.5, constituencies:[c], demographics:["ind"]});
    }
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"psoe", amount:0.4*effectiveness*credibility, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"federal_left", amount:0.25*effectiveness*credibility, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"abstain", amount:0.2*effectiveness*credibility, maxDonorFraction:0.5, constituencies:["catalunya"]});
    Q.erc_redbelt_mod = Math.min(4, Q.erc_redbelt_mod + 0.35*effectiveness*credibility);
    if (!Q.erc_advisor_action) Q.party_resources -= 1;
!}

We have increased our campaigning among industrial workers across Catalonia, but such a generalized campaign will have a hard time breaking through Barcelona's red belt. [? if gabriel_rufian_advisor: The figure of Gabriel Rufian seems to be functioning greatly for these campaigns. ?][? if burdens_broken and (erc_supporting or erc_in_gob): However, our failure to meet the social commitments we assumed in government makes the campaign a bit harder to believe. ?]

@redbelt
subtitle: [? if not erc_advisor_action: \[-1 resources\] ?]
view-if: gabriel_rufian_advisor = 1 or erc_break_red_belt = 1
choose-if: (erc_advisor_action or party_resources >= 1)
unavailable-subtitle: Not enough resources.
on-arrival: {!
    var effectiveness = Math.max(0, 1-Q.erc_dissent/100);
    var credibility = Q.burdens_broken && (Q.erc_supporting || Q.erc_in_gob) ? 0.3 : 1;
    var weights = {barcelona:1.8 + 0.6*Q.gabriel_rufian_advisor, tarragona:1.2 + 0.3*Q.gabriel_rufian_advisor};
    for (var c of ["barcelona", "tarragona"]) {
        var amount = weights[c]*effectiveness*credibility;
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"psc", amount:amount*0.7, maxDonorFraction:0.5, constituencies:[c], demographics:["ind"]});
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"federal_left", amount:amount*0.2, maxDonorFraction:0.5, constituencies:[c], demographics:["ind"]});
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"cs", amount:amount*0.1, maxDonorFraction:0.5, constituencies:[c], demographics:["ind"]});
    }
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"psoe", amount:0.65*effectiveness*credibility, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"federal_left", amount:0.2*effectiveness*credibility, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"psc", amount:0.7*effectiveness*credibility, maxDonorFraction:0.5});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"federal_left", amount:0.25*effectiveness*credibility, maxDonorFraction:0.5});
    Q.erc_redbelt_mod = Q.erc_redbelt_mod + (0.8 + 0.25*Q.gabriel_rufian_advisor)*effectiveness*credibility;
    if (!Q.erc_advisor_action) Q.party_resources -= 1;
!}

We have increased our campaigning efforts among industrial workers, specially around Barcelona's red belt, the traditional stronghold of the PSC. [? if gabriel_rufian_advisor: The figure of Gabriel Rufian seems to be functioning greatly for these campaigns. ?][? if burdens_broken and (erc_supporting or erc_in_gob): Our failure to meet the social commitments we assumed in government makes the campaign a bit harder to believe, though. ?]

- @post_event: Continue...


@middle
subtitle: [? if not erc_advisor_action: \[-1 resources\] ?]
choose-if: (erc_advisor_action or party_resources >= 1)
unavailable-subtitle: Not enough resources.
on-arrival: {!
    var effectiveness = Math.max(0, 1-Q.erc_dissent/100);
    var credibility = Q.broken_roadmap ? 0.25 : 1;
    var advisor = {barcelona:0.25*(Q.joan_josep_nuet_advisor + Q.joan_laporta_advisor), girona:0.25*Q.raul_romeva_advisor, lleida:0.25*Q.raul_romeva_advisor, tarragona:0};
    for (var c of Q.parlament_constituencies) {
        var amount = (1.5 + advisor[c])*effectiveness*credibility;
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"ciu", amount:amount*0.55, maxDonorFraction:0.5, constituencies:[c], demographics:["middle"]});
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"psc", amount:amount*0.25, maxDonorFraction:0.5, constituencies:[c], demographics:["middle"]});
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"abstain", amount:amount*0.2, maxDonorFraction:0.5, constituencies:[c], demographics:["middle"]});
    }
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"ciu", amount:0.55*effectiveness*credibility, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"psoe", amount:0.25*effectiveness*credibility, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"ciu", amount:0.45*effectiveness*credibility, maxDonorFraction:0.5});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"psc", amount:0.2*effectiveness*credibility, maxDonorFraction:0.5});
    if (!Q.erc_advisor_action) Q.party_resources -= 1;
!}

We have increased our campaigning among the middle class. [? if broken_roadmap: Our failure to follow through with our promised roadmap makes our campaigning harder to believe, though. ?]

@business
subtitle: [? if not erc_advisor_action: \[-1 resources\] ?]
choose-if: (erc_advisor_action or party_resources >= 1)
unavailable-subtitle: Not enough resources.
on-arrival: {!
    var effectiveness = Math.max(0, 1-Q.erc_dissent/100);
    var credibility = Q.broken_roadmap ? 0.25 : 1;
    var roadmapFit = Q.erc_roadmap <= 2 ? 1 : 0.5;
    var appeal = (Math.max(0, Math.min(1, Q.erc_pragmatic_strength/100))*effectiveness + 0.3*Q.joan_laporta_advisor)*credibility*roadmapFit;
    for (var c of Q.parlament_constituencies) {
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"ciu", amount:appeal*0.7, maxDonorFraction:0.5, constituencies:[c], demographics:["buss"]});
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"ppc", amount:appeal*0.3, maxDonorFraction:0.5, constituencies:[c], demographics:["buss"]});
    }
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"ciu", amount:appeal*0.45, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"congreso", to:"erc", from:"pp", amount:appeal*0.2, maxDonorFraction:0.5, constituencies:["catalunya"]});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"ciu", amount:appeal*0.35, maxDonorFraction:0.5});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"pp", amount:appeal*0.15, maxDonorFraction:0.5});
    if (!Q.erc_advisor_action) Q.party_resources -= 1;
!}

We have increased our campaigning among the business community. [? if erc_pragmatic_strength < 40 or erc_roadmap > 2: However, our general party lines are not the most appealing to this group, who may prefer more pragmatic approaches to politics. ?][? if broken_roadmap = 1: We have been unable to follow through with our roadmap to independence, and that makes our campaign somewhat more difficult. ?]

- @post_event: Continue...


