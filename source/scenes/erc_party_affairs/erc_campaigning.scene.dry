@local_election
view-if: next_local_election_time - time <= 12
subtitle: [? if not erc_advisor_action: \[-1 resources\] ?]
choose-if: (erc_advisor_action or party_resources >= 1)
unavailable-subtitle: Not enough resources.
on-arrival: {!
    var effectiveness = Math.max(0, 1-Q.erc_dissent/100);
    for (var c of Q.parlament_constituencies) {
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"psc", amount:0.12*effectiveness, maxDonorFraction:0.5, constituencies:[c], demographics:["ind", "middle"]});
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"federal_left", amount:0.05*effectiveness, maxDonorFraction:0.5, constituencies:[c], demographics:["young", "unemployed"]});
        G.cardSupportTransfer(Q, {contest:"parlament", to:"erc", from:"ciu", amount:0.1*effectiveness, maxDonorFraction:0.5, constituencies:[c], demographics:["rural"]});
    }
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"psc", amount:0.45*effectiveness, maxDonorFraction:0.5});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"federal_left", amount:0.3*effectiveness, maxDonorFraction:0.5});
    G.cardSupportTransfer(Q, {contest:"barcelona", to:"erc", from:"ciu", amount:0.2*effectiveness, maxDonorFraction:0.5});
    Q.erc_redbelt_mod += (0.25 + 0.2*Q.erc_break_red_belt)*effectiveness;
    Q.erc_interior_mod += 0.45*effectiveness;
    if (!Q.erc_advisor_action) Q.party_resources -= 1;
!}

Campaigning efforts have been focused on the upcoming local elections, and supporting our grassroots candidates across the country.

