title: Coalition Builder
set-bg: img/generalitat_interior.jpg
new-page: true
on-arrival: {!
    Q.playground_coalitions_needed_seats = 0;
    Q.playground_coalitions_set_seats = 0;
    Q.playground_coalitions = null;
!}
# choose-if: achievement_game_completed # TODO: set this lock!
unavailable-subtitle: Finish the game once to unlock.
call: root.start_menu

= Coalition Builder

The Coalition Builder is an in-game tool used mostly for debugging and testing. Test its limits here!

- @parlament: Parlament de Catalunya
- @congreso: Congreso de los Diputados
- @local: Saló de Plens de Barcelona
- @root: Exit Playground

@parlament
set-bg: img/parlament_de_catalunya.jpg
new-page: true
call: parlament_coalition
on-arrival: {!
    if (Q.playground_coalitions_type !== "parlament") Q.playground_coalitions = null;
    Q.playground_coalitions_type = "parlament";
    var parlament_size = 0;
    for (var constituency of Q.parlament_constituencies) {
        parlament_size += Q.parlament_seats[constituency];
    }
    Q.parlament_s_majority = Math.floor(parlament_size/2) + 1;
    Q.playground_coalitions_needed_seats = parlament_size;
    Q.playground_coalitions_set_seats = parlament_size;
!}
on-display: {!
    if (!Q.playground_coalitions) {
        Q.playground_coalitions = G.coalitionBuilderConfig(Q, "parlament", [
            ["si","SI"],
            ["cup","CUP"],
            ["jxsi","JxSí"],
            ["icv","ICV-EUiA"],
            ["cecp","CECP"],
            ["ecp","ECP"],
            ["erc","ERC"],
            ["csqp","CSQP"],
            ["psc","PSC"],
            ["jxcat","JxCat"],
            ["junts","Junts"],
            ["dl","DL"],
            ["cdc","CDC"],
            ["pdcat","PDeCAT"],
            ["cs","Cs"],
            ["ciu","CiU"],
            ["unio","UDC"],
            ["ppc","PPC"],
            ["pxc","PxC"],
            ["fnc","FNC"],
            ["vox","Vox"]
        ]);
    }

    const data = [];
    if (Q.dl_parlament_s) data.push({ id: "dl", seats: Q.dl_parlament_s });

    if (Q.si_parlament_s) {
        data.push({
            "id": "si",
            "legend": "SI",
            "name": "SI",
            "seats": Q.si_parlament_s,
        });
    }

    if (Q.cup_parlament_s) {
        data.push({
            "id": "cup",
            "legend": "CUP",
            "name": "CUP",
            "seats": Q.cup_parlament_s,
        });
    }

    if (Q.jxsi_parlament_s) {
        data.push({
            "id": "jxsi",
            "legend": "JxSí",
            "name": "JxSí",
            "seats": Q.jxsi_parlament_s,
        });
    }

    if (Q.icv_parlament_s) {
        data.push({
            "id": "icv",
            "legend": "ICV-EUiA",
            "name": "ICV-EUiA",
            "seats": Q.icv_parlament_s,
        });
    }

    if (Q.cecp_parlament_s) {
        data.push({
            "id": "cecp",
            "legend": "CECP",
            "name": "CECP",
            "seats": Q.cecp_parlament_s,
        });
    }

    if(Q.ecp_parlament_s) {
        data.push({
            "id": "ecp",
            "legend": "ECP",
            "name": "ECP",
            "seats": Q.ecp_parlament_s,
        });
    }

    if (Q.erc_parlament_s) {
        data.push({
            "id": "erc",
            "legend": "ERC",
            "name": "ERC",
            "seats": Q.erc_parlament_s,
        });
    }

    if (Q.csqp_parlament_s) {
        data.push({
            "id": "csqp",
            "legend": "CSQP",
            "name": "CSQP",
            "seats": Q.csqp_parlament_s,
        });
    }

    if (Q.psc_parlament_s) {
        data.push({
            "id": "psc",
            "legend": "PSC",
            "name": "PSC",
            "seats": Q.psc_parlament_s,
        });
    }

    if (Q.jxcat_parlament_s) {
        data.push({
            "id": "jxcat",
            "legend": "JxCat",
            "name": "JxCat",
            "seats": Q.jxcat_parlament_s,
        });
    }

    if (Q.junts_parlament_s) {
        data.push({
            "id": "junts",
            "legend": "Junts",
            "name": "Junts",
            "seats": Q.junts_parlament_s,
        });
    }

    if (Q.cdc_parlament_s) {
        data.push({
            "id": "cdc",
            "legend": "CDC",
            "name": "CDC",
            "seats": Q.cdc_parlament_s,
        });
    }

    if (Q.pdcat_parlament_s) {
        data.push({
            "id": "pdcat",
            "legend": "PDeCAT",
            "name": "PDeCAT",
            "seats": Q.pdcat_parlament_s,
        });
    }

    if (Q.cs_parlament_s) {
        data.push({
            "id": "cs",
            "legend": "Cs",
            "name": "Cs",
            "seats": Q.cs_parlament_s,
        });
    }

    if (Q.ciu_parlament_s) {
        data.push({
            "id": "ciu",
            "legend": "CiU",
            "name": "CiU",
            "seats": Q.ciu_parlament_s,
        });
    }

    if (Q.unio_parlament_s) {
        data.push({
            "id": "unio",
            "legend": "UDC",
            "name": "UDC",
            "seats": Q.unio_parlament_s,
        });
    }

    if (Q.ppc_parlament_s) {
        data.push({
            "id": "ppc",
            "legend": "PPC",
            "name": "PPC",
            "seats": Q.ppc_parlament_s,
        });
    }

    if (Q.pxc_parlament_s) {
        data.push({
            "id": "pxc",
            "legend": "PxC",
            "name": "PxC",
            "seats": Q.pxc_parlament_s,
        });
    }

    if (Q.fnc_parlament_s) {
        data.push({
            "id": "fnc",
            "legend": "FNC",
            "name": "FNC",
            "seats": Q.fnc_parlament_s,
        });
    }

    if (Q.vox_parlament_s) {
        data.push({
            "id": "vox",
            "legend": "Vox",
            "name": "Vox",
            "seats": Q.vox_parlament_s,
        });
    }

    Q.election_simulation_parlament_hemicycle = {
        seats: data.map(function (party) {
            return { party: party.id, seats: party.seats, colour: party.id };
        }),
        majority: Q.parlament_s_majority,
    };

    Q.playground_coalition_parlament_none_s = 0;
!}

= Coalitions - Parlament

{!<div id="parlament" data-widget="hemicycle" data-props='{"configFrom":"election_simulation_parlament_hemicycle","animate":true}'></div>!}

{!<div id="parlament-coalition-widget" data-widget="coalitions" data-props='{"configFrom":"parlament_coalition_config"}'></div>!}

{!<div id="parlament-coalition-builder-playground" data-widget="builder-playground" data-props='{"configFrom": "playground_coalitions"}'></div>!}

- @run_parlament
- @coalition_builder: Back

@run_parlament
on-arrival: {! G.applyCoalitionBuilder(Q); !}
title: Set this Parlament
choose-if: playground_coalitions_set_seats == playground_coalitions_needed_seats
unavailable-subtitle: [+ playground_coalitions_set_seats +] assigned seats, **[+ playground_coalitions_needed_seats +]** required.
go-to: parlament


