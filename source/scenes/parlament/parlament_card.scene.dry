title: Parlament
new-page: true
view-if: parlament_timer <= 0 and year > 2012 and not cat_caretaker_gov
on-arrival: parlament_timer += 6; month_actions += 1; coming_from_parlament = true;
is-card: true
card-image: img/parlament_card.jpg
tags: erc_party cup_party parlament_card
go-to: parlament_options if not cat_caretaker_gov; parlament_dissolved if cat_caretaker_gov
role: card-parliament
