    // Store the view-model for the widget protocol (data-widget="hemicycle"
    // marker below points at this key via configFrom) — a plain, JSON-safe Q
    // object the UI reads, not a value pushed through a browser global/d3
    // call (docs/design/LEARNINGS.md, 2026-07-17: no function closures in Q).
    // `legend`/`name` are dropped: out/html/d3-parliament.js's own renderer
    // only ever reads `.id`/`.seats` off each party, so `party`/`colour`
    // both reuse `id` (the same token the old shell's `.seat.<id>` CSS
    // classes already key their fill colour on) and legend/name carry no
    // rendering weight. See docs/design/desk_ui_plan.md §6 and
    // out/html/widgets.js (old shell) / Hemicycle.vue (Desk), both of which
    // resolve configFrom against Q.
    Q.parlament_hemicycle = {
        seats: data.map(function (p) {
            return { party: p.id, seats: p.seats, colour: p.id };
        }),
        majority: Q.parlament_s_majority,
    };
!}
