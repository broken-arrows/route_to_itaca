title: Parlament
new-page: true
view-if: year > 2012
choose-if: parlament_timer <= 0 and not cat_caretaker_gov
unavailable-subtitle: [? if cat_caretaker_gov : The Parlament is currently dissolved.?]
on-arrival: {!
    Q.parlament_action_open = Q.parlament_timer <= 0 && !Q.cat_caretaker_gov;
    Q.coming_from_parlament = Q.parlament_action_open;
    if (Q.parlament_action_open) {
        Q.parlament_timer += 6;
        Q.month_actions += 1;
    }
!}
card-image: img/parlament_card.jpg
go-to: parlament_options
role: pinned-parliament
