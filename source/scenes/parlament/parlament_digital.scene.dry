title: Law on Digital Public Services and Cybersecurity
new-page: true
choose-if: party_resources > 0 and not parlament_digital_passed
subtitle: [? if coming_from_parlament: \[-1 resources\]?]
unavailable-subtitle: [? if parlament_digital_passed: Already approved!?][? if not parlament_digital_passed and party_resources < 1: Not enough resources.?]
on-arrival: {!
    if (Q.coming_from_parlament) Q.party_resources -= 1;
    Q.parlament_digital_deals = [];
!}

= Law on Digital Public Services and Cybersecurity

In the digital age, it is no surprise that Catalonia's public administration already depends on digital identification, electronic records and shared databases. Yet responsibility for protecting those systems remains fragmented, and transparency and data protection could be much better.

The Parlament has a chance now to centralize those responsibilities in a public Cybersecurity Agency and recognize digital rights in dealings with Catalan institutions. The difficult boundary is whether the new body should protect the Generalitat's own systems or, more broadly, claim responsibility for cybersecurity throughout Catalonia.

- @digital_public_services: Focus on protecting Catalan Public services and their users
- @digital_national_scope: Establish a National Cybersecurity and digital-rights framework

@digital_public_services
subtitle: A public-law agency will protect Generalitat's systems and guarantee citizen data integrity.
on-arrival: parlament_digital_variant = "public_services"
go-to: digital_negotiation

While it is not surprising that the Spanish right is against this, some are still on the fence on the Generalitat taking on such powers. We may want to approach them if we want to secure an ample majority for this vote.

@digital_national_scope
subtitle: The agency will do the above, while also coordinate incidents throughout Catalonia with law enforcement, and assist citizens and companies directly.
on-arrival: parlament_digital_variant = "national_scope"
go-to: digital_negotiation

While it is not surprising that the Spanish right is against this, some are still on the fence on the Generalitat taking on such powers. We may want to approach them if we want to secure an ample majority for this vote.


@digital_negotiation
on-arrival: {!
    var playerProposal = Q.coming_from_parlament;
    var proposingParty = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    var nationalScope = Q.parlament_digital_variant == "national_scope";
    var yesNames = nationalScope
        ? ["ciu","cdc","dl","pdcat","jxsi","jxcat","junts","erc","cup","si"]
        : ["ciu","cdc","dl","pdcat","jxsi","jxcat","junts","erc","cup","psc","icv","csqp","cecp","ecp","unio","si"];
    var noNames = nationalScope
        ? ["ppc","cs","vox","pxc"]
        : ["cs","vox","pxc"];

    if (nationalScope) {
        if (Q.psc_leader == "Montserrat Tura") {
            yesNames.push("psc");
        } else if (Q.psc_leader != "Àngel Ros" && Q.psc_leader != "Núria Parlon") {
            noNames.push("psc");
        }

        if (Q.csqp_leader == "Arcadi Oliveres") yesNames.push("csqp");

        if (Q.cecp_leader == "Arcadi Oliveres" || Q.cecp_leader == "Jaume Asens") {
            yesNames.push("cecp");
        } else if (Q.cecp_leader == "Joan Coscubiela") {
            noNames.push("cecp");
        }
    }

    if (playerProposal && !yesNames.includes(proposingParty)) yesNames.push(proposingParty);
    Q.parlament_digital_yes_names = yesNames;
    Q.parlament_digital_no_names = noNames;

    function canApproach(party, eligible) {
        if (!eligible || !party) return false;
        if ((Q[party + "_parlament_s"] || 0) <= 0) return false;
        if (Q.parlament_digital_yes_names.includes(party)) return false;
        return !Q.parlament_digital_deals.some(function (deal) { return deal.party == party; });
    }

    var ercPlayer = Q.player_party == "erc";
    var cupPlayer = Q.player_party == "cup";
    Q.parlament_digital_can_approach_cup = canApproach("cup", ercPlayer);
    Q.parlament_digital_can_approach_psc = canApproach("psc", ercPlayer);
    Q.parlament_digital_can_approach_erc = canApproach("erc", cupPlayer);
    Q.parlament_digital_can_approach_convergence = canApproach(Q.parlament_current_ciu, ercPlayer || cupPlayer);
    Q.parlament_digital_can_approach_icv = canApproach(Q.parlament_current_icv, ercPlayer || cupPlayer);
!}

- @digital_approach_cup
- @digital_approach_psc
- @digital_approach_erc
- @digital_approach_convergence
- @digital_approach_icv
- @digital_vote: Proceed with the vote

@digital_approach_cup
title: Approach the CUP before the vote
view-if: parlament_digital_can_approach_cup
choose-if: cup_relations > 55
unavailable-subtitle: We don't have good enough relations with the CUP
on-arrival: parlament_digital_deal_party = "cup"
go-to: digital_make_deal

· The CUP will not oppose our proposal.

@digital_approach_psc
title: Approach the PSC before the vote
view-if: parlament_digital_can_approach_psc
choose-if: psc_relations > 55
unavailable-subtitle: We don't have good enough relations with the PSC
on-arrival: parlament_digital_deal_party = "psc"
go-to: digital_make_deal

· The PSC will not oppose our proposal.

@digital_approach_erc
title: Approach ERC before the vote
view-if: parlament_digital_can_approach_erc
choose-if: erc_relations > 55
unavailable-subtitle: We don't have good enough relations with ERC
on-arrival: parlament_digital_deal_party = "erc"
go-to: digital_make_deal

· ERC will not oppose our proposal.

@digital_approach_convergence
title: Approach [+ parlament_current_ciu +] before the vote
choose-if: (ciu_parlament_s > 0 and ciu_relations > 55) or (cdc_parlament_s > 0 and cdc_relations > 55) or (dl_parlament_s > 0 and dl_relations > 55) or (pdcat_parlament_s > 0 and pdcat_relations > 55) or (jxcat_parlament_s > 0 and jxcat_relations > 55 and not player_in_jxcat) or (junts_parlament_s > 0 and junts_relations > 55)
view-if: parlament_digital_can_approach_convergence
unavailable-subtitle: We don't have good enough relations with [+ parlament_current_ciu +]
on-arrival: {!
    Q.parlament_digital_deal_party = Q.parlament_current_ciu;
!}
go-to: digital_make_deal

· [+ parlament_current_ciu +] will not oppose our proposal.

@digital_approach_icv
title: Approach [+ parlament_current_icv +] before the vote
view-if: parlament_digital_can_approach_icv
choose-if: (icv_parlament_s > 0 and icv_relations > 55) or (csqp_parlament_s > 0 and csqp_relations > 55) or (cecp_parlament_s > 0 and cecp_relations > 55) or (ecp_parlament_s > 0 and ecp_relations > 55)
unavailable-subtitle: We don't have good enough relations with [+ parlament_current_icv +]
on-arrival: {!
    Q.parlament_digital_deal_party = Q.parlament_current_icv;
!}
go-to: digital_make_deal

· [+ parlament_current_icv +] will not oppose our proposal.

@digital_make_deal
on-arrival: {!
    var party = Q.parlament_digital_deal_party;
    var baselineNo = Q.parlament_digital_no_names.includes(party);
    var newPosition = baselineNo && Q[party + "_relations"] <= 65 ? "abstain" : "yes";
    Q.parlament_digital_deals.push({party: party, position: newPosition});
    Q[party + "_relations"] -= 5;
!}
go-to: digital_negotiation

@digital_vote
subtitle: [? if not parlament_digital_deal_party: Who needs their support anyway? ?]
on-arrival: {!
    var playerProposal = Q.coming_from_parlament;
    var proposingParty = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    Q.coming_from_parlament = false;

    var nationalScope = Q.parlament_digital_variant == "national_scope";
    var author = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    var leftDonor = Q.parlament_current_icv;
    var modernisationDonor = Q.parlament_current_ciu;
    var proposalYoung = nationalScope ? 0.06 : 0.03;
    var proposalMiddle = nationalScope ? 0.045 : 0.03;
    var proposalBusiness = nationalScope ? 0.03 : 0.02;
    for (const c of Q.parlament_constituencies) {
        Q[author + "_parlament_" + c + "_young_support"] += proposalYoung;
        Q[leftDonor + "_parlament_" + c + "_young_support"] -= proposalYoung;
        Q[author + "_parlament_" + c + "_middle_support"] += proposalMiddle;
        Q[modernisationDonor + "_parlament_" + c + "_middle_support"] -= proposalMiddle;
        Q[author + "_parlament_" + c + "_buss_support"] += proposalBusiness;
        Q[modernisationDonor + "_parlament_" + c + "_buss_support"] -= proposalBusiness;
    }

    // TODO: Revisit the CUP's votes once CUP leadership dynamics are modelled.
    var yesNames = nationalScope
        ? ["ciu","cdc","dl","pdcat","jxsi","jxcat","junts","erc","cup","si"]
        : ["ciu","cdc","dl","pdcat","jxsi","jxcat","junts","erc","cup","psc","icv","csqp","cecp","ecp","unio","si"];
    var noNames = nationalScope
        ? ["ppc","cs","vox","pxc"]
        : ["cs","vox","pxc"];

    if (nationalScope) {
        if (Q.psc_leader == "Montserrat Tura") {
            yesNames.push("psc");
        } else if (Q.psc_leader != "Àngel Ros" && Q.psc_leader != "Núria Parlon") {
            noNames.push("psc");
        }

        if (Q.csqp_leader == "Arcadi Oliveres") yesNames.push("csqp");

        if (Q.cecp_leader == "Arcadi Oliveres" || Q.cecp_leader == "Jaume Asens") {
            yesNames.push("cecp");
        } else if (Q.cecp_leader == "Joan Coscubiela") {
            noNames.push("cecp");
        }
    }

    if (playerProposal && !yesNames.includes(proposingParty)) yesNames.push(proposingParty);
    for (const deal of (Q.parlament_digital_deals || [])) {
        yesNames = yesNames.filter(function (party) { return party != deal.party; });
        noNames = noNames.filter(function (party) { return party != deal.party; });
        if (deal.position == "yes") yesNames.push(deal.party);
    }
    var all = ["ciu","cdc","dl","pdcat","jxsi","jxcat","junts","erc","cup","psc","ppc","cs","icv","csqp","cecp","ecp","unio","si","vox","pxc","fnc"];
    var labels = {ciu:"CiU",cdc:"CDC",dl:"DL",pdcat:"PDeCAT",jxsi:"JxSí",jxcat:"JxCat",junts:"Junts",erc:"ERC",cup:"CUP",psc:"PSC",ppc:"PPC",cs:"Cs",icv:"ICV-EUiA",csqp:"CSQP",cecp:"CECP",ecp:"ECP",unio:"UDC",si:"SI",vox:"Vox",pxc:"PxC",fnc:"FNC"};
    var yesParties = [], noParties = [], abstainParties = [];
    Q.parlament_digital_yes = 0;
    Q.parlament_digital_no = 0;
    Q.parlament_digital_abst = 0;
    for (const p of all) {
        var seats = Q[p + "_parlament_s"] || 0;
        if (seats <= 0) continue;
        if (yesNames.includes(p)) {
            Q.parlament_digital_yes += seats;
            yesParties.push({label:labels[p]});
        } else if (noNames.includes(p)) {
            Q.parlament_digital_no += seats;
            noParties.push({label:labels[p]});
        } else {
            Q.parlament_digital_abst += seats;
            abstainParties.push({label:labels[p]});
        }
    }
    Q.parlament_digital_passed = Q.parlament_digital_yes > Q.parlament_digital_no;
    Q.parlament_digital_vote_result = {outcomes:[
        {kind:"yes",label:"Yes",votes:Q.parlament_digital_yes,parties:yesParties},
        {kind:"abstain",label:"Abstention",votes:Q.parlament_digital_abst,parties:abstainParties},
        {kind:"no",label:"No",votes:Q.parlament_digital_no,parties:noParties}
    ]};

    if (Q.parlament_digital_passed) {
        var passageYoung = nationalScope ? 0.14 : 0.07;
        var passageMiddle = nationalScope ? 0.105 : 0.07;
        var passageBusiness = nationalScope ? 0.07 : 0.046;
        for (const c of Q.parlament_constituencies) {
            Q[author + "_parlament_" + c + "_young_support"] += passageYoung;
            Q[leftDonor + "_parlament_" + c + "_young_support"] -= passageYoung;
            Q[author + "_parlament_" + c + "_middle_support"] += passageMiddle;
            Q[modernisationDonor + "_parlament_" + c + "_middle_support"] -= passageMiddle;
            Q[author + "_parlament_" + c + "_buss_support"] += passageBusiness;
            Q[modernisationDonor + "_parlament_" + c + "_buss_support"] -= passageBusiness;
        }

        Q.cybersecurity_agency_scope = nationalScope ? "catalonia" : "generalitat";
        G.registerLaw(Q, {id:"digital_agency_core",title:"Catalan Cybersecurity Agency",icon:"img/comms_icon.svg",targets:{gdp_growth:0.015,generalitat_surplus:-0.010},ramp_ticks:12});
        if (nationalScope) {
            G.registerLaw(Q, {id:"digital_agency_national_scope",title:"National Cybersecurity Framework",icon:"img/comms_icon.svg",targets:{gdp_growth:0.020,generalitat_surplus:-0.015},ramp_ticks:8});
            Q.independence_trust += 1;
        }
        Q.constitutional_digital_countdown = 24;
        Q.countdowns.push("constitutional_digital");
    }
!}

<div data-widget="chamber-vote" data-props='{"configFrom":"parlament_digital_vote_result"}'></div>

[? if parlament_digital_passed and parlament_digital_variant == "public_services": The Parlament has approved the law! Even if the agency focuses only on the public side of the digital infrastructure, the classical PP-Cs coalition has nevertheless and as usual asked the Constitutional Court to strike it down.?]
[? if parlament_digital_passed and parlament_digital_variant == "national_scope": The Parlament has approved the law! Supporters are presenting it as both a civil-rights guarantee and essential sovereign infrastructure. Its territorial reach will almost certainly trigger a challenge in the courts.?]
[? if not parlament_digital_passed: The Parlament has rejected the bill. The need for safer digital services has not disappeared, but this draft has failed to assemble a majority.?]

- @post_event: Continue...
