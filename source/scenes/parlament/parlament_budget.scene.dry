title: Negotiate the Generalitat's budget
choose-if: budget_year < year
unavailable-subtitle: This year's budget has already been approved.
new-page: true
on-arrival: {!
    if (!Q.budget_draft_origin || !Q.budget_draft || Q.budget_draft_origin.year != Q.year)
        throw new Error("A budget must be submitted by the Economy ministry");
    Q.budget_year_attempted = Q.year;
    Q.budget_parlament_trigger = false;
    Q.parlament_budget_changes_made = false;
    Q.parlament_budget_player_vote = "auto";
    Q.parlament_budget_deals = [];
!}
go-to: review

@review
new-page: true
on-arrival: {!
    var origin = Q.budget_draft_origin;
    var draft = Q.budget_draft;
    var spending = ["education_spending", "healthcare_spending", "public_salary_level"];
    // Fiscal points relative to the inherited High (+1) policy.
    var taxProfiles = [
        {name:"Very low", revenue:-3},
        {name:"Low", revenue:-2},
        {name:"Moderate", revenue:-1},
        {name:"High", revenue:0},
        {name:"Very high", revenue:1}
    ];
    var capNames = ["Further austerity", "Maintain reduced services and pay",
        "Restore ordinary services and pay", "Authorize expanded services and improved pay",
        "Authorize modernized services and broader pay improvements",
        "Full spending authorization, including exceptional service laws"];
    var projectIds = {county:"territory_county_roads", b40:"territory_b40", metro1:"territory_metro1", metro2:"territory_metro2", water2:"territory_water2", water3:"territory_water3", tmobilitat2:"territory_tmobilitat2", rail1:"territory_rail1", rail2:"territory_rail2", icf:"bnl_icf_proposal", digital:"vp_digital3_proposal", universal:"healthcare_universal_proposal"};
    var projectCosts = {county:1, b40:2, metro1:2, metro2:1, water2:1, water3:2, tmobilitat2:2, rail1:1, rail2:2, icf:2, digital:1, universal:1};
    var available = {};
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    Q.parlament_budget_icf_name = Q.bnl_icf_prepared_branch == "cooperative" ? "ICF cooperative and social-economy lending" : "expanded ICF public guarantees";
    for (var key of Object.keys(projectIds)) {
        var law = (Q.active_mods || {})[projectIds[key]];
        available[key] = !!law && law.active && law.def.colour == "gray";
        if (key == "water2") available[key] = available[key] && (Q.territory_water == 1);
        if (key == "water3") available[key] = available[key] && (Q.territory_water == 2);
        if (key == "tmobilitat2") available[key] = available[key] && (Q.territory_tmobilitat == 1);
        if (key == "rail2") available[key] = available[key] && (Q.territory_tmobilitat == 2);
        if (key == "icf") available[key] = available[key] && Q.bnl_icf_level == 1 &&
            ["guarantees", "cooperative"].includes(Q.bnl_icf_prepared_branch) && !Q.cat_caretaker_gov &&
            controlledParties.includes(Q.bnl_minister_party) && controlledParties.includes(Q.economy_minister_party);
        if (key == "digital") available[key] = available[key] && Q.vp_digital_level == 2 && Q.vp_digital_prepared &&
            !Q.cat_caretaker_gov && controlledParties.includes(Q.vicepresident_party) && Q.parlament_digital_passed && ["generalitat", "catalonia"].includes(Q.cybersecurity_agency_scope) && (Q.active_mods || {}).digital_agency_core && Q.active_mods.digital_agency_core.active;
        if (key == "universal") available[key] = available[key] && Q.healthcare_universal_level == 1 && Q.healthcare_universal_introduced &&
            !Q.cat_caretaker_gov && controlledParties.includes(Q.health_minister_party);
        Q["parlament_budget_" + key + "_available"] = available[key];
        Q["parlament_budget_" + key] = !!draft.projects[key];
    }
    var taxMin = Math.max(-2, origin.tax_policy_level - 1, origin.enacted_tax_policy_level - 2);
    var taxMax = Math.min(2, origin.tax_policy_level + 1, origin.enacted_tax_policy_level + 2);
    var capMin = Math.max(-2, origin.social_spending_cap - 1);
    var capMax = Math.min(3, origin.social_spending_cap + 1);
    var cabinet = (Q.cat_coalition || []).concat(Q.president_party).filter(function (p, i, all) {
        return p && all.indexOf(p) == i;
    });
    function belongs(party, parties) {
        return parties.includes(party) || ["jxsi", "jxcat"].some(function (list) {
            return parties.includes(list) && (!!Q[party + "_in_" + list] ||
                ["ciu", "cdc", "dl", "pdcat", "junts"].includes(party));
        });
    }
    var commitments = (Q.coalition_policy_commitments || []).filter(function (record) {
        return record.status == "pending_budget" || record.status == "applied";
    });
    function matches(record, projection) {
        if (record.kind == "tax_policy_level") return projection.tax >= record.target;
        if (record.kind == "social_spending_cap") return projection.cap >= record.target;
        // Conditional ministry promises do not independently require a cap raise.
        return record.status == "pending_budget" && record.target > projection.cap ||
            projection.levels[record.kind] >= record.target;
    }
    function project(proposal) {
        var tax = proposal.tax_policy_level;
        var cap = proposal.social_spending_cap;
        var valid = origin.year == Q.year && Number.isInteger(tax) && tax >= taxMin && tax <= taxMax &&
            Number.isInteger(cap) && cap >= capMin && cap <= capMax &&
            (cap == 3 || Q.education_spending != 3 && Q.healthcare_spending != 3);
        var levels = {};
        var cuts = [];
        for (var kind of spending) {
            levels[kind] = Q[kind];
            if (Q[kind] > cap) {
                cuts.push(kind);
                if (origin.author != "player") valid = false;
                if (Q[kind] <= 2) levels[kind] = cap;
            }
        }
        for (var record of commitments) {
            if (record.status != "pending_budget" || !spending.includes(record.kind)) continue;
            var current = levels[record.kind];
            if (Number.isInteger(current) && current >= -2 && current <= 2 && Number.isInteger(record.target) && record.target >= -2 && record.target <= 2 && record.target <= cap)
                levels[record.kind] = Math.max(current, record.target);
        }
        var preparedLevels = {education_spending:Q.education_prepared_level,
            healthcare_spending:Q.healthcare_prepared_level, public_salary_level:Q.public_salary_prepared_level};
        for (var kind of spending) {
            var target = preparedLevels[kind];
            if (target != null && target == Q[kind] + 1 && Q[kind] >= -2 && Q[kind] < 2 && target <= cap)
                levels[kind] = Math.max(levels[kind], target);
        }
        var cost = 0;
        for (var key of Object.keys(projectIds)) {
            if (!proposal.projects[key]) continue;
            if (!available[key]) valid = false;
            cost += projectCosts[key];
        }
        var profile = taxProfiles[tax + 2];
        var margin = 1 + origin.surplus_at_draft / 0.7 + profile.revenue -
            taxProfiles[origin.enacted_tax_policy_level + 2].revenue -
            2 * (cap - origin.enacted_social_spending_cap) - cost;
        var result = {valid:valid, tax:tax, cap:cap, levels:levels, cuts:cuts,
            margin:margin, shortfall:Math.max(0, -margin), taxProfile:profile};
        result.brokenCabinet = commitments.filter(function (r) { return r.scope == "cabinet" && !matches(r, result); });
        result.brokenExternal = commitments.filter(function (r) { return r.scope == "external_support" && !matches(r, result); });
        return result;
    }
    var projection = project(draft);
    Q.parlament_budget_projection = projection;
    Q.parlament_budget_tax_name = projection.taxProfile.name;
    Q.parlament_budget_cap_name = capNames[projection.cap + 2];
    var commitmentNames = {social_spending_cap:"Higher social spending authorization", education_spending:"Education improvement",
        healthcare_spending:"Health improvement", public_salary_level:"Public-pay improvement", tax_policy_level:"Higher Regional Taxes"};
    Q.parlament_budget_commitment_summary = commitments.map(function (record) {
        var outcome;
        if (!matches(record, projection)) outcome = "this draft would breach the government-formation agreement";
        else if (record.status == "pending_budget" && spending.includes(record.kind) && record.target > projection.cap)
            outcome = "remains conditional on future funding on a social spending cap increase";
        else outcome = record.status == "pending_budget" ? "would be fulfilled" : "would be maintained";
        return commitmentNames[record.kind] + " (" + (record.scope == "cabinet" ? "cabinet agreement" : "agreed") + "): " + outcome + ".";
    }).join(" ");
    Q.parlament_budget_cabinet_breach_text = projection.brokenCabinet.map(function (record) { return commitmentNames[record.kind]; }).join(", ");
    Q.parlament_budget_external_breach_text = projection.brokenExternal.map(function (record) { return commitmentNames[record.kind]; }).join(", ");
    Q.parlament_budget_margin = projection.margin;
    Q.parlament_budget_shortfall = projection.shortfall;
    Q.parlament_budget_player_authored = origin.author == "player";
    Q.parlament_budget_education_cut = projection.cuts.includes("education_spending");
    Q.parlament_budget_health_cut = projection.cuts.includes("healthcare_spending");
    Q.parlament_budget_pay_cut = projection.cuts.includes("public_salary_level");
    Q.parlament_budget_inherited_deficit = origin.surplus_at_draft < 0;
    Q.parlament_budget_tax_lower = draft.tax_policy_level > taxMin;
    Q.parlament_budget_tax_higher = draft.tax_policy_level < taxMax;
    var lowerCap = {tax_policy_level:draft.tax_policy_level, social_spending_cap:draft.social_spending_cap - 1, projects:draft.projects};
    Q.parlament_budget_cap_lower = draft.social_spending_cap > capMin && project(lowerCap).valid;
    Q.parlament_budget_cap_higher = draft.social_spending_cap < capMax;
    Q.parlament_budget_player_governs = !!Q.player_party && !Q.cat_caretaker_gov && belongs(Q.player_party, cabinet);
    Q.parlament_budget_executive_grant = Q.parlament_budget_player_governs ?
        projection.margin >= 2 ? 2 : projection.margin >= -1 ? 1 : 0 : 0;

    var roadmap = 0;
    for (var party of cabinet) {
        roadmap = Math.max(roadmap, Number(Q[party + "_roadmap"]) || 0);
        if (party == "jxsi" || party == "jxcat")
            for (var member of ["ciu", "cdc", "dl", "pdcat", "junts", "erc", "cup"])
                if (Q[member + "_in_" + party]) roadmap = Math.max(roadmap, Number(Q[member + "_roadmap"]) || 0);
    }
    Q.parlament_budget_government_roadmap = roadmap;
    var pscFacesIndyCabinet = !cabinet.includes("psc") && roadmap >= 1 &&
        cabinet.some(function (p) { return ["erc", "cup", "jxsi", "jxcat"].includes(p); });
    function promised(party, kind, p) {
        return commitments.some(function (r) {
            return r.kind == kind && belongs(party, r.signatories || []) && matches(r, p) &&
                (kind == "tax_policy_level" ? p.tax : p.cap) <= r.target;
        });
    }
    function hardVetoReasons(party, proposal, p) {
        var reasons = [];
        var expanding = p.cap > origin.enacted_social_spending_cap;
        if (!p.valid) reasons.push("when does this even fire? report a bug if you see this");
        if (p.brokenCabinet.length && belongs(party, cabinet)) reasons.push("The proposed budget contradicts the cabinet's policy agreement.");
        if (belongs(party, (Q.cat_coalition_support || []).concat(Q.cat_coalition_abstain || [])) && p.brokenExternal.some(function (r) {
            return belongs(party, r.signatories || []);
        })) reasons.push("The proposed budget goes against coalition-support agreement.");
        if (party == "ciu" && p.tax >= 2 && !promised(party, "tax_policy_level", p))
            reasons.push("CiU will not approve of such a radical tax increase.");
        if (party == "ciu" && p.shortfall > 0) reasons.push("CiU will not approve a budget with a funding gap.");
        if (["cdc", "dl", "pdcat", "junts", "unio"].includes(party) && p.shortfall > 1)
            reasons.push(party + " will not accept this large a funding gap.");
        if (["ciu", "cdc", "dl", "pdcat", "junts", "unio", "ppc", "cs"].includes(party) && expanding &&
            origin.surplus_at_draft < 0 && !promised(party, "social_spending_cap", p))
            reasons.push("They oppose a higher spending cap while the Generalitat remains in deficit.");
        if (["erc", "cup", "psc", "icv", "csqp", "cecp", "ecp"].includes(party) && p.cuts.length)
            reasons.push(party + " will not accept compulsory cuts to public services.");
        if (["cup", "icv", "csqp", "cecp", "ecp"].includes(party) && proposal.projects.b40)
            reasons.push("They oppose the building of the Fourth Belt.");
        if (["icv", "csqp", "cecp", "ecp"].includes(party) && Q.year >= 2013 && roadmap > 1) {
            var exceptional = party == "csqp" && Q.csqp_leader == "Arcadi Oliveres" ||
                party == "cecp" && ["Arcadi Oliveres", "Jaume Asens"].includes(Q.cecp_leader);
            if (!exceptional) reasons.push("Their leadership is against the Generalitat's current independence roadmap.");
            else if (!expanding || p.tax < 1) reasons.push("Their leadership expects expanded social funding and a credible tax package.");
        }
        if (party == "psc" && Q.year >= 2013 && roadmap > 1) {
            if (Q.psc_leader != "Montserrat Tura") reasons.push("The PSC will not support this government's independence roadmap.");
            else if (!expanding || p.tax < 1 || proposal.projects.b40) reasons.push("The PSC expoects greater funding for public services.");
        }
        if (["ppc", "cs"].includes(party) && Q.year >= 2013 && roadmap > 0)
            reasons.push("Their leadership is against the Generalitat's current independence roadmap.");
        return reasons;
    }
    function basePosition(party) {
        var tax = projection.tax;
        var capChange = projection.cap - origin.enacted_social_spending_cap;
        var expanding = capChange > 0 || spending.some(function (kind) { return projection.levels[kind] > Q[kind]; });
        var metro = draft.projects.metro1 || draft.projects.metro2 || draft.projects.rail1 ||
            draft.projects.rail2 || draft.projects.tmobilitat2;
        if (["ciu", "cdc", "dl", "pdcat", "junts", "unio"].includes(party))
            return projection.shortfall == 0 && (capChange <= 0 || promised(party, "social_spending_cap", projection)) &&
                (tax < 2 || promised(party, "tax_policy_level", projection)) ? "yes" : "no";
        var agreedTax = promised(party, "tax_policy_level", projection);
        var agreedCap = promised(party, "social_spending_cap", projection);
        if (party == "erc") return (tax >= 1 || agreedTax) && (projection.cap >= Math.min(0, origin.enacted_social_spending_cap) || agreedCap) ? "yes" : "no";
        if (party == "cup") return (expanding || projection.cap >= 1 || agreedCap) && (tax >= 2 || tax >= 1 && (draft.projects.metro2 || draft.projects.rail2 || draft.projects.tmobilitat2 || draft.projects.water3) || agreedTax) ? "yes" : "no";
        if (["icv", "csqp", "cecp", "ecp"].includes(party)) return (expanding || projection.cap >= 1 || agreedCap) && (tax >= 1 || agreedTax) ? "yes" : "no";
        if (party == "psc") return (pscFacesIndyCabinet ? expanding && (tax == 1 || tax == 2 && metro) :
            (projection.cap >= Math.min(0, origin.enacted_social_spending_cap) || agreedCap) && (tax >= 0 || agreedTax) && (tax < 2 || metro || agreedTax)) ? "yes" : "no";
        if (["ppc", "cs"].includes(party)) return (capChange <= 0 || agreedCap) && (tax <= 0 || agreedTax) && projection.shortfall == 0 ? "yes" : "no";
        return party == "si" ? "abstain" : "no";
    }
    var deals = Q.parlament_budget_deals;
    var playerVehicle = Q.player_in_jxsi && Q.jxsi_parlament_s > 0 ? "jxsi" :
        Q.player_in_jxcat && Q.jxcat_parlament_s > 0 ? "jxcat" : Q.player_party;
    function position(party) {
        // The player's choice controls their live ballot carrier.
        if (party == playerVehicle && Q.parlament_budget_player_vote != "auto")
            return Q.parlament_budget_player_vote == "yes" && !Q.parlament_budget_player_can_yes ? "no" : Q.parlament_budget_player_vote;
        if (party == "jxsi" || party == "jxcat") {
            var members = ["cdc"];
            if (Q["erc_in_" + party]) members.push("erc");
            if (Q["cup_in_" + party]) members.push("cup");
            var memberVotes = members.map(position);
            return memberVotes.every(function (v) { return v == "yes"; }) ? "yes" : memberVotes.includes("no") ? "no" : "abstain";
        }
        if (hardVetoReasons(party, draft, projection).length) return "no";
        if (deals.some(function (d) { return d.party == party; })) return "yes";
        return basePosition(party);
    }
    function hasSeats(party) {
        if (Q[party + "_parlament_s"] > 0) return true;
        if (["erc", "cup"].includes(party)) return ["jxsi", "jxcat"].some(function (list) { return Q[party + "_in_" + list] && Q[list + "_parlament_s"] > 0; });
        return ["ciu", "cdc", "dl", "pdcat", "junts"].includes(party) && (Q.jxsi_parlament_s > 0 || Q.jxcat_parlament_s > 0);
    }
    Q.parlament_budget_player_has_seats = hasSeats(playerVehicle);
    Q.parlament_budget_player_policy_can_yes = !hardVetoReasons(Q.player_party, draft, projection).length;
    Q.parlament_budget_player_default = Q.parlament_budget_player_policy_can_yes ? basePosition(Q.player_party) : "no";
    Q.parlament_budget_player_resource_required = Q.parlament_budget_player_default == "no" &&
        (Q.player_party == "erc" && projection.tax <= 0 || Q.player_party == "cup" && projection.tax < 2) ? 1 : 0;
    Q.parlament_budget_player_can_yes = Q.parlament_budget_player_policy_can_yes && Q.party_resources >= Q.parlament_budget_player_resource_required;
    Q.parlament_budget_player_resource_cost = Q.parlament_budget_player_vote == "yes" && Q.parlament_budget_player_default == "no" ? Q.parlament_budget_player_resource_required : 0;
    Q.parlament_budget_player_position = position(playerVehicle);
    var parties = ["ciu", "cdc", "dl", "pdcat", "junts", "jxsi", "jxcat", "erc", "cup", "psc", "icv", "csqp", "cecp", "ecp", "ppc", "cs", "unio", "si", "vox", "pxc", "fnc"];
    var labels = {ciu:"CiU", cdc:"CDC", dl:"DL", pdcat:"PDeCAT", junts:"Junts", jxsi:"JxSí", jxcat:"JxCat", erc:"ERC", cup:"CUP", psc:"PSC", icv:"ICV-EUiA", csqp:"CSQP", cecp:"CECP", ecp:"ECP", ppc:"PPC", cs:"Cs", unio:"UDC", si:"SI", vox:"Vox", pxc:"PxC", fnc:"FNC"};
    var groups = {yes:[], abstain:[], no:[]};
    var counts = {yes:0, abstain:0, no:0};
    var positions = {};
    for (var party of parties) {
        var seats = Number(Q[party + "_parlament_s"]) || 0;
        if (seats <= 0) continue;
        var vote = position(party);
        positions[party] = vote;
        groups[vote].push({label:labels[party]});
        counts[vote] += seats;
    }
    Q.parlament_budget_positions = positions;
    Q.parlament_budget_yes = counts.yes;
    Q.parlament_budget_no = counts.no;
    Q.parlament_budget_abstain = counts.abstain;
    Q.parlament_budget_chamber_majority = counts.yes > counts.no;
    Q.parlament_budget_cabinet_yes = cabinet.every(function (p) { return position(p) == "yes"; });
    Q.parlament_budget_can_pass = projection.valid && Q.parlament_budget_chamber_majority && Q.parlament_budget_cabinet_yes;
    Q.parlament_budget_vote_result = {outcomes:[{kind:"yes", label:"Yes", votes:counts.yes, parties:groups.yes},
        {kind:"abstain", label:"Abstention", votes:counts.abstain, parties:groups.abstain},
        {kind:"no", label:"No", votes:counts.no, parties:groups.no}]};

    var ciuTarget = Q.parlament_current_ciu;
    if (ciuTarget == "jxcat" || !Q[ciuTarget + "_parlament_s"] && (Q.jxsi_parlament_s > 0 || Q.jxcat_parlament_s > 0)) ciuTarget = "cdc";
    Q.parlament_budget_ciu_target = ciuTarget;
    Q.parlament_budget_ciu_label = ciuTarget == "cdc" && (Q.jxsi_parlament_s > 0 || Q.jxcat_parlament_s > 0) ? "the CDC wing of the unity list" : labels[ciuTarget];
    Q.parlament_budget_icv_target = Q.parlament_current_icv;
    Q.parlament_budget_deal_proposals = {};
    function supportOffer(party) {
        var business = ["ciu", "cdc", "dl", "pdcat", "junts"].includes(party);
        var proposed = {tax_policy_level:draft.tax_policy_level, social_spending_cap:draft.social_spending_cap, projects:Object.assign({}, draft.projects)};
        var terms = [];
        if (business) {
            proposed.tax_policy_level = Math.max(taxMin, draft.tax_policy_level - 1);
            proposed.social_spending_cap = Math.max(capMin, draft.social_spending_cap - 1);
            // A promised authorization is a binding cabinet term, not a concession to reverse.
            for (var r of commitments) if (r.scope == "cabinet" && r.kind == "social_spending_cap") proposed.social_spending_cap = Math.max(proposed.social_spending_cap, r.target);
            if (!project(proposed).valid) proposed.social_spending_cap = draft.social_spending_cap;
            if (available.county) proposed.projects.county = true;
            if (available.b40) proposed.projects.b40 = true;
            if (available.water2) proposed.projects.water2 = true;
            if (available.rail1) proposed.projects.rail1 = true;
            if (available.icf && Q.bnl_icf_prepared_branch == "guarantees") proposed.projects.icf = true;
        } else {
            proposed.tax_policy_level = Math.min(taxMax, draft.tax_policy_level + 1);
            proposed.social_spending_cap = Math.min(capMax, draft.social_spending_cap + 1);
            if (["cup", "icv", "csqp", "cecp", "ecp"].includes(party)) proposed.projects.b40 = false;
            if (available.metro2) proposed.projects.metro2 = true;
            else if (available.metro1) proposed.projects.metro1 = true;
            else if (available.rail2) proposed.projects.rail2 = true;
            else if (available.tmobilitat2) proposed.projects.tmobilitat2 = true;
            else if (available.rail1) proposed.projects.rail1 = true;
            if (available.water3) proposed.projects.water3 = true;
            else if (available.water2) proposed.projects.water2 = true;
            if (available.icf && Q.bnl_icf_prepared_branch == "cooperative") proposed.projects.icf = true;
        }
        if (proposed.tax_policy_level != draft.tax_policy_level) terms.push("Autonomic Taxes: " + taxProfiles[proposed.tax_policy_level + 2].name + ".");
        if (proposed.social_spending_cap != draft.social_spending_cap) terms.push("Spending authorization: " + capNames[proposed.social_spending_cap + 2] + ".");
        var projectNames = {county:"county roads", b40:"the B-40", metro1:"the L9/L10", metro2:"the L1/L3 expansion", water2:"public water facilities", water3:"public water supply and management", tmobilitat2: "Catalonia-wide T-mobilitat", rail1:"the Lleida-La Pobla railway", rail2:"the Tarragona and Girona train-trams", icf:Q.parlament_budget_icf_name, digital:"fully-digital administration", universal:"truly universal healthcare access"};
        for (var key of Object.keys(projectIds)) if (proposed.projects[key] != draft.projects[key]) terms.push((proposed.projects[key] ? "Fund " : "Remove ") + projectNames[key] + ".");
        var p = project(proposed);
        var reasons = hardVetoReasons(party, proposed, p);
        if (!terms.length && basePosition(party) == "no") reasons.push("No acceptable policy concession seem possible with them at the moment...");
        var threshold = party == "cup" && ["Endavant", "Third Sector"].includes(Q.cup_faction) ? 65 : 55;
        if (Q.party_resources <= Q.parlament_budget_player_resource_cost) reasons.push("Not enough resources.");
        if ((Number(Q[party + "_relations"]) || 0) <= threshold) reasons.push("Our relations with " + (labels[party] || party) + " are not good enough.");
        Q.parlament_budget_deal_proposals[party] = proposed;
        return {possible:!reasons.length, reason:reasons.join(" "), terms:terms.join(" ") || "Support the existing terms."};
    }
    var approachParties = {cup:"cup", psc:"psc", erc:"erc", icv:Q.parlament_budget_icv_target, ciu:ciuTarget};
    for (var key of Object.keys(approachParties)) {
        var party = approachParties[key];
        var eligible = key == "cup" || key == "psc" ? Q.player_party == "erc" : key == "erc" ? Q.player_party == "cup" : true;
        var offer = supportOffer(party);
        Q["parlament_budget_can_approach_" + key] = eligible && party != Q.player_party && hasSeats(party) && position(party) != "yes" && !deals.some(function (d) { return d.party == party; });
        Q["parlament_budget_" + key + "_deal_possible"] = offer.possible;
        Q["parlament_budget_" + key + "_block_reason"] = offer.reason;
        Q["parlament_budget_" + key + "_deal_terms"] = offer.terms;
    }
    Q.parlament_budget_deal_names = deals.map(function (d) { return labels[d.party]; }).join(", ");
    Q.parlament_budget_npc_deal_count = deals.length;
    Q.parlament_budget_constituency_weights = {barcelona:1.05, girona:0.95, lleida:0.90, tarragona:1.10};
    function carrier(party) {
        if (["ciu", "cdc", "dl", "pdcat", "junts"].includes(party)) party = "ciu";
        if (["icv", "csqp", "cecp", "ecp"].includes(party)) party = "federal_left";
        for (var list of ["jxsi", "jxcat"]) if (Q[party + "_in_" + list] && Q[list + "_parlament_s"] > 0) return list;
        return party;
    }
    var outsideYes = Object.keys(positions).filter(function (p) { return positions[p] == "yes" && !belongs(p, cabinet); });
    Q.parlament_budget_actors = [];
    function addActors(parties, share) {
        var carriers = parties.map(carrier).filter(function (p, i, all) { return all.indexOf(p) == i; });
        for (var party of carriers) Q.parlament_budget_actors.push({party:party, weight:share / carriers.length});
    }
    addActors(cabinet, outsideYes.length ? 0.8 : 1);
    addActors(outsideYes, 0.2);
    Q.parlament_budget_cabinet_actors = [];
    var cabinetCarriers = cabinet.map(carrier).filter(function (p, i, all) { return all.indexOf(p) == i; });
    for (var party of cabinetCarriers) Q.parlament_budget_cabinet_actors.push({party:party, weight:1 / cabinetCarriers.length});
    Q.parlament_budget_tax_change = projection.tax - origin.enacted_tax_policy_level;
!}

= Budget Negotiations

[? if economy_minister_gender = "f": Consellera?][? if economy_minister_gender = "m": Conseller?] of Economy [+ economy_minister +] has submitted a budget for the [+ year +], which would give the current [+ cat_coalition_disp +] breathing room to operate. [? if parlament_budget_changes_made: After amendments, the terms are:?][? if not parlament_budget_changes_made: [? if economy_minister_gender = "f": Her?][? if economy_minister_gender = "m": His?] proposed terms are:?]

· Autonomic Taxes: **[+ parlament_budget_tax_name +]**.

· Spending authorization: **[+ parlament_budget_cap_name +]**.

[? if parlament_budget_education_cut: · Education spending will be reduced to fit the proposed ceiling.?]
[? if parlament_budget_health_cut: · Health spending will be reduced to fit the proposed ceiling.?]
[? if parlament_budget_pay_cut: · Public salaries will be reduced to fit the proposed ceiling.?]
[? if parlament_budget_county: · Fund the prepared county-roads expansion.?]
[? if parlament_budget_b40: · Fund the prepared Fourth Belt B-40 extension.?]
[? if parlament_budget_metro1: · Fund the prepared L9/L10 Metro project.?]
[? if parlament_budget_metro2: · Fund the prepared L1/L3 Metro expansion.?]
[? if parlament_budget_water2: · Fund expanded public water facilities.?]
[? if parlament_budget_water3: · Fund public water supply and management.?]
[? if parlament_budget_tmobilitat2: · Fund public Catalonia-wide T-mobilitat.?]
[? if parlament_budget_rail1: · Fund the Lleida-La Pobla railway.?]
[? if parlament_budget_rail2: · Fund the Tarragona and Girona train-trams.?]
[? if parlament_budget_icf: · Fund [+ parlament_budget_icf_name +].?]
[? if parlament_budget_digital: · Fund the transformation into a Fully-Digital administration.?]
[? if parlament_budget_universal: · Fund truly universal healthcare access.?]

[? if parlament_budget_commitment_summary: **Agreed policy commitments:** [+ parlament_budget_commitment_summary +]?]

[? if parlament_budget_cabinet_breach_text: **Cabinet agreement breached:** [+ parlament_budget_cabinet_breach_text +].?]

[? if parlament_budget_external_breach_text: **Outside investiture agreement breached:** [+ parlament_budget_external_breach_text +].?]

[? if parlament_budget_shortfall > 0: This proposed budget includes a **funding gap**, which the Generalitat will have to finance with debt. ?][? if parlament_budget_shortfall = 0: This proposed budget is, in principle, within projected fiscal room.?] [? if parlament_budget_inherited_deficit and parlament_budget_shortfall = 0: The Generalitat nevertheless inherits a deficit, so at best this would improve the current situation. ?]

<div data-widget="chamber-vote" data-props='{"configFrom":"parlament_budget_vote_result"}'></div>

[? if parlament_budget_npc_deal_count > 0: Support has been negotiated with [+ parlament_budget_deal_names +]. **Further amendments void these agreements.**?]
[? if parlament_budget_player_vote = "yes" and parlament_budget_player_default = "no": Our support for this compromise may cause internal dissent if it passes.?]

