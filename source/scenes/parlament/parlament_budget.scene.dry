call: generalitat_setpolicy

The Parlament has approved the [+ year +] budget with [+ parlament_budget_yes +] votes in favour. The Generalitat can now fund the projects included in it.

- @post_event

@continue
view-if: not budget_external_breach
go-to: post_event

@walk_away
title: [? if parlament_budget_can_pass: Withdraw our budget proposal?][? if not parlament_budget_can_pass: No budget agreement can be reached...?]
subtitle: The Generalitat will continue to operate under its [+ budget_year +] budget.
choose-if: parlament_budget_player_authored or not parlament_budget_can_pass
unavailable-subtitle: This government has enough votes to pass its proposal.
on-arrival: {!
    Q.parlament_budget_trust_outcome = "";
    if (Q.budget_year >= Q.year) throw new Error("This year's budget has already been approved");
    if (Q.parlament_budget_can_pass && !Q.parlament_budget_player_authored) throw new Error("An NPC budget with sufficient support cannot be withdrawn");
    if (Q.parlament_budget_failed_year != Q.year) {
        var penalty = Q.parlament_budget_can_pass ? 0.32 : 0.18;
        // Disappointment follows actual prepared or signed service delivery, not an edited ceiling.
        var missed = 0;
        var electoralProposalIds = {education_spending:"education_spending_proposal", healthcare_spending:"healthcare_spending_proposal", public_salary_level:"public_salary_proposal"};
        for (var electoralKind of Object.keys(electoralProposalIds)) {
            var electoralProposal = (Q.active_mods || {})[electoralProposalIds[electoralKind]];
            var electoralPromised = (Q.coalition_policy_commitments || []).some(function (r) {
                return r.kind == electoralKind && r.status == "pending_budget" && r.target > Q[electoralKind];
            });
            if (electoralProposal && electoralProposal.active || electoralPromised) missed += 1;
        }
        var electoralPolicies = [{origin:Q.player_party, actors:Q.parlament_budget_cabinet_actors,
            direction:-1, demographics:{middle:penalty, young:penalty, ind:penalty},
            provinces:Q.parlament_budget_constituency_weights,
            losses:Q.player_party == "cup" ? [["abstain",0.60],["federal_left",0.25],["erc",0.15]] :
                [["abstain",0.60],["cup",0.20],["federal_left",0.20]],
            barcelona:(penalty > 0.2 ? 0.04 : 0.02), congreso:(penalty > 0.2 ? 0.02 : 0.01)}];
        if (missed) electoralPolicies.push({origin:Q.player_party, actors:Q.parlament_budget_cabinet_actors,
            direction:-missed, demographics:{young:0.12,unemployed:0.12,ind:0.12},
            provinces:Q.parlament_budget_constituency_weights, barcelona:(0.01), congreso:(0.005)});

    // Named routes keep their shares when a donor is absent or on the same list.
    for (var electoralPolicy of electoralPolicies) {
        var voterOrigin = electoralPolicy.origin;
        var voterActors = [];
        for (var electoralActor of electoralPolicy.actors) voterActors.push({party:electoralActor.party,
            origin:["jxsi","jxcat"].includes(electoralActor.party) ? voterOrigin : electoralActor.party,weight:electoralActor.weight});
        var voterCells = [];
        for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || []) {
            var voterAmount = (electoralPolicy.demographics[voterDemo] || 0) * (electoralPolicy.provinces[voterProvince] || 0);
            if (voterAmount) voterCells.push({contest:"parlament",province:voterProvince,demo:voterDemo,amount:voterAmount});
        }
        if (electoralPolicy.congreso && (Q.congreso_constituencies || []).includes("catalunya")) voterCells.push({contest:"congreso",province:"catalunya",demo:null,amount:electoralPolicy.congreso});
        if (electoralPolicy.barcelona) voterCells.push({contest:"barcelona",province:null,demo:null,amount:electoralPolicy.barcelona});
        for (var voterCell of voterCells) {
            var voterContest = voterCell.contest;
            var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
            var voterSignedAmount = voterCell.amount * (Math.abs(electoralPolicy.direction));
            if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
            var voterDirection = electoralPolicy.direction > 0 ? 1 : -1;
            for (var voterActor of voterActors) {
                var voterRouteList = electoralPolicy.direction > 0 ? electoralPolicy.gains : electoralPolicy.losses || (voterActor.origin == "erc" ? [["cup",0.45],["fl",0.35],["abstain",0.20]] : voterActor.origin == "cup" ? [["fl",0.45],["erc",0.35],["abstain",0.20]] : voterActor.origin == "psc" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : ["ecp","cecp","csqp","icv","federal_left"].includes(voterActor.origin) ? [["cup",0.40],["erc",0.30],["abstain",0.30]] : [["erc",0.40],["fl",0.35],["abstain",0.25]]);
                for (var voterRoute of voterRouteList) {
                    var voterPair = [];
                    for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                        var voterCandidates = [voterParty];
                        if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                        if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                        if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                        if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                        if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                        if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                        var voterCarrier = null;
                        for (var voterCandidate of voterCandidates) {
                            if (!voterLineup.includes(voterCandidate)) continue;
                            if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                            if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                        }
                        voterPair.push(voterCarrier);
                    }
                    if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                    var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                    var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                    if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                    if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                    G.cardSupportTransfer(Q,voterOptions);

                }
            }
        }
    }

        Q.parlament_budget_failed_year = Q.year;
        Q.budget_failed_times += 1;
    }
    Q.parlament_budget_trust_outcome = "failure";
    Q.coming_from_parlament = false;
!}
call: parlament_budget.trust_loss

No agreement seems to be possible... The Generalitat will continue to operate under its last approved budget from [+ budget_year +].

- @post_event

@trust_loss
on-arrival: {!
    Q.parlament_budget_trust_loss_applied = false;
    var vehicle = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    var cabinet = Q.cat_coalition || [];
    // A united cabinet blocked by the chamber has not lost trust in its partners.
    if (["postpone", "failure"].includes(Q.parlament_budget_trust_outcome) &&
        !Q.cat_caretaker_gov && Q.budget_year < Q.year &&
        Q.budget_draft_origin && Q.budget_draft_origin.year == Q.year &&
        cabinet.includes(vehicle) && cabinet.length > 1 && Q.parlament_budget_cabinet_yes === false) {
        if (!Q.budget_trust_record || Q.budget_trust_record.year != Q.year)
            Q.budget_trust_record = {year:Q.year, failed:false, losses:{}};
        var record = Q.budget_trust_record;
        if (Q.parlament_budget_trust_outcome == "failure" && !record.failed) {
            record.failed = true;
            Q.budget_internal_failed_times = (Number(Q.budget_internal_failed_times) || 0) + 1;
        }
        var loss = Q.parlament_budget_trust_outcome == "failure" ?
            (Q.budget_internal_failed_times > 1 ? 5 : 3) : 1;
        // Postponement is part of the eventual annual loss, not an extra charge.
        // Include represented list members, while excluding the player's vehicle.
        var recipients = new Set();
        for (var partner of cabinet.filter(function(p) { return p != vehicle; })) {
            recipients.add(partner);
            if (partner == "jxsi" || partner == "jxcat")
                for (var member of Q.parties || []) if (Q[member + "_in_" + partner]) recipients.add(member);
        }
        for (var partner of recipients) {
            if (partner == Q.player_party || !Number.isFinite(Q[partner + "_relations"])) continue;
            var previous = record.losses[partner] || 0;
            if (loss > previous) {
                Q[partner + "_relations"] = Math.max(0, Q[partner + "_relations"] - (loss - previous));
                record.losses[partner] = loss;
                Q.parlament_budget_trust_loss_applied = true;
                Q.coalition_rupture_recheck = true;
            }
        }
    }
!}
