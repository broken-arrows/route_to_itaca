@make_deal
on-arrival: {!
    var party = Q.parlament_budget_deal_party;
    var key = party == Q.parlament_budget_ciu_target ? "ciu" : party == Q.parlament_budget_icv_target ? "icv" : party;
    if (!Q["parlament_budget_" + key + "_deal_possible"] || Q.party_resources <= Q.parlament_budget_player_resource_cost)
        throw new Error("Budget support negotiations are unavailable");
    var proposal = Q.parlament_budget_deal_proposals[party];
    // Terms are charged only through the projection. Keep earlier deals only
    // while their exact accepted clauses remain intact.
    Q.parlament_budget_deals = Q.parlament_budget_deals.filter(function (deal) {
        return deal.tax == proposal.tax_policy_level && deal.cap == proposal.social_spending_cap &&
            Object.keys(proposal.projects).every(function (key) { return deal.projects[key] == proposal.projects[key]; });
    });
    Q.budget_draft = {tax_policy_level:proposal.tax_policy_level, social_spending_cap:proposal.social_spending_cap, projects:Object.assign({}, proposal.projects)};
    Q.parlament_budget_deals.push({party:party, tax:proposal.tax_policy_level, cap:proposal.social_spending_cap, projects:Object.assign({}, proposal.projects)});
    Q.parlament_budget_changes_made = true;
    Q.party_resources -= 1;
    Q[party + "_relations"] -= 5;
!}
go-to: review

@postpone
title: Can we instead postpone the vote?
choose-if: month < 11 and not parlament_budget_can_pass
unavailable-subtitle: [? if month >= 11 : The year is already about to end. ?][? if parlament_budget_can_pass: There is already a majority supporting this budget. ?]
on-arrival: {!
    Q.parlament_budget_trust_outcome = "";
    if (Q.month >= 11 || Q.parlament_budget_can_pass || Q.budget_year >= Q.year)
        throw new Error("Budget postponement conditions changed");
    Q.budget_postponed_trigger = false;
    Q.budget_postponed_countdown = 11 - Q.month;
    if (!Q.countdowns.includes("budget_postponed")) Q.countdowns.push("budget_postponed");
    Q.parlament_budget_trust_outcome = "postpone";
!}
call: parlament_budget.trust_loss

The Parlament will reconvene in [+ budget_postponed_countdown +] [? if rubicon: weeks?][? if not rubicon: months?] to discuss the budget again. Let's hope negotiations are more fruitful then... 


@pass
title: Approve the budget
subtitle: [? if parlament_budget_player_governs: \[ +[+ parlament_budget_executive_grant +] budget\]?]
choose-if: parlament_budget_can_pass
unavailable-subtitle: [? if not parlament_budget_chamber_majority: Not enough parliamentary support.?][? if not parlament_budget_cabinet_yes: Every cabinet party must approve the budget.?]
on-arrival: {!
    if (!Q.parlament_budget_can_pass || Q.budget_year >= Q.year || Q.party_resources < Q.parlament_budget_player_resource_cost)
        throw new Error("Budget approval conditions changed");
    // Recheck ICF funding authority before charging resources or enacting any terms.
    if (Q.budget_draft.projects.icf) {
        var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
        var icfProposal = (Q.active_mods || {}).bnl_icf_proposal;
        if (Q.cat_caretaker_gov || !controlledParties.includes(Q.bnl_minister_party) ||
            !controlledParties.includes(Q.economy_minister_party) || Q.bnl_icf_level != 1 ||
            !["guarantees", "cooperative"].includes(Q.bnl_icf_prepared_branch) ||
            !icfProposal || !icfProposal.active || icfProposal.def.colour != "gray")
            throw new Error("ICF budget funding conditions changed");
    }
    // Recheck digital authority before any budget mutation, even for a stale YES.
    if (Q.budget_draft.projects.digital) {
        var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
        var digitalProposal = (Q.active_mods || {}).vp_digital3_proposal;
        if (Q.cat_caretaker_gov || !controlledParties.includes(Q.vicepresident_party) || Q.vp_digital_level != 2 ||
            !Q.vp_digital_prepared || !digitalProposal || !digitalProposal.active || digitalProposal.def.colour != "gray" ||
            !(Q.parlament_digital_passed && ["generalitat", "catalonia"].includes(Q.cybersecurity_agency_scope) && (Q.active_mods || {}).digital_agency_core && Q.active_mods.digital_agency_core.active)) throw new Error("Digital budget funding conditions changed");
    }
    // Recheck health authority before charging resources or enacting any budget terms.
    if (Q.budget_draft.projects.universal) {
        var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
        var universalProposal = (Q.active_mods || {}).healthcare_universal_proposal;
        if (Q.cat_caretaker_gov || !controlledParties.includes(Q.health_minister_party) || Q.healthcare_universal_level != 1 ||
            !Q.healthcare_universal_introduced || !universalProposal || !universalProposal.active || universalProposal.def.colour != "gray")
            throw new Error("Universal healthcare budget funding conditions changed");
    }
    var projection = Q.parlament_budget_projection;
    var origin = Q.budget_draft_origin;
    Q.party_resources -= Q.parlament_budget_player_resource_cost;
    if (Q.parlament_budget_player_governs) Q.government_budget += Q.parlament_budget_executive_grant;
    var creditBurden = Q.parlament_budget_player_governs &&
        (Q.burdens_start_countdown > 0 || Q.burdens_start_trigger || Q.burdens_goal > 0 && Q.burdens_time > 0);
    var spending = ["education_spending", "healthcare_spending", "public_salary_level"];
    var enactedBefore = {tax_policy_level:Q.tax_policy_level};
    for (var kind of spending) enactedBefore[kind] = Q[kind];
    var deliveredCommitments = (Q.coalition_policy_commitments || []).filter(function (record) {
        if (record.status != "pending_budget" || record.kind == "social_spending_cap") return false;
        var actual = record.kind == "tax_policy_level" ? projection.tax : projection.levels[record.kind];
        return actual >= record.target && actual > enactedBefore[record.kind];
    });
    var taxChange = Q.parlament_budget_tax_change;
    if (Q.parlament_budget_player_governs && projection.tax < enactedBefore.tax_policy_level &&
        (Q.player_party == "cup" || enactedBefore.tax_policy_level > 0)) Q.burdens_broken = true;
    // Count each delivered tier once, regardless of overlapping ministry/coalition promises.
    if (creditBurden) {
        for (var kind of spending) Q.burdens_done += Math.max(0, projection.levels[kind] - enactedBefore[kind]);
        for (var record of deliveredCommitments) {
            if (record.kind == "tax_policy_level") Q.burdens_done += 1;
        }
    }
    var electoralPolicies = [];
    var electoralServiceProfiles = {
        "healthcare_spending": {
            "provinces": {
                "barcelona": 1,
                "girona": 1.1,
                "lleida": 1.1,
                "tarragona": 1.05
            },
            "tiers": [
                {
                    "retired": 0.9,
                    "ind": 0.8,
                    "unemployed": 0.7,
                    "young": 0.3,
