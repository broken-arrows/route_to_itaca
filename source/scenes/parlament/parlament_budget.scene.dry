@make_deal
on-arrival: {!
    var party = Q.parlament_budget_deal_party;
    var key = party == Q.parlament_budget_ciu_target ? "ciu" : party == Q.parlament_budget_icv_target ? "icv" : party;
    if (!Q["parlament_budget_" + key + "_deal_possible"] || Q.party_resources <= Q.parlament_budget_player_resource_cost)
        throw new Error("Budget support negotiations are unavailable");
    var proposal = Q.parlament_budget_deal_proposals[party];
    // Terms are charged only through the projection. Keep earlier deals only
    // while their exact accepted clauses remain intact.
    Q.parlament_budget_deals = Q.parlament_budget_deals.filter(function (deal) {
        return deal.tax == proposal.tax_policy_level && deal.cap == proposal.social_spending_cap &&
            Object.keys(proposal.projects).every(function (key) { return deal.projects[key] == proposal.projects[key]; });
    });
    Q.budget_draft = {tax_policy_level:proposal.tax_policy_level, social_spending_cap:proposal.social_spending_cap, projects:Object.assign({}, proposal.projects)};
    Q.parlament_budget_deals.push({party:party, tax:proposal.tax_policy_level, cap:proposal.social_spending_cap, projects:Object.assign({}, proposal.projects)});
    Q.parlament_budget_changes_made = true;
    Q.party_resources -= 1;
    Q[party + "_relations"] -= 5;
!}
go-to: review

@pass
title: Approve the budget
subtitle: [? if parlament_budget_player_governs: \[+[+ parlament_budget_executive_grant +] budget\]?]
choose-if: parlament_budget_can_pass
unavailable-subtitle: [? if not parlament_budget_chamber_majority: Not enough parliamentary support.?][? if not parlament_budget_cabinet_yes: Every cabinet party must approve the budget.?]
on-arrival: {!
    if (!Q.parlament_budget_can_pass || Q.budget_year >= Q.year || Q.party_resources < Q.parlament_budget_player_resource_cost)
        throw new Error("Budget approval conditions changed");
    // Recheck ICF funding authority before charging resources or enacting any terms.
    if (Q.budget_draft.projects.icf) {
        var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
        var icfProposal = (Q.active_mods || {}).bnl_icf_proposal;
        if (Q.cat_caretaker_gov || !controlledParties.includes(Q.bnl_minister_party) ||
            !controlledParties.includes(Q.economy_minister_party) || Q.bnl_icf_level != 1 ||
            !["guarantees", "cooperative"].includes(Q.bnl_icf_prepared_branch) ||
            !icfProposal || !icfProposal.active || icfProposal.def.colour != "gray")
            throw new Error("ICF budget funding conditions changed");
    }
    // Recheck digital authority before any budget mutation, even for a stale YES.
    if (Q.budget_draft.projects.digital) {
        var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
        var digitalProposal = (Q.active_mods || {}).vp_digital3_proposal;
        if (Q.cat_caretaker_gov || !controlledParties.includes(Q.vicepresident_party) || Q.vp_digital_level != 2 ||
            !Q.vp_digital_prepared || !digitalProposal || !digitalProposal.active || digitalProposal.def.colour != "gray" ||
            !(Q.parlament_digital_passed && ["generalitat", "catalonia"].includes(Q.cybersecurity_agency_scope) && (Q.active_mods || {}).digital_agency_core && Q.active_mods.digital_agency_core.active)) throw new Error("Digital budget funding conditions changed");
    }
    // Recheck health authority before charging resources or enacting any budget terms.
    if (Q.budget_draft.projects.universal) {
        var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
        var universalProposal = (Q.active_mods || {}).healthcare_universal_proposal;
        if (Q.cat_caretaker_gov || !controlledParties.includes(Q.health_minister_party) || Q.healthcare_universal_level != 1 ||
            !Q.healthcare_universal_introduced || !universalProposal || !universalProposal.active || universalProposal.def.colour != "gray")
            throw new Error("Universal healthcare budget funding conditions changed");
    }
    var projection = Q.parlament_budget_projection;
    var origin = Q.budget_draft_origin;
    Q.party_resources -= Q.parlament_budget_player_resource_cost;
    if (Q.parlament_budget_player_governs) Q.government_budget += Q.parlament_budget_executive_grant;
    function creditBudgetBurden() {
        if (!Q.parlament_budget_player_governs) return;
        if (Q.burdens_start_countdown > 0 || Q.burdens_goal > 0 && Q.burdens_time > 0) Q.burdens_done += 1;
    }
    var spending = ["education_spending", "healthcare_spending", "public_salary_level"];
    var enactedBefore = {tax_policy_level:Q.tax_policy_level};
    for (var kind of spending) enactedBefore[kind] = Q[kind];
    var deliveredCommitments = (Q.coalition_policy_commitments || []).filter(function (record) {
        if (record.status != "pending_budget" || record.kind == "social_spending_cap") return false;
        var actual = record.kind == "tax_policy_level" ? projection.tax : projection.levels[record.kind];
        return actual >= record.target && actual > enactedBefore[record.kind];
    });
    var serviceChange = spending.reduce(function (sum, kind) { return sum + projection.levels[kind] - Q[kind]; }, 0) / 3;
    var capChange = (projection.cap - origin.enacted_social_spending_cap) * 0.2;
    var socialChange = serviceChange + capChange;
    var taxChange = Q.parlament_budget_tax_change;
    for (var record of deliveredCommitments) creditBudgetBurden();
    // Coalition deliveries receive their own points, so the same change cannot
    // also earn the budget's aggregate social point.
    var otherServiceChange = spending.reduce(function (sum, kind) {
        return sum + (deliveredCommitments.some(function (record) { return record.kind == kind; }) ? 0 : projection.levels[kind] - enactedBefore[kind]);
    }, 0);
    if (otherServiceChange > 0) creditBudgetBurden();
    var votes = Q.parlament_budget_positions;
    var left = ["cup", Q.parlament_current_icv, "erc", "psc"].find(function (p) { return votes[p] == "no"; }) || "abstain";
    var right = ["ppc", "cs", Q.parlament_current_ciu, "unio"].find(function (p) { return votes[p] == "no"; }) || "abstain";
    function shift(weights, change, alternative) {
        if (!change) return;
        for (var actor of Q.parlament_budget_actors)
            for (var demographic of Object.keys(weights))
                for (var constituency of Q.parlament_constituencies) {
                    var amount = weights[demographic] * Math.abs(change) * actor.weight * Q.parlament_budget_constituency_weights[constituency];
                    G.cardSupportTransfer(Q, {contest:"parlament", from:change > 0 ? "abstain" : actor.party,
                        to:change > 0 ? actor.party : alternative, amount:amount, maxDonorFraction:0.5,
                        constituencies:[constituency], demographics:[demographic]});
                }
    }
    shift({unemployed:1.2, young:0.9, ind:0.75, middle:0.5, rural:0.35, retired:0.25}, socialChange, left);
    shift({buss:0.35, rural:0.15, retired:0.1}, -socialChange, right);
    shift({middle:0.35, retired:0.25, ind:0.18, young:0.15, buss:0.2}, -taxChange, taxChange > 0 ? right : left);
    // Smaller local and national signals share the same collective responsibility.
    var signal = 0.27 * socialChange - 0.06 * taxChange;
    var national = 0.03 * socialChange - 0.01 * taxChange;
    for (var actor of Q.parlament_budget_actors) {
        var party = actor.party;
        var local = party == "ppc" ? "pp" : party;
        var congreso = party == "ppc" ? "pp" : party == "psc" ? "psoe" : party;
        if (["jxsi", "jxcat"].includes(party)) {
            // Interior local scores use the constituent parties' keys.
            var members = ["ciu"];
            if (Q["erc_in_" + party]) members.push("erc");
            if (Q["cup_in_" + party]) members.push("cup");
            for (var member of members) {
                var localMember = member == "ciu" ? Q.parlament_current_ciu == "jxcat" ? "junts" : Q.parlament_current_ciu : member;
                Q[localMember + "_interior_mod"] = (Q[localMember + "_interior_mod"] || 0) + signal * actor.weight / members.length;
            }
            local = Q[party + "_in_local"] ? party : Q["erc_in_" + party] ? "erc" : "ciu";
            congreso = Q[party + "_in_congreso"] ? party : Q["erc_in_" + party] ? "erc" : "ciu";
        } else Q[local + "_interior_mod"] = (Q[local + "_interior_mod"] || 0) + signal * actor.weight;
        if (signal) G.cardSupportTransfer(Q, {contest:"barcelona", from:signal > 0 ? local == "psc" ? "ciu" : "psc" : local,
            to:signal > 0 ? local : local == "cup" ? "federal_left" : "cup", amount:Math.abs(signal) * actor.weight, maxDonorFraction:0.5});
        if (national) G.cardSupportTransfer(Q, {contest:"congreso", from:national > 0 ? "abstain" : congreso,
            to:national > 0 ? congreso : "abstain", amount:Math.abs(national) * actor.weight, maxDonorFraction:0.5, constituencies:["catalunya"]});
    }
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    // Cabinet partners include the constituents of their unity lists.
    var coalitionPartners = (Q.cat_coalition || []).slice();
    for (var list of ["jxsi", "jxcat"]) {
        if (coalitionPartners.includes(list)) {
            for (var party of Q.parties || []) {
                if (Q[party + "_in_" + list]) coalitionPartners.push(party);
            }
        }
    }
    // Only the player-authored Economy package carries these executive reactions.
    if (origin.author == "player") {
        if (projection.tax != Q.tax_policy_level) {
            var ercTaxAffinity = [-1, 0, 0, 0, 0];
            if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
                Q.erc_relations += Math.max(-4, Math.min(4, ercTaxAffinity[projection.tax + 2] - ercTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes("erc") ? 2 : 1);
            var ciuTaxAffinity = [3, 2, 1, 0, -1];
            if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
                Q[Q.parlament_current_ciu + "_relations"] += Math.max(-4, Math.min(4, ciuTaxAffinity[projection.tax + 2] - ciuTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
            var pscTaxAffinity = [0, 0, 1, 0, 0];
            if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
                Q.psc_relations += Math.max(-4, Math.min(4, pscTaxAffinity[projection.tax + 2] - pscTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes("psc") ? 2 : 1);
            var icvTaxAffinity = [-1, 0, 0, 0, 0];
            if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
                Q[Q.parlament_current_icv + "_relations"] += Math.max(-4, Math.min(4, icvTaxAffinity[projection.tax + 2] - icvTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
            var cupTaxAffinity = [-1, 0, 0, 0, -1];
            if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
                Q.cup_relations += Math.max(-4, Math.min(4, cupTaxAffinity[projection.tax + 2] - cupTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes("cup") ? 2 : 1);
            var ppcTaxAffinity = [3, 2, 1, 0, -2];
            if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
                Q.ppc_relations += Math.max(-4, Math.min(4, ppcTaxAffinity[projection.tax + 2] - ppcTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes("ppc") ? 2 : 1);
            var csTaxAffinity = [3, 2, 1, 0, -2];
            if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
                Q.cs_relations += Math.max(-4, Math.min(4, csTaxAffinity[projection.tax + 2] - csTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes("cs") ? 2 : 1);
            if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
                Q.pdcat_relations += (Math.max(-4, Math.min(4, ciuTaxAffinity[projection.tax + 2] - ciuTaxAffinity[Q.tax_policy_level + 2]))) * (coalitionPartners.includes("pdcat") ? 2 : 1);
            if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
                Q.unio_relations += (Math.max(-4, Math.min(4, ciuTaxAffinity[projection.tax + 2] - ciuTaxAffinity[Q.tax_policy_level + 2]))) * (coalitionPartners.includes("unio") ? 2 : 1);
            if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
                Q.fnc_relations += (Math.max(-4, Math.min(4, ppcTaxAffinity[projection.tax + 2] - ppcTaxAffinity[Q.tax_policy_level + 2]))) * (coalitionPartners.includes("fnc") ? 2 : 1);
            if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
                Q.pxc_relations += (Math.max(-4, Math.min(4, ppcTaxAffinity[projection.tax + 2] - ppcTaxAffinity[Q.tax_policy_level + 2]))) * (coalitionPartners.includes("pxc") ? 2 : 1);
            if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
                Q.vox_relations += (Math.max(-4, Math.min(4, ppcTaxAffinity[projection.tax + 2] - ppcTaxAffinity[Q.tax_policy_level + 2]))) * (coalitionPartners.includes("vox") ? 2 : 1);
            for (var list of ["jxsi", "jxcat"]) {
                if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                    list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                    Q[list + "_relations"] += Math.max(-4, Math.min(4, ciuTaxAffinity[projection.tax + 2] - ciuTaxAffinity[Q.tax_policy_level + 2])) * 2;
            }
            if (Q.player_party == "erc") {
                var erc_leftTaxDissent = [1, 0, 0, 0, 1];
                Q.erc_left_dissent += Math.max(-6, Math.min(6, erc_leftTaxDissent[projection.tax + 2] - erc_leftTaxDissent[Q.tax_policy_level + 2]));
                var erc_coreTaxDissent = [0, 0, 0, 0, 0];
                Q.erc_core_dissent += Math.max(-6, Math.min(6, erc_coreTaxDissent[projection.tax + 2] - erc_coreTaxDissent[Q.tax_policy_level + 2]));
                var erc_pragmaticTaxDissent = [-1, -1, 0, 0, 1];
                Q.erc_pragmatic_dissent += Math.max(-6, Math.min(6, erc_pragmaticTaxDissent[projection.tax + 2] - erc_pragmaticTaxDissent[Q.tax_policy_level + 2]));
            }
            if (Q.player_party == "cup") {
                var cup_endavantTaxDissent = [2, 1, 0, 0, 2];
                Q.cup_endavant_dissent += Math.max(-6, Math.min(6, cup_endavantTaxDissent[projection.tax + 2] - cup_endavantTaxDissent[Q.tax_policy_level + 2]));
                var cup_poblelliureTaxDissent = [1, 0, 0, 0, 1];
                Q.cup_poblelliure_dissent += Math.max(-6, Math.min(6, cup_poblelliureTaxDissent[projection.tax + 2] - cup_poblelliureTaxDissent[Q.tax_policy_level + 2]));
                var cup_thirdsectorTaxDissent = [1, 0, 0, 0, 1];
                Q.cup_thirdsector_dissent += Math.max(-6, Math.min(6, cup_thirdsectorTaxDissent[projection.tax + 2] - cup_thirdsectorTaxDissent[Q.tax_policy_level + 2]));
            }
        }
        var forcedCuts = spending.some(function (kind) { return projection.levels[kind] < enactedBefore[kind]; });
        if (forcedCuts) {
            // Charge each crossed cut, without adding an authorization penalty.
            for (var kind of spending) {
                for (var previousLevel = enactedBefore[kind]; previousLevel > projection.levels[kind]; previousLevel--) {
                    if (kind == "public_salary_level") {
                        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
                            Q.erc_relations -= 1 * (coalitionPartners.includes("erc") ? 2 : 1);
                        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
                            Q[Q.parlament_current_ciu + "_relations"] += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
                        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
                            Q.psc_relations -= 1 * (coalitionPartners.includes("psc") ? 2 : 1);
                        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
                            Q[Q.parlament_current_icv + "_relations"] -= 2 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
                        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
                            Q.cup_relations -= 1 * (coalitionPartners.includes("cup") ? 2 : 1);
                        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
                            Q.ppc_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("ppc") ? 2 : 1);
                        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
                            Q.cs_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("cs") ? 2 : 1);
                        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
                            Q.pdcat_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("pdcat") ? 2 : 1);
                        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
                            Q.unio_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("unio") ? 2 : 1);
                        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
                            Q.fnc_relations += 0 * (coalitionPartners.includes("fnc") ? 2 : 1);
                        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
                            Q.pxc_relations += 0 * (coalitionPartners.includes("pxc") ? 2 : 1);
                        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
                            Q.vox_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("vox") ? 2 : 1);
                        // An outside cabinet list follows its CiU-family leadership.
                        for (var list of ["jxsi", "jxcat"]) {
                            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                                Q[list + "_relations"] += (previousLevel > 0 ? 1 : 0) * 2;
                        }
                        if (Q.player_party == "erc") {
                            Q.erc_left_dissent += 2;
                            Q.erc_core_dissent += 1;
                            Q.erc_pragmatic_dissent += previousLevel <= 0 ? 1 : 0;
                        }
                        if (Q.player_party == "cup") {
                            Q.cup_endavant_dissent += 2;
                            Q.cup_poblelliure_dissent += 1;
                            Q.cup_thirdsector_dissent += 2;
                        }
                    } else {
                        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
                            Q.erc_relations += (previousLevel > 0 ? -2 : -1) * (coalitionPartners.includes("erc") ? 2 : 1);
                        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
                            Q[Q.parlament_current_ciu + "_relations"] += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
                        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
                            Q.psc_relations += (previousLevel > 0 ? -2 : -1) * (coalitionPartners.includes("psc") ? 2 : 1);
                        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
                            Q[Q.parlament_current_icv + "_relations"] += (previousLevel > 0 ? -3 : -2) * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
                        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
                            Q.cup_relations -= 2 * (coalitionPartners.includes("cup") ? 2 : 1);
                        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
                            Q.ppc_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("ppc") ? 2 : 1);
                        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
                            Q.cs_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("cs") ? 2 : 1);
                        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
                            Q.pdcat_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("pdcat") ? 2 : 1);
                        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
                            Q.unio_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("unio") ? 2 : 1);
                        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
                            Q.fnc_relations += 0 * (coalitionPartners.includes("fnc") ? 2 : 1);
                        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
                            Q.pxc_relations += 0 * (coalitionPartners.includes("pxc") ? 2 : 1);
                        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
                            Q.vox_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("vox") ? 2 : 1);
                        // An outside cabinet list follows its CiU-family leadership.
                        for (var list of ["jxsi", "jxcat"]) {
                            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                                Q[list + "_relations"] += (previousLevel > 0 ? 1 : 0) * 2;
                        }
                        if (Q.player_party == "erc") {
                            Q.erc_left_dissent += previousLevel <= 0 ? 2 : kind == "healthcare_spending" && previousLevel == 2 ? 4 : 3;
                            Q.erc_core_dissent += 1;
                            Q.erc_pragmatic_dissent += previousLevel <= 0 ? 1 : 0;
                        }
                        if (Q.player_party == "cup") {
                            Q.cup_endavant_dissent += kind == "healthcare_spending" && previousLevel == 2 ? 4 : 3;
                            Q.cup_poblelliure_dissent += 1;
                            Q.cup_thirdsector_dissent += kind == "healthcare_spending" && previousLevel == 2 ? 4 : 3;
                        }
                    }
                }
            }
        } else if (projection.cap != Q.social_spending_cap) {
            var authorizationChange = projection.cap - Q.social_spending_cap;
            if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
                Q.erc_relations += (authorizationChange) * (coalitionPartners.includes("erc") ? 2 : 1);
            if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
                Q[Q.parlament_current_ciu + "_relations"] += (-authorizationChange) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
            if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
                Q.psc_relations += (authorizationChange) * (coalitionPartners.includes("psc") ? 2 : 1);
            if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
                Q[Q.parlament_current_icv + "_relations"] += (authorizationChange) * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
            if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
                Q.cup_relations += (authorizationChange) * (coalitionPartners.includes("cup") ? 2 : 1);
            if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
                Q.ppc_relations += (-authorizationChange) * (coalitionPartners.includes("ppc") ? 2 : 1);
            if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
                Q.cs_relations += (-authorizationChange) * (coalitionPartners.includes("cs") ? 2 : 1);
            if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
                Q.pdcat_relations += (-authorizationChange) * (coalitionPartners.includes("pdcat") ? 2 : 1);
            if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
                Q.unio_relations += (-authorizationChange) * (coalitionPartners.includes("unio") ? 2 : 1);
            if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
                Q.fnc_relations += (-authorizationChange) * (coalitionPartners.includes("fnc") ? 2 : 1);
            if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
                Q.pxc_relations += (-authorizationChange) * (coalitionPartners.includes("pxc") ? 2 : 1);
            if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
                Q.vox_relations += (-authorizationChange) * (coalitionPartners.includes("vox") ? 2 : 1);
            // An outside cabinet list follows its CiU-family leadership.
            for (var list of ["jxsi", "jxcat"]) {
                if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                    list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                    Q[list + "_relations"] += (-authorizationChange) * 2;
            }
            if (Q.player_party == "erc") {
                Q.erc_left_dissent += -authorizationChange;
            }
            if (Q.player_party == "cup") {
                Q.cup_endavant_dissent += -authorizationChange;
                Q.cup_thirdsector_dissent += -authorizationChange;
            }
        }
    }
    if (origin.author != "player" && Q.parlament_budget_player_vote == "yes" && Q.parlament_budget_player_default == "no") {
        if (Q.player_party == "erc") { Q.erc_left_dissent += 6; Q.erc_civic_dissent += 3; }
        if (Q.player_party == "cup") { Q.cup_endavant_dissent += 8; Q.cup_thirdsector_dissent += 5; Q.cup_poblelliure_dissent += 2; }
    }
    Q.tax_policy_level = projection.tax;
    Q.social_spending_cap = projection.cap;
    for (var kind of spending) Q[kind] = projection.levels[kind];
    // Approved ministry increases already paid for their executive effort.
    var preparedFields = {education_spending:"education_prepared_level", healthcare_spending:"healthcare_prepared_level", public_salary_level:"public_salary_prepared_level"};
    var preparedLaws = {education_spending:"education_spending_proposal", healthcare_spending:"healthcare_spending_proposal", public_salary_level:"public_salary_proposal"};
    for (var kind of spending) {
        var field = preparedFields[kind];
        if (Q[field] != null && Q[kind] >= Q[field]) {
            Q[field] = null;
            G.deactivateLaw(Q, preparedLaws[kind], undefined, true);
        }
    }
    Q.budget_external_breach = projection.brokenExternal.length > 0;
    if (Q.budget_external_breach) {
        Q.budget_external_broken_commitments = projection.brokenExternal;
        Q.budget_external_breach_parties = projection.brokenExternal.reduce(function (parties, record) {
            return parties.concat(record.signatories || []);
        }, []).filter(function (p, i, all) { return p && all.indexOf(p) == i; });
    }
    for (var record of Q.coalition_policy_commitments || []) {
        if (record.status != "pending_budget") continue;
        var actual = Q[record.kind];
        if (actual >= record.target) {
            record.status = "applied";
            G.deactivateLaw(Q, "coalition_pending_" + record.kind, undefined, true);
        }
    }
    if (Q.parlament_budget_icf && Q.bnl_icf_level == 1 &&
        ["guarantees", "cooperative"].includes(Q.bnl_icf_prepared_branch) && !Q.cat_caretaker_gov &&
        [Q.player_party, Q.player_in_jxsi ? "jxsi" : null, Q.player_in_jxcat ? "jxcat" : null].includes(Q.bnl_minister_party) &&
        [Q.player_party, Q.player_in_jxsi ? "jxsi" : null, Q.player_in_jxcat ? "jxcat" : null].includes(Q.economy_minister_party)) {
        Q.bnl_icf_level = 2;
        Q.bnl_icf_branch = Q.bnl_icf_prepared_branch;
        Q.bnl_icf_prepared_branch = null;
        G.deactivateLaw(Q, "bnl_icf_proposal", undefined, true);
        if (Q.active_mods && Q.active_mods.bnl_icf1) Q.active_mods.bnl_icf1.hidden = true;
        var cooperative = Q.bnl_icf_branch == "cooperative";
        G.registerLaw(Q, {id:"bnl_icf2", title:cooperative ? "ICF Cooperative and Social-Economy Lending" : "Expanded ICF Public Guarantees",
            colour:"green", icon:"img/economy_icon.svg", bnl_branch:Q.bnl_icf_branch, ramp_ticks:6,
            description:cooperative ? "Dedicated ICF finance supports cooperatives and social-economy enterprises alongside existing SME lending." :
                "Expanded public guarantees improve business access to investment finance alongside existing SME lending.",
            targets:cooperative ? {gdp_growth:0.04, unemployment_recovery:0.01, welfare_index_growth:0.06, generalitat_surplus:-0.02} :
                {gdp_growth:0.12, unemployment_recovery:0.02, generalitat_surplus:-0.02}});
    }
    if (Q.budget_draft.projects.digital) {
        Q.vp_digital_level = 3;
        Q.vp_digital_prepared = false;
        G.deactivateLaw(Q, "vp_digital3_proposal", undefined, true);
        if (Q.active_mods && Q.active_mods.vp_digital2) Q.active_mods.vp_digital2.hidden = true;
        G.registerLaw(Q, {id:"vp_digital3", title:"Digital Administrative Continuity", colour:"green", icon:"img/comms_icon.svg",
            description:"Redundant services, recovery arrangements and independent operating capacity have allowed the secure full digitalization of all of the Generalitat's systems.",
            targets:{generalitat_surplus:-0.01}, ramp_ticks:12});
        Q.independence_trust = Math.min(60, Q.independence_trust + 2);
    }
    if (Q.budget_draft.projects.universal) {
        Q.healthcare_universal_level = 2;
        Q.healthcare_universal_introduced = false;
        G.deactivateLaw(Q, "healthcare_universal_proposal", undefined, true);
        if (Q.active_mods && Q.active_mods.healthcare_universal1) Q.active_mods.healthcare_universal1.hidden = true;
        G.registerLaw(Q, {id:"healthcare_universal2", title:"True Universal Healthcare Access", colour:"green", icon:"img/health_icon.svg",
            description:"Universal entitlement to publicly funded healthcare has been funded for all residents, regardless of legal status.",
            targets:{welfare_index_growth:0.05, generalitat_surplus:-0.02, social_dissent_eq:-1}, ramp_ticks:12});
    }
    if (Q.parlament_budget_county) {
        Q.territory_roads_approved = Math.max(Q.territory_roads_approved, 1);
        G.deactivateLaw(Q, "territory_county_roads", undefined, true);
        G.registerLaw(Q, {id:"territory_county_roads", title:"County roads expansion",
            colour:"orange", icon:"img/car_icon.svg",
            description:"Under construction: expansion of critical road links like the C-17 and the A-27.",
            targets:{generalitat_surplus:-0.005}});
        if (!Q.countdowns.includes("territory_county_roads")) Q.countdowns.push("territory_county_roads");
        Q.territory_county_roads_countdown = 12;
    }
    if (Q.parlament_budget_b40) {
        Q.territory_roads_approved = 2;
        G.deactivateLaw(Q, "territory_b40", undefined, true);
        G.registerLaw(Q, {id:"territory_b40", title:"Barcelona's Fourth Belt",
            colour:"orange", icon:"img/car_icon.svg",
            description:"Under construction: B-40, Barcelona's final bypass highway.",
            targets:{generalitat_surplus:-0.005}});
        if (!Q.countdowns.includes("territory_b40")) Q.countdowns.push("territory_b40");
        Q.territory_b40_countdown = 24;
    }
    if (Q.parlament_budget_metro1) {
        creditBudgetBurden();
        Q.territory_metro_approved = Math.max(Q.territory_metro_approved, 1);
        G.deactivateLaw(Q, "territory_metro1", undefined, true);
        G.registerLaw(Q, {id:"territory_metro1", colour:"orange",
            description:"Under construction: completing Barcelona's L9/L10 Metro line.",
            title:"Metro L9/L10", icon:"img/subway_icon.svg",
            targets:{generalitat_surplus:-0.01, unemployment_recovery:0.01}});
        if (!Q.countdowns.includes("territory_metro1")) Q.countdowns.push("territory_metro1");
        Q.territory_metro1_countdown = 48;
    }
    if (Q.parlament_budget_metro2) {
        creditBudgetBurden();
        Q.territory_metro_approved = 2;
        G.deactivateLaw(Q, "territory_metro2", undefined, true);
        G.registerLaw(Q, {id:"territory_metro2", colour:"orange",
            description:"Under construction: expanding Barcelona's L1 and L3 Metro lines.",
            title:"Metro L1/L3", icon:"img/subway_icon.svg",
            targets:{generalitat_surplus:-0.01, unemployment_recovery:0.01}});
        if (!Q.countdowns.includes("territory_metro2")) Q.countdowns.push("territory_metro2");
        Q.territory_metro2_countdown = 36;
    }
    if (Q.parlament_budget_water2) {
        creditBudgetBurden();
        G.deactivateLaw(Q, "territory_water2", undefined, true);
        Q.territory_water = 2;
        Q.climate_transition_points += 1;
    }
    if (Q.parlament_budget_water3) {
        creditBudgetBurden();
        G.deactivateLaw(Q, "territory_water3", undefined, true);
        Q.territory_water = 3;
        Q.climate_transition_points += 1;
    }
    if (Q.parlament_budget_tmobilitat2) {
        creditBudgetBurden();
        G.deactivateLaw(Q, "territory_tmobilitat2", undefined, true);
        G.registerLaw(Q, {id:"territory_tmobilitat2", title:"Catalonia-Wide T-mobilitat", colour:"orange",
            icon:"img/territory_icon.svg", description:"Under deployment: ticketing technology and operation is being brought under public control, and will see its implementation extended to cover all of Catalonia.",
            targets:{}});
        if (!Q.countdowns.includes("territory_tmobilitat2")) Q.countdowns.push("territory_tmobilitat2");
        Q.territory_tmobilitat2_countdown = 12;
    }
    if (Q.parlament_budget_rail1) {
        creditBudgetBurden();
        G.deactivateLaw(Q, "territory_rail1", undefined, true);
        G.registerLaw(Q, {id:"territory_rail1", title:"Lleida-La Pobla Railway", colour:"orange",
            icon:"img/rail_icon.svg", description:"Under deployment: revitalization the FGC Lleida-La Pobla line with new trains and improved services.",
            targets:{generalitat_surplus:-0.005, unemployment_recovery:0.005}});
        if (!Q.countdowns.includes("territory_rail1")) Q.countdowns.push("territory_rail1");
        Q.territory_rail1_countdown = 12;
    }
    if (Q.parlament_budget_rail2) {
        creditBudgetBurden();
        G.deactivateLaw(Q, "territory_rail2", undefined, true);
        G.registerLaw(Q, {id:"territory_rail2", title:"Tarragona and Girona Train-Trams", colour:"orange",
            icon:"img/rail_icon.svg", description:"Under construction: build-out train-tram networks in the Camp de Tarragona and the Girona counties.",
            targets:{generalitat_surplus:-0.01, unemployment_recovery:0.01}});
        if (!Q.countdowns.includes("territory_rail2")) Q.countdowns.push("territory_rail2");
        Q.territory_rail2_countdown = 36;
    }
    Q.budget_year = Q.year;
    Q.budget_failed_times = 0;
    Q.coming_from_parlament = false;
!}
call: generalitat_setpolicy

The Parlament has approved the [+ year +] budget with [+ parlament_budget_yes +] votes in favour. The Generalitat can now fund the projects included in it.

- @post_event

@continue
view-if: not budget_external_breach
go-to: post_event

@walk_away
title: [? if parlament_budget_can_pass: Withdraw our budget proposal?][? if not parlament_budget_can_pass: No budget agreement can be reached...?]
subtitle: The Generalitat will continue to operate under its [+ budget_year +] budget.
choose-if: parlament_budget_player_authored or not parlament_budget_can_pass
unavailable-subtitle: This government has enough votes to pass its proposal.
on-arrival: {!
    if (Q.parlament_budget_can_pass && !Q.parlament_budget_player_authored) throw new Error("An NPC budget with sufficient support cannot be withdrawn");
    if (Q.parlament_budget_failed_year != Q.year) {
        var penalty = Q.parlament_budget_can_pass ? 0.32 : 0.18;
        var missed = Math.max(0, Q.budget_draft.social_spending_cap - Q.budget_draft_origin.enacted_social_spending_cap);
        for (var actor of Q.parlament_budget_cabinet_actors) {
            for (var constituency of Q.parlament_constituencies) {
                G.cardSupportTransfer(Q, {contest:"parlament", from:actor.party, to:"abstain",
                    amount:penalty * actor.weight * Q.parlament_budget_constituency_weights[constituency], maxDonorFraction:0.5,
                    constituencies:[constituency], demographics:["middle", "young", "ind"]});
                if (missed) G.cardSupportTransfer(Q, {contest:"parlament", from:actor.party, to:"abstain",
                    amount:0.12 * missed * actor.weight * Q.parlament_budget_constituency_weights[constituency], maxDonorFraction:0.5,
                    constituencies:[constituency], demographics:["young", "unemployed", "ind"]});
            }
            var local = actor.party == "ppc" ? "pp" : actor.party;
            var congreso = actor.party == "psc" ? "psoe" : local;
            G.cardSupportTransfer(Q, {contest:"barcelona", from:local, to:local == "psc" ? "federal_left" : "psc", amount:penalty * 0.3 * actor.weight, maxDonorFraction:0.5});
            G.cardSupportTransfer(Q, {contest:"congreso", from:congreso, to:"abstain", amount:penalty * 0.04 * actor.weight, maxDonorFraction:0.5, constituencies:["catalunya"]});
        }
        Q.parlament_budget_failed_year = Q.year;
        Q.budget_failed_times += 1;
    }
    Q.coming_from_parlament = false;
!}

No agreement seems to be possible... The Generalitat will continue to operate under its last approved budget from [+ budget_year +].

- @post_event
