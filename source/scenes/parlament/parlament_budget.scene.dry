    };
    var electoralProposalIds = {healthcare_spending:"healthcare_spending_proposal", education_spending:"education_spending_proposal", public_salary_level:"public_salary_proposal"};
    for (var electoralKind of spending) {
        var electoralBefore = enactedBefore[electoralKind];
        var electoralAfter = projection.levels[electoralKind];
        if (electoralBefore == electoralAfter) continue;
        var electoralDirection = Math.sign(electoralAfter - electoralBefore);
        var electoralProposal = (Q.active_mods || {})[electoralProposalIds[electoralKind]];
        var electoralOrigin = electoralProposal && electoralProposal.active && electoralProposal.def.electoral_origin || Q.player_party;
        var electoralActors = Q.parlament_budget_actors;
        if (electoralDirection > 0 && electoralProposal && electoralProposal.active && electoralProposal.def.electoral_origin) {
            var electoralMinister = electoralOrigin;
            for (var electoralList of ["jxsi", "jxcat"]) if (Q[electoralOrigin + "_in_" + electoralList]) electoralMinister = electoralList;
            var electoralCabinet = [];
            for (var electoralPartner of electoralProposal.def.electoral_cabinet || Q.cat_coalition || []) {
                if (["ciu", "cdc", "dl", "junts"].includes(electoralPartner)) electoralPartner = Q.parlament_current_ciu;
                if (["icv", "csqp", "cecp", "ecp"].includes(electoralPartner)) electoralPartner = Q.parlament_current_icv;
                for (var electoralList of ["jxsi", "jxcat"]) if (Q[electoralPartner + "_in_" + electoralList]) electoralPartner = electoralList;
                if (!electoralCabinet.includes(electoralPartner)) electoralCabinet.push(electoralPartner);
            }
            var electoralOtherCabinet = electoralCabinet.filter(function (p, i, all) { return p != electoralMinister && all.indexOf(p) == i; });
            electoralActors = [{party:electoralMinister, weight:electoralOtherCabinet.length ? 0.8 : 1}];
            for (var electoralPartner of electoralOtherCabinet) electoralActors.push({party:electoralPartner, weight:0.2 / electoralOtherCabinet.length});
        }
        for (var electoralTier = Math.min(electoralBefore,electoralAfter); electoralTier < Math.max(electoralBefore,electoralAfter); electoralTier++) {
            var electoralProfile = electoralServiceProfiles[electoralKind];
            if (!electoralProfile.tiers[electoralTier + 2]) continue;
            electoralPolicies.push({origin:electoralOrigin, actors:electoralActors, direction:electoralDirection,
                demographics:electoralProfile.tiers[electoralTier + 2], provinces:electoralProfile.provinces,
                gains:electoralOrigin == "cup" ? [["federal_left",0.45],["erc",0.30],["abstain",0.25]] : [["psc",0.45],["federal_left",0.30],["abstain",0.25]],
                barcelona:(electoralProfile.barcelona[electoralTier + 2]), congreso:(electoralProfile.congreso[electoralTier + 2])});
        }
    }
    var electoralCapChange = projection.cap - origin.enacted_social_spending_cap;
    // Permission alone receives a small response, separate from delivered services.
    if (electoralCapChange) electoralPolicies.push({origin:Q.player_party, actors:Q.parlament_budget_actors, direction:electoralCapChange,
        demographics:{unemployed:0.08,young:0.07,ind:0.07,middle:0.05,rural:0.04,retired:0.03},
        provinces:Q.parlament_budget_constituency_weights,
        gains:Q.player_party == "cup" ? [["federal_left",0.45],["erc",0.30],["abstain",0.25]] : [["psc",0.45],["federal_left",0.30],["abstain",0.25]],
        barcelona:(0.007), congreso:(0.003)});
    if (taxChange) electoralPolicies.push({origin:Q.player_party, actors:Q.parlament_budget_actors, direction:-taxChange,
        demographics:{buss:0.45,middle:0.30,retired:0.12,ind:0.10,young:0.08}, provinces:Q.parlament_budget_constituency_weights,
        gains:Q.player_party == "cup" ? [["erc",0.45],["ciu",0.35],["psc",0.20]] : [["ciu",0.50],["cs",0.30],["psc",0.20]],
        losses:Q.player_party == "cup" ? [["erc",0.45],["ciu",0.35],["abstain",0.20]] : [["ciu",0.50],["cs",0.35],["abstain",0.15]],
        barcelona:(0.025), congreso:(0.01)});

    // Named routes keep their shares when a donor is absent or on the same list.
    for (var electoralPolicy of electoralPolicies) {
        var voterOrigin = electoralPolicy.origin;
        var voterActors = [];
        for (var electoralActor of electoralPolicy.actors) voterActors.push({party:electoralActor.party,
            origin:["jxsi","jxcat"].includes(electoralActor.party) ? voterOrigin : electoralActor.party,weight:electoralActor.weight});
        var voterCells = [];
        for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || []) {
            var voterAmount = (electoralPolicy.demographics[voterDemo] || 0) * (electoralPolicy.provinces[voterProvince] || 0);
            if (voterAmount) voterCells.push({contest:"parlament",province:voterProvince,demo:voterDemo,amount:voterAmount});
        }
        if (electoralPolicy.congreso && (Q.congreso_constituencies || []).includes("catalunya")) voterCells.push({contest:"congreso",province:"catalunya",demo:null,amount:electoralPolicy.congreso});
        if (electoralPolicy.barcelona) voterCells.push({contest:"barcelona",province:null,demo:null,amount:electoralPolicy.barcelona});
        for (var voterCell of voterCells) {
            var voterContest = voterCell.contest;
            var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
            var voterSignedAmount = voterCell.amount * (Math.abs(electoralPolicy.direction));
            if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
            var voterDirection = electoralPolicy.direction > 0 ? 1 : -1;
            for (var voterActor of voterActors) {
                var voterWeight = voterActor.weight;
                if (electoralPolicy.direction < 0 && origin.initiative_protest_party == Q.player_party &&
                    (voterActor.party == Q.player_party || Q.player_in_jxsi && voterActor.party == "jxsi" ||
                        Q.player_in_jxcat && voterActor.party == "jxcat")) voterWeight *= 0.5;
                var voterRouteList = electoralPolicy.direction > 0 ? electoralPolicy.gains : electoralPolicy.losses || (voterActor.origin == "erc" ? [["cup",0.45],["fl",0.35],["abstain",0.20]] : voterActor.origin == "cup" ? [["fl",0.45],["erc",0.35],["abstain",0.20]] : voterActor.origin == "psc" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : ["ecp","cecp","csqp","icv","federal_left"].includes(voterActor.origin) ? [["cup",0.40],["erc",0.30],["abstain",0.30]] : [["erc",0.40],["fl",0.35],["abstain",0.25]]);
                for (var voterRoute of voterRouteList) {
                    var voterPair = [];
                    for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                        var voterCandidates = [voterParty];
                        if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                        if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                        if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                        if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                        if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                        if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                        var voterCarrier = null;
                        for (var voterCandidate of voterCandidates) {
                            if (!voterLineup.includes(voterCandidate)) continue;
                            if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                            if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                        }
                        voterPair.push(voterCarrier);
                    }
                    if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                    var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                    var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterWeight * voterRoute[1],maxDonorFraction:0.5};
                    if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                    if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                    G.cardSupportTransfer(Q,voterOptions);

                }
            }
        }
    }
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    // Cabinet partners include the constituents of their unity lists.
    var coalitionPartners = (Q.cat_coalition || []).slice();
    for (var list of ["jxsi", "jxcat"]) {
        if (coalitionPartners.includes(list)) {
            for (var party of Q.parties || []) {
                if (Q[party + "_in_" + list]) coalitionPartners.push(party);
            }
        }
    }
    // Only the player-authored Economy package carries these executive reactions.
    if (origin.author == "player") {
        if (projection.tax != Q.tax_policy_level) {
            var ercTaxAffinity = [-1, 0, 0, 0, 0];
            if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
                Q.erc_relations += Math.max(-4, Math.min(4, ercTaxAffinity[projection.tax + 2] - ercTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes("erc") ? 2 : 1);
            var ciuTaxAffinity = [3, 2, 1, 0, -1];
            if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
                Q[Q.parlament_current_ciu + "_relations"] += Math.max(-4, Math.min(4, ciuTaxAffinity[projection.tax + 2] - ciuTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
            var pscTaxAffinity = [0, 0, 1, 0, 0];
            if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
                Q.psc_relations += Math.max(-4, Math.min(4, pscTaxAffinity[projection.tax + 2] - pscTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes("psc") ? 2 : 1);
            var icvTaxAffinity = [-1, 0, 0, 0, 0];
            if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
                Q[Q.parlament_current_icv + "_relations"] += Math.max(-4, Math.min(4, icvTaxAffinity[projection.tax + 2] - icvTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
            var cupTaxAffinity = [-1, 0, 0, 0, -1];
            if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
                Q.cup_relations += Math.max(-4, Math.min(4, cupTaxAffinity[projection.tax + 2] - cupTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes("cup") ? 2 : 1);
            var ppcTaxAffinity = [3, 2, 1, 0, -2];
            if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
                Q.ppc_relations += Math.max(-4, Math.min(4, ppcTaxAffinity[projection.tax + 2] - ppcTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes("ppc") ? 2 : 1);
            var csTaxAffinity = [3, 2, 1, 0, -2];
            if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
                Q.cs_relations += Math.max(-4, Math.min(4, csTaxAffinity[projection.tax + 2] - csTaxAffinity[Q.tax_policy_level + 2])) * (coalitionPartners.includes("cs") ? 2 : 1);
            if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
                Q.pdcat_relations += (Math.max(-4, Math.min(4, ciuTaxAffinity[projection.tax + 2] - ciuTaxAffinity[Q.tax_policy_level + 2]))) * (coalitionPartners.includes("pdcat") ? 2 : 1);
            if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
                Q.unio_relations += (Math.max(-4, Math.min(4, ciuTaxAffinity[projection.tax + 2] - ciuTaxAffinity[Q.tax_policy_level + 2]))) * (coalitionPartners.includes("unio") ? 2 : 1);
            if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
                Q.fnc_relations += (Math.max(-4, Math.min(4, ppcTaxAffinity[projection.tax + 2] - ppcTaxAffinity[Q.tax_policy_level + 2]))) * (coalitionPartners.includes("fnc") ? 2 : 1);
            if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
                Q.pxc_relations += (Math.max(-4, Math.min(4, ppcTaxAffinity[projection.tax + 2] - ppcTaxAffinity[Q.tax_policy_level + 2]))) * (coalitionPartners.includes("pxc") ? 2 : 1);
            if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
                Q.vox_relations += (Math.max(-4, Math.min(4, ppcTaxAffinity[projection.tax + 2] - ppcTaxAffinity[Q.tax_policy_level + 2]))) * (coalitionPartners.includes("vox") ? 2 : 1);
            for (var list of ["jxsi", "jxcat"]) {
                if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                    list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                    Q[list + "_relations"] += Math.max(-4, Math.min(4, ciuTaxAffinity[projection.tax + 2] - ciuTaxAffinity[Q.tax_policy_level + 2])) * 2;
            }
            if (Q.player_party == "erc") {
                var erc_leftTaxDissent = [1, 0, 0, 0, 1];
                Q.erc_left_dissent += Math.max(-6, Math.min(6, erc_leftTaxDissent[projection.tax + 2] - erc_leftTaxDissent[Q.tax_policy_level + 2]));
                var erc_coreTaxDissent = [0, 0, 0, 0, 0];
                Q.erc_core_dissent += Math.max(-6, Math.min(6, erc_coreTaxDissent[projection.tax + 2] - erc_coreTaxDissent[Q.tax_policy_level + 2]));
                var erc_pragmaticTaxDissent = [-1, -1, 0, 0, 1];
                Q.erc_pragmatic_dissent += Math.max(-6, Math.min(6, erc_pragmaticTaxDissent[projection.tax + 2] - erc_pragmaticTaxDissent[Q.tax_policy_level + 2]));
            }
            if (Q.player_party == "cup") {
                var cup_endavantTaxDissent = [2, 1, 0, 0, 2];
                Q.cup_endavant_dissent += Math.max(-6, Math.min(6, cup_endavantTaxDissent[projection.tax + 2] - cup_endavantTaxDissent[Q.tax_policy_level + 2]));
                var cup_poblelliureTaxDissent = [1, 0, 0, 0, 1];
                Q.cup_poblelliure_dissent += Math.max(-6, Math.min(6, cup_poblelliureTaxDissent[projection.tax + 2] - cup_poblelliureTaxDissent[Q.tax_policy_level + 2]));
                var cup_thirdsectorTaxDissent = [1, 0, 0, 0, 1];
                Q.cup_thirdsector_dissent += Math.max(-6, Math.min(6, cup_thirdsectorTaxDissent[projection.tax + 2] - cup_thirdsectorTaxDissent[Q.tax_policy_level + 2]));
            }
        }
        var forcedCuts = spending.some(function (kind) { return projection.levels[kind] < enactedBefore[kind]; });
        if (forcedCuts) {
            // Charge each crossed cut, without adding an authorization penalty.
            for (var kind of spending) {
                for (var previousLevel = enactedBefore[kind]; previousLevel > projection.levels[kind]; previousLevel--) {
                    if (kind == "public_salary_level") {
                        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
                            Q.erc_relations -= 1 * (coalitionPartners.includes("erc") ? 2 : 1);
                        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
                            Q[Q.parlament_current_ciu + "_relations"] += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
                        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
                            Q.psc_relations -= 1 * (coalitionPartners.includes("psc") ? 2 : 1);
                        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
                            Q[Q.parlament_current_icv + "_relations"] -= 2 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
                        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
                            Q.cup_relations -= 1 * (coalitionPartners.includes("cup") ? 2 : 1);
                        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
                            Q.ppc_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("ppc") ? 2 : 1);
                        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
                            Q.cs_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("cs") ? 2 : 1);
                        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
                            Q.pdcat_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("pdcat") ? 2 : 1);
                        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
                            Q.unio_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("unio") ? 2 : 1);
                        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
                            Q.fnc_relations += 0 * (coalitionPartners.includes("fnc") ? 2 : 1);
                        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
                            Q.pxc_relations += 0 * (coalitionPartners.includes("pxc") ? 2 : 1);
                        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
                            Q.vox_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("vox") ? 2 : 1);
                        // An outside cabinet list follows its CiU-family leadership.
                        for (var list of ["jxsi", "jxcat"]) {
                            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                                Q[list + "_relations"] += (previousLevel > 0 ? 1 : 0) * 2;
                        }
                        if (Q.player_party == "erc") {
                            Q.erc_left_dissent += 2;
                            Q.erc_core_dissent += 1;
                            Q.erc_pragmatic_dissent += previousLevel <= 0 ? 1 : 0;
                        }
                        if (Q.player_party == "cup") {
                            Q.cup_endavant_dissent += 2;
                            Q.cup_poblelliure_dissent += 1;
                            Q.cup_thirdsector_dissent += 2;
                        }
                    } else {
                        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
                            Q.erc_relations += (previousLevel > 0 ? -2 : -1) * (coalitionPartners.includes("erc") ? 2 : 1);
                        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
                            Q[Q.parlament_current_ciu + "_relations"] += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
                        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
