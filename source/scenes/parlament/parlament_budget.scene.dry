@cap_lower
title: Lower social spending caps
view-if: parlament_budget_cap_lower
on-arrival: {!
    Q.budget_draft.social_spending_cap += -1;
    Q.parlament_budget_deals = [];
    Q.parlament_budget_changes_made = true;
!}
go-to: review

@cap_higher
title: Raise social spending caps
view-if: parlament_budget_cap_higher
on-arrival: {!
    Q.budget_draft.social_spending_cap += 1;
    Q.parlament_budget_deals = [];
    Q.parlament_budget_changes_made = true;
!}
go-to: review

@tax_lower
title: Lower taxes across the board
view-if: parlament_budget_tax_lower
on-arrival: {!
    Q.budget_draft.tax_policy_level += -1;
    Q.parlament_budget_deals = [];
    Q.parlament_budget_changes_made = true;
!}
go-to: review

@tax_higher
title: Progressively raise taxes
