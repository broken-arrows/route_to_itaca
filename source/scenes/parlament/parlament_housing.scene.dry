title: Housing Emergency Law
new-page: true
choose-if: party_resources > 0 and not parlament_housing_passed
subtitle: [? if coming_from_parlament: \[-1 resources\]?]
unavailable-subtitle: [? if parlament_housing_passed: Already approved!?][? if not parlament_housing_passed and party_resources < 1: Not enough resources.?]
on-arrival: {!
    if (Q.coming_from_parlament) Q.party_resources -= 1;
    Q.parlament_housing_deals = [];
!}

= Housing Emergency Law

Since the burst of the housing bubble, Catalonia has faced a housing emergency. With a very small public housing numbers, families face dramatic evictions, uncapped rent increases, and unsustainable debt. A citizen initiative has finally reached the halls of the Parlament, but it is now up to the parties to decide how to respond to that. Housing policy requires a direction: the administration's efforts can either be put on expanding public stock, or on creating and enforcing compulsory rent caps, debt relief, and other protections for tenants, as the citizen initiative proposes.

- @housing_public_stock: Expand public housing stock.
- @housing_compulsory_relief: Develop a framework for rent caps and more tenant-protective legislation.

@housing_public_stock
on-arrival: parlament_housing_variant = "acquisition_rehabilitation"
go-to: housing_negotiation

Such expansion of the public rent offering will take a toll on the Generalitat's finances, which makes some on the right a bit uneasy. We may want to approach them if we want to secure an ample majority for this vote.

@housing_compulsory_relief
on-arrival: parlament_housing_variant = "compulsory_rent_debt_relief"
go-to: housing_negotiation

Such a radical intervention on the private housing market is a bit of a tough pill to swallow for some on the centre and on the right. We may want to approach them if we want to secure an ample majority for this vote.

@housing_negotiation
on-arrival: {!
    var playerProposal = Q.coming_from_parlament;
    var proposingParty = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    var ambitious = Q.parlament_housing_variant == "compulsory_rent_debt_relief";
    var yesNames = ambitious
        ? ["jxsi","jxcat","erc","cup","icv","csqp","cecp","ecp","si"]
        : ["ciu","cdc","dl","pdcat","jxsi","jxcat","junts","erc","psc","cs","icv","csqp","cecp","ecp","si"];
    var noNames = ambitious
        ? ["ppc","cs","vox","pxc","fnc"]
        : ["ppc","vox","pxc","fnc"];
    if (playerProposal && !yesNames.includes(proposingParty)) yesNames.push(proposingParty);
    Q.parlament_housing_yes_names = yesNames;
    Q.parlament_housing_no_names = noNames;

    function canApproach(party, eligible) {
        if (!eligible || !party) return false;
        if ((Q[party + "_parlament_s"] || 0) <= 0) return false;
        if (Q.parlament_housing_yes_names.includes(party)) return false;
        return !Q.parlament_housing_deals.some(function (deal) { return deal.party == party; });
    }

    var ercPlayer = Q.player_party == "erc";
    var cupPlayer = Q.player_party == "cup";
    Q.parlament_housing_can_approach_cup = canApproach("cup", ercPlayer);
    Q.parlament_housing_can_approach_psc = canApproach("psc", ercPlayer);
    Q.parlament_housing_can_approach_erc = canApproach("erc", cupPlayer);
    Q.parlament_housing_can_approach_convergence = canApproach(Q.parlament_current_ciu, ercPlayer || cupPlayer);
    Q.parlament_housing_can_approach_icv = canApproach(Q.parlament_current_icv, ercPlayer || cupPlayer);
!}

- @housing_approach_cup
- @housing_approach_psc
- @housing_approach_erc
- @housing_approach_convergence
- @housing_approach_icv
- @housing_vote: Proceed with the vote

@housing_approach_cup
title: Approach the CUP before the vote
view-if: parlament_housing_can_approach_cup
choose-if: cup_relations > 55
unavailable-subtitle: We don't have good enough relations with the CUP
on-arrival: parlament_housing_deal_party = "cup"
go-to: housing_make_deal

· The CUP will not oppose our proposal.

@housing_approach_psc
title: Approach the PSC before the vote
view-if: parlament_housing_can_approach_psc
choose-if: psc_relations > 55
unavailable-subtitle: We don't have good enough relations with the PSC
on-arrival: parlament_housing_deal_party = "psc"
go-to: housing_make_deal

· The PSC will not oppose our proposal.

@housing_approach_erc
title: Approach ERC before the vote
view-if: parlament_housing_can_approach_erc
choose-if: erc_relations > 55
unavailable-subtitle: We don't have good enough relations with ERC
on-arrival: parlament_housing_deal_party = "erc"
go-to: housing_make_deal

· ERC will not oppose our proposal.

@housing_approach_convergence
title: Approach [+ parlament_current_ciu +] before the vote
choose-if: (ciu_parlament_s > 0 and ciu_relations > 55) or (cdc_parlament_s > 0 and cdc_relations > 55) or (dl_parlament_s > 0 and dl_relations > 55) or (pdcat_parlament_s > 0 and pdcat_relations > 55) or (jxcat_parlament_s > 0 and jxcat_relations > 55 and not player_in_jxcat) or (junts_parlament_s > 0 and junts_relations > 55)
view-if: parlament_housing_can_approach_convergence
unavailable-subtitle: We don't have good enough relations with [+ parlament_current_ciu +]
on-arrival: {!
    Q.parlament_housing_deal_party = Q.parlament_current_ciu;
!}
go-to: housing_make_deal

· [+ parlament_current_ciu +] will not oppose our proposal.

@housing_approach_icv
title: Approach [+ parlament_current_icv +] before the vote
view-if: parlament_housing_can_approach_icv
choose-if: (icv_parlament_s > 0 and icv_relations > 55) or (csqp_parlament_s > 0 and csqp_relations > 55) or (cecp_parlament_s > 0 and cecp_relations > 55) or (ecp_parlament_s > 0 and ecp_relations > 55)
unavailable-subtitle: We don't have good enough relations with [+ parlament_current_icv +]
on-arrival: {!
    Q.parlament_housing_deal_party = Q.parlament_current_icv;
!}
go-to: housing_make_deal

· [+ parlament_current_icv +] will not oppose our proposal.

@housing_make_deal
on-arrival: {!
    var party = Q.parlament_housing_deal_party;
    var baselineNo = Q.parlament_housing_no_names.includes(party);
    var newPosition = baselineNo && Q[party + "_relations"] <= 65 ? "abstain" : "yes";
    Q.parlament_housing_deals.push({party: party, position: newPosition});
    Q[party + "_relations"] -= 5;
!}
go-to: housing_negotiation

@housing_vote
subtitle: [? if not parlament_housing_deal_party: Who needs their support anyway? ?]
on-arrival: {!
    var playerProposal = Q.coming_from_parlament;
    var proposingParty = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    Q.coming_from_parlament = false;
    var ambitious = Q.parlament_housing_variant == "compulsory_rent_debt_relief";
    var author = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    var socialDonor = Q.parlament_current_icv;
    var backlash = Q.cs_parlament_s > 0 ? "cs" : "ppc";

    var proposalYoung = ambitious ? 0.0825 : 0.075;
    var proposalUnemployed = ambitious ? 0.1125 : 0.105;
    var proposalMiddle = ambitious ? 0.045 : 0.045;
    var proposalBussLoss = ambitious ? 0.06 : 0;
    var proposalMiddleLoss = ambitious ? 0.027 : 0;
    var proposalRetiredLoss = ambitious ? 0.015 : 0;
    for (const c of Q.parlament_constituencies) {
        Q[author + "_parlament_" + c + "_young_support"] += proposalYoung;
        Q[socialDonor + "_parlament_" + c + "_young_support"] -= proposalYoung;
        Q[author + "_parlament_" + c + "_unemployed_support"] += proposalUnemployed;
        Q[socialDonor + "_parlament_" + c + "_unemployed_support"] -= proposalUnemployed;
        Q[author + "_parlament_" + c + "_middle_support"] += proposalMiddle;
        Q[socialDonor + "_parlament_" + c + "_middle_support"] -= proposalMiddle;
        Q[author + "_parlament_" + c + "_buss_support"] -= proposalBussLoss;
        Q[backlash + "_parlament_" + c + "_buss_support"] += proposalBussLoss;
        Q[author + "_parlament_" + c + "_middle_support"] -= proposalMiddleLoss;
        Q[backlash + "_parlament_" + c + "_middle_support"] += proposalMiddleLoss;
        Q[author + "_parlament_" + c + "_retired_support"] -= proposalRetiredLoss;
        Q[backlash + "_parlament_" + c + "_retired_support"] += proposalRetiredLoss;
    }

    var yesNames = ambitious
        ? ["jxsi","jxcat","erc","cup","icv","csqp","cecp","ecp","si"]
        : ["ciu","cdc","dl","pdcat","jxsi","jxcat","junts","erc","psc","cs","icv","csqp","cecp","ecp","si"];
    var noNames = ambitious
        ? ["ppc","cs","vox","pxc","fnc"]
        : ["ppc","vox","pxc","fnc"];
    if (playerProposal && !yesNames.includes(proposingParty)) yesNames.push(proposingParty);
    for (const deal of (Q.parlament_housing_deals || [])) {
        yesNames = yesNames.filter(function (party) { return party != deal.party; });
        noNames = noNames.filter(function (party) { return party != deal.party; });
        if (deal.position == "yes") yesNames.push(deal.party);
    }
    var all = ["ciu","cdc","dl","pdcat","jxsi","jxcat","junts","erc","cup","psc","ppc","cs","icv","csqp","cecp","ecp","unio","si","vox","pxc","fnc"];
    var labels = {ciu:"CiU",cdc:"CDC",dl:"DL",pdcat:"PDeCAT",jxsi:"JxSí",jxcat:"JxCat",junts:"Junts",erc:"ERC",cup:"CUP",psc:"PSC",ppc:"PPC",cs:"Cs",icv:"ICV-EUiA",csqp:"CSQP",cecp:"CECP",ecp:"ECP",unio:"UDC",si:"SI",vox:"Vox",pxc:"PxC",fnc:"FNC"};
    var yesParties = [], noParties = [], abstainParties = [];
    Q.parlament_housing_yes = 0;
    Q.parlament_housing_no = 0;
    Q.parlament_housing_abst = 0;
    for (const p of all) {
        var seats = Q[p + "_parlament_s"] || 0;
        if (seats <= 0) continue;
        if (yesNames.includes(p)) {
            Q.parlament_housing_yes += seats;
            yesParties.push({label:labels[p]});
        } else if (noNames.includes(p)) {
            Q.parlament_housing_no += seats;
            noParties.push({label:labels[p]});
        } else {
            Q.parlament_housing_abst += seats;
            abstainParties.push({label:labels[p]});
        }
    }
    Q.parlament_housing_passed = Q.parlament_housing_yes > Q.parlament_housing_no;
    Q.parlament_housing_vote_result = {outcomes:[
        {kind:"yes",label:"Yes",votes:Q.parlament_housing_yes,parties:yesParties},
        {kind:"abstain",label:"Abstention",votes:Q.parlament_housing_abst,parties:abstainParties},
        {kind:"no",label:"No",votes:Q.parlament_housing_no,parties:noParties}
    ]};

    if (Q.parlament_housing_passed) {
        var passageYoung = ambitious ? 0.1925 : 0.175;
        var passageUnemployed = ambitious ? 0.2625 : 0.245;
        var passageMiddle = ambitious ? 0.105 : 0.105;
        var passageBussLoss = ambitious ? 0.14 : 0;
        var passageMiddleLoss = ambitious ? 0.063 : 0;
        var passageRetiredLoss = ambitious ? 0.035 : 0;
        for (const c of Q.parlament_constituencies) {
            Q[author + "_parlament_" + c + "_young_support"] += passageYoung;
            Q[socialDonor + "_parlament_" + c + "_young_support"] -= passageYoung;
            Q[author + "_parlament_" + c + "_unemployed_support"] += passageUnemployed;
            Q[socialDonor + "_parlament_" + c + "_unemployed_support"] -= passageUnemployed;
            Q[author + "_parlament_" + c + "_middle_support"] += passageMiddle;
            Q[socialDonor + "_parlament_" + c + "_middle_support"] -= passageMiddle;
            Q[author + "_parlament_" + c + "_buss_support"] -= passageBussLoss;
            Q[backlash + "_parlament_" + c + "_buss_support"] += passageBussLoss;
            Q[author + "_parlament_" + c + "_middle_support"] -= passageMiddleLoss;
            Q[backlash + "_parlament_" + c + "_middle_support"] += passageMiddleLoss;
            Q[author + "_parlament_" + c + "_retired_support"] -= passageRetiredLoss;
            Q[backlash + "_parlament_" + c + "_retired_support"] += passageRetiredLoss;
        }
        if (ambitious) {
            Q.welfare_index += 0.8;
            G.registerLaw(Q, {id:"housing_compulsory_social_rent",title:"Compulsory Social Rent",icon:"img/home_icon.svg",targets:{welfare_index_growth:0.14,generalitat_surplus:-0.015,gdp_growth:-0.02,social_dissent_eq:-2.5},ramp_ticks:4});
            G.registerLaw(Q, {id:"housing_debt_relief_procedure",title:"Mortgage Debt Relief",icon:"img/home_icon.svg",targets:{welfare_index_growth:0.08,gdp_growth:-0.03,social_dissent_eq:-1},ramp_ticks:4});
        } else {
            G.registerLaw(Q, {id:"housing_public_stock",title:"Public Housing Expansion",icon:"img/home_icon.svg",targets:{unemployment_recovery:0.04,welfare_index_growth:0.14,generalitat_surplus:-0.05,social_dissent_eq:-2},ramp_ticks:9});
        }
        Q.constitutional_housing_countdown = 20;
        Q.countdowns.push("constitutional_housing");
    }
!}

<div data-widget="chamber-vote" data-props='{"configFrom":"parlament_housing_vote_result"}'></div>

[? if parlament_housing_passed and parlament_housing_variant == "acquisition_rehabilitation": The Parlament has approved the public-housing programme. Its results will take time and money. Let's hope for it to be a worthwhile long-term investment. ?]
[? if parlament_housing_passed and parlament_housing_variant == "compulsory_rent_debt_relief": The original intent of the citizen initiative has become law. Banks and large landlords must now offer social rent, and a new framework for rent caps is being implemented.?]
[? if not parlament_housing_passed: The Parlament has rejected the bill. No one is particularly happy about this, as doing nothing is for sure guaranteed to not help in addressing the housing crisis. Social organization will keep pressing, and the proposal may be introduced again in a hopefully more favourable moment.?]

- @post_event: Continue...
