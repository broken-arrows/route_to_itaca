role: event

= Parlament votes on Healthcare Privatization

{!<div id="parlament" data-widget="hemicycle" data-props='{"configFrom":"parlament_hemicycle"}'></div>!}

[? if health_minister_gender = "m": Conseller ?][? if health_minister_gender = "f": Consellera ?]of Health [+ health_minister +], working under the current [+ cat_coalition_disp +], is bringing forward quite a controversial proposal. The effective burial of the public healthcare system is about to be voted.

- @vote_no: We'll, of course, vote No.
- @vote_yes: Exceptional times call for exceptional measures, we'll vote Yes.
- @prevent_law

@vote_no
on-arrival: parlament_healthcare_privatization_player_vote = "no"
go-to:vote

@vote_yes
choose-if: player_party != "cup"
unavailable-subtitle: Our party will never vote for this.
on-arrival: parlament_healthcare_privatization_player_vote = "yes"
go-to:vote

@prevent_law
title: Block the discussion and voting of the law to take place in the first place!
subtitle: Speaker of the House [+ speaker +] can argue that it is against the Statute of Autonomy and thus, does not pass the bar to get to the floor. It will require a bit of legal shielding efforts to make such an argument, though. \[-1 resources\]
choose-if: party_resources > 0 and (speaker_party = player_party or (speaker_party = "jxsi" and player_in_jxsi) or (speaker_party = "jxcat" and player_in_jxcat))
unavailable-subtitle: [? if not (speaker_party = player_party or (speaker_party = "jxsi" and player_in_jxsi) or (speaker_party = "jxcat" and player_in_jxcat)): We do not control the Speaker of the House.  ?][? if (speaker_party = player_party or (speaker_party = "jxsi" and player_in_jxsi) or (speaker_party = "jxcat" and player_in_jxcat)): Not enough resources. ?]
on-arrival: party_resources -= 1
go-to: on_no

Thanks to some clever maneuvering, Speaker of the House [+ speaker +] has been able to get the Parlament legal services on [? if speaker_gender = "f": her?][? if speaker_gender = "m": his?] side and block the proposal before it even reached the floor.

@vote
on-arrival: {!
    var proposer = Q.health_minister_party;
    var playerCarrier = Q.player_in_jxsi && Q.jxsi_parlament_s > 0 ? "jxsi" :
        Q.player_in_jxcat && Q.jxcat_parlament_s > 0 ? "jxcat" : Q.player_party;
    var playerYes = Q.player_party != "cup" && Q.parlament_healthcare_privatization_player_vote == "yes";
    var parties = ["ciu","cdc","dl","pdcat","jxsi","jxcat","junts","erc","cup","psc","ppc","cs","icv","csqp","cecp","ecp","unio","si","vox","pxc","fnc"];
    var labels = {ciu:"CiU",cdc:"CDC",dl:"DL",pdcat:"PDeCAT",jxsi:"JxSí",jxcat:"JxCat",junts:"Junts",erc:"ERC",cup:"CUP",psc:"PSC",ppc:"PPC",cs:"Cs",icv:"ICV-EUiA",csqp:"CSQP",cecp:"CECP",ecp:"ECP",unio:"UDC",si:"SI",vox:"Vox",pxc:"PxC",fnc:"FNC"};
    var yesParties = [], noParties = [], abstainParties = [];
    Q.parlament_healthcare_privatization_yes = 0;
    Q.parlament_healthcare_privatization_no = 0;
    Q.parlament_healthcare_privatization_abst = 0;
    for (const party of parties) {
        var seats = Q[party + "_parlament_s"] || 0;
        if (seats <= 0) continue;
        var position = "no";
        if (["cs", "vox", "pxc", "fnc"].includes(party)) {
            position = "yes";
        } else if (party == "ppc" && proposer == "cs" && Q.cat_coalition.includes("cs")) {
            position = "yes";
        } else if (party == "pdcat" || party == "unio") {
            position = "abstain";
        }
        // A unity list carries its constituents' seats once; the player's
        // choice controls that carrier only while the player belongs to it.
        if (party == playerCarrier) position = playerYes ? "yes" : "no";
        if (position == "yes") {
            Q.parlament_healthcare_privatization_yes += seats;
            yesParties.push({label:labels[party]});
        } else if (position == "abstain") {
            Q.parlament_healthcare_privatization_abst += seats;
            abstainParties.push({label:labels[party]});
        } else {
            Q.parlament_healthcare_privatization_no += seats;
            noParties.push({label:labels[party]});
        }
    }
    Q.parlament_healthcare_privatization_passed = Q.healthcare_privatization_introduced && Q.parlament_healthcare_privatization_yes > Q.parlament_healthcare_privatization_no && Q.healthcare_spending == -2;
    Q.parlament_healthcare_privatization_vote_result = {outcomes:[
        {kind:"yes",label:"Yes",votes:Q.parlament_healthcare_privatization_yes,parties:yesParties},
        {kind:"abstain",label:"Abstention",votes:Q.parlament_healthcare_privatization_abst,parties:abstainParties},
        {kind:"no",label:"No",votes:Q.parlament_healthcare_privatization_no,parties:noParties}
    ]};
    G.deactivateLaw(Q, "healthcare_privatization_proposal", undefined, true);
!}
go-to: on_yes if parlament_healthcare_privatization_passed; on_no if not parlament_healthcare_privatization_passed

<div data-widget="chamber-vote" data-props='{"configFrom":"parlament_healthcare_privatization_vote_result"}'></div>

[? if not parlament_healthcare_privatization_passed: The Parlament has rejected [+ health_minister +]'s  proposal. ?]

@on_yes
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (Q.parlament_healthcare_privatization_passed && Q.healthcare_privatization_introduced && Q.healthcare_spending == -2 && !Q.cat_caretaker_gov && controlledParties.includes(Q.health_minister_party)) {
        Q.government_budget += 2;
        Q.healthcare_spending = -3;
        Q.burdens_broken = true;
        if (!Q.healthcare_privatized_ruling) {
            if (!Q.countdowns.includes("constitutional_healthcare_privatization")) Q.countdowns.push("constitutional_healthcare_privatization");
            Q.constitutional_healthcare_privatization_countdown = 6;
        }
        var voterPolicies = [{demographics:{retired:2,ind:2,unemployed:2.2,young:1.2,middle:1}, provinces:{barcelona:1,girona:1.1,lleida:1.1,tarragona:1.05}, routes:(null), sign:-1, congreso:(0.1), barcelona:(0.2)},{demographics:Q.player_party == "cup" ? {buss:0.12} : {buss:0.35}, provinces:{barcelona:1,girona:1,lleida:1,tarragona:1}, routes:([["ciu",0.65],["cs",0.35]]), sign:1, congreso:(0.006), barcelona:(0.012)}];

        // Policy voters: explicit demographic/province transfers, with ministry responsibility 80/20.
        var voterOrigin = Q.player_party;
        var voterCabinet = Array.from(new Set(Q.cat_coalition || []));
        // Allocate ministry responsibility once across unique Parlament ballot carriers.
        var voterActors = [];
        for (var voterParty of [voterOrigin].concat(voterCabinet)) {

            var voterCandidates = [voterParty];
            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        for (var voterPolicy of voterPolicies) {
            var voterCells = [];
            for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || []) {
                var voterAmount = (voterPolicy.demographics[voterDemo] || 0) * (voterPolicy.provinces[voterProvince] || 0);
                if (voterAmount) voterCells.push({contest:"parlament",province:voterProvince,demo:voterDemo,amount:voterAmount});
            }
            if (voterPolicy.congreso && (Q.congreso_constituencies || []).includes("catalunya")) voterCells.push({contest:"congreso",province:"catalunya",demo:null,amount:voterPolicy.congreso});
            if (voterPolicy.barcelona) voterCells.push({contest:"barcelona",province:null,demo:null,amount:voterPolicy.barcelona});
            for (var voterCell of voterCells) {
                var voterContest = voterCell.contest;
                var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
                var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
                var voterSignedAmount = voterCell.amount * (Math.abs(voterPolicy.sign));
                if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
                var voterDirection = voterPolicy.sign > 0 ? 1 : -1;
                for (var voterActor of voterActors) {
                    var voterRouteList = voterPolicy.routes || (voterPolicy.backlash ? (voterActor.origin == "cup" ? [["erc",0.60],["ciu",0.25],["abstain",0.15]] : voterActor.origin == "erc" ? [["ciu",0.60],["cs",0.25],["abstain",0.15]] : [["ciu",0.45],["cs",0.35],["abstain",0.20]]) : (voterActor.origin == "erc" ? [["cup",0.45],["fl",0.35],["abstain",0.20]] : voterActor.origin == "cup" ? [["fl",0.45],["erc",0.35],["abstain",0.20]] : voterActor.origin == "psc" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : ["ecp","cecp","csqp","icv"].includes(voterActor.origin) ? [["cup",0.40],["erc",0.30],["abstain",0.30]] : [["erc",0.40],["fl",0.35],["abstain",0.25]]));
                    for (var voterRoute of voterRouteList) {
                        var voterPair = [];
                        for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                            var voterCandidates = [voterParty];
                            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                            if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                            if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                            if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                            var voterCarrier = null;
                            for (var voterCandidate of voterCandidates) {
                                if (!voterLineup.includes(voterCandidate)) continue;
                                if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                                if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                            }
                            voterPair.push(voterCarrier);
                        }
                        if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                        var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                        var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                        if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                        if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                        G.cardSupportTransfer(Q,voterOptions);

                    }
                }
            }
        }
    }
    Q.healthcare_privatization_introduced = false;
!}
call: generalitat_setpolicy

In a landmark vote, the Parlament has approved the effective privatization of healthcare. Whatever is left of public healthcare is to be completely replaced by private hospitals and clinics and, in the best case scenario for vulnerable patients, public subsidies for basic treatment.

- @post_event

@on_no
on-arrival: {!
    Q.healthcare_privatization_introduced = false;
    G.deactivateLaw(Q, "healthcare_privatization_proposal", undefined, true);
!}

Public Healthcare in Catalonia, even if on the verge of collapsing, will live to fight another day, at least for now.

- @post_event
