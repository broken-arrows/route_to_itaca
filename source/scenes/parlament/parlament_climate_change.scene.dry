title: Climate Change Law
new-page: true
choose-if: party_resources > 0 and not parlament_climate_change_passed
subtitle: [? if coming_from_parlament: \[-1 resources\]?]
unavailable-subtitle: [? if parlament_climate_change_passed: Already approved!?][? if not parlament_climate_change_passed and party_resources < 1: Not enough resources.?]
on-arrival: {!
    if (Q.coming_from_parlament) Q.party_resources -= 1;
    Q.parlament_climate_change_deals = [];
!}

= Climate Change Law

Catalonia already feels a warming climate through drought, fire risk and increased coastal erosion. While unprecedented in Europe, it is within the powers of the Parlament to bind the executive and companies and individuals operating in Catalonia to, for instance, measured carbon budgets. Alternatively, it could also bet on a faster economy-wide transition, even if that may step into the blurry lines of autonomy powers in sectors like energy and transport planning.

- @climate_carbon_budgets: Set carbon budgets for Catalan institutions and industry
- @climate_economy_transition: Bind the whole economy to a rapid green transition

@climate_carbon_budgets
on-arrival: parlament_climate_change_variant = "carbon_budgets"
go-to: climate_change_vote

@climate_economy_transition
subtitle: An unprecedented effort with economy-wide targets, fossil-fuel restrictions and transport and energy mandates. One may even call it a green version of the "New Deal"?
on-arrival: parlament_climate_change_variant = "economy_transition"
go-to: climate_change_negotiation

Many on the right of the political spectrum are fundamentally opposed to this level of regulation of the private sector. We may want to approach them if we want to secure an ample majority for this vote.

@climate_change_negotiation
on-arrival: {!
    var playerProposal = Q.coming_from_parlament;
    var proposingParty = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    var ambitious = Q.parlament_climate_change_variant == "economy_transition";
    var yesNames = ambitious
        ? ["jxsi","jxcat","erc","cup","psc","icv","csqp","cecp","ecp","si"]
        : ["ciu","cdc","dl","pdcat","jxsi","jxcat","junts","erc","cup","psc","cs","icv","csqp","cecp","ecp","unio","si"];
    var noNames = ambitious
        ? ["ppc","vox","pxc","fnc"]
        : ["vox","pxc","fnc"];
    if (playerProposal && !yesNames.includes(proposingParty)) yesNames.push(proposingParty);
    Q.parlament_climate_change_yes_names = yesNames;
    Q.parlament_climate_change_no_names = noNames;

    function canApproach(party, eligible) {
        if (!eligible || !party) return false;
        if ((Q[party + "_parlament_s"] || 0) <= 0) return false;
        if (Q.parlament_climate_change_yes_names.includes(party)) return false;
        return !Q.parlament_climate_change_deals.some(function (deal) { return deal.party == party; });
    }

    var ercPlayer = Q.player_party == "erc";
    var cupPlayer = Q.player_party == "cup";
    Q.parlament_climate_change_can_approach_cup = canApproach("cup", ercPlayer);
    Q.parlament_climate_change_can_approach_psc = canApproach("psc", ercPlayer);
    Q.parlament_climate_change_can_approach_erc = canApproach("erc", cupPlayer);
    Q.parlament_climate_change_can_approach_convergence = canApproach(Q.parlament_current_ciu, ercPlayer || cupPlayer);
    Q.parlament_climate_change_can_approach_icv = canApproach(Q.parlament_current_icv, ercPlayer || cupPlayer);
!}

- @climate_change_approach_cup
- @climate_change_approach_psc
- @climate_change_approach_erc
- @climate_change_approach_convergence
- @climate_change_approach_icv
- @climate_change_vote: Proceed with the vote

@climate_change_approach_cup
title: Approach the CUP before the vote
view-if: parlament_climate_change_can_approach_cup
choose-if: cup_relations > 55
unavailable-subtitle: We don't have good enough relations with the CUP
on-arrival: parlament_climate_change_deal_party = "cup"
go-to: climate_change_make_deal

· The CUP will not oppose our proposal.

@climate_change_approach_psc
title: Approach the PSC before the vote
view-if: parlament_climate_change_can_approach_psc
choose-if: psc_relations > 55
unavailable-subtitle: We don't have good enough relations with the PSC
on-arrival: parlament_climate_change_deal_party = "psc"
go-to: climate_change_make_deal

· The PSC will not oppose our proposal.

@climate_change_approach_erc
title: Approach ERC before the vote
view-if: parlament_climate_change_can_approach_erc
choose-if: erc_relations > 55
unavailable-subtitle: We don't have good enough relations with ERC
on-arrival: parlament_climate_change_deal_party = "erc"
go-to: climate_change_make_deal

· ERC will not oppose our proposal.

@climate_change_approach_convergence
title: Approach [+ parlament_current_ciu +] before the vote
choose-if: (ciu_parlament_s > 0 and ciu_relations > 55) or (cdc_parlament_s > 0 and cdc_relations > 55) or (dl_parlament_s > 0 and dl_relations > 55) or (pdcat_parlament_s > 0 and pdcat_relations > 55) or (jxcat_parlament_s > 0 and jxcat_relations > 55 and not player_in_jxcat) or (junts_parlament_s > 0 and junts_relations > 55)
view-if: parlament_climate_change_can_approach_convergence
unavailable-subtitle: We don't have good enough relations with [+ parlament_current_ciu +]
on-arrival: {!
    Q.parlament_climate_change_deal_party = Q.parlament_current_ciu;
!}
go-to: climate_change_make_deal

· [+ parlament_current_ciu +] will not oppose our proposal.

@climate_change_approach_icv
title: Approach [+ parlament_current_icv +] before the vote
view-if: parlament_climate_change_can_approach_icv
choose-if: (icv_parlament_s > 0 and icv_relations > 55) or (csqp_parlament_s > 0 and csqp_relations > 55) or (cecp_parlament_s > 0 and cecp_relations > 55) or (ecp_parlament_s > 0 and ecp_relations > 55)
unavailable-subtitle: We don't have good enough relations with [+ parlament_current_icv +]
on-arrival: {!
    Q.parlament_climate_change_deal_party = Q.parlament_current_icv;
!}
go-to: climate_change_make_deal

· [+ parlament_current_icv +] will not oppose our proposal.

@climate_change_make_deal
on-arrival: {!
    var party = Q.parlament_climate_change_deal_party;
    var baselineNo = Q.parlament_climate_change_no_names.includes(party);
    var newPosition = baselineNo && Q[party + "_relations"] <= 65 ? "abstain" : "yes";
    Q.parlament_climate_change_deals.push({party: party, position: newPosition});
    Q[party + "_relations"] -= 5;
!}
go-to: climate_change_negotiation

@climate_change_vote
subtitle: [? if not parlament_climate_change_deal_party: Who needs their support anyway? ?]
on-arrival: {!
    // TODO: Even more radical version for CUP?
    var playerProposal = Q.coming_from_parlament;
    var proposingParty = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    Q.coming_from_parlament = false;
    var ambitious = Q.parlament_climate_change_variant == "economy_transition";
    var author = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    var greenDonor = Q.parlament_current_icv;
    var backlash = Q.cs_parlament_s > 0 ? "cs" : "ppc";

    var proposalYoung = ambitious ? 0.12 : 0.06;
    var proposalMiddle = ambitious ? 0.06 : 0.03;
    var proposalBussLoss = ambitious ? 0.12 : 0;
    var proposalMiddleLoss = ambitious ? 0.054 : 0;
    var proposalRetiredLoss = ambitious ? 0.03 : 0;
    for (const c of Q.parlament_constituencies) {
        Q[author + "_parlament_" + c + "_young_support"] += proposalYoung;
        Q[greenDonor + "_parlament_" + c + "_young_support"] -= proposalYoung;
        Q[author + "_parlament_" + c + "_middle_support"] += proposalMiddle;
        Q[greenDonor + "_parlament_" + c + "_middle_support"] -= proposalMiddle;
        Q[author + "_parlament_" + c + "_buss_support"] -= proposalBussLoss;
        Q[backlash + "_parlament_" + c + "_buss_support"] += proposalBussLoss;
        Q[author + "_parlament_" + c + "_middle_support"] -= proposalMiddleLoss;
        Q[backlash + "_parlament_" + c + "_middle_support"] += proposalMiddleLoss;
        Q[author + "_parlament_" + c + "_retired_support"] -= proposalRetiredLoss;
        Q[backlash + "_parlament_" + c + "_retired_support"] += proposalRetiredLoss;
    }

    var yesNames = ambitious
        ? ["jxsi","jxcat","erc","cup","psc","icv","csqp","cecp","ecp","si"]
        : ["ciu","cdc","dl","pdcat","jxsi","jxcat","junts","erc","cup","psc","cs","icv","csqp","cecp","ecp","unio","si"];
    var noNames = ambitious
        ? ["ppc","vox","pxc","fnc"]
        : ["vox","pxc","fnc"];
    if (playerProposal && !yesNames.includes(proposingParty)) yesNames.push(proposingParty);
    for (const deal of (Q.parlament_climate_change_deals || [])) {
        yesNames = yesNames.filter(function (party) { return party != deal.party; });
        noNames = noNames.filter(function (party) { return party != deal.party; });
        if (deal.position == "yes") yesNames.push(deal.party);
    }
    var all = ["ciu","cdc","dl","pdcat","jxsi","jxcat","junts","erc","cup","psc","ppc","cs","icv","csqp","cecp","ecp","unio","si","vox","pxc","fnc"];
    var labels = {ciu:"CiU",cdc:"CDC",dl:"DL",pdcat:"PDeCAT",jxsi:"JxSí",jxcat:"JxCat",junts:"Junts",erc:"ERC",cup:"CUP",psc:"PSC",ppc:"PPC",cs:"Cs",icv:"ICV-EUiA",csqp:"CSQP",cecp:"CECP",ecp:"ECP",unio:"UDC",si:"SI",vox:"Vox",pxc:"PxC",fnc:"FNC"};
    var yesParties = [], noParties = [], abstainParties = [];
    Q.parlament_climate_change_yes = 0;
    Q.parlament_climate_change_no = 0;
    Q.parlament_climate_change_abst = 0;
    for (const p of all) {
        var seats = Q[p + "_parlament_s"] || 0;
        if (seats <= 0) continue;
        if (yesNames.includes(p)) {
            Q.parlament_climate_change_yes += seats;
            yesParties.push({label:labels[p]});
        } else if (noNames.includes(p)) {
            Q.parlament_climate_change_no += seats;
            noParties.push({label:labels[p]});
        } else {
            Q.parlament_climate_change_abst += seats;
            abstainParties.push({label:labels[p]});
        }
    }
    Q.parlament_climate_change_passed = Q.parlament_climate_change_yes > Q.parlament_climate_change_no;
    Q.parlament_climate_change_vote_result = {outcomes:[
        {kind:"yes",label:"Yes",votes:Q.parlament_climate_change_yes,parties:yesParties},
        {kind:"abstain",label:"Abstention",votes:Q.parlament_climate_change_abst,parties:abstainParties},
        {kind:"no",label:"No",votes:Q.parlament_climate_change_no,parties:noParties}
    ]};

    if (Q.parlament_climate_change_passed) {
        var passageYoung = ambitious ? 0.28 : 0.14;
        var passageMiddle = ambitious ? 0.14 : 0.07;
        var passageBussLoss = ambitious ? 0.28 : 0;
        var passageMiddleLoss = ambitious ? 0.126 : 0;
        var passageRetiredLoss = ambitious ? 0.07 : 0;
        for (const c of Q.parlament_constituencies) {
            Q[author + "_parlament_" + c + "_young_support"] += passageYoung;
            Q[greenDonor + "_parlament_" + c + "_young_support"] -= passageYoung;
            Q[author + "_parlament_" + c + "_middle_support"] += passageMiddle;
            Q[greenDonor + "_parlament_" + c + "_middle_support"] -= passageMiddle;
            Q[author + "_parlament_" + c + "_buss_support"] -= passageBussLoss;
            Q[backlash + "_parlament_" + c + "_buss_support"] += passageBussLoss;
            Q[author + "_parlament_" + c + "_middle_support"] -= passageMiddleLoss;
            Q[backlash + "_parlament_" + c + "_middle_support"] += passageMiddleLoss;
            Q[author + "_parlament_" + c + "_retired_support"] -= passageRetiredLoss;
            Q[backlash + "_parlament_" + c + "_retired_support"] += passageRetiredLoss;
        }
        if (ambitious) {
            Q.climate_capacity = (Q.climate_capacity || 0) + 18;
            Q.climate_transition_mature = false;
            Q.climate_transition_contested_struck = false;
            G.registerLaw(Q, {id:"climate_transition_core_initial",title:"Climate Transition Program",icon:"img/leaf_icon.svg",targets:{gdp_growth:-0.04,generalitat_surplus:-0.02,unemployment_recovery:0.015}});
            G.registerLaw(Q, {id:"climate_binding_targets_initial",title:"Binding Economy-Wide Climate Targets",icon:"img/leaf_icon.svg",targets:{gdp_growth:-0.06,generalitat_surplus:-0.01,unemployment_recovery:0.005}});
            Q.climate_transition_matures_countdown = 12;
            Q.countdowns.push("climate_transition_matures");
        } else {
            Q.climate_capacity = (Q.climate_capacity || 0) + 8;
            G.registerLaw(Q, {id:"climate_carbon_budgets",title:"Catalan Carbon Budgets",icon:"img/leaf_icon.svg",targets:{gdp_growth:-0.02,generalitat_surplus:-0.015,welfare_index_growth:0.03},ramp_ticks:12});
        }
        Q.constitutional_climate_change_countdown = 24;
        Q.countdowns.push("constitutional_climate_change");
    }
!}

<div data-widget="chamber-vote" data-props='{"configFrom":"parlament_climate_change_vote_result"}'></div>

[? if parlament_climate_change_passed and parlament_climate_change_variant == "carbon_budgets": In a first for the European continent, the Parlament has approved binding Carbon budgets for the Catalan institutions and industry. The program, while a first-of-a-kind, it's still quite forgiving and relies on slowly building capacity slowly, so even right-wing parties that historically accepted climate legislation have little to oppose.?]
[? if parlament_climate_change_passed and parlament_climate_change_variant == "economy_transition": In a true first in the European continent, the Parlament has approved a binding economy-wide climate transition. There's little doubt in that the first years will be costly, but we should hope and expect a more resilient and sustainable economy in the long run.?]
[? if not parlament_climate_change_passed: The Parlament has rejected the first-of-its-kind Climate law. The draft can return, but climate change will hardly wait for a more convenient majority.?]

- @post_event: Continue...
