title: The no-confidence vote
view-if: year = 2018 and month = 6
tags: event
new-page: true
max-visits: 1
on-arrival: {!
    // TODO: un-hardcode this: motion of no confidence happens conditionally and depending on player action
    // PSOE wins the no-confidence vote; Sánchez becomes PM. Government changes,
    // PSOE consolidates the anti-PP left and partially resets its corruption stain.
    Q.spanish_coalition = ["psoe"];
    G.setText(Q, "spanish_coalition_disp", G.text("{party} {government}", {
        party: "PSOE",
        government: G.governmentTooltipText("gobierno", Q.spanish_coalition, G.text("Minority government - {seats}/{majority}", {
            seats: String(Q.psoe_congreso_s),
            majority: String(Q.congreso_s_majority)
        }), G.text("<span style='color: var(--psoe);'>minority government</span>"))
    }));
    Q.spanish_pm = "Pedro Sánchez";
    Q.spanish_pm_party = "psoe";
    Q.spanish_pm_gender = "m";
    Q.corruption_psoe = Math.max(0, Q.corruption_psoe - 8);
    G.spaSupportInject(Q, 'psoe', 'all', 5.0, 'podemos');
    G.spaSupportInject(Q, 'psoe', 'all', 4.0, 'abstain');
!}
role: event

- @post_event: TODO
