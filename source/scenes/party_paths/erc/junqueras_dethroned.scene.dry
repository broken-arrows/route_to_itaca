{!<div data-widget="result-bars" data-props='{"configFrom":"erc_primary_second_round"}'></div>!}

@result
on-arrival: {!
    var primary = Q.erc_primary;
    if (primary?.winner && !primary.resolved) {
        primary.resolved = true;
        Q.junqueras_dethroned = true;
        var winner = primary.candidates.find(function (c) { return c.id == primary.winner; });
        G.setText(Q, "erc_primary_winner_name", G.literalText(winner.name));
        Q.erc_primary_winner_gender = winner.gender;
        Q.erc_primary_seat = winner.id;
        Q.junqueras_reelected = winner.id == "oriol_junqueras";
        if (!Q.junqueras_reelected) {
            Q.oriol_junqueras_advisor = 0;
            Q.oriol_junqueras_advisor_available = 0;
            // A party primary does not reverse a public-office disqualification.
            var disqualified = Q.consultation_verdict && Q.consultation_verdict.defendants.some(function (d) { return d.name == winner.name; });
            if (!disqualified) {
                Q.erc_leader = winner.name;
                Q.erc_leader_gender = winner.gender;
            }
        }
        var final = primary.needsRunoff ? primary.runoff : primary.first;
        var votes = final.find(function (row) { return row.id == winner.id; });
        var profile = {
            oriol_junqueras: {dissent:[2,-3,0,2], relations:{}},
            marta_rovira: {dissent:[-4,4,0,0], relations:{cup:3, [Q.parlament_current_icv]:4}},
            pere_aragones: {dissent:[1,1,-4,Q.erc_roadmap == 3 ? 3 : 6], relations:{psc:4, cup:-3}},
            raul_romeva: {dissent:[0,-2,1,-2], relations:{[Q.parlament_current_ciu]:4, cup:3}},
            carme_forcadell: {dissent:[0,2,6,-5], relations:{cup:4}}
        }[winner.id];
        var closeResult = Math.max(0, Math.min(1, (65 - primary.winningShare) / 15));
        var pragmaticDissent = Q.erc_pragmatic_dissent;
        var disappointed = [];
        for (var f = 0; f < primary.factions.length; f++) {
            var weight = primary.weights[f];
            var approval = weight ? votes.factions[f] / (100 * weight) : 0;
            disappointed.push(weight * (1 - approval));
            if (!weight) continue;
            var change = profile.dissent[f] + 14 * (0.5 - approval) + 3 * closeResult * (1 - approval);
            var key = "erc_" + primary.factions[f] + "_dissent";
            Q[key] = Math.max(0, Math.min(100, (Number(Q[key]) || 0) + change));
        }
        for (var [party, change] of Object.entries(profile.relations)) {
            var relation = party + "_relations";
            if (Number.isFinite(Q[relation])) Q[relation] = Math.max(0, Math.min(100, Q[relation] + change));
        }

        // The opening loss still applies. Only a concluded primary adds this shock.
        var carrier = ["jxsi", "jxcat"].find(function (list) { return Q["erc_in_" + list]; }) || "erc";
        var ercShare = 1;
        if (carrier != "erc") {
            var remainder = Q["cup_in_" + carrier] ? 1 - (Number(Q[carrier + "_cup_formation_num"]) || 0) / 100 : 1;
            ercShare = Math.max(0, Math.min(1, remainder * (Number(Q[carrier + "_formation_num"]) || 50) / 100));
        }
        var destinations = [Q.parlament_current_icv, Q.parlament_current_ciu, "psc", "cup"].map(function (party) {
            var live = party && party != carrier && Q.parties.includes(party) && !Q[party + "_in_" + carrier] &&
                Q.parlament_constituencies.some(function (province) {
                    return Q.parlament_demographics.some(function (demographic) {
                        return Q[party + "_parlament_" + province + "_" + demographic + "_support"] > 0;
                    });
                });
            return live ? party : "abstain";
        });
        var disappointedTotal = disappointed.reduce(function (sum, n) { return sum + n; }, 0);
        var shares = {abstain: disappointedTotal > 0 ? 0.5 : 1};
        if (disappointedTotal > 0) for (var f = 0; f < disappointed.length; f++) {
            var to = destinations[f];
            shares[to] = (shares[to] || 0) + 0.5 * disappointed[f] / disappointedTotal;
        }
        for (var province of Q.parlament_constituencies) for (var demographic of Q.parlament_demographics) {
            var stock = Number(Q[carrier + "_parlament_" + province + "_" + demographic + "_support"]) || 0;
            var loss = stock * ercShare * (0.02 + 0.03 * closeResult);
            if (loss <= 0) continue;
            for (var [to, share] of Object.entries(shares)) if (share > 0) {
                G.cardSupportTransfer(Q, {contest:"parlament", from:carrier, to:to, amount:loss * share,
                    maxDonorFraction:0.5, constituencies:[province], demographics:[demographic]});
            }
        }

        // seat_leader recounts the board after the departures.
        var departures = [
            ["elisenda_paluzie", "erc_primary_paluzie_departed",
                ["oriol_junqueras", "pere_aragones"].includes(winner.id) && Q.erc_roadmap != 3],
            ["joan_laporta", "erc_primary_laporta_departed", winner.id != "carme_forcadell"],
            ["alfred_bosch", "erc_primary_bosch_departed",
                winner.id == "carme_forcadell" && Q.erc_roadmap == 3 && pragmaticDissent >= 49]
        ];
        for (var [advisor, notice, shouldLeave] of departures) {
            if (!shouldLeave || Q[advisor + "_departed"] ||
                !(Q[advisor + "_advisor"] || Q[advisor + "_advisor_available"])) continue;
            Q[advisor + "_advisor"] = 0;
            Q[advisor + "_advisor_available"] = 0;
            Q[advisor + "_departed"] = true;
            Q[notice] = true;
        }
        if (winner.id == "carme_forcadell" && Q.speaker == winner.name) {
            var occupied = [Q.president, Q.vicepresident, Q.economy_minister, Q.interior_minister,
                Q.health_minister, Q.education_minister, Q.bnl_minister, Q.foreign_minister, Q.territory_minister];
            var disqualified = (Q.consultation_verdict?.defendants || []).map(function (person) { return person.name; });
            var candidates = Q.year >= 2017 ? ["Roger Torrent", "Anna Simó"] : ["Anna Simó", "Roger Torrent"];
            Q.speaker = candidates.concat(["Lluís Corominas", "Alba Vergés", "Montserrat Fornells"]).find(function (name) {
                return !occupied.includes(name) && !disqualified.includes(name);
            });
            Q.speaker_gender = ["Anna Simó", "Alba Vergés", "Montserrat Fornells"].includes(Q.speaker) ? "f" : "m";
            G.setText(Q, "erc_primary_new_speaker", G.literalText(Q.speaker));
        }
    }
!}
call: junqueras_dethroned.seat_leader

[+ erc_primary_winner_name +] has won the party primary. 

[? if erc_primary_winner_name = "Oriol Junqueras" : It seems like, after all, Oriol Junqueras will keep its post. While some purges of dissenters may be expected, and some have already handed their resignations, the turth is most of the party has folded back into the old structures and ways of doing. ?]
[? if erc_primary_winner_name = "Marta Rovira" : While not a monumental change in party phiolosophy, Marta Rovira embodies a spirit of certain renewal, hinting a slight move to the left for the party, less willing to tolerate any deviations to the right just for National liberation.  ?]
[? if erc_primary_winner_name = "Pere Aragonès" : In a very continuist leadership change, Pere Aragonès' leadership makes ERC a party much more clearly focused on managing government and achieving success on that front than on the streets or in big clashes with the Spanish state.  ?]
[? if erc_primary_winner_name = "Raül Romeva" : In what feels like a enormous win for National Unity, Raül Romeva is clear in his ambitions towards a more united pro-independence front across factions and party lines. ?]
[? if erc_primary_winner_name = "Carme Forcadell" : In what feels like a enormous win for National Unity, the former ANC president is setting a clear independence horizon, pushing ERC ever closer to open confrontation with the Spanish government. [? if erc_primary_new_speaker: For now, she has stepped down as Speaker of the House, with [+ erc_primary_new_speaker +] taking over. ?] ?]

[? if erc_primary_paluzie_departed: Given the elected leadership's "lack of commitment" towards independence, Elisenda Paluzie has anounced her resignation from the party. We can expect her to return to independence grassroots organizing in force. ?]

[? if erc_primary_laporta_departed: After leaving SI and coming to ERC, this leadership contest seems to have been the last straw for Joan Laporta. Who knows what's his future from now onwards. Maybe back to sports? ?]

[? if erc_primary_bosch_departed: Given ERC's "radicalization", Alfred Bosch has announce his resignation. After this many years in the party, maybe it is time for retirement after all... ?]



# [? if erc_primary_displaced_advisor: [+ erc_primary_displaced_advisor +] leaves??]

- @post_event: A new [? if erc_primary_winner_name = "Oriol Junqueras" : old ?] ERC...

@seat_leader
on-arrival: {!
    // Restore/seat the leader once; displace the least senior available name
    // only if needed, following the original scene's advisory-board fallback.
    var roster = [
        ["sergi_sabria","core","Sergi Sabrià"], ["carles_mundo","civic","Carles Mundó"],
        ["joan_laporta","civic","Joan Laporta"], ["joan_josep_nuet","left","Joan Josep Nuet"],
        ["elisenda_paluzie","civic","Elisenda Paluzie"], ["alfred_bosch","pragmatic","Alfred Bosch"],
        ["ernest_maragall","pragmatic","Ernest Maragall"], ["teresa_jorda","left","Teresa Jordà"],
        ["dolors_bassa","left","Dolors Bassa"], ["roger_torrent","pragmatic","Roger Torrent"],
        ["gabriel_rufian","core","Gabriel Rufián"], ["raul_romeva","core","Raül Romeva"],
        ["carme_forcadell","civic","Carme Forcadell"], ["pere_aragones","pragmatic","Pere Aragonès"],
        ["joan_tarda","core","Joan Tardà"], ["marta_rovira","left","Marta Rovira"],
        ["oriol_junqueras","core","Oriol Junqueras"]
    ];
    var winner = roster.find(function (a) { return a[0] == Q.erc_primary_seat; });
    if (!winner) return;
    Q.n_advisors = roster.filter(function (a) { return !!Q[a[0] + "_advisor"]; }).length;
    if (Q[winner[0] + "_advisor"]) return;
    if (Q.n_advisors >= (Number(Q.max_advisors) || 3)) {
        var displaced = roster.find(function (a) { return a[0] != winner[0] && Q[a[0] + "_advisor"]; });
        Q[displaced[0] + "_advisor"] = 0;
        Q.n_advisors--;
        Q["erc_" + displaced[1] + "_dissent"] += 7;
        G.setText(Q, "erc_primary_displaced_advisor", G.literalText(displaced[2]));
    }
    Q[winner[0] + "_advisor"] = 1;
    Q.n_advisors++;
    var dissent = "erc_" + winner[1] + "_dissent";
    Q[dissent] = Math.max(0, Q[dissent] - 4);
!}


