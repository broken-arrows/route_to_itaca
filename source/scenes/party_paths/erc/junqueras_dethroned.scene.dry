@cast_ballot
title: The militancy votes...
on-arrival: {!
    var record = Q.erc_primary;
    var isRunoff = Q.erc_primary_campaign_runoff;
    var round = isRunoff ? "runoff" : "first";
    var cast = isRunoff ? "runoffCast" : "firstCast";
    if (!record || !record.started || record.resolved || record[cast]) return;
    var ballot = record[round];
    if (!ballot.length) return;
    var candidates = record.candidates;
    var endorsed = ballot.find(function (row) { return row.id == Q.erc_primary_endorsement; });
    if (endorsed && Q.party_resources >= 1) {
        Q.party_resources -= 1;
        // Transfer a small share within each faction, preserving its total vote.
        for (var row of ballot) {
            if (row == endorsed) continue;
            for (var f = 0; f < row.factions.length; f++) {
                var gain = row.factions[f] * 0.08;
                row.factions[f] -= gain;
                endorsed.factions[f] += gain;
            }
        }
    }
    record[cast] = true;
    Q.erc_primary_endorsement = "";
    function rank(ballot) {
        for (var row of ballot) row.share = row.factions.reduce(function (sum, n) { return sum + n; }, 0);
        // Stable nomination order settles exact ties, with the incumbent first.
        return ballot.sort(function (a, b) { return b.share - a.share || candidates.findIndex(function (c) { return c.id == a.id; }) - candidates.findIndex(function (c) { return c.id == b.id; }); });
    }

    // Largest remainders give visible percentages summing to exactly 100.00.
    function bars(ballot, round) {
        var units = ballot.map(function (row, i) { var value = row.share * 100; return {i:i, value:Math.floor(value), remainder:value - Math.floor(value)}; });
        var left = 10000 - units.reduce(function (sum, row) { return sum + row.value; }, 0);
        var sorted = units.slice().sort(function (a, b) { return b.remainder - a.remainder || a.i - b.i; });
        for (var i = 0; i < left; i++) sorted[i % sorted.length].value++;
        return {rows:ballot.map(function (row, i) {
            var c = candidates.find(function (candidate) { return candidate.id == row.id; });
            var key = "erc_primary_" + round + "_" + row.id;
            Q[key] = units[i].value / 100;
            return {label:c.name, shareFrom:key, colour:c.colour};
        })};
    }

    rank(ballot);
    if (!isRunoff) {
        Q.erc_primary_first_round = bars(ballot, "first");
        var factions = record.factions;
        var trustEffect = record.trustEffect, electoralEffect = record.electoralEffect;
        var roadmap = record.roadmap ?? Q.erc_roadmap;
        record.needsRunoff = record.first[0].share <= 50 + 1e-9 && candidates.length > 1;
        if (record.needsRunoff) {
            record.runoff = record.first.slice(0, 2).map(function (row) { return {id:row.id, share:0, factions:row.factions.slice()}; });
            var order = ["oriol_junqueras", "marta_rovira", "pere_aragones", "raul_romeva", "carme_forcadell"];
            // Second preferences, not a unified anti-incumbent bloc.
            var transfers = [[0,6,4,4,2], [4,0,5,7,4], [6,7,0,4,1], [3,7,4,0,7], [4,6,1,8,0]];
            var fit = [[1,1.4,1.1,1], [1.5,1.1,1.1,0.8], [0.8,0.8,1.6,0.35], [1.1,1,1,1.2], [0.9,0.6,0.3,1.7]];
            for (var row of record.first.slice(2)) for (var f = 0; f < factions.length; f++) {
                var preferences = record.runoff.map(function (finalist) {
                    var target = order.indexOf(finalist.id);
                    var value = transfers[order.indexOf(row.id)][target] * fit[target][f];
                    if (target == 0) value *= Math.max(0.35, Math.min(1.6, 1 + (trustEffect + electoralEffect) / 45));
                    if (target == 2 && f == 3 && roadmap >= 2) value *= 0.5;
                    return value;
                });
                var sum = preferences[0] + preferences[1];
                for (var i = 0; i < 2; i++) record.runoff[i].factions[f] += row.factions[f] * preferences[i] / sum;
            }
            rank(record.runoff);
        }
        Q.erc_primary_needs_runoff = record.needsRunoff;
        if (record.needsRunoff) {
            // Keep the runoff baseline in the save, but publish it only after campaigning.
            record.winner = null;
            record.winningShare = null;
            return;
        }
    } else {
        Q.erc_primary_second_round = bars(ballot, "second");
    }
    record.winner = ballot[0].id;
    record.winningShare = ballot[0].share;
!}
go-to: first_ballot if not erc_primary_campaign_runoff and not erc_primary_second_round; runoff_ballot if erc_primary_campaign_runoff or erc_primary_second_round

@first_ballot
go-to: runoff if erc_primary_needs_runoff; result if not erc_primary_needs_runoff

{!<div data-widget="result-bars" data-props='{"configFrom":"erc_primary_first_round"}'></div>!}

@runoff
on-arrival: {!
    Q.erc_primary_campaign_runoff = true;
    Q.erc_primary_endorsement = "";
    if (!Q.erc_primary.runoffCast) Q.erc_primary_second_round = null;
!}

With such a result, it is still not enough to close up the race, and a second round will be held. 

