title: Ciudadanos goes nationwide
view-if: year = 2015 and month = 2
tags: event
new-page: true
max-visits: 1
on-arrival: {!
    // Cs runs state-wide for the first time, drawing anti-corruption PP voters + abstainers.
    Q.spa_cs_active = true;
    G.spaSupportInject(Q, 'cs', 'all', 9.0, 'pp');
    G.spaSupportInject(Q, 'cs', 'all', 2.0, 'abstain');

    Q.cs_leader = "Inés Arrimadas";
    Q.cs_leader_gender = "f";
    Q.csspa_leader = "Albert Rivera";
    Q.csspa_leader_gender = "m";
!}
role: event

