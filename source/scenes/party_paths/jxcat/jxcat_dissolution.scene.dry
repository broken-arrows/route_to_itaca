title: The end of the JxCat unity list
view-if: jxcat_formed and not jxcat_dissolved and erc_in_jxcat and jxcat_dissolution_trigger
tags: event
new-page: true
face-image: img/jxsi/unity.jpg
max-visits: 1
role: event
on-arrival: {!
    if (Q.jxcat_formed && !Q.jxcat_dissolved)
        Q.jxcat_dissolution_had_cup = !!Q.cup_in_jxcat;
    {
        const CDC = ["ciu", "cdc", "dl", "pdcat", "junts"];
        const OFFICES = [
            "president",
            "vicepresident",
            "speaker",
            "economy_minister",
            "interior_minister",
            "health_minister",
            "education_minister",
            "territory_minister",
            "foreign_minister",
            "bnl_minister",
        ];
        const num = (value) => (Number.isFinite(Number(value)) ? Number(value) : 0);
        const clamp = (value, low, high) => Math.max(low, Math.min(high, value));
        const CONGRESO = [
            "_congreso_catalunya_support",
            "_congreso_pv_cat",
            "_congreso_pv",
            "_congreso_s",
            "_congreso_s_catalunya",
        ];
        const LOCAL = [
            "_local_barcelona_support",
            "_local_barcelona_pv",
            "_local_barcelona_s",
            "_local_rb_holdings",
            "_local_rb_pct",
            "_local_interior_holdings",
            "_local_interior_pct",
            "_local_redbelt",
            "_local_interior",
        ];
        function listShares(Q, list, province, demographic, arena) {
            const core = list === "jxcat" ? "jxcat" : Q.parlament_current_ciu;
            const cup = Q["cup_in_" + list]
                ? clamp(num(Q[list + "_cup_formation_num"]), 10, 100) / 100 : 0;
            const erc = clamp(num(Q[list + "_formation_num"] || 50) / 100, 0, 1) * (1 - cup);
            const base = { [core]: 1 - cup - erc, erc, ...(cup ? { cup } : {}) };
            // Congreso and the allocation of already elected representatives use
            // the agreement directly. Only live support receives current tilts.
            if (!arena || arena === "congreso")
                return base;
            // Level-based breakup weights, not the monthly delta coefficients.
            // At movement/trust 50, welfare 60 and dissent 40, retain the baseline.
            const level = (key, neutral, scale) => clamp(((Number.isFinite(Number(Q[key])) ? Number(Q[key]) : neutral) - neutral) / scale, -1, 1);
            const movement = level("independence_movement", 50, 50);
            const trust = level("independence_trust", 50, 50);
            const welfare = level("welfare_index", 60, 40);
            const dissent = level("social_dissent", 40, 40);
            const frustration = clamp(movement - trust, 0, 1);
            // Sensitivities: movement, welfare, social dissent, frustrated expectations.
            const demographics = {
                buss: [0.65, 0.6, 0.4, 0.5], ind: [0.8, 0.8, 1.6, 0.8],
                middle: [1, 1, 1, 1], young: [1.1, 1.4, 1.8, 1.6],
                retired: [0.6, 1.8, 0.4, 0.4], rural: [1.5, 0.7, 0.8, 0.6],
                unemployed: [1, 1.4, 2, 0.9],
            };
            const provinces = {
                barcelona: [1, 1, 1, 1], girona: [1.4, 0.9, 1.1, 1.2],
                lleida: [1.1, 0.9, 0.8, 0.8], tarragona: [0.8, 1.1, 1, 0.9],
            };
            const local = {
                barcelona: [1, 1.2, 1.3, 1.2], redbelt: [0.85, 1.4, 1.6, 1.1],
                interior: [1.35, 0.75, 0.8, 1],
            };
            const demo = demographics[demographic] || [1, 1, 1, 1];
            const prov = provinces[province] || [1, 1, 1, 1];
            const scale = arena === "parlament" ? demo.map((v, i) => v * prov[i]) : local[arena];
            const m = movement * scale[0], w = welfare * scale[1];
            const d = dissent * scale[2], f = frustration * scale[3];
            // These only divide the existing common-list electorate; they do not
            // award a second movement/economic gain to the bloc as a whole.
            const tilts = {
                [core]: -0.12 * m + 0.18 * trust + 0.22 * w - 0.16 * d - 0.12 * f,
                erc: 0.20 * m + 0.18 * trust - 0.08 * w + 0.05 * d - 0.04 * f,
                cup: 0.15 * m - 0.18 * trust - 0.28 * w + 0.25 * d + 0.35 * f,
            };
            const weights = Object.fromEntries(Object.entries(base).map(([party, share]) => [party, share * Math.exp(clamp(tilts[party], -0.7, 0.7))]));
            const total = Object.values(weights).reduce((sum, value) => sum + value, 0);
            return Object.fromEntries(Object.entries(weights).map(([party, weight]) => [party, weight / total]));
        }
        function distribute(Q, source, suffix, shares, integer) {
            const total = num(Q[source + suffix]);
            const parties = Object.keys(shares);
            const values = parties.map((p) => total * shares[p]);
            if (integer) {
                const order = parties
                    .map((p, i) => i)
                    .sort((a, b) => values[b] -
                    Math.floor(values[b]) -
                    (values[a] - Math.floor(values[a])));
                const rounded = values.map(Math.floor);
                const remainder = Math.round(total) - rounded.reduce((a, b) => a + b, 0);
                for (let i = 0; i < remainder; i++)
                    rounded[order[i % order.length]]++;
                values.splice(0, values.length, ...rounded);
            }
            Q[source + suffix] = 0;
            parties.forEach((p, i) => {
                Q[p + suffix] = num(Q[p + suffix]) + values[i];
            });
        }
        if (Q.jxcat_formed && !Q.jxcat_dissolved) {
            const baseline = listShares(Q, "jxcat");
            const members = Object.keys(baseline);
            // Preserve historical vote results and representatives. Their party
            // affiliations change, but current polling does not elect a new chamber.
            distribute(Q, "jxcat", "_parlament_s", baseline, true);
            distribute(Q, "jxcat", "_parlament_pv", baseline, false);
            for (const province of Q.parlament_constituencies || []) {
                for (const demographic of Q.parlament_demographics || []) {
                    const suffix = "_parlament_" + province + "_" + demographic + "_support";
                    const current = listShares(Q, "jxcat", province, demographic, "parlament");
                    const loss = num(Q["jxcat" + suffix]) * 0.05;
                    Q["jxcat" + suffix] = num(Q["jxcat" + suffix]) - loss;
                    Q["abstain" + suffix] = num(Q["abstain" + suffix]) + loss;
                    distribute(Q, "jxcat", suffix, current, false);
                }
            }
            if (Q.jxcat_in_congreso) {
                for (const suffix of CONGRESO)
                    distribute(Q, "jxcat", suffix, baseline, suffix.includes("_s") && !suffix.endsWith("_support"));
            }
            if (Q.jxcat_in_local) {
                for (const suffix of LOCAL) {
                    const arena = suffix === "_local_barcelona_support" ? "barcelona"
                        : suffix === "_local_redbelt" ? "redbelt"
                            : suffix === "_local_interior" ? "interior" : "";
                    const current = arena ? listShares(Q, "jxcat", null, null, arena) : baseline;
                    distribute(Q, "jxcat", suffix, current, suffix === "_local_barcelona_s");
                }
            }
            for (const p of [...CDC, "erc", "cup"])
                Q[p + "_in_jxcat"] = false;
            Q.player_in_jxcat = false;
            Q.jxcat_in_congreso = false;
            Q.jxcat_in_local = false;
            Q.jxcat_dissolved = true;
            Q.jxcat_dissolution_trigger = false;
            Q.independence_trust = num(Q.independence_trust) - 1.5;
            const core = "jxcat";
            // The common ballot becomes the standalone CDC successor. Restore
            // its own leader before resolving the officeholders' affiliations.
            const cdc = Q.parlament_current_ciu;
            for (const field of ["leader", "leader_gender", "relations", "dissent", "roadmap", "ideology"])
                Q["jxcat_" + field] = Q[cdc + "_" + field];
            Q.jxcat_leader_party = cdc;
            Q.parlament_current_ciu = "jxcat";
            const oldLeader = Q.jxcat_formation_num > 50 ? "erc" : core;
            const replacements = { jxcat: members };
            const defaultParty = oldLeader;
            const expand = (p) => replacements[p] || [p];
            for (const role of [
                "cat_coalition",
                "cat_coalition_support",
                "cat_coalition_abstain",
            ]) {
                Q[role] = [...new Set((Q[role] || []).flatMap(expand))];
            }
            Q.cat_coalition_support = Q.cat_coalition_support.filter((p) => !Q.cat_coalition.includes(p));
            Q.cat_coalition_abstain = Q.cat_coalition_abstain.filter((p) => !Q.cat_coalition.includes(p) && !Q.cat_coalition_support.includes(p));
            for (const office of OFFICES) {
                const members = replacements[Q[office + "_party"]];
                if (!members)
                    continue;
                Q[office + "_party"] =
                    members.find((p) => Q[p + "_leader"] === Q[office]) ||
                        (members.includes(defaultParty) ? defaultParty : members[0]);
            }
            for (const p of [...CDC, "erc", "cup", "jxsi", "jxcat"]) {
                const list = Q[p + "_in_jxcat"]
                    ? "jxcat"
                    : Q[p + "_in_jxsi"]
                        ? "jxsi"
                        : p;
                Q[p + "_in_gob"] =
                    Q.cat_coalition.includes(p) || Q.cat_coalition.includes(list);
                Q[p + "_supporting"] =
                    Q[p + "_in_gob"] ||
                        Q.cat_coalition_support.includes(p) ||
                        Q.cat_coalition_support.includes(list);
            }
            Q.position_disp = Q[Q.player_party + "_in_gob"]
                ? "Generalitat"
                : Q[Q.player_party + "_supporting"]
                    ? "<span style='font-style: italic'>Government Support</span>"
                    : "<span style='font-style: italic'>Opposition</span>";
            if (Q.cat_coalition.length) {
                const seats = Q.cat_coalition.reduce((sum, p) => sum + num(Q[p + "_parlament_s"]), 0);
                const majority = num(Q.parlament_s_majority) || 68;
                const names = {
                    jxsi: "JxSí",
                    jxcat: "JxCat",
                    pdcat: "PDeCAT",
                    junts: "Junts",
                };
                const label = Q.cat_coalition
                    .map((p) => names[p] || p.toUpperCase())
                    .join(" + ");
                Q.cat_coalition_disp =
                    '<span class="generalitat-coalition" data-parties="' +
                        Q.cat_coalition.join(" ") +
                        '" data-summary="' +
                        (seats >= majority ? "Majority" : "Minority") +
                        " government - " +
                        seats +
                        "/" +
                        majority +
                        '">' +
                        label +
                        "</span>";
            }
        }
    }
    this.state.currentHands['main'] = [];
    this.state.currentHands['main.main_easy'] = [];
    this.state.currentHands['main.main_hard'] = [];
!}

= The end of the jxcat

The disagreements within jxcat have ended the common list. ERC[? if jxcat_dissolution_had_cup: and CUP?] will run independently, while [+ jxcat_leader +] has insisted on keeping the coalition alive, even if it means only [+ parlament_current_ciu +] will be there, followed only by minor parties and organization.

# TODO: face-image

- @post_event: It's time for everybody to follow their own path
