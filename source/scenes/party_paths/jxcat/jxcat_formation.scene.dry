subtitle: Formally an even split between ERC and [+ parlament_current_ciu +] \[-1 resources\]
view-if: player_party == "erc" and (not jxcat_president_kind or president != jxcat_neutral_candidate)
choose-if: jxcat_neutral_available
unavailable-subtitle: [? if jxcat_cdc_relations < 55: We don't have good enough relations with [+ parlament_current_ciu +]. ?][? if erc_civic_strength < 15: Our party's ties with civil society are not strong enough for this to work out. ?][? if party_resources < 1: Not enough resources. ?]
on-arrival: {!
    Q.jxcat_select_president = false;
    Q.jxcat_selected_leader = 'neutral';
!}
go-to: participation

