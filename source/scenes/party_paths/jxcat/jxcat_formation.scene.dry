@formed
title: A new unity list
on-arrival: {!
    {
        Q.unity_disunity_timer = 6;
        const CDC = ["ciu", "cdc", "dl", "pdcat", "junts"];
        const OFFICES = [
            "president",
            "vicepresident",
            "speaker",
            "economy_minister",
            "interior_minister",
            "health_minister",
            "education_minister",
            "territory_minister",
            "foreign_minister",
            "bnl_minister",
        ];
        const num = (value) => (Number.isFinite(Number(value)) ? Number(value) : 0);
        const clamp = (value, low, high) => Math.max(low, Math.min(high, value));
        const CONGRESO = [
            "_congreso_catalunya_support",
            "_congreso_pv_cat",
            "_congreso_pv",
            "_congreso_s",
            "_congreso_s_catalunya",
        ];
        const LOCAL = [
            "_local_barcelona_support",
            "_local_barcelona_pv",
            "_local_barcelona_s",
            "_local_rb_holdings",
            "_local_rb_pct",
            "_local_interior_holdings",
            "_local_interior_pct",
            "_local_redbelt",
            "_local_interior",
        ];
        function listShares(Q, list, province, demographic, arena) {
            const core = list === "jxcat" ? "jxcat" : Q.parlament_current_ciu;
            const cup = Q["cup_in_" + list]
                ? clamp(num(Q[list + "_cup_formation_num"]), 10, 100) / 100 : 0;
            const erc = clamp(num(Q[list + "_formation_num"] || 50) / 100, 0, 1) * (1 - cup);
            const base = { [core]: 1 - cup - erc, erc, ...(cup ? { cup } : {}) };
            // Congreso and the allocation of already elected representatives use
            // the agreement directly. Only live support receives current tilts.
            if (!arena || arena === "congreso")
                return base;
            // Level-based breakup weights, not the monthly delta coefficients.
            // At movement/trust 50, welfare 60 and dissent 40, retain the baseline.
            const level = (key, neutral, scale) => clamp(((Number.isFinite(Number(Q[key])) ? Number(Q[key]) : neutral) - neutral) / scale, -1, 1);
            const movement = level("independence_movement", 50, 50);
            const trust = level("independence_trust", 50, 50);
            const welfare = level("welfare_index", 60, 40);
            const dissent = level("social_dissent", 40, 40);
            const frustration = clamp(movement - trust, 0, 1);
            // Sensitivities: movement, welfare, social dissent, frustrated expectations.
            const demographics = {
                buss: [0.65, 0.6, 0.4, 0.5], ind: [0.8, 0.8, 1.6, 0.8],
                middle: [1, 1, 1, 1], young: [1.1, 1.4, 1.8, 1.6],
                retired: [0.6, 1.8, 0.4, 0.4], rural: [1.5, 0.7, 0.8, 0.6],
                unemployed: [1, 1.4, 2, 0.9],
            };
            const provinces = {
                barcelona: [1, 1, 1, 1], girona: [1.4, 0.9, 1.1, 1.2],
                lleida: [1.1, 0.9, 0.8, 0.8], tarragona: [0.8, 1.1, 1, 0.9],
            };
            const local = {
                barcelona: [1, 1.2, 1.3, 1.2], redbelt: [0.85, 1.4, 1.6, 1.1],
                interior: [1.35, 0.75, 0.8, 1],
            };
            const demo = demographics[demographic] || [1, 1, 1, 1];
            const prov = provinces[province] || [1, 1, 1, 1];
            const scale = arena === "parlament" ? demo.map((v, i) => v * prov[i]) : local[arena];
            const m = movement * scale[0], w = welfare * scale[1];
            const d = dissent * scale[2], f = frustration * scale[3];
            // These only divide the existing common-list electorate; they do not
            // award a second movement/economic gain to the bloc as a whole.
            const tilts = {
                [core]: -0.12 * m + 0.18 * trust + 0.22 * w - 0.16 * d - 0.12 * f,
                erc: 0.20 * m + 0.18 * trust - 0.08 * w + 0.05 * d - 0.04 * f,
                cup: 0.15 * m - 0.18 * trust - 0.28 * w + 0.25 * d + 0.35 * f,
            };
            const weights = Object.fromEntries(Object.entries(base).map(([party, share]) => [party, share * Math.exp(clamp(tilts[party], -0.7, 0.7))]));
            const total = Object.values(weights).reduce((sum, value) => sum + value, 0);
            return Object.fromEntries(Object.entries(weights).map(([party, weight]) => [party, weight / total]));
        }
        function distribute(Q, source, suffix, shares, integer) {
            const total = num(Q[source + suffix]);
            const parties = Object.keys(shares);
            const values = parties.map((p) => total * shares[p]);
            if (integer) {
                const order = parties
                    .map((p, i) => i)
                    .sort((a, b) => values[b] -
                    Math.floor(values[b]) -
                    (values[a] - Math.floor(values[a])));
                const rounded = values.map(Math.floor);
                const remainder = Math.round(total) - rounded.reduce((a, b) => a + b, 0);
                for (let i = 0; i < remainder; i++)
                    rounded[order[i % order.length]]++;
                values.splice(0, values.length, ...rounded);
            }
            Q[source + suffix] = 0;
            parties.forEach((p, i) => {
                Q[p + suffix] = num(Q[p + suffix]) + values[i];
            });
        }
        function move(Q, from, to, suffix) {
            if (from === to)
                return;
            Q[to + suffix] = num(Q[to + suffix]) + num(Q[from + suffix]);
            Q[from + suffix] = 0;
        }
        function mapGovernment(Q, replacements, defaultParty) {
            const expand = (p) => replacements[p] || [p];
            for (const role of [
                "cat_coalition",
                "cat_coalition_support",
                "cat_coalition_abstain",
            ]) {
                Q[role] = [...new Set((Q[role] || []).flatMap(expand))];
            }
            Q.cat_coalition_support = Q.cat_coalition_support.filter((p) => !Q.cat_coalition.includes(p));
            Q.cat_coalition_abstain = Q.cat_coalition_abstain.filter((p) => !Q.cat_coalition.includes(p) && !Q.cat_coalition_support.includes(p));
            for (const office of OFFICES) {
                const members = replacements[Q[office + "_party"]];
                if (!members)
                    continue;
                Q[office + "_party"] =
                    members.find((p) => Q[p + "_leader"] === Q[office]) ||
                        (members.includes(defaultParty) ? defaultParty : members[0]);
            }
            for (const p of [...CDC, "erc", "cup", "jxsi", "jxcat"]) {
                const list = Q[p + "_in_jxcat"]
                    ? "jxcat"
                    : Q[p + "_in_jxsi"]
                        ? "jxsi"
                        : p;
                Q[p + "_in_gob"] =
                    Q.cat_coalition.includes(p) || Q.cat_coalition.includes(list);
                Q[p + "_supporting"] =
                    Q[p + "_in_gob"] ||
                        Q.cat_coalition_support.includes(p) ||
                        Q.cat_coalition_support.includes(list);
            }
            Q.position_disp = Q[Q.player_party + "_in_gob"]
                ? "Generalitat"
                : Q[Q.player_party + "_supporting"]
                    ? "<span style='font-style: italic'>Government Support</span>"
                    : "<span style='font-style: italic'>Opposition</span>";
            if (Q.cat_coalition.length) {
                const seats = Q.cat_coalition.reduce((sum, p) => sum + num(Q[p + "_parlament_s"]), 0);
                const majority = num(Q.parlament_s_majority) || 68;
                const names = {
                    jxsi: "JxSí",
                    jxcat: "JxCat",
                    pdcat: "PDeCAT",
                    junts: "Junts",
                };
                const label = Q.cat_coalition
                    .map((p) => names[p] || p.toUpperCase())
                    .join(" + ");
                Q.cat_coalition_disp =
                    '<span class="generalitat-coalition" data-parties="' +
                        Q.cat_coalition.join(" ") +
                        '" data-summary="' +
                        (seats >= majority ? "Majority" : "Minority") +
                        " government - " +
                        seats +
                        "/" +
                        majority +
                        '">' +
                        label +
                        "</span>";
            }
        }
        if (!Q.jxcat_formed) {
            const includeCup = Q.jxcat_include_cup;
            const leader = Q.jxcat_selected_leader;
            if (!(Q.jxcat_select_president ? Q.jxcat_president_available : Q["jxcat_" + leader + "_available"]))
                throw new Error("Unavailable JxCat leadership");
            const cost = num(Q.jxcat_leadership_cost) + (includeCup && Q.player_party === "erc" ? 1 : 0);
            if (num(Q.party_resources) < cost)
                throw new Error("Insufficient negotiation resources");
            if (includeCup && !Q.jxcat_cup_join_available)
                throw new Error("CUP cannot join JxCat");
            Q.party_resources -= cost;
            const cdc = Q.parlament_current_ciu;
            const local = !!Q.jxsi_in_local;
            const congreso = !!Q.jxsi_in_congreso;
            if (Q.jxsi_formed && !Q.jxsi_dissolved) {
                const baseline = listShares(Q, "jxsi");
                const members = Object.keys(baseline);
                // Preserve historical vote results and representatives. Their party
                // affiliations change, but current polling does not elect a new chamber.
                distribute(Q, "jxsi", "_parlament_s", baseline, true);
                distribute(Q, "jxsi", "_parlament_pv", baseline, false);
                for (const province of Q.parlament_constituencies || []) {
                    for (const demographic of Q.parlament_demographics || []) {
                        const suffix = "_parlament_" + province + "_" + demographic + "_support";
                        const current = listShares(Q, "jxsi", province, demographic, "parlament");
                        distribute(Q, "jxsi", suffix, current, false);
                    }
                }
                if (Q.jxsi_in_congreso) {
                    for (const suffix of CONGRESO)
                        distribute(Q, "jxsi", suffix, baseline, suffix.includes("_s") && !suffix.endsWith("_support"));
                }
                if (Q.jxsi_in_local) {
                    for (const suffix of LOCAL) {
                        const arena = suffix === "_local_barcelona_support" ? "barcelona"
                            : suffix === "_local_redbelt" ? "redbelt"
                                : suffix === "_local_interior" ? "interior" : "";
                        const current = arena ? listShares(Q, "jxsi", null, null, arena) : baseline;
                        distribute(Q, "jxsi", suffix, current, suffix === "_local_barcelona_s");
                    }
                }
                for (const p of [...CDC, "erc", "cup"])
                    Q[p + "_in_jxsi"] = false;
                Q.player_in_jxsi = false;
                Q.jxsi_in_congreso = false;
                Q.jxsi_in_local = false;
                Q.jxsi_dissolved = true;
                Q.jxsi_dissolution_trigger = false;
                const core = Q.parlament_current_ciu;
                const oldLeader = Q.jxsi_formation_num > 50 ? "erc" : core;
                mapGovernment(Q, { jxsi: members }, oldLeader);
            }
            const suffixes = ["_parlament_s", "_parlament_pv"];
            for (const c of Q.parlament_constituencies || []) {
                for (const d of Q.parlament_demographics || [])
                    suffixes.push(`_parlament_${c}_${d}_support`);
            }
            const members = [cdc, "erc", ...(includeCup ? ["cup"] : [])];
            for (const p of members) {
                for (const suffix of suffixes)
                    move(Q, p, "jxcat", suffix);
            }
            // Existing joint agreements continue; previously separate contests stay separate.
            const localMembers = local ? members : [cdc];
            const congresoMembers = congreso ? members : [cdc];
            for (const p of localMembers)
                for (const suffix of LOCAL)
                    move(Q, p, "jxcat", suffix);
            for (const p of congresoMembers)
                for (const suffix of CONGRESO)
                    move(Q, p, "jxcat", suffix);
            for (const field of [
                "leader",
                "leader_gender",
                "relations",
                "dissent",
                "roadmap",
                "ideology",
            ]) {
                Q["jxcat_" + field] = Q[cdc + "_" + field];
            }
            Q.jxcat_leader = Q.jxcat_proposed_leader;
            Q.jxcat_leader_gender = Q.jxcat_proposed_leader_gender;
            Q.jxcat_leader_party = leader === "cdc" ? cdc : leader;
            Q.jxcat_roadmap =
                leader === "neutral"
                    ? num(Q.jxsi_roadmap || Q.erc_roadmap)
                    : Q[(leader === "cdc" ? cdc : leader) + "_roadmap"];
            Q.jxcat_ideology = "National coalition, Independence";
            Q.jxcat_formed = true;
            Q.jxcat_dissolved = false;
            Q.jxcat_formation_trigger = false;
            Q.erc_in_jxcat = true;
            Q.cup_in_jxcat = !!includeCup;
            Q[cdc + "_in_jxcat"] = true;
            Q.player_in_jxcat = Q.player_party === "erc" || includeCup;
            Q.jxcat_in_local = local;
            Q.jxcat_in_congreso = congreso;
            mapGovernment(Q, Object.fromEntries(members.map((p) => [p, ["jxcat"]])), "jxcat");
            Q.historical_event =
                "JxCat unites " +
                    (includeCup ? "CDC, ERC and CUP" : "CDC and ERC") +
                    " behind " +
                    Q.jxcat_leader +
                    ".";
        }
    }
    this.state.currentHands['main'] = [];
    this.state.currentHands['main.main_easy'] = [];
    this.state.currentHands['main.main_hard'] = [];
!}

jxcat will contest the next Parlament election under [+ jxcat_leader +], bringing together [+ parlament_current_ciu +] and ERC[? if cup_in_jxcat: , with CUP also inside the list?].

- @post_event: Surely for the better!

@refuse
title: [? if player_party == "erc": Refuse the common list?][? if player_party == "cup": No unity agreement can be reached... ?]
subtitle: [+ parlament_current_ciu +] will push their coalition ideas alone[? if jxsi_formed and not jxsi_dissolved: , while jxsi will be dissolved?].
view-if: jxcat_failure_available
choose-if: jxcat_failure_available
on-arrival: {!
    Q.jxcat_failed_renewal = true;
    if (Q.jxsi_formed && !Q.jxsi_dissolved)
        Q.jxsi_dissolution_trigger = true;
!}
go-to: jxsi_dissolution.dissolve if jxsi_formed and not jxsi_dissolved; alone if not jxsi_formed or jxsi_dissolved

@alone
title: JxCat without a unity agreement
on-arrival: {!
    {
        const CDC = ["ciu", "cdc", "dl", "pdcat", "junts"];
        const OFFICES = [
            "president",
            "vicepresident",
            "speaker",
            "economy_minister",
            "interior_minister",
            "health_minister",
            "education_minister",
            "territory_minister",
            "foreign_minister",
            "bnl_minister",
        ];
        const num = (value) => (Number.isFinite(Number(value)) ? Number(value) : 0);
        const CONGRESO = [
            "_congreso_catalunya_support",
            "_congreso_pv_cat",
            "_congreso_pv",
            "_congreso_s",
            "_congreso_s_catalunya",
        ];
        const LOCAL = [
            "_local_barcelona_support",
            "_local_barcelona_pv",
            "_local_barcelona_s",
            "_local_rb_holdings",
            "_local_rb_pct",
            "_local_interior_holdings",
            "_local_interior_pct",
            "_local_redbelt",
            "_local_interior",
        ];
        if (!Q.jxcat_formed) {
            if (Q.jxsi_formed && !Q.jxsi_dissolved)
                throw new Error("Dissolve JxSi before forming standalone JxCat");
            const cdc = Q.parlament_current_ciu;
            const suffixes = ["_parlament_s", "_parlament_pv"];
            for (const c of Q.parlament_constituencies || []) {
                for (const d of Q.parlament_demographics || [])
                    suffixes.push(`_parlament_${c}_${d}_support`);
            }
            for (const suffix of [...suffixes, ...CONGRESO, ...LOCAL]) {
                Q["jxcat" + suffix] = num(Q["jxcat" + suffix]) + num(Q[cdc + suffix]);
                Q[cdc + suffix] = 0;
            }
            for (const field of [
                "leader",
                "leader_gender",
                "relations",
                "dissent",
                "roadmap",
                "ideology",
            ]) {
                Q["jxcat_" + field] = Q[cdc + "_" + field];
            }
            Q.jxcat_leader_party = cdc;
            Q.jxcat_formed = true;
            Q.jxcat_dissolved = false;
            Q.jxcat_formation_trigger = false;
            Q.erc_in_jxcat = false;
            Q.cup_in_jxcat = false;
            Q.player_in_jxcat = false;
            Q[cdc + "_in_jxcat"] = true;
            Q.jxcat_in_congreso = false;
            Q.jxcat_in_local = false;
            Q.parlament_current_ciu = "jxcat";
            const replacements = { [cdc]: ["jxcat"] };
            const defaultParty = "jxcat";
            const expand = (p) => replacements[p] || [p];
            for (const role of [
                "cat_coalition",
                "cat_coalition_support",
                "cat_coalition_abstain",
            ]) {
                Q[role] = [...new Set((Q[role] || []).flatMap(expand))];
            }
            Q.cat_coalition_support = Q.cat_coalition_support.filter((p) => !Q.cat_coalition.includes(p));
            Q.cat_coalition_abstain = Q.cat_coalition_abstain.filter((p) => !Q.cat_coalition.includes(p) && !Q.cat_coalition_support.includes(p));
            for (const office of OFFICES) {
                const members = replacements[Q[office + "_party"]];
                if (!members)
                    continue;
                Q[office + "_party"] =
                    members.find((p) => Q[p + "_leader"] === Q[office]) ||
                        (members.includes(defaultParty) ? defaultParty : members[0]);
            }
            for (const p of [...CDC, "erc", "cup", "jxsi", "jxcat"]) {
                const list = Q[p + "_in_jxcat"]
                    ? "jxcat"
                    : Q[p + "_in_jxsi"]
                        ? "jxsi"
                        : p;
                Q[p + "_in_gob"] =
                    Q.cat_coalition.includes(p) || Q.cat_coalition.includes(list);
                Q[p + "_supporting"] =
                    Q[p + "_in_gob"] ||
                        Q.cat_coalition_support.includes(p) ||
                        Q.cat_coalition_support.includes(list);
            }
            Q.position_disp = Q[Q.player_party + "_in_gob"]
                ? "Generalitat"
                : Q[Q.player_party + "_supporting"]
                    ? "<span style='font-style: italic'>Government Support</span>"
                    : "<span style='font-style: italic'>Opposition</span>";
            if (Q.cat_coalition.length) {
                const seats = Q.cat_coalition.reduce((sum, p) => sum + num(Q[p + "_parlament_s"]), 0);
                const majority = num(Q.parlament_s_majority) || 68;
                const names = {
                    jxsi: "JxSí",
                    jxcat: "JxCat",
                    pdcat: "PDeCAT",
                    junts: "Junts",
                };
                const label = Q.cat_coalition
                    .map((p) => names[p] || p.toUpperCase())
                    .join(" + ");
                Q.cat_coalition_disp =
                    '<span class="generalitat-coalition" data-parties="' +
                        Q.cat_coalition.join(" ") +
                        '" data-summary="' +
                        (seats >= majority ? "Majority" : "Minority") +
                        " government - " +
                        seats +
                        "/" +
                        majority +
                        '">' +
                        label +
                        "</span>";
            }
            Q.historical_event =
                "The unity proposal has failed. " +
                    Q.jxcat_leader +
                    " will lead JxCat without ERC or the CUP.";
        }
    }
    this.state.currentHands['main'] = [];
    this.state.currentHands['main.main_easy'] = [];
    this.state.currentHands['main.main_hard'] = [];

    if (Q.president_party == "jxcat" && (Q.cat_coalition.includes("erc") || Q.cat_coalition.includes("cup") || Q.erc_supporting)) {
        Q.parlament_snap_election_countdown = 1;
    }
!}

The common-list proposal has failed. [+ jxcat_leader +] will lead jxcat as the successor to [+ parlament_current_ciu +], while ERC and CUP run separately. [? if parlament_snap_election_countdown = 1: It's unclear how long can the current government can last, given the very visible disagreements between the parties... ?]

- @post_event: Each party will take its own road
