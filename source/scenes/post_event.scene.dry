title: Post Event
new-page: true
on-arrival: {!
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;

// clamp variables to their ranges
if (Q.public_debt < 0) Q.public_debt = 0;
if (Q.public_debt > 100) Q.public_debt = 100;
if (Q.unemployment < 0) Q.unemployment = 0;
if (Q.unemployment > 100) Q.unemployment = 100;
if (Q.social_dissent < 0) Q.social_dissent = 0;
if (Q.social_dissent > 100) Q.social_dissent = 100;
if (Q.independence_movement < 0) Q.independence_movement = 0;
if (Q.independence_movement > 100) Q.independence_movement = 100;
if (Q.independence_trust < 0) Q.independence_trust = 0;
if (Q.independence_trust > 100) Q.independence_trust = 100;
if (Q.cat_spa_relations < 0) Q.cat_spa_relations = 0;
if (Q.cat_spa_relations > 100) Q.cat_spa_relations = 100;


for (var c of Q.parlament_constituencies) {
    for (var d of Q.parlament_demographics) {
        for (var p of Q.parties) {
            if (Q[p + '_parlament_' + c + '_' + d + '_support'] < 0) {
                Q[p + '_parlament_' + c + '_' + d + '_support'] = 0;
            }
            if (Q[p + '_parlament_' + c + '_' + d + '_support'] > 99) {
                Q[p + '_parlament_' + c + '_' + d + '_support'] = 99;
            }
        }
        if (Q['abstain_parlament_' + c + '_' + d + '_support'] < 0) {
            Q['abstain_parlament_' + c + '_' + d + '_support'] = 0;
        }
        if (Q['abstain_parlament_' + c + '_' + d + '_support'] > 99) {
            Q['abstain_parlament_' + c + '_' + d + '_support'] = 99;
        }
    }
}


// 1. update dates
var has_time_passed = false;
if (Q.rubicon) {
    if (Q.month_actions_last > Q.month_actions) {
        has_time_passed = true;
        Q.week += 1;
    }
    if (Q.month_actions >= 4) {
        Q.time += 1;
        Q.month_actions = 0;
    }
    Q.month_actions_last = Q.month_actions;
} else {
    if (Q.month_actions >= 1) {
        has_time_passed = true;
        Q.month_actions = 0;
        Q.time += 1;
        Q.month += 1;
    }
} 
if (Q.week >= 5) {
    Q.month += 1;
    Q.week = 1;
}
if (Q.month >= 13) {
    Q.month = 1;
    Q.year += 1;
}

if (has_time_passed) {
    console.info("Time has passed. Current date: ", Q.year, Q.month, Q.week);
    console.log("Debug DELETE ME TODO: time to next spanish election: ", Q.next_spanish_election_time - Q.time);
    G.engineTick(Q);
    // 2.1. Timers
    for (timer of Q.rubicon_timers) {
        if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
            Q[timer+'_timer'] -= 1;
        }
    }
    if (!Q.rubicon) {
        for (timer of Q.timers) {
            if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
                Q[timer+'_timer'] -= 1;
            }
        }
    }
    // 2.2. Checks
    if (Q.roadmap_year > 0 && Q.year > Q.roadmap_year) {
        Q.broken_roadmap = 1;
    }

    if (Q.month == 1 && Q.week == 1) {
        // It's a new year
        var party_resources_size = 0;
        if ((Q.player_party == "erc" && Q.erc_in_jxsi) || (Q.player_party == "cup" && Q.cup_in_jxsi)) {
            party_resources_size = Math.floor(Q.jxsi_parlament_s / 10);
        } else if ((Q.player_party == "erc" && Q.erc_in_jxcat) || (Q.player_party == "cup" && Q.cup_in_jxcat)) {
            party_resources_size = Math.floor(Q.jxcat_parlament_s / 10);
        } else {
            party_resources_size = Math.floor(Q[Q.player_party + "_parlament_s"] / 10);
        }
        if (party_resources_size < 1) party_resources_size = 1;
        if (party_resources_size > 3) party_resources_size = 3;

        Q.party_resources += party_resources_size * Q.party_resources_mult + Q.party_income;

        // TODO: more stuff that happens on a new year (govt budget, etc)
        // TODO: give more/less based on difficulty?

        // PxC sanity check in the rare case that they have seats
        if (Q.year >= 2015 && (!Q.fnc_formed || !Q.pxc_dissolved)) {
            Q.fnc_formed = true;
            Q.pxc_dissolved = true;
            for (var c of Q.parlament_constituencies) {
                for (var d of Q.parlament_demographics) {
                    Q["fnc_parlament_" + c + "_" + d + "_support"] = 0.9 * Q["pxc_parlament_" + c + "_" + d + "_support"];
                    Q["vox_parlament_" + c + "_" + d + "_support"] = 0.1 * Q["pxc_parlament_" + c + "_" + d + "_support"];
                    Q["pxc_parlament_" + c + "_" + d + "_support"] = 0;
            }
        }
    }
    }

    if (Q.time + 5 == Q.next_spanish_election_time || Q.time + 12 == Q.next_spanish_election_time) {
        // Resolve parties that actually run
        // It's a double check to allow "last minute" coalitions + allow coalition re-forming on failed elections (e.g 2015-2016 changes)
        if (Q.party_reaching_out_bng == 2) {
            Q.spa_bng_active = true;
        } else if (Q.party_reaching_out_bng == -2) {
            Q.spa_bng_active = false;
        } else {
            if (Q.iu_in_up) {
                if ((Q.year <= 2016 || Q.constitution_reformed) && Q.party_reaching_out_bng < 1) {
                    Q.spa_bng_active = false;
                } else if (Q.party_reaching_out_bng > -1 && !(Q.psoe_congreso_galicia_support <= Q.up_congreso_galicia_support + Q.bng_congreso_galicia_support || Q.congreso_coalition_sorpasso)) {
                    Q.spa_bng_active = true;
                } else {
                    Q.spa_bng_active = false;
                }
            } else {
                if ((Q.psoe_congreso_galicia_support <= Q.podemos_congreso_galicia_support + Q.bng_congreso_galicia_support || (Q.congreso_coalition_sorpasso && Q.constitution_reformed))) {
                    Q.spa_bng_active = true;
                } else {
                    Q.spa_bng_active = false;
                }
            }
        }
        if (Q.party_reaching_out_compromis == 2) {
            Q.spa_compromis_active = true;
        } else if (Q.party_reaching_out_compromis == -2) {
            Q.spa_compromis_active = false;
        } else {
            if ((Q.year <= 2016 || Q.constitution_reformed) && Q.party_reaching_out_compromis < 1) {
                Q.spa_compromis_active = false;
            } else if (Q.party_reaching_out_compromis > -1 && !(Q.psoe_congreso_valencia_support <= Q.podemos_congreso_valencia_support + Q.up_congreso_valencia_support + Q.compromis_congreso_valencia_support || Q.congreso_coalition_sorpasso)) {
                Q.spa_compromis_active = true;
            } else {
                Q.spa_compromis_active = false;
            }
        }
        if (Q.party_reaching_out_mes == 2) {
            Q.spa_mes_active = true;
        } else if (Q.party_reaching_out_mes == -2) {
            Q.spa_mes_active = false;
        } else {
            if (Q.iu_in_up && Q.party_reaching_out_mes < 1 && (Q.year < 2019 || Q.constitution_reformed)) {
                Q.spa_mes_active = false;
            } else if (Q.party_reaching_out_mes > -1 && !(Q.psoe_congreso_balears_support <= Q.podemos_congreso_balears_support + Q.up_congreso_balears_support + Q.mes_congreso_balears_support || (Q.congreso_coalition_sorpasso && Q.constitution_reformed))) {
                Q.spa_mes_active = true;
            } else {
                Q.spa_mes_active = false;
            }
        }
        
        if ((Q.pp_congreso_navarra_support*0.95 <= Q.cs_congreso_navarra_support) || (Q.pp_congreso_navarra_support*0.95 <= Q.podemos_congreso_navarra_support) || (Q.pp_congreso_navarra_support*0.95 <= Q.psoe_congreso_navarra_support) || (Q.pp_congreso_navarra_support*0.95 <= Q.up_congreso_navarra_support)) {
            Q.upn_in_pp = false;
        } else {
            Q.upn_in_pp = true;
            if (Q.year > 2016 && Q.pp_congreso_navarra_support*0.7 >= Q.cs_congreso_navarra_support) {
                Q.spa_nsuma_formed = true;
            }
        }
        if (Q.year > 2016) {
            var foro_weight_sum = 0;
            for (var r of Q.congreso_constituencies) {
                if (Q["cs_congreso_" + r + "_support"] * 0.9 >= Q["pp_congreso_" + r + "_support"]) {
                    foro_weight_sum += 1;
                    if (r == "res") {
                        foro_weight_sum += 1;
                    }
                }
            }
            if (!Q.upn_in_pp) {
                foro_weight_sum += 1;
            }
            if (Q.prc_congreso_rest_support >= 0.4) {
                foro_weight_sum += 1;
            }
            if (Q.cc_congreso_res_support >= 0.7){
                foro_weight_sum += 1;
            }
            if (foro_weight_sum > 3) {
                Q.spa_foro_active = true;
            } else {
                Q.spa_foro_active = false;
            }
        }
        if ((!Q.spa_te_active) && (Q.year > 2017)) {
            // TBD: More options to trigger this?
            Q.spa_te_active = true;
            G.spaSupportInject(Q, 'te', 'rest', 0.22, 'abstain');
        }
    }
    

    // 2.3. Ripple effects from time passing.
    if (Q.unemployment >= 20 && (Q.erc_supporting == 1 || Q.erc_in_gob == 1)) {
        Q.erc_left_dissent += 0.5;
    }
    if (Q.broken_roadmap == 1) {
        Q.erc_civic_dissent += 1;
    }
    // TODO: Ripple effect for CUP

    // 2.4. Historical records
    // Parlament
    if (!Q.historical_mode || (Q.month % 4 == 0 && Q.week == 1) || (Q.year == Q.next_election_year && Q.month == Q.next_election_month && Q.week == Q.next_election_week)) {
        // For historical mode, only record 4 times a year + election times.
        var party_support_results = {'date': new Date(Q.year, Q.month-1, Q.week*7)};
        for (var p of Q.parties) {
            var p_support = 0;
            var total_pop = 0;
            for (var c of Q.parlament_constituencies) {
                for (var d of Q.parlament_demographics) {
                    if (Q[p + '_parlament_' + c + '_' + d + '_support'] > 0) {
                        p_support += Q[p + '_parlament_' + c + '_' + d + '_support']*Q['parlament_' + c + '_' + d + '_pop']/100;
                    }
                    total_pop += Q['parlament_' + c + '_' + d + '_pop'];
                }
            }
            party_support_results[p] = p_support/total_pop * 100;
        }
        Q.party_support_records.push(party_support_results);
    }
    // Congreso
    if (!Q.historical_mode || (Q.month % 4 == 0 && Q.week == 1) || (Q.year == Q.next_spanish_election_year && Q.month == Q.next_spanish_election_month && Q.week == Q.next_spanish_election_week)) {
        var party_spa_support_records = {'date': new Date(Q.year, Q.month-1, Q.week*7)};
        for (var p of Q.congreso_parties) {
            var p_support = 0;
            var total_pop = 0;
            for (var c of Q.congreso_constituencies) {
                if (Q[p + '_congreso_' + c + '_support'] > 0) {
                    p_support += Q[p + '_congreso_' + c + '_support']*Q['congreso_pop'][c]/100;
                }
                total_pop += Q['congreso_pop'][c];    
            }
            party_spa_support_records[p] = p_support/total_pop * 100;
            }
        Q.party_spa_support_records.push(party_spa_support_records);
    }

    Q.economic_records.push({
        'date': new Date(Q.year, Q.month-1, Q.week*7),
        'gdp_growth': Q.gdp_growth,
        'public_debt': Q.public_debt,
        'unemployment': Q.unemployment,
        'generalitat_surplus': Q.generalitat_surplus,
    })
    Q.social_records.push({
        'date': new Date(Q.year, Q.month-1, Q.week*7),
        'independence_movement': Q.independence_movement,
        'independence_trust': Q.independence_trust,
        'social_dissent': Q.social_dissent,
        'cat_spa_relations': Q.cat_spa_relations,
        'podemos_channeling': Q.podemos_channeling,
        'welfare_index': Q.welfare_index
    })


    // 2.5. Countdown updating.
    for (var countdown of Q.countdowns) {
        if (Q[countdown + "_countdown"] >= 0) {
            Q[countdown + "_countdown"] -= 1;
            // countdowns at -1 are actually usefull for visualizations
        } else {
            if (Q[countdown + "_countdown"] == 0) {
                Q[countdown + "_countdown"] = -1;
                console.info("Countdown for " + countdown + " reached trigger.");
                Q[countdown + '_trigger'] = 1;
            }
            console.log("Countdown " + countdown + ": " + Q[countdown + "_countdown"] + " ticks remaining.");
        }
    }
}

// 3. re-calculate dissent.
for (var p of Q.parties) {
    var total_strength = 0;
    var total_dissent = 0;
    if (Q[p+"_factions"]) {
        for (var c of (Q[p+"_factions"])) {
            if (Q[p + '_' + c + '_dissent'] < 0) {
                Q[p + '_' + c + '_dissent'] = 0;
            } else if (Q[p + '_' + c + '_dissent'] >= 100) {
                Q[p + '_' + c + '_dissent'] = 99;
            }
            if (Q[p + '_' + c + '_strength'] < 0) {
                Q[p + '_' + c + '_strength'] = 0.1;
            }
            total_strength += Q[p + '_' + c + '_strength'];
        }
        for (var c of (Q[p+"_factions"])) {
            Q[p + '_' + c + '_strength'] = 100*Q[p + '_' + c + '_strength']/total_strength;
            total_dissent += Q[p + '_' + c + '_dissent']*Q[p + '_' + c + '_strength']/total_strength;
        }
        Q[p+'_dissent'] = total_dissent;
    }
}

// 4. Achievement check
if (Q.spanish_pm == "Pedro Sánchez") {
    Q.psoe_sanchez_president_ever = true;
    if (Q.psoe_barons_revolted ) {
        this.achieve('perrosanxe');
    }
}
if (Q.congreso_coalition_sorpasso && (Q.spanish_pm_party == "podemos" || Q.spanish_pm_party == "up")) {
    this.achieve('asalto_cielos');
}

// 5. Hidden triggers
if (!Q.hidden_right_consolidation && (Q.year == 2019 && Q.month == 10)) {
    Q.hidden_right_consolidation = true;
    // TODO: un-hardcode this? how? via condition of cs giving too much to the pp??
    G.spaSupportInject(Q, 'vox', 'all', 3.5, 'cs');
    G.spaSupportInject(Q, 'vox', 'all', 2.0, 'abstain');
    G.spaSupportInject(Q, 'pp',  'all', 8.0, 'cs');
    G.spaSupportInject(Q, 'pp',  'all', 3.0, 'abstain');
}
if (!Q.hidden_cc_surge && ((Q.year == 2019 && Q.month == 2) || (Q.social_dissent > 90))) {
    // TBD: More/different options to trigger this?
    Q.hidden_cc_surge = true;
    G.spaSupportInject(Q, 'cc', 'rest', 0.28, 'abstain');
}
if (!Q.hidden_prc_surge && (Q.year == 2019 && Q.month == 2) || (Q.year > 2015 && (!Q.upn_in_pp || Q.spa_foro_active) )) {
    Q.hidden_prc_surge = true;
    G.spaSupportInject(Q, 'prc', 'rest', 0.22, 'abstain');
}
if ((!Q.hidden_vox_surge) && (Q.year == 2019 || (Q.year >= 2017 && Q.next_spanish_election_time - Q.time <= 6))) {
    Q.hidden_vox_surge = true;
    Q.vox_active = true;
    G.spaSupportInject(Q, 'vox', 'all', 4.0, 'pp');
    G.spaSupportInject(Q, 'vox', 'all', 0.5, 'cs');
}
if ((!Q.hidden_bng_surge) && (Q.year == 2019)) {
    Q.hidden_bng_surge = true;  
    if (!Q.iu_in_up) {
        G.spaSupportInject(Q, 'bng', 'galicia', 5.5, 'podemos');
    } else {
        G.spaSupportInject(Q, 'bng', 'galicia', 5.5, 'up');
    }
}
if ((!Q.podemos_hidden_surge) && (Q.year == 2014 && Q.month == 5)) {
    Q.podemos_hidden_surge = true;
    G.spaSupportInject(Q, 'podemos', 'all', 6.0, 'iu');
    G.spaSupportInject(Q, 'podemos', 'all', 9.0, 'abstain');
    G.spaSupportInject(Q, 'podemos', 'all', 3.0, 'psoe');
}
if (Q.amaiur_congreso_s > 0 && Q.spa_ehbildu_active && Q.year == 2015 && Q.month == 10) {
    // So that deltas dont look weird on the first election
    Q.ehbildu_congreso_s = Q.amaiur_congreso_s;
    Q.ehbildu_congreso_pv = Q.amaiur_congreso_pv;
    Q.amaiur_congreso_s = 0;
    Q.amaiur_congreso_pv = 0;
}
if (!Q.hidden_right_shift && Q.art155_ever) {
    Q.hidden_right_shift = true;
    var _pp = Q.pp_local_barcelona_support || 0;
    var _toPsc = Math.min(2.7, _pp);
    var _toCs = Math.min(0.5, Math.max(0, _pp - _toPsc));
    Q.pp_local_barcelona_support = _pp - (_toPsc + _toCs);
    Q.psc_local_barcelona_support = (Q.psc_local_barcelona_support || 0) + _toPsc;
    Q.cs_local_barcelona_support = (Q.cs_local_barcelona_support || 0) + _toCs;
    // TODO: parallel parlament / congreso unionist shift? (calibration only models Barcelona city)
}

// Silent leadership changes
if (Q.pnv_leader == "Íñigo Urkullu" && Q.year >= 2013) {
    Q.pnv_leader = "Andoni Ortuzar";
    Q.pnv_leader_gender = "m";
}
if (Q.next_election_time - Q.time > 12 && Q.year > 2016) {
    Q.ppc_leader = "Xavier García Albiol";
    Q.ppc_leader_gender = "m";
}
if (Q.ehbildu_leader == "Laura Mintegi" && Q.year >= 2015) {
    Q.ehbildu_leader == "Maddalen Iriarte"
    Q.ehbildu_leader_gender = "f";
}
if (Q.upn_leader == "Yolanda Barcina" && Q.year >= 2015 && Q.month >= 9) {
    Q.upn_leader = "Javier Esparza";
    Q.upn_leader_gender = "m";   
}
if (Q.bng_leader == "Francisco Jorquera" && Q.year >= 2015) {
    Q.bng_leader = "Ana Pontón";
    Q.bng_leader_gender = "f";
}
if (Q.ccpnc_leader == "Paulino Rivero" && Q.year >= 2015) {
    Q.ccpnc_leader = "Fernando Clavijo";
    Q.ccpnc_leader_gender = "m";
}
if (Q.fac_leader == "Paulino Rivero" && Q.year >= 2015) {
    Q.fac_leader = "Cristina Coto";
    Q.fac_leader_gender = "f";
}
if (Q.ehbildu_leader == "Maddalen Iriarte" && Q.year >= 2016 && Q.month >= 6) {
    Q.ehbildu_leader = "Arnaldo Otegi";
    Q.ehbildu_leader_gender = "m";
}
if (Q.fac_leader == "Cristina Coto" && Q.year >= 2019) {
    Q.fac_leader = "Carmen Moriyón";
    Q.fac_leader_gender = "f";
}
if (Q.mes_leader == "Biel Barceló" && Q.year >= 2019) {
    Q.mes_leader = "Miquel Ensenyat";
    Q.mes_leader_gender = "m";
}

Q.has_event = 0;
// check if there are any cards in #event, and then go to main if not.
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
}

Q.has_election = 0;
// check if there are any cards in #election, and then go to main if not.
var scene = this.game.scenes['post_event.elections_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_election = 1;
}
!}
on-departure: {!
// TODO: set historical/international events. Hardcoded ones are easier to handle as qdisplays.
if (Q.historical_event == Q.last_historical_event) {
    Q.historical_event = 0;  
} 
Q.last_historical_event = Q.historical_event;
!}
go-to: events_choice if has_event = 1; elections_choice if has_election = 1; main if has_event = 0 and has_election = 0 and difficulty = 0; main.main_easy if has_event = 0 and has_election = 0 and difficulty < 0; main.main_hard if has_event = 0 and has_election = 0 and difficulty > 0

= [+ month : month +] [+ year +][? if rubicon:, Week [+ week +]?]

@events_choice
role: newspaper

- #event

@elections_choice
role: newspaper

- #election

# go-to: main

# This scene is solely for updating numbers after events, and routing to special events.

