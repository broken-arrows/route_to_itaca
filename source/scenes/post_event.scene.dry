title: Continue...
new-page: true
on-arrival: {!
var sovereigntyTimerBefore = Q.coalition_phase_timer;
Q.erc_advisor_action = null;
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;

// clamp variables to their ranges
if (Q.public_debt < 0) Q.public_debt = 0;
if (Q.public_debt > 100) Q.public_debt = 100;
if (Q.unemployment < 0) Q.unemployment = 0;
if (Q.unemployment > 100) Q.unemployment = 100;
if (Q.social_dissent < 0) Q.social_dissent = 0;
if (Q.social_dissent > 100) Q.social_dissent = 100;
if (Q.independence_movement < 0) Q.independence_movement = 0;
if (Q.independence_movement > 100) Q.independence_movement = 100;
if (Q.independence_trust < 0) Q.independence_trust = 0;
if (Q.independence_trust > 100) Q.independence_trust = 100;
if (Q.cat_spa_relations < 0) Q.cat_spa_relations = 0;
if (Q.cat_spa_relations > 100) Q.cat_spa_relations = 100;

Q.player_roadmap = Q[Q.player_party + "_roadmap"];

for (var c of Q.parlament_constituencies) {
    for (var d of Q.parlament_demographics) {
        for (var p of Q.parties) {
            if (Q[p + '_parlament_' + c + '_' + d + '_support'] < 0) {
                Q[p + '_parlament_' + c + '_' + d + '_support'] = 0;
            }
            if (Q[p + '_parlament_' + c + '_' + d + '_support'] > 99) {
                Q[p + '_parlament_' + c + '_' + d + '_support'] = 99;
            }
        }
        if (Q['abstain_parlament_' + c + '_' + d + '_support'] < 0) {
            Q['abstain_parlament_' + c + '_' + d + '_support'] = 0;
        }
        if (Q['abstain_parlament_' + c + '_' + d + '_support'] > 99) {
            Q['abstain_parlament_' + c + '_' + d + '_support'] = 99;
        }
    }
}


if (Q.coalition_phase_timer === undefined) Q.coalition_phase_timer = 0;

function updatePendingEvents(engine) {
    Q.has_event = 0;
    var scene = engine.game.scenes['post_event.events_choice'];
    var choices = engine._compileChoices(scene);
    if (choices && choices[0].title != "Continue...") {
        Q.has_event = 1;
    }

    Q.has_election = 0;
    var scene = engine.game.scenes['post_event.elections_choice'];
    var choices = engine._compileChoices(scene);
    if (choices && choices[0].title != "Continue...") {
        Q.has_election = 1;
    }
}

// Keep the requested advance until both current editions have been resolved.
updatePendingEvents(this);

// 1. update dates
var has_time_passed = false;
if (Q.rubicon && !Q.has_event && !Q.has_election) {
    if (Q.month_actions_last > Q.month_actions) {
        has_time_passed = true;
        Q.week += 1;
    }
    if (Q.month_actions >= 4) {
        Q.time += 1;
        Q.month_actions = 0;
    }
    if (Q.week >= 5) {
        Q.month += 1;
        Q.week = 1;
        if (Q.burdens_time > 0) {
            Q.burdens_time -= 1;
        }
    }
    Q.month_actions_last = Q.month_actions;
} else if (!Q.rubicon && !Q.has_event && !Q.has_election) {
    if (Q.month_actions >= 1) {
        has_time_passed = true;
        Q.month_actions = 0;
        Q.time += 1;
        Q.month += 1;
        if (Q.burdens_time > 0) {
            Q.burdens_time -= 1;
        }
    }
} 

if (Q.month >= 13) {
    Q.month = 1;
    Q.year += 1;
}

// External monetary support begins in March 2015, including late-loaded saves.
// Resolve after the calendar advances and before the monthly economic tick.
if (!Q.ecb_qe && (Q.year > 2015 || (Q.year === 2015 && Q.month >= 3))) {
    Q.ecb_qe = true;
}

if (has_time_passed) {
    console.info("Time has passed. Current date: ", Q.year, Q.month, Q.week);
    G.engineTick(Q);
    // 2.1. Timers
    if (Q.rubcion) {
        for (timer of Q.rubicon_timers) {
            if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
                Q[timer+'_timer'] -= 1;
            }
        }
    }
    for (timer of Q.timers) {
        if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
            Q[timer+'_timer'] -= 1;
        }
    }

    // 2.2. Checks
    if (Q.iu_leader == 'Cayo Lara' && Q.year >= 2015) {
        Q.iu_leader = 'Alberto Garzón';
        Q.iu_leader_gender = 'm';
    }
    if (Q.roadmap_year > 0 && Q.year > Q.roadmap_year && Q.roadmap_year != 0) {
        Q.broken_roadmap = 1;
        Q.broken_roadmap_trigger = true;
    }
    if (Q.burdens_goal > 0 && Q.burdens_time <= 0) {
        if (Q.burdens_done < Q.burdens_goal) {
            // Start once per failure
            if (!Q.burdens_broken || !Number.isFinite(Q.burdens_restart_countdown)) {
                Q.burdens_restart_countdown = 24;
            }
            Q.burdens_broken = 1;
            if (!Q.countdowns.includes("burdens_restart")) Q.countdowns.push("burdens_restart");
        } else {
            Q.burdens_done = 0;
            Q.burdens_time = 12;
        }
    }

    if (Q.month == 1 && Q.week == 1) {
        // It's a new year
        var party_resources_size = 0;
        if ((Q.player_party == "erc" && Q.erc_in_jxsi) || (Q.player_party == "cup" && Q.cup_in_jxsi)) {
            party_resources_size = Math.floor(Q.jxsi_parlament_s / 10);
        } else if ((Q.player_party == "erc" && Q.erc_in_jxcat) || (Q.player_party == "cup" && Q.cup_in_jxcat)) {
            party_resources_size = Math.floor(Q.jxcat_parlament_s / 10);
        } else {
            party_resources_size = Math.floor(Q[Q.player_party + "_parlament_s"] / 10);
        }
        if (party_resources_size < 1) party_resources_size = 1;
        if (party_resources_size > 3) party_resources_size = 3;

        Q.party_resources += party_resources_size * Q.party_resources_mult + Q.party_income;

        var playerList = Q.player_in_jxsi ? "jxsi" :
            Q.player_in_jxcat ? "jxcat" : Q.player_party;
        var cabinet = Q.cat_coalition || [];
        if (Q.player_party && !Q.cat_caretaker_gov &&
            (cabinet.includes(Q.player_party) || cabinet.includes(playerList))) {
            var yearlyAllowance = Math.max(0, 1 - (Number(Q.difficulty) || 0));
            Q.government_budget = (Number(Q.government_budget) || 0) + yearlyAllowance;
        }

        // PxC sanity check in the rare case that they have seats
        if (Q.year >= 2015 && (!Q.fnc_formed || !Q.pxc_dissolved)) {
            if (!Number.isFinite(Q.fnc_relations))
                Q.fnc_relations = Number.isFinite(Q.pxc_relations) ? Q.pxc_relations : 0;
            Q.fnc_formed = true;
            Q.pxc_dissolved = true;
            for (var c of Q.parlament_constituencies) {
                for (var d of Q.parlament_demographics) {
                    Q["fnc_parlament_" + c + "_" + d + "_support"] = 0.9 * Q["pxc_parlament_" + c + "_" + d + "_support"];
                    Q["vox_parlament_" + c + "_" + d + "_support"] = 0.1 * Q["pxc_parlament_" + c + "_" + d + "_support"];
                    Q["pxc_parlament_" + c + "_" + d + "_support"] = 0;
            }
        }
    }
    }

    if (Q.time + 2 == Q.next_spanish_election_time || Q.time + 5 == Q.next_spanish_election_time || Q.time + 12 == Q.next_spanish_election_time) {
        // Recheck at the election tour, after any three-month IU agreement.
        // Extremes remain decisive; intermediate outreach has party-specific weight.
        for (var entry of [['bng', 'galicia'], ['compromis', 'valencia'], ['mes', 'balears']]) {
            var party = entry[0], region = entry[1];
            var alignment = Q['party_reaching_out_' + party] || 0;
            var left = (Q['podemos_congreso_' + region + '_support'] || 0) + (Q['up_congreso_' + region + '_support'] || 0);
            var own = Q[party + '_congreso_' + region + '_support'] || 0;
            // A folded ally still has an organization: do not read zero ballot
            // support as proof that it has no bargaining power.
            var strength = own || Q[party + '_congreso_' + region + '_stashed'] || 0;
            var challenge = left > 0 && left + own >= (Q['psoe_congreso_' + region + '_support'] || 0);
            var reform = !!Q.constitution_reformed;
            var sorpasso = !!Q.congreso_coalition_sorpasso;
            var opportunity = challenge || sorpasso;
            // Easy makes a single outreach action decisive in either direction.
            var decisiveAlignment = Q.difficulty < 0 ? 1 : 2;
            var joins = false;
            if (Q.podemos_surged && alignment <= -decisiveAlignment) {
                joins = true;
            } else if (Q.podemos_surged && alignment < decisiveAlignment) {
                if (party == 'bng') {
                    // National success matters to BNG only with favourable outreach.
                    // Regional weakness alone does not surrender its autonomy.
                    if (alignment < 0) {
                        joins = opportunity;
                    } else if (alignment == 0) {
                        joins = challenge && (reform || (Q.iu_in_up && Q.year <= 2016));
                    } else {
                        joins = challenge && reform;
                    }
                } else if (party == 'compromis') {
                    // Compromís seeks a viable governing alternative, not merely
                    // shelter under a larger regional Podemos vote.
                    if (alignment < 0) {
                        joins = opportunity || Q.year <= 2016;
                    } else if (alignment == 0) {
                        joins = opportunity && (Q.year <= 2016 || Q.iu_in_up || reform);
                    } else {
                        joins = opportunity && reform;
                    }
                } else {
                    // For MÉS, the larger ballot also offers access to representation.
                    // Its stashed support preserves that comparison while folded.
                    var representation = left > 0 && left >= strength * 2;
                    var earlyUnion = Q.iu_in_up && Q.year < 2019;
                    if (alignment < 0) {
                        joins = representation || opportunity || earlyUnion;
                    } else if (alignment == 0) {
                        joins = (representation && (earlyUnion || opportunity || reform))
                            || (opportunity && (earlyUnion || reform));
                    } else {
                        joins = opportunity && reform;
                    }
                }
            }
            Q['spa_' + party + '_active'] = !joins;
        }

        if ((Q.pp_congreso_navarra_support*0.95 <= Q.cs_congreso_navarra_support) || (Q.pp_congreso_navarra_support*0.95 <= Q.podemos_congreso_navarra_support) || (Q.pp_congreso_navarra_support*0.95 <= Q.psoe_congreso_navarra_support) || (Q.pp_congreso_navarra_support*0.95 <= Q.up_congreso_navarra_support)) {
            Q.upn_in_pp = false;
        } else {
            Q.upn_in_pp = true;
            if (Q.year > 2016 && Q.pp_congreso_navarra_support*0.7 >= Q.cs_congreso_navarra_support) {
                Q.spa_nsuma_formed = true;
            }
        }
        if (Q.year > 2016) {
            var foro_weight_sum = 0;
            for (var r of Q.congreso_constituencies) {
                if (Q["cs_congreso_" + r + "_support"] * 0.9 >= Q["pp_congreso_" + r + "_support"]) {
                    foro_weight_sum += 1;
                    if (r == "res") {
                        foro_weight_sum += 1;
                    }
                }
            }
            if (!Q.upn_in_pp) {
                foro_weight_sum += 1;
            }
            if (Q.prc_congreso_rest_support >= 0.4) {
                foro_weight_sum += 1;
            }
            if (Q.cc_congreso_res_support >= 0.7){
                foro_weight_sum += 1;
            }
            if (foro_weight_sum > 3) {
                Q.spa_foro_active = true;
            } else {
                Q.spa_foro_active = false;
            }
        }
        if ((!Q.spa_te_active) && (Q.year > 2017)) {
            // TBD: More options to trigger this?
            Q.spa_te_active = true;
            G.spaSupportInject(Q, 'te', 'rest', 0.22, 'abstain');
        }
        G.reconcileCongresoLineup(Q);
    }


    // 2.3. Ripple effects from time passing.
    if (Q.broken_roadmap == 1) {
        Q.erc_civic_dissent += 1;
    }
    if (Q.player_party === "erc") {
        if (Q.unemployment >= 20) {
            if (Q.erc_in_gob) {
                Q.erc_left_dissent += 0.5 * (Q.rubicon ? 0.25 : 1);
            } else if (Q.erc_supporting) {
                Q.erc_left_dissent += 0.25 * (Q.rubicon ? 0.25 : 1);
        }
        }
        var pragmaticRoadmapDissent = Q.erc_roadmap === 3 ? 0.75 : Q.erc_roadmap === 2 ? 0.2 : 0;
        Q.erc_pragmatic_dissent += pragmaticRoadmapDissent * (Q.rubicon ? 0.25 : 1);
    }
    // TODO: Ripple effect for CUP-player

    

    // ERC advisors: recurring work only on elapsed time, scaled during weekly play.
    if (Q.player_party === "erc") {
        var advisorMonth = Q.rubicon ? 0.25 : 1;
        var factions = {
            left: ["dolors_bassa", "joan_josep_nuet", "marta_rovira", "teresa_jorda"],
            core: ["oriol_junqueras", "gabriel_rufian", "joan_tarda", "sergi_sabria", "raul_romeva"],
            pragmatic: ["pere_aragones", "roger_torrent", "alfred_bosch", "ernest_maragall"],
            civic: ["joan_laporta", "carles_mundo", "carme_forcadell", "elisenda_paluzie"]
        };
        var mediators = ["oriol_junqueras", "joan_tarda", "sergi_sabria", "raul_romeva"].filter(function(p) { return Q[p + "_advisor"]; }).length;
        for (var faction of Object.keys(factions)) {
            var represented = factions[faction].filter(function(p) { return Q[p + "_advisor"]; }).length;
            var relief = Math.min(0.2, represented * 0.1) + Math.min(0.1, mediators * 0.025);
            Q["erc_" + faction + "_dissent"] = Math.max(0, Q["erc_" + faction + "_dissent"] - advisorMonth * relief);
        }
        for (var pair of [["marta_rovira", "left"], ["roger_torrent", "pragmatic"], ["elisenda_paluzie", "civic"]]) {
            if (Q[pair[0] + "_advisor"]) Q["erc_" + pair[1] + "_strength"] += 0.1 * advisorMonth;
        }
        for (var pair of [["joan_josep_nuet", Q.parlament_current_icv], ["carme_forcadell", Q.parlament_current_ciu]]) {
            var relation = pair[1] + "_relations";
            if (Q[pair[0] + "_advisor"] && pair[1] && Number.isFinite(Q[relation]) && Q[relation] >= 30 && Q[relation] < 65 && !Q.burdens_broken && !Q.broken_roadmap) Q[relation] = Math.min(65, Q[relation] + 0.1 * advisorMonth);
        }
        var effectiveness = advisorMonth * Math.max(0, 1 - Q.erc_dissent / 100) * (Q.burdens_broken && (Q.erc_in_gob || Q.erc_supporting) ? 0.3 : 1);
        if (Q.gabriel_rufian_advisor) {
            G.cardSupportTransfer(Q, {contest:"congreso",to:"erc",from:"psoe",amount:0.025*effectiveness,maxDonorFraction:0.5,constituencies:["catalunya"]});
            Q.erc_redbelt_mod += Math.min(Math.max(0, 4 - Q.erc_redbelt_mod), 0.025 * effectiveness);
        }
        if (Q.dolors_bassa_advisor) {
            G.cardSupportTransfer(Q, {contest:"congreso",to:"erc",from:"federal_left",amount:0.02*effectiveness,maxDonorFraction:0.5,constituencies:["catalunya"]});
            G.cardSupportTransfer(Q, {contest:"parlament",to:"erc",from:"psc",amount:0.01*effectiveness,maxDonorFraction:0.5,constituencies:["barcelona","tarragona"],demographics:["ind","unemployed"]});
        }
        if (Q.teresa_jorda_advisor) {
            G.cardSupportTransfer(Q, {contest:"parlament",to:"erc",from:"ciu",amount:0.02*effectiveness,maxDonorFraction:0.5,constituencies:["girona","lleida","tarragona"],demographics:["rural"]});
            Q.erc_interior_mod += Math.min(Math.max(0, 4 - Q.erc_interior_mod), 0.025 * effectiveness);
        }
        if (Q.alfred_bosch_advisor || Q.ernest_maragall_advisor) G.cardSupportTransfer(Q, {contest:"barcelona",to:"erc",from:"psc",amount:0.03*effectiveness,maxDonorFraction:0.5});
    }
    // Special countdown for ERC's bside
    if (Q.erc_bside_pending) Q.erc_bside_pending.months = Math.max(0, Q.erc_bside_pending.months - (Q.rubicon ? 0.25 : 1));

    // 2.4. Historical records
    // Parlament
    if (!Q.historical_mode || (Q.month % 4 == 0 && Q.week == 1) || (Q.year == Q.next_election_year && Q.month == Q.next_election_month && Q.week == Q.next_election_week)) {
        // For historical mode, only record 4 times a year + election times.
        var party_support_results = {'date': new Date(Q.year, Q.month-1, Q.week*7), 'week': Q.rubicon ? Q.week : null};
        for (var p of Q.parties) {
            var p_support = 0;
            var total_pop = 0;
            for (var c of Q.parlament_constituencies) {
                for (var d of Q.parlament_demographics) {
                    if (Q[p + '_parlament_' + c + '_' + d + '_support'] > 0) {
                        p_support += Q[p + '_parlament_' + c + '_' + d + '_support']*Q['parlament_' + c + '_' + d + '_pop']/100;
                    }
                    total_pop += Q['parlament_' + c + '_' + d + '_pop'];
                }
            }
            party_support_results[p] = p_support/total_pop * 100;
        } 
        Q.party_support_records.push(party_support_results);
    }
    // Congreso
    if (!Q.historical_mode || (Q.month % 4 == 0 && Q.week == 1) || (Q.year == Q.next_spanish_election_year && Q.month == Q.next_spanish_election_month && Q.week == Q.next_spanish_election_week)) {
        var party_spa_support_records = {'date': new Date(Q.year, Q.month-1, Q.week*7), 'week': Q.rubicon ? Q.week : null};
        for (var p of Q.congreso_parties) {
            var p_support = 0;
            var total_pop = 0;
            for (var c of Q.congreso_constituencies) {
                if (Q[p + '_congreso_' + c + '_support'] > 0) {
                    p_support += Q[p + '_congreso_' + c + '_support']*Q['congreso_pop'][c]/100;
                }
                total_pop += Q['congreso_pop'][c];    
            }
            party_spa_support_records[p] = p_support/total_pop * 100;
            }
        Q.party_spa_support_records.push(party_spa_support_records);
    }

    Q.economic_records.push({
        'date': new Date(Q.year, Q.month-1, Q.week*7),
        'gdp_growth': Q.gdp_growth,
        'public_debt': Q.public_debt,
        'unemployment': Q.unemployment,
        'generalitat_surplus': Q.generalitat_surplus,
    })
    Q.social_records.push({
        'date': new Date(Q.year, Q.month-1, Q.week*7),
        'independence_movement': Q.independence_movement,
        'independence_trust': Q.independence_trust,
        'social_dissent': Q.social_dissent,
        'cat_spa_relations': Q.cat_spa_relations,
        'podemos_channeling': Q.podemos_channeling,
        'welfare_index': Q.welfare_index
    })


    // 2.5. Countdown updating.
    for (var countdown of Q.countdowns) {
        if (Q[countdown + "_countdown"] >= 0) {
            Q[countdown + "_countdown"] -= 1;
            // countdowns at -1 are actually usefull for visualizations
        } 
        if (Q[countdown + "_countdown"] == 0) {
            Q[countdown + "_countdown"] = -1;
            console.info("Countdown for " + countdown + " reached trigger.");
            Q[countdown + '_trigger'] = 1;
        } else if (Q[countdown + "_countdown"] > 0) {
            console.log("Countdown " + countdown + ": " + Q[countdown + "_countdown"] + " ticks remaining.");
        }
    }
}

// Coalition law promises are checked after countdowns and against actual passage.
for (var record of Q.coalition_indy_commitments || []) {
    if (["broken", "penalized"].includes(record.status) && Q[record.law]) record.status = "fulfilled";
    if (record.status != "pending") continue;
    if (!Q.cat_coalition.includes(record.target) || !Q[Q.player_party + "_in_gob"]) {
        record.status = "retired";
    } else if (Q[record.law]) {
        record.status = "fulfilled";
    } else if (Q.year * 12 + Q.month >= record.deadline) {
        record.status = "broken";
        Q.coalition_indy_breach_trigger = true;
    }
}

// 3. re-calculate dissent.
for (var p of Q.parties) {
    var total_strength = 0;
    var total_dissent = 0;
    if (Q[p+"_factions"]) {
        for (var c of (Q[p+"_factions"])) {
            if (Q[p + '_' + c + '_dissent'] < 0) {
                Q[p + '_' + c + '_dissent'] = 0;
            } else if (Q[p + '_' + c + '_dissent'] >= 100) {
                Q[p + '_' + c + '_dissent'] = 99;
            }
            if (Q[p + '_' + c + '_strength'] < 0) {
                Q[p + '_' + c + '_strength'] = 0;
            }
            total_strength += Q[p + '_' + c + '_strength'];
        }
        for (var c of (Q[p+"_factions"])) {
            Q[p + '_' + c + '_strength'] = total_strength > 0 ? 100*Q[p + '_' + c + '_strength']/total_strength : 0;
            total_dissent += Q[p + '_' + c + '_dissent']*Q[p + '_' + c + '_strength']/100;
        }
        Q[p+'_dissent'] = total_dissent;
    }
}

if (Q.player_in_jxsi) {
    Q.jxsi_dissent = 0;
    var jxsi_count = 0;
    for (var p of Q.parties) {
        if (p != Q.player_party && Q[p + "_in_jxsi"]) {
            jxsi_count += 1;
            Q.jxsi_dissent += 80 - Q[p + "_relations"];
        }
    }
    Q.jxsi_dissent = Q.jxsi_dissent / jxsi_count;
} else if (Q.player_in_jxcat) {
    Q.jxcat_dissent = 0;
    var jxcat_count = 0;
    for (var p of Q.parties) {
        if (p != Q.player_party && Q[p + "_in_jxcat"]) {
            jxcat_count += 1;
            Q.jxcat_dissent += 80 - Q[p + "_relations"];
        }
    }
    Q.jxcat_dissent = Q.jxcat_dissent / jxcat_count;
}

var playerVehicle = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
Q.cat_coalition_dissent = 0;
var partners = (Q.cat_coalition || []).filter(function(p) { return p != playerVehicle; });
if ((Q.cat_coalition || []).includes(playerVehicle) && partners.length) {
    Q.cat_coalition_dissent = partners.reduce(function(total, p) { return total + 80 - Q[p + "_relations"]; }, 0) / partners.length;
}

// One rupture at a time, per partner; never infer relations between NPC parties.
if (has_time_passed || Q.coalition_rupture_recheck) {
    Q.coalition_rupture_recheck = false;
    Q.coalition_rupture_trigger = false;
    Q.coalition_rupture_target = "";
    if (!Q.cat_caretaker_gov && (Q.cat_coalition || []).includes(playerVehicle)) {
        for (var partner of partners) {
            var relations = Q[partner + "_relations"];
            var ownRoadmap = Q[playerVehicle + "_roadmap"];
            var partnerRoadmap = Q[partner + "_roadmap"];
            var incompatible = ownRoadmap >= 1 && partnerRoadmap >= 1 && Math.abs(ownRoadmap - partnerRoadmap) > 1;
            var brokenLaw = (Q.coalition_indy_commitments || []).some(function(record) {
                return record.target == partner && ["broken", "penalized"].includes(record.status) && !Q[record.law];
            });
            var brokenPolicy = (Q.coalition_policy_commitments || []).some(function(record) {
                if (record.scope != "cabinet" || !(record.signatories || []).includes(partner)) return false;
                if (!["broken", "applied"].includes(record.status)) return false;
                var actual = Q[record.kind];
                if (record.status == "broken" && actual >= record.target) record.status = "applied";
                return actual < record.target;
            });
            if (relations < 30 || (relations < 40 && (brokenLaw || brokenPolicy || incompatible))) {
                Q.coalition_rupture_target = partner;
                Q.coalition_rupture_trigger = true;
                Q.coalition_rupture_low_relations = relations < 30;
                Q.coalition_rupture_broken_agreement = brokenLaw || brokenPolicy;
                Q.coalition_rupture_roadmap_conflict = incompatible;
                break;
            }
        }
    }
}

// 4. Achievement check
if (!Q.podemos_actually_podemos && (Q.spanish_coalition.includes("podemos") || Q.spanish_coalition.includes("up"))) {
    Q.podemos_actually_podemos = true;
}
if (Q.president_gender == "f" && Q.president != "Neus Munté") {
    Q.woman_generalitat_presidenta_ever = true;
} else if (Q.president == "Neus Munté" && !Q.woman_generalitat_presidenta_ever) {
    this.achieve("moneda_de_canvi");
}
if (Q.territory_rail2_countdown <= 0 && Q.territory_metro2_countdown <= 0) {
    this.achieve("frikitrens");
}
if (Q.parlament_climate_change_passed && Q.parlament_inheritance_tax_passed && Q.education_spending >= 2 && Q.healthcare_spending >= 2 && Q.public_salary_level >= 2) {
    this.achieve("dinamarca_del_sud");
}
if (Q.spanish_pm == "Pedro Sánchez") {
    Q.psoe_sanchez_president_ever = true;
    if (Q.psoe_barons_revolted ) {
        this.achieve('perrosanxe');
    }
}
if (Q.congreso_coalition_sorpasso && (Q.spanish_pm_party == "podemos" || Q.spanish_pm_party == "up")) {
    this.achieve('asalto_cielos');
}
if (Q.year + 1 > Q.budget_year) {
    Q.not_financially_responsible = true;
}

// 5. Hidden triggers

// Trigger governing party budget negotiations
if (has_time_passed && !Q.budget_postponed_countdown > 0 && !Q.rubicon && !Q.cat_caretaker_gov && Q.year > Q.budget_year && Q.budget_year_attempted != Q.year && Q.month > 4 && !((Q[Q.player_party + "_in_jxsi"] && Q.economy_minister_party == "jxsi") || (Q[Q.player_party + "_in_jxcat"] && Q.economy_minister_party == "jxcat") || Q.economy_minister_party == Q.player_party)) {
    var rnd = G.random(Q);
    if (rnd <= 0.2) {
        Q.budget_parlament_trigger  = true;
    }
}


if (has_time_passed && !Q.cat_caretaker_gov && !Q.rubicon && !Q.coalition_rupture_trigger &&
    !Q.parlament_snap_election && Q.budget_internal_failed_times >= 2 &&
    Q.year > Q.budget_year && Q.next_election_time - Q.time > 2 &&
    (Q.cat_coalition || []).includes(playerVehicle) && Q.president_party != playerVehicle &&
    Number.isFinite(Q[Q.president_party + "_relations"]) && Q[Q.president_party + "_relations"] < 40 &&
    G.random(Q) < 0.20) {
    Q.parlament_snap_election = 1;
    Q.snap_budget_distrust = true;
}


if (Q.broken_roadmap_expires_trigger) {
    Q.broken_roadmap_expires_trigger = false;
    Q.broken_roadmap = 0;
}

if (Q.broken_roadmap && ((Q.cat_coalition || []).includes(Q.player_party) ||
    (Q.cat_coalition || []).includes(playerVehicle))) Q.burdens_broken = true;

if (Q.territory_county_roads_trigger) {
