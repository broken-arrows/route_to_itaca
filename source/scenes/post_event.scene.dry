            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        var voterCells = [];
        for (var voterRow of voterProfile) voterCells.push({contest:"parlament",province:voterRow[0],demo:voterRow[1],amount:voterRow[2],family:voterRow[3]});
        for (var voterSide of voterSideProfile) {
            if (!voterRoutes[voterSide[2]]) continue;
            if (voterSide[0] == "congreso" && !(Q.congreso_constituencies || []).includes("catalunya")) continue;
            voterCells.push({contest:voterSide[0],province:voterSide[0] == "congreso" ? "catalunya" : null,demo:null,amount:voterSide[1],family:voterSide[2]});
        }
        for (var voterCell of voterCells) {
            var voterContest = voterCell.contest;
            var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
            var voterSignedAmount = voterCell.amount * ((.6) * (1) * (voterOrigin == "cup" ? (1) : 1));
            if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
            var voterDirection = voterSignedAmount > 0 ? 1 : -1;
            for (var voterActor of voterActors) {
                var voterRouteList = voterRoutes[voterCell.family][voterOrigin == "cup" ? 1 : 0];
                for (var voterRoute of voterRouteList) {
                    var voterPair = [];
                    for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                        var voterCandidates = [voterParty];
                        if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                        if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                        if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                        if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                        if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                        if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                        var voterCarrier = null;
                        for (var voterCandidate of voterCandidates) {
                            if (!voterLineup.includes(voterCandidate)) continue;
                            if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                            if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                        }
                        voterPair.push(voterCarrier);
                    }
                    if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                    var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                    var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                    if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                    if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                    G.cardSupportTransfer(Q,voterOptions);

                }
            }
        }
    }
}

if (!Q.hidden_right_consolidation && (Q.year == 2019 && Q.month == 10)) {
    Q.hidden_right_consolidation = true;
    // TODO: un-hardcode this? how? via condition of cs giving too much to the pp??
    G.spaSupportInject(Q, 'vox', 'all', 3.5, 'cs');
    G.spaSupportInject(Q, 'vox', 'all', 2.0, 'abstain');
    G.spaSupportInject(Q, 'pp',  'all', 8.0, 'cs');
    G.spaSupportInject(Q, 'pp',  'all', 3.0, 'abstain');
}
if (!Q.hidden_cc_surge && ((Q.year == 2019 && Q.month == 2) || (Q.social_dissent > 90))) {
    // TBD: More/different options to trigger this?
    Q.hidden_cc_surge = true;
    G.spaSupportInject(Q, 'cc', 'rest', 0.28, 'abstain');
}
if (!Q.hidden_prc_surge && ((Q.year == 2019 && Q.month == 2) || (Q.year > 2015 && (!Q.upn_in_pp || Q.spa_foro_active)))) {
    Q.hidden_prc_surge = true;
    G.spaSupportInject(Q, 'prc', 'rest', 0.22, 'abstain');
}
if ((!Q.hidden_vox_surge) && (Q.year == 2019 || (Q.year >= 2017 && Q.next_spanish_election_time - Q.time <= 6))) {
    Q.hidden_vox_surge = true;
    Q.vox_active = true;
    G.spaSupportInject(Q, 'vox', 'all', 4.0, 'pp');
    G.spaSupportInject(Q, 'vox', 'all', 0.5, 'cs');
}
if ((!Q.hidden_bng_surge) && (Q.year == 2019)) {
    Q.hidden_bng_surge = true;  
    if (!Q.iu_in_up) {
        G.spaSupportInject(Q, 'bng', 'galicia', 5.5, 'podemos');
    } else {
        G.spaSupportInject(Q, 'bng', 'galicia', 5.5, 'up');
    }
}
if ((!Q.hidden_erc_ciu_transfer) && (Q.year == 2016 && Q.month == 5)) {
    // TBD/FIXME: Make this dynamic
    Q.hidden_erc_ciu_transfer = true;
    G.spaSupportInject(Q, 'erc', 'catalunya', 2.0, 'ciu');
    G.spaSupportInject(Q, 'erc', 'catalunya', 1.0, 'abstain');
}
if ((!Q.podemos_hidden_surge) && (Q.year == 2014 && Q.month == 5)) {
    Q.podemos_hidden_surge = true;
    G.spaSupportInject(Q, 'podemos', 'all', 6.0, 'iu');
    G.spaSupportInject(Q, 'podemos', 'all', 9.0, 'abstain');
    G.spaSupportInject(Q, 'podemos', 'all', 3.0, 'psoe');
}
if (Q.amaiur_congreso_s > 0 && Q.spa_ehbildu_active && Q.year == 2015 && Q.month == 10) {
    // So that deltas dont look weird on the first election
    Q.ehbildu_congreso_s = Q.amaiur_congreso_s;
    Q.ehbildu_congreso_pv = Q.amaiur_congreso_pv;
    Q.amaiur_congreso_s = 0;
    Q.amaiur_congreso_pv = 0;
}
if (!Q.hidden_right_shift && Q.art155_ever) {
    Q.hidden_right_shift = true;
    var _pp = Q.pp_local_barcelona_support || 0;
    var _toPsc = Math.min(2.7, _pp);
    var _toCs = Math.min(0.5, Math.max(0, _pp - _toPsc));
    Q.pp_local_barcelona_support = _pp - (_toPsc + _toCs);
    Q.psc_local_barcelona_support = (Q.psc_local_barcelona_support || 0) + _toPsc;
    Q.cs_local_barcelona_support = (Q.cs_local_barcelona_support || 0) + _toCs;
    // TODO: parallel parlament / congreso unionist shift? (calibration only models Barcelona city)
}

// Silent leadership changes
if (Q.pnv_leader == "Íñigo Urkullu" && Q.year >= 2013) {
    Q.pnv_leader = "Andoni Ortuzar";
    Q.pnv_leader_gender = "m";
}
if (Q.next_election_time - Q.time > 12 && Q.year > 2016) {
    Q.ppc_leader = "Xavier García Albiol";
    Q.ppc_leader_gender = "m";
}
if (Q.ehbildu_leader == "Laura Mintegi" && Q.year >= 2015) {
    Q.ehbildu_leader == "Maddalen Iriarte"
    Q.ehbildu_leader_gender = "f";
}
if (Q.upn_leader == "Yolanda Barcina" && Q.year >= 2015 && Q.month >= 9) {
    Q.upn_leader = "Javier Esparza";
    Q.upn_leader_gender = "m";   
}
if (Q.bng_leader == "Francisco Jorquera" && Q.year >= 2015) {
    Q.bng_leader = "Ana Pontón";
    Q.bng_leader_gender = "f";
}
if (Q.ccpnc_leader == "Paulino Rivero" && Q.year >= 2015) {
    Q.ccpnc_leader = "Fernando Clavijo";
    Q.ccpnc_leader_gender = "m";
}
if (Q.fac_leader == "Paulino Rivero" && Q.year >= 2015) {
    Q.fac_leader = "Cristina Coto";
    Q.fac_leader_gender = "f";
}
if (Q.ehbildu_leader == "Maddalen Iriarte" && Q.year >= 2016 && Q.month >= 6) {
    Q.ehbildu_leader = "Arnaldo Otegi";
    Q.ehbildu_leader_gender = "m";
}
if (Q.fac_leader == "Cristina Coto" && Q.year >= 2019) {
    Q.fac_leader = "Carmen Moriyón";
    Q.fac_leader_gender = "f";
}
if (Q.mes_leader == "Biel Barceló" && Q.year >= 2019) {
    Q.mes_leader = "Miquel Ensenyat";
    Q.mes_leader_gender = "m";
}

// Reassess an earlier CUP ballot after all final-recess interludes, before
// offering either the withdrawal announcement or the final negotiation round.
if (Q.parlament_coalition_sovereignty_phase === 3 && sovereigntyTimerBefore > 0 && Q.coalition_phase_timer <= 0) {
    this._runActions(this.game.scenes['parlament_coalition_sovereignty_assembly.withdrawal'].onArrival, 'sovereignty withdrawal');
}

// Monthly updates may have made new stories or elections available.
updatePendingEvents(this);
!}
call: generalitat_setpolicy
on-departure: {!
// TODO: set historical/international events. Hardcoded ones are easier to handle as qdisplays.
if (Q.historical_event == Q.last_historical_event) {
    Q.historical_event = 0;  
} 
// Deliver warnings only when returning to the main page, where the notice is visible.
if (Q.player_party == 'erc' && !Q.has_event && !Q.has_election) {
    var warnings = [];
    if (!Q.erc_left_resign && !Q.erc_left_split_warned && Q.erc_left_dissent >= 49 && Q.erc_left_dissent < 55) {
        warnings.push(G.text("In the mean time, within ERC, the party's left wing is now loudly voicing its dissent in public media, warning once more, and maybe for one last time, the current leadership.")); Q.erc_left_split_warned = true;
    }
    if (!Q.erc_core_resign && !Q.erc_core_split_warned && Q.erc_core_dissent >= 49 && Q.erc_core_dissent < 55) {
        warnings.push(G.text("In the mean time, within ERC, the party's Republican Core is now loudly voicing its dissent in public media, warning once more, and maybe for one last time, the current leadership..")); Q.erc_core_split_warned = true;
    }
    if (!Q.erc_pragmatic_resign && !Q.erc_pragmatic_split_warned && Q.erc_pragmatic_dissent >= 49 && Q.erc_pragmatic_dissent < 55) {
        warnings.push(G.text("In the mean time, within ERC, the party's Pragmatic sector is now loudly voicing its dissent in public media, warning once more, and maybe for one last time, the current leadership.")); Q.erc_pragmatic_split_warned = true;
    }
    if (!Q.erc_civic_resign && !Q.erc_civic_split_warned && Q.erc_civic_dissent >= 49 && Q.erc_civic_dissent < 55) {
        warnings.push(G.text("In the mean time, a group of Civil society organizations is warning ERC's leadership loudly and widely, threatening to break course with the party if no course of action happens any time soon.")); Q.erc_civic_split_warned = true;
    }
    if (warnings.length) {
        if (Q.historical_event) warnings.unshift(G.getText(Q, 'historical_event'));
        G.setText(Q, 'historical_event', G.joinText(warnings, ' '));
    }
}
G.copyText(Q, "last_historical_event", "historical_event");

// TODO: Replace the temporary constitutional reform ending with a playable reform process.
// TODO: Replace the temporary agreed-referendum ending with authorization, court and voting scenes.
if (Q.constitution_reformed) {
    var supersededPromises = ["negotiated_cash", "negotiated_funding", "negotiated_funding_psoe",
        "negotiated_renfe", "negotiated_renfe_psoe", "negotiated_ports", "negotiated_ports_psoe",
        "negotiated_education", "negotiated_police", "negotiated_police_psoe", "negotiated_borders", "negotiated_borders_psoe"];
    Q.countdowns = Q.countdowns.filter(function (name) { return !supersededPromises.includes(name); });
    for (var name of supersededPromises) {
        Q[name + "_countdown"] = -1;
        Q[name + "_trigger"] = false;
    }
}
// TODO: remove game over on jxcat_formed!
!}
go-to: game_over if negotiated_reform_trigger or negotiated_referendum_trigger or (jxcat_formed and player_in_jxcat); events_choice if has_event = 1 and not negotiated_reform_trigger and not negotiated_referendum_trigger; elections_choice if has_election = 1 and not negotiated_reform_trigger and not negotiated_referendum_trigger; main if has_event = 0 and has_election = 0 and difficulty = 0 and not negotiated_reform_trigger and not negotiated_referendum_trigger; main.main_easy if has_event = 0 and has_election = 0 and difficulty < 0 and not negotiated_reform_trigger and not negotiated_referendum_trigger; main.main_hard if has_event = 0 and has_election = 0 and difficulty > 0 and not negotiated_reform_trigger and not negotiated_referendum_trigger

= [+ month : month +] [+ year +][? if rubicon:, Week [+ week +]?]

