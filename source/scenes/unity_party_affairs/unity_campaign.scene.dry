    G.cardSupportTransfer(Q, {contest:"congreso", to: (Q.player_in_jxsi ? "jxsi" : "jxcat"), from:"federal_left", amount:0.3*effectiveness*credibility, maxDonorFraction:0.5, constituencies:["catalunya"]});
