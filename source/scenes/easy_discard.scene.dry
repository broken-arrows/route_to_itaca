title: Return card to hand
view-if: difficulty <= 0 and not last_advisor_action
go-to: root
on-arrival: {!
Q.month_actions -= 1;
    // return card to hand
    var card = this.state.lastPlayedCard;
    card.image = card.cardImage;
    if (Q.difficulty == 0) {
        this.state.currentHands['main'].push(card);
    } else if (Q.difficulty > 0) {
        this.state.currentHands['main.main_hard'].push(card);
    } else if (Q.difficulty < 0) {
        this.state.currentHands['main.main_easy'].push(card);
    }
    // Restore every cooldown timer to its pre-play value. The engine snapshots
    // Q into state.lastPlayedCardQ before running the card's on-arrival; no
    // time passes between playing a card and discarding it, so the only *_timer
    // that changed is this card's own cooldown. Reverting it (whatever the card
    // named it) is what lets the returned card pass its own view-if again
    // instead of being filtered straight back out of the hand. We iterate the
    // CURRENT timers, not the snapshot's: a timer the card CREATED (its var was
    // undefined before play, so the snapshot has no such key) must be reset to
    // 0 = "available", not left at its cooldown value.
    var preplay = this.state.lastPlayedCardQ;
    if (preplay) {
        for (var k in Q) {
            if (k.slice(-6) == "_timer") {
                Q[k] = (preplay[k] !== undefined) ? preplay[k] : 0;
            }
        }
    }
    // reduce visit count
    if (this.state.visits[card.id]) {
        this.state.visits[card.id] -= 1;
    }
!}
