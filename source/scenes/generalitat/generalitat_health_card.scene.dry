title: Ministry of Health
new-page: true
view-if: generalitat_health_timer <= 0 and (health_minister_party == player_party or (player_in_jxsi and health_minister_party = "jxsi") or (player_in_jxcat and health_minister_party = "jxcat")) and not cat_caretaker_gov
on-arrival: {!
    Q.month_actions += 1;
    Q.generalitat_health_timer += 4;
    Q.healthcare_raise_pending = Q.healthcare_prepared_level != null &&
        Q.healthcare_prepared_level === Q.healthcare_spending + 1;
!}
is-card: true
card-image: img/generalitat/catsalut.jpg
face-image: img/generalitat/catsalut.jpg
frequency: 100
tags: generalitat
role: card-gov

= Ministry of Health

The Ministry of Health commands the highest budget allocation of the Generalitat. What do we want to do here?

- @universal_access1
- @universal_access2
- @reproductive_care
- @trans_care
- @healthcare_public
- @healthcare_expand
- @revert_cuts
- @healthcare_de_public
- @healthcare_cuts
- @healthcare_privatize
- @healthcare_de_privatize
- @post_event: We don't want to do anything in this ministry at the moment
- @easy_discard

@healthcare_public
title: Roll out a Public-only Healthcare system
subtitle: Such a landmark policy would ultimately need the Parlament's approval \[-2 budget if passed\]\[-1 resources\]
view-if: healthcare_spending >= 2
choose-if: healthcare_spending = 2 and social_spending_cap = 3 and not healthcare_public_introduced and government_budget >= 2 and party_resources > 0
unavailable-subtitle: [? if healthcare_spending = 3: Already approved!. ?][? if social_spending_cap < 3: The current social spending cap does not allow for this level of investment.?][? if healthcare_public_introduced: This proposal is waiting on the Parlament's approval.?][? if government_budget < 2: Not enough budget. ?][? if party_resources <= 0: Not enough resources. ?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.health_minister_party) && !Q.cat_caretaker_gov && Q.healthcare_spending == 2 && Q.social_spending_cap == 3 && !Q.healthcare_public_introduced && Q.government_budget >= 2 && Q.party_resources > 0) {
        Q.healthcare_public_introduced = true;
        Q.party_resources -= 1;
        G.registerLaw(Q, {id:"healthcare_public_proposal", title:"Public-Only Healthcare Proposal",
                    colour:"gray", icon:"img/health_icon.svg",
                    description:"Pending parliamentary approval: Wwile some private clinics still will be allowed for things like plastic surgery, healthcare coverage is to be taken almost entirely out of private hands. Public hospitals and clinics are to cover all the range of health needs.",
                    targets:{}});
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations += 2 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] -= 3 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations -= 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += 3 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations += 4 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations -= 3 * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations -= 3 * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += -3 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += -3 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += -3 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += -3 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += -3 * (coalitionPartners.includes("vox") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] -= 3 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent -= 5;
            Q.erc_core_dissent -= 1;
            Q.erc_pragmatic_dissent += 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent -= 6;
            Q.cup_poblelliure_dissent -= 2;
            Q.cup_thirdsector_dissent -= 4;
        }
    }
!}

All executive preparations have been made for public hospitals and clinics to cover all health needs, building on expanded staffing, mental health services and dental coverage. Private healthcare is to be severely restricted, with only counted exceptions. The Parlament must, however, approve of this new legal framework. [? if healthcare_public_ruling: The existing Constitutional ruling does mean that private providers must still be allowed to operate alongside the public system. ?]

@healthcare_de_public
title: Re-introduce some private-circuit Healthcare
view-if: healthcare_spending = 3
subtitle: Requires the Parlament's approval \[ +1 budget if passed\]\[-1 resources\]
choose-if: not healthcare_de_public_introduced and party_resources > 0
unavailable-subtitle: [? if healthcare_de_public_introduced: This proposal is waiting on the Parlament's approval. ?][? if party_resources <= 0: Not enough resources. ?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.health_minister_party) && !Q.cat_caretaker_gov && Q.healthcare_spending == 3 && !Q.healthcare_de_public_introduced && Q.party_resources > 0) {
        Q.healthcare_de_public_introduced = true;
        Q.party_resources -= 1;
        G.registerLaw(Q, {id:"healthcare_de_public_proposal", title:"Mixed Healthcare System Proposal",
                    colour:"gray", icon:"img/health_icon.svg",
                    description:"Pending parliamentary approval: Private hospitals and clinics would re-gain a role alongside the expanded public healthcare system.",
                    targets:{}});
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations -= 2 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += 3 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations += 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] -= 3 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations -= 4 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += 3 * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations += 3 * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 3 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 3 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 3 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 3 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += 3 * (coalitionPartners.includes("vox") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += 3 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += 5;
            Q.erc_core_dissent += 1;
            Q.erc_pragmatic_dissent -= 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += 6;
            Q.cup_poblelliure_dissent += 2;
            Q.cup_thirdsector_dissent += 4;
        }
    }
!}

We are asking the Parlament to replace the public-only healthcare framework with a mixed system. Public hospitals and clinics will retain their expanded funding and dental coverage, while private providers will have a larger role in the healthcare circuit.

@healthcare_expand
title: Expand Healthcare funding
view-if: healthcare_spending >= 0 and healthcare_spending < 2
subtitle: \[-1 budget [? if healthcare_spending >= social_spending_cap: on spending cap increase approval ?]\]
choose-if: government_budget > 0 and not healthcare_raise_pending
unavailable-subtitle: [? if government_budget <= 0: Not enough budget.?][? if healthcare_raise_pending: This increase is already awaiting budget authorization.?]
go-to: approve_raise

@healthcare_cuts
title: Cut Healthcare funding
subtitle: This goes against the party line, but money does have to come from somewhere \[ +1 budget\]
choose-if: healthcare_spending < 3 and healthcare_spending > -2
unavailable-subtitle: There's nothing left to cut...
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.health_minister_party) && !Q.cat_caretaker_gov && Q.healthcare_spending > -2 && Q.healthcare_spending < 3) {
        var previousLevel = Q.healthcare_spending;
        Q.healthcare_spending -= 1;
        Q.healthcare_prepared_level = null;
        G.deactivateLaw(Q, "healthcare_spending_proposal", undefined, true);
        Q.government_budget += 1;
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations += (previousLevel > 0 ? -2 : -1) * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations += (previousLevel > 0 ? -2 : -1) * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += (previousLevel > 0 ? -3 : -2) * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations -= 2 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 0 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 0 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("vox") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += (previousLevel > 0 ? 1 : 0) * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += previousLevel <= 0 ? 2 : previousLevel == 2 ? 4 : 3;
            Q.erc_core_dissent += 1;
            Q.erc_pragmatic_dissent += previousLevel <= 0 ? 1 : 0;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += previousLevel == 2 ? 4 : 3;
            Q.cup_poblelliure_dissent += 1;
            Q.cup_thirdsector_dissent += previousLevel == 2 ? 4 : 3;
        }
        var voterPolicies = [{demographics:(previousLevel - 1) < 0 ? {retired:0.9,ind:0.8,unemployed:0.7,young:0.3,middle:0.25} : (previousLevel - 1) == 0 ? {retired:0.7,ind:0.6,unemployed:0.55,young:0.55,middle:0.4} : {retired:0.9,ind:1,unemployed:1.1,young:0.6,middle:0.3}, provinces:{barcelona:1,girona:1.1,lleida:1.1,tarragona:1.05}, routes:(null), sign:-1, congreso:(previousLevel <= 0 ? 0.045 : previousLevel == 1 ? 0.04 : 0.05), barcelona:(previousLevel <= 0 ? 0.09 : previousLevel == 1 ? 0.08 : 0.10)}];

        // Policy voters: explicit demographic/province transfers, with ministry responsibility 80/20.
        var voterOrigin = Q.player_party;
        var voterCabinet = Array.from(new Set(Q.cat_coalition || []));
        // Allocate ministry responsibility once across unique Parlament ballot carriers.
        var voterActors = [];
        for (var voterParty of [voterOrigin].concat(voterCabinet)) {

            var voterCandidates = [voterParty];
            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        for (var voterPolicy of voterPolicies) {
            var voterCells = [];
            for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || []) {
                var voterAmount = (voterPolicy.demographics[voterDemo] || 0) * (voterPolicy.provinces[voterProvince] || 0);
                if (voterAmount) voterCells.push({contest:"parlament",province:voterProvince,demo:voterDemo,amount:voterAmount});
            }
            if (voterPolicy.congreso && (Q.congreso_constituencies || []).includes("catalunya")) voterCells.push({contest:"congreso",province:"catalunya",demo:null,amount:voterPolicy.congreso});
            if (voterPolicy.barcelona) voterCells.push({contest:"barcelona",province:null,demo:null,amount:voterPolicy.barcelona});
            for (var voterCell of voterCells) {
                var voterContest = voterCell.contest;
                var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
                var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
                var voterSignedAmount = voterCell.amount * (Math.abs(voterPolicy.sign));
                if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
                var voterDirection = voterPolicy.sign > 0 ? 1 : -1;
                for (var voterActor of voterActors) {
                    var voterRouteList = voterPolicy.routes || (voterActor.origin == "erc" ? [["cup",0.45],["fl",0.35],["abstain",0.20]] : voterActor.origin == "cup" ? [["fl",0.45],["erc",0.35],["abstain",0.20]] : voterActor.origin == "psc" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : ["ecp","cecp","csqp","icv"].includes(voterActor.origin) ? [["cup",0.40],["erc",0.30],["abstain",0.30]] : [["erc",0.40],["fl",0.35],["abstain",0.25]]);
                    for (var voterRoute of voterRouteList) {
                        var voterPair = [];
                        for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                            var voterCandidates = [voterParty];
                            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                            if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                            if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                            if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                            var voterCarrier = null;
                            for (var voterCandidate of voterCandidates) {
                                if (!voterLineup.includes(voterCandidate)) continue;
                                if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                                if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                            }
                            voterPair.push(voterCarrier);
                        }
                        if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                        var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                        var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                        if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                        if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                        G.cardSupportTransfer(Q,voterOptions);

                    }
                }
            }
        }
    }
!}
call: generalitat_setpolicy

Going against the historic party line, we've had no other choice but to cut back some spending in Healthcare. This is understandably disliked by many, let's hope this is a necessary sacrifice.

@healthcare_de_privatize
title: Re-introduce Public Healthcare in-force
subtitle: This will requires the Parlament's approval \[-2 budget if passed\]\[-1 resources\]
view-if: healthcare_spending = -3
choose-if: not healthcare_de_privatization_introduced and government_budget >= 2 and party_resources > 0
unavailable-subtitle: [? if healthcare_de_privatization_introduced: This proposal is waiting on the Parlament's approval. ?][? if government_budget < 2: Not enough budget. ?][? if party_resources <= 0: Not enough resources. ?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.health_minister_party) && !Q.cat_caretaker_gov && Q.healthcare_spending == -3 && !Q.healthcare_de_privatization_introduced && Q.government_budget >= 2 && Q.party_resources > 0) {
        Q.healthcare_de_privatization_introduced = true;
        Q.party_resources -= 1;
        G.registerLaw(Q, {id:"healthcare_de_privatization_proposal", title:"Restored Public Healthcare",
                    colour:"gray", icon:"img/health_icon.svg",
                    description:"Pending parliamentary approval: Public hospitals and clinics would reopen alongside private providers, reversing full privatization.",
                    targets:{}});
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations += 3 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += 1 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations += 2 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += 3 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations += 3 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += ((Q.cat_coalition || []).includes("cs") ? -1 : 1) * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations -= 2 * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 1 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 1 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += -2 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += -2 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += -2 * (coalitionPartners.includes("vox") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += 1 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent -= 8;
            Q.erc_core_dissent -= 3;
            Q.erc_pragmatic_dissent -= 2;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent -= 5;
            Q.cup_poblelliure_dissent -= 2;
            Q.cup_thirdsector_dissent -= 5;
        }
    }
!}

Reverting course after the disastrous policy of healthcare privatization, we are getting the Health Ministry ready to reopen public hospitals and clinics across Catalonia. The final push must come from the Parlament, as the legislative framework that dismantled the public service must be voted away.

@healthcare_privatize
title: Work towards fully privatizing Healthcare
subtitle: This is considered extremely radical by much of the Catalan population, and will ultimately require approval from the Parlament. \[ +2 budget if passed\]\[-1 resources\]
view-if: healthcare_spending <= -2
choose-if: healthcare_spending = -2 and not healthcare_privatization_introduced and player_party != "cup" and party_resources > 0
unavailable-subtitle: [? if healthcare_spending = -3: Healthcare has already been privatized! ?][? if healthcare_privatization_introduced and not healthcare_spending = -3: This proposal is waiting on the Parlament's approval. ?][? if player_party = "cup": There's no way our party can embark on this path. ?][? if party_resources <= 0: Not enough resources. ?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.health_minister_party) && !Q.cat_caretaker_gov && Q.healthcare_spending == -2 && !Q.healthcare_privatization_introduced && Q.player_party != "cup" && Q.party_resources > 0) {
        Q.healthcare_privatization_introduced = true;
        Q.party_resources -= 1;
        G.registerLaw(Q, {id:"healthcare_privatization_proposal", title:"Fully Privatized Healthcare",
                    colour:"gray", icon:"img/health_icon.svg",
                    description:"Pending parliamentary approval: Public hospitals and clinics would be privatized. Limited subsidies would remain, but most patients would have to rely on private insurance or pay for treatment themselves.",
                    targets:{}});
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations -= 4 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]) && Q.parlament_current_ciu != "pdcat")
            Q[Q.parlament_current_ciu + "_relations"] -= 1 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations -= 4 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] -= 5 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations -= 6 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += ((Q.cat_coalition || []).includes("cs") ? 1 : -1) * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations += 3 * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 0 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 0 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 3 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 3 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += 3 * (coalitionPartners.includes("vox") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] -= 1 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += 12;
            Q.erc_core_dissent += 6;
            Q.erc_pragmatic_dissent += 4;
            Q.erc_civic_dissent += 2;
        }
    }
!}

Against the wishes of big parts of the party, who accuse us of going against everything [+ player_party +] has stood for, we have put together a proposal for pushing the Catalan healthcare system as close as possible to full privatization. This will, nonetheless, require approval from the Parlament.

@revert_cuts
title: Revert Healthcare spending cuts
view-if: healthcare_spending < 0 and healthcare_spending > -3
subtitle: \[-1 budget [? if healthcare_spending >= social_spending_cap: on spending cap increase approval ?]\]
choose-if: government_budget > 0 and not healthcare_raise_pending
unavailable-subtitle: [? if government_budget <= 0: Not enough budget.?][? if healthcare_raise_pending: This increase is already awaiting budget authorization.?]
go-to: approve_raise

@approve_raise
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.health_minister_party) && !Q.cat_caretaker_gov && Q.healthcare_spending >= -2 && Q.healthcare_spending < 2 && Q.government_budget > 0 && (Q.healthcare_prepared_level == null || Q.healthcare_prepared_level !== Q.healthcare_spending + 1)) {
        var previousLevel = Q.healthcare_spending;
        Q.government_budget -= 1;
        Q.health_raise_delivered = Q.healthcare_spending + 1 <= Q.social_spending_cap;
        if (Q.health_raise_delivered) {
            Q.healthcare_spending += 1;
            if (Q.burdens_start_countdown > 0 || Q.burdens_start_trigger || Q.burdens_goal > 0 && Q.burdens_time > 0) Q.burdens_done += 1;
            Q.healthcare_prepared_level = null;
            G.deactivateLaw(Q, "healthcare_spending_proposal", undefined, true);
        } else {
            Q.healthcare_prepared_level = Q.healthcare_spending + 1;
            G.registerLaw(Q, {id:"healthcare_spending_proposal", electoral_origin:Q.player_party, electoral_cabinet:Array.from(new Set(Q.cat_coalition || [])), title:"Healthcare Spending Increase",
                colour:"gray", icon:"img/health_icon.svg",
                description:"Pending budget approval: will take effect the moment a higher spending cap authorizes it.", targets:{}});
        }
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations += (previousLevel < 0 ? 1 : 2) * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations += (previousLevel < 0 ? 1 : 2) * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += (previousLevel < 0 ? 2 : 3) * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations += 2 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 0 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 0 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("vox") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += (previousLevel < 0 ? 0 : -1) * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += previousLevel < 0 ? -2 : previousLevel == 1 ? -4 : -3;
            Q.erc_core_dissent -= 1;
            Q.erc_pragmatic_dissent += previousLevel < 0 ? -1 : 0;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += previousLevel == 1 ? -4 : -3;
            Q.cup_poblelliure_dissent -= 1;
            Q.cup_thirdsector_dissent += previousLevel == 1 ? -4 : -3;
        }
        if (Q.health_raise_delivered) {
            var voterPolicies = [{demographics:previousLevel < 0 ? {retired:0.9,ind:0.8,unemployed:0.7,young:0.3,middle:0.25} : previousLevel == 0 ? {retired:0.7,ind:0.6,unemployed:0.55,young:0.55,middle:0.4} : {retired:0.9,ind:1,unemployed:1.1,young:0.6,middle:0.3}, provinces:{barcelona:1,girona:1.1,lleida:1.1,tarragona:1.05}, routes:(Q.player_party == "cup" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : [["psc",0.45],["fl",0.30],["abstain",0.25]]), sign:1, congreso:(previousLevel < 0 ? 0.045 : previousLevel == 0 ? 0.04 : 0.05), barcelona:(previousLevel < 0 ? 0.09 : previousLevel == 0 ? 0.08 : 0.10)}];

            // Policy voters: explicit demographic/province transfers, with ministry responsibility 80/20.
            var voterOrigin = Q.player_party;
            var voterCabinet = Array.from(new Set(Q.cat_coalition || []));
            // Allocate ministry responsibility once across unique Parlament ballot carriers.
            var voterActors = [];
            for (var voterParty of [voterOrigin].concat(voterCabinet)) {

                var voterCandidates = [voterParty];
                if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
                var voterCarrier = null;
                for (var voterCandidate of voterCandidates) {
                    if (!(Q.parties || []).includes(voterCandidate)) continue;
                    for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                        if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                    if (voterCarrier) break;
                }
                if (voterParty == voterOrigin && !voterCarrier) break;
                if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
            }
            for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
                voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
            for (var voterPolicy of voterPolicies) {
                var voterCells = [];
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || []) {
                    var voterAmount = (voterPolicy.demographics[voterDemo] || 0) * (voterPolicy.provinces[voterProvince] || 0);
                    if (voterAmount) voterCells.push({contest:"parlament",province:voterProvince,demo:voterDemo,amount:voterAmount});
                }
                if (voterPolicy.congreso && (Q.congreso_constituencies || []).includes("catalunya")) voterCells.push({contest:"congreso",province:"catalunya",demo:null,amount:voterPolicy.congreso});
                if (voterPolicy.barcelona) voterCells.push({contest:"barcelona",province:null,demo:null,amount:voterPolicy.barcelona});
                for (var voterCell of voterCells) {
                    var voterContest = voterCell.contest;
                    var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
                    var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
                    var voterSignedAmount = voterCell.amount * (Math.abs(voterPolicy.sign));
                    if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
                    var voterDirection = voterPolicy.sign > 0 ? 1 : -1;
                    for (var voterActor of voterActors) {
                        var voterRouteList = voterPolicy.routes || (voterActor.origin == "erc" ? [["cup",0.45],["fl",0.35],["abstain",0.20]] : voterActor.origin == "cup" ? [["fl",0.45],["erc",0.35],["abstain",0.20]] : voterActor.origin == "psc" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : ["ecp","cecp","csqp","icv"].includes(voterActor.origin) ? [["cup",0.40],["erc",0.30],["abstain",0.30]] : [["erc",0.40],["fl",0.35],["abstain",0.25]]);
                        for (var voterRoute of voterRouteList) {
                            var voterPair = [];
                            for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                                var voterCandidates = [voterParty];
                                if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                                if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                                if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                                if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                                if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                                if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                                var voterCarrier = null;
                                for (var voterCandidate of voterCandidates) {
                                    if (!voterLineup.includes(voterCandidate)) continue;
                                    if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                                    if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                                }
                                voterPair.push(voterCarrier);
                            }
                            if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                            var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                            var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                            if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                            if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                            G.cardSupportTransfer(Q,voterOptions);

                        }
                    }
                }
            }
        }
    }
!}
call: generalitat_setpolicy

[? if health_raise_delivered and healthcare_spending <= 0: Austerity measures affecting public healthcare have been reversed, but years of spending cuts have left a mark. Significant effort remains to recover and improve the system.?][? if health_raise_delivered and healthcare_spending = 1: We've invested further in Healthcare, increasing staffing, reducing waiting times and improving and expanding mental health services.?][? if health_raise_delivered and healthcare_spending = 2: We've expanded the public system to include dental coverage, giving everyone access to care that many previously had to pay for themselves.?][? if not health_raise_delivered: While the increase has been approved, it will only take effect when a passed budget raises the social spending cap. ?]

@universal_access1
title: Remove barriers to healthcare access
view-if: healthcare_universal_level = 0
subtitle: Not only administrative, but geographic too. \[-1 budget\]
choose-if: government_budget >= 1 and healthcare_spending >= 0
unavailable-subtitle: [? if healthcare_spending < 0: Budget cuts need to be reversed first. ?][? if healthcare_spending > 1: Not enough budget.?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.health_minister_party) && !Q.cat_caretaker_gov && Q.healthcare_universal_level == 0 && Q.government_budget >= 1) {
        Q.government_budget -= 1;
        Q.healthcare_universal_level = 1;
        if (Q.burdens_start_countdown > 0 || Q.burdens_start_trigger || Q.burdens_goal > 0 && Q.burdens_time > 0) Q.burdens_done += 1;
        G.registerLaw(Q, {id:"healthcare_universal1", title:"Broader Healthcare Access", colour:"green", icon:"img/health_icon.svg",
            description:"Healthcare access has been expanded, with better rural reach and improved administrative protocols, erasing many of the previously existing barriers.",
            targets:{welfare_index_growth:0.05, generalitat_surplus:-0.01, social_dissent_eq:-1}, ramp_ticks:6});
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q["erc" + "_relations"]))
            Q["erc" + "_relations"] += 2 * 1 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q["psc" + "_relations"]))
            Q["psc" + "_relations"] += 2 * 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += 3 * 1 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q["cup" + "_relations"]))
            Q["cup" + "_relations"] += 3 * 1 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q["ppc" + "_relations"]))
            Q["ppc" + "_relations"] += -1 * 1 * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 1 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 1 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 0 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 0 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += 0 * (coalitionPartners.includes("vox") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += 0 * 1 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += -3 * 1;
            Q.erc_core_dissent += -1 * 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += -4 * 1;
            Q.cup_poblelliure_dissent += -1 * 1;
            Q.cup_thirdsector_dissent += -3 * 1;
        }
        var voterPolicies = [{demographics:{ind:0.45,young:0.35,unemployed:0.55,middle:0.15}, provinces:{barcelona:1,girona:0.8,lleida:0.8,tarragona:1}, routes:(Q.player_party == "cup" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : [["fl",0.40],["psc",0.35],["abstain",0.25]]), sign:1, congreso:(0.025), barcelona:(0.05)},{demographics:Q.player_party == "cup" ? {buss:0.04,retired:0.03} : {buss:0.10,retired:0.08}, provinces:{barcelona:1,girona:1,lleida:1,tarragona:1}, routes:(null), sign:-1, backlash:true, congreso:(0.003), barcelona:(0.006)}];

        // Policy voters: explicit demographic/province transfers, with ministry responsibility 80/20.
        var voterOrigin = Q.player_party;
        var voterCabinet = Array.from(new Set(Q.cat_coalition || []));
        // Allocate ministry responsibility once across unique Parlament ballot carriers.
        var voterActors = [];
        for (var voterParty of [voterOrigin].concat(voterCabinet)) {

            var voterCandidates = [voterParty];
            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        for (var voterPolicy of voterPolicies) {
            var voterCells = [];
            for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || []) {
                var voterAmount = (voterPolicy.demographics[voterDemo] || 0) * (voterPolicy.provinces[voterProvince] || 0);
                if (voterAmount) voterCells.push({contest:"parlament",province:voterProvince,demo:voterDemo,amount:voterAmount});
            }
            if (voterPolicy.congreso && (Q.congreso_constituencies || []).includes("catalunya")) voterCells.push({contest:"congreso",province:"catalunya",demo:null,amount:voterPolicy.congreso});
            if (voterPolicy.barcelona) voterCells.push({contest:"barcelona",province:null,demo:null,amount:voterPolicy.barcelona});
            for (var voterCell of voterCells) {
                var voterContest = voterCell.contest;
                var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
                var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
                var voterSignedAmount = voterCell.amount * (Math.abs(voterPolicy.sign));
                if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
                var voterDirection = voterPolicy.sign > 0 ? 1 : -1;
                for (var voterActor of voterActors) {
                    var voterRouteList = voterPolicy.routes || (voterPolicy.backlash ? (voterActor.origin == "cup" ? [["erc",0.60],["ciu",0.25],["abstain",0.15]] : voterActor.origin == "erc" ? [["ciu",0.60],["cs",0.25],["abstain",0.15]] : [["ciu",0.45],["cs",0.35],["abstain",0.20]]) : (voterActor.origin == "erc" ? [["cup",0.45],["fl",0.35],["abstain",0.20]] : voterActor.origin == "cup" ? [["fl",0.45],["erc",0.35],["abstain",0.20]] : voterActor.origin == "psc" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : ["ecp","cecp","csqp","icv"].includes(voterActor.origin) ? [["cup",0.40],["erc",0.30],["abstain",0.30]] : [["erc",0.40],["fl",0.35],["abstain",0.25]]));
                    for (var voterRoute of voterRouteList) {
                        var voterPair = [];
                        for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                            var voterCandidates = [voterParty];
                            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                            if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                            if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                            if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                            var voterCarrier = null;
                            for (var voterCandidate of voterCandidates) {
                                if (!voterLineup.includes(voterCandidate)) continue;
                                if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                                if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                            }
                            voterPair.push(voterCarrier);
                        }
                        if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                        var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                        var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                        if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                        if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                        G.cardSupportTransfer(Q,voterOptions);

                    }
                }
            }
        }
    }
