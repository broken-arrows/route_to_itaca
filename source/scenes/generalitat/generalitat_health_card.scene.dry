title: Ministry of Health
new-page: true
view-if: generalitat_health_timer <= 0 and (health_minister_party == player_party)
on-arrival: {!
    Q.month_actions += 1;
    Q.generalitat_health_timer += 3;
!}
is-card: true
card-image: img/health_icon.svg
face-image: img/health_icon.svg
frequency: 100
tags: generalitat
role: card-gov

= Ministry of Health

