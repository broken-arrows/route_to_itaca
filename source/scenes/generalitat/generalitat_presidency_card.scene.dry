title: Ministry of the Presidency
new-page: true
view-if: generalitat_presidency_timer <= 0 and (president_party == player_party or (player_in_jxsi and president_party == "jxsi") or (player_in_jxcat and president_party == "jxcat")) and not cat_caretaker_gov
on-arrival: {!
    Q.month_actions += 1;
    Q.generalitat_presidency_timer += 4;
!}
call: generalitat_coalition_card.prepare
is-card: true
card-image: img/cat_seal.svg
face-image: img/cat_seal.svg
frequency: 100
tags: generalitat
role: card-gov

= Ministry of the Presidency

More options are TODO!

- @call_consultation
- @generalitat_vp_card.other_ministry
- @kick_out_coalition_partners
- @generalitat_coalition_card.new_elections
- @post_event: We don't want to do anything in this ministry at the moment
- @easy_discard

@call_consultation
title: Call for a Non-binding consultation on independence
choose-if: parlament_non_binding_consultations and not consultation_happened and not consultation_pending
unavailable-subtitle: [? if not parlament_non_binding_consultations: There is no legal framework for such a thing... yet? ?][? if consultation_happened: We have already held a non-binding consultation! ?][? if consultation_pending: A non-binding consultation is already pending! ?]
on-arrival: {!
    Q.consultation_pending = true;   
!}
go-to: question_of_the_question


@kick_out_coalition_partners
title: Kick our coalition partners out of the government
view-if: coalition_expulsion_available
subtitle: We'll govern alone as a [+ coalition_expulsion_government_disp +].
go-to: generalitat_coalition_card.kick_them_out
