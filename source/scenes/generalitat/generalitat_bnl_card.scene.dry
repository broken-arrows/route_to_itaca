        var voterRoutes = {"environment":[[["fl",0.45],["cup",0.3],["abstain",0.25]],[["fl",0.45],["erc",0.3],["abstain",0.25]]],"employer_loss":[[["ciu",0.65],["cs",0.35]],[["erc",0.6],["ciu",0.4]]]};
        // Side elections have small authored percentage-point profiles.
