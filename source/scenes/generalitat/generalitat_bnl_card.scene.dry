title: Ministry of Business and Labour
view-if: generalitat_bnl_timer <= 0 and (bnl_minister_party == player_party or (player_in_jxsi and bnl_minister_party == "jxsi") or (player_in_jxcat and bnl_minister_party == "jxcat")) and not cat_caretaker_gov
on-arrival: {!
    Q.month_actions += 1;
    Q.generalitat_bnl_timer += 4;
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    Q.bnl_controls_economy = controlledParties.includes(Q.economy_minister_party);
    (function () { var labels = [G.text("Strongly restrictive"), G.text("Restrictive"), G.text("Ordinary"), G.text("Permissive"), G.text("Strongly permissive")]; var label = labels[Q.bnl_tourism_level + 2]; if (label) G.setText(Q, "bnl_tourism_name", label); else Q.bnl_tourism_name = undefined; })();
!}
new-page: true
card-image: img/generalitat/treball.jpg
face-image: img/generalitat/treball.jpg
frequency: 100
tags: generalitat
role: card-gov

= Ministry of Business and Labour

Business and Labour Departments handles Generalitat-administered help and guidance to business, financing and promotion, worker protection and negotiations, and many more.

- @icf1
- @icf_guarantees
- @icf_cooperative
- @inspection1
- @inspection2
- @tourism_less
- @tourism_more
- @unions_sovereignty
- @unions_established
- @post_event: We don't want to do anything in this ministry at the moment
- @easy_discard

@icf1
title: Expand public-supported lending to the self-employed and small business
view-if: bnl_icf_level == 0
subtitle: This will require more support for the ICF. \[-1 budget\]
choose-if: government_budget >= 1
unavailable-subtitle: Not enough budget.
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.bnl_minister_party) && !Q.cat_caretaker_gov && Q.government_budget >= 1 && Q.bnl_icf_level == 0) {
        Q.government_budget -= 1;
        Q.bnl_icf_level = 1;
        if (Q.burdens_start_countdown > 0 || Q.burdens_start_trigger || Q.burdens_goal > 0 && Q.burdens_time > 0) Q.burdens_done += 1;

        var voterOrigin = Q.player_party;
        var voterCabinet = [Q.player_party].concat(Q.cat_coalition || []);
        var voterProfile = [["barcelona","buss",0.55,"sme"],["barcelona","middle",0.15,"sme"],["girona","buss",0.55,"sme"],["girona","middle",0.15,"sme"],["lleida","buss",0.55,"sme"],["lleida","middle",0.15,"sme"],["tarragona","buss",0.55,"sme"],["tarragona","middle",0.15,"sme"]];
        var voterRoutes = {"sme":[[["ciu",0.5],["psc",0.3],["cs",0.2]],[["erc",0.45],["fl",0.35],["abstain",0.2]]]};
        // Side elections have small authored percentage-point profiles.
        var voterSideProfile = [["congreso",0.012,"sme"],["barcelona",0.025,"sme"]];
        // Allocate ministry responsibility once across unique Parlament ballot carriers.
        var voterActors = [];
        for (var voterParty of [voterOrigin].concat(voterCabinet)) {

            var voterCandidates = [voterParty];
            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        var voterCells = [];
        for (var voterRow of voterProfile) voterCells.push({contest:"parlament",province:voterRow[0],demo:voterRow[1],amount:voterRow[2],family:voterRow[3]});
        for (var voterSide of voterSideProfile) {
            if (!voterRoutes[voterSide[2]]) continue;
            if (voterSide[0] == "congreso" && !(Q.congreso_constituencies || []).includes("catalunya")) continue;
            voterCells.push({contest:voterSide[0],province:voterSide[0] == "congreso" ? "catalunya" : null,demo:null,amount:voterSide[1],family:voterSide[2]});
        }
        for (var voterCell of voterCells) {
            var voterContest = voterCell.contest;
            var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
            var voterSignedAmount = voterCell.amount * ((1) * (1) * (voterOrigin == "cup" ? (.7) : 1));
            if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
            var voterDirection = voterSignedAmount > 0 ? 1 : -1;
            for (var voterActor of voterActors) {
                var voterRouteList = voterRoutes[voterCell.family][voterOrigin == "cup" ? 1 : 0];
                for (var voterRoute of voterRouteList) {
                    var voterPair = [];
                    for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                        var voterCandidates = [voterParty];
                        if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                        if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                        if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                        if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                        if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                        if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                        var voterCarrier = null;
                        for (var voterCandidate of voterCandidates) {
                            if (!voterLineup.includes(voterCandidate)) continue;
                            if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                            if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                        }
                        voterPair.push(voterCarrier);
                    }
                    if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                    var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                    var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                    if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                    if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                    G.cardSupportTransfer(Q,voterOptions);

                }
            }
        }
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q["erc" + "_relations"]))
            Q["erc" + "_relations"] += 1 * 1 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += 2 * 1 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q["psc" + "_relations"]))
            Q["psc" + "_relations"] += 1 * 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += 1 * 1 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q["ppc" + "_relations"]))
            Q["ppc" + "_relations"] += 1 * 1 * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q["cs" + "_relations"]))
            Q["cs" + "_relations"] += 1 * 1 * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 2 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 2 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 1 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 1 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += 1 * (coalitionPartners.includes("vox") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += 2 * 1 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += -1 * 1;
            Q.erc_pragmatic_dissent += -2 * 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_thirdsector_dissent += -1 * 1;
        }
    }
!}
call: generalitat_setpolicy

The ICF is now set to offer improved access to credit for the self-employed and small business. We'll have to give it time for this policy to be judged in its merits or failures...

- @post_event

@icf_guarantees
title: Further expand public debt guarantees
view-if: bnl_icf_level == 1 and not bnl_icf_prepared_branch
subtitle: [? if player_party == "cup": Our party opposes this.?] This will require an approved budget to back it. \[-1 budget\]
choose-if: government_budget >= 1 and bnl_controls_economy
unavailable-subtitle: [? if government_budget < 1: Not enough budget.?][? if not bnl_controls_economy: We also need control of the Economy Ministry.?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.bnl_minister_party) && !Q.cat_caretaker_gov && Q.government_budget >= 1 && Q.bnl_icf_level == 1 && !Q.bnl_icf_prepared_branch && controlledParties.includes(Q.economy_minister_party)) {
        Q.government_budget -= 1;
        Q.bnl_icf_prepared_branch = "guarantees";
        G.registerLaw(Q, {id:"bnl_icf_proposal", title:"Further Expansion of ICF public guarantees", colour:"gray", icon:"img/economy_icon.svg",
            description:"Pending budget approval: a broader public guarantee programme is set to help businesses of all sizes obtain investment finance.", targets:{}});
        // Keep ownership with the initiating ministry through funding and completion.
        var voterSnapshot = Q.active_mods["bnl_icf_proposal"].def;
        voterSnapshot.electoral_origin = Q.player_party;
        voterSnapshot.electoral_cabinet = Array.from(new Set([Q.player_party].concat(Q.cat_coalition || [])));
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q["erc" + "_relations"]))
            Q["erc" + "_relations"] += 1 * 1 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += 3 * 1 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q["psc" + "_relations"]))
            Q["psc" + "_relations"] += 1 * 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q["cup" + "_relations"]))
            Q["cup" + "_relations"] += -1 * 1 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q["ppc" + "_relations"]))
            Q["ppc" + "_relations"] += 2 * 1 * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q["cs" + "_relations"]))
            Q["cs" + "_relations"] += 2 * 1 * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 3 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 3 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 2 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 2 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += 2 * (coalitionPartners.includes("vox") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += 3 * 1 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_pragmatic_dissent += -2 * 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += 2 * 1;
            Q.cup_poblelliure_dissent += 1 * 1;
        }
    }
!}

A broader public guarantee programme is set to help businesses of all sizes obtain investment finance, but it will only be possible if the approved budget finances it.

- @post_event

@icf_cooperative
title: Create a public lending line for cooperative and social-economy projects
view-if: bnl_icf_level == 1 and not bnl_icf_prepared_branch
subtitle: This will require an approved budget to back it. \[-1 budget\]
choose-if: government_budget >= 1 and bnl_controls_economy
unavailable-subtitle: [? if government_budget < 1: Not enough budget.?][? if not bnl_controls_economy: We also need control of the Economy Ministry.?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.bnl_minister_party) && !Q.cat_caretaker_gov && Q.government_budget >= 1 && Q.bnl_icf_level == 1 && !Q.bnl_icf_prepared_branch && controlledParties.includes(Q.economy_minister_party)) {
        Q.government_budget -= 1;
        Q.bnl_icf_prepared_branch = "cooperative";
        G.registerLaw(Q, {id:"bnl_icf_proposal", title:"Cooperative and social-economy lending", colour:"gray", icon:"img/economy_icon.svg",
            description:"Pending budget approval: am ICF-backed dedicated lending programme is set to support cooperatives and social-economy projects.", targets:{}});
        // Keep ownership with the initiating ministry through funding and completion.
        var voterSnapshot = Q.active_mods["bnl_icf_proposal"].def;
        voterSnapshot.electoral_origin = Q.player_party;
        voterSnapshot.electoral_cabinet = Array.from(new Set([Q.player_party].concat(Q.cat_coalition || [])));
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q["erc" + "_relations"]))
            Q["erc" + "_relations"] += 2 * 1 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += -1 * 1 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q["psc" + "_relations"]))
            Q["psc" + "_relations"] += 1 * 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += 3 * 1 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q["cup" + "_relations"]))
            Q["cup" + "_relations"] += 3 * 1 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q["ppc" + "_relations"]))
            Q["ppc" + "_relations"] += -1 * 1 * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q["cs" + "_relations"]))
            Q["cs" + "_relations"] += -1 * 1 * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += -1 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += -1 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += -1 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += -1 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += -1 * (coalitionPartners.includes("vox") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += -1 * 1 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += -3 * 1;
            Q.erc_core_dissent += -1 * 1;
            Q.erc_pragmatic_dissent += -1 * 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += -6 * 1;
            Q.cup_poblelliure_dissent += -3 * 1;
            Q.cup_thirdsector_dissent += -5 * 1;
        }
    }
!}

A ICF-backed dedicated lending programme is set to support cooperatives and social-economy projects, but it will only be possible if the approved budget finances it.

- @post_event

@inspection1
title: Strengthen labour inspection
view-if: bnl_inspection_level == 0
subtitle: \[-1 budget\]
choose-if: government_budget >= 1
unavailable-subtitle: Not enough budget.
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.bnl_minister_party) && !Q.cat_caretaker_gov && Q.government_budget >= 1 && Q.bnl_inspection_level == 0) {
        Q.government_budget -= 1;
        Q.bnl_inspection_level = 1;
        if (Q.burdens_start_countdown > 0 || Q.burdens_start_trigger || Q.burdens_goal > 0 && Q.burdens_time > 0) Q.burdens_done += 1;

        var voterOrigin = Q.player_party;
        var voterCabinet = [Q.player_party].concat(Q.cat_coalition || []);
        var voterProfile = [["barcelona","ind",0.6,"labour"],["barcelona","young",0.4,"labour"],["barcelona","unemployed",0.25,"labour"],["girona","ind",0.54,"labour"],["girona","young",0.36000000000000004,"labour"],["girona","unemployed",0.225,"labour"],["lleida","ind",0.42,"labour"],["lleida","young",0.27999999999999997,"labour"],["lleida","unemployed",0.175,"labour"],["tarragona","ind",0.6,"labour"],["tarragona","young",0.4,"labour"],["tarragona","unemployed",0.25,"labour"],["barcelona","buss",-0.12,"employer_loss"],["girona","buss",-0.108,"employer_loss"],["lleida","buss",-0.08399999999999999,"employer_loss"],["tarragona","buss",-0.12,"employer_loss"]];
        var voterRoutes = {"labour":[[["fl",0.4],["psc",0.35],["abstain",0.25]],[["fl",0.45],["erc",0.3],["abstain",0.25]]],"employer_loss":[[["ciu",0.65],["cs",0.35]],[["erc",0.6],["ciu",0.4]]]};
        // Side elections have small authored percentage-point profiles.
        var voterSideProfile = [["congreso",0.025,"labour"],["barcelona",0.05,"labour"],["congreso",-0.003,"employer_loss"],["barcelona",-0.006,"employer_loss"]];
        // Allocate ministry responsibility once across unique Parlament ballot carriers.
        var voterActors = [];
        for (var voterParty of [voterOrigin].concat(voterCabinet)) {

            var voterCandidates = [voterParty];
            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        var voterCells = [];
        for (var voterRow of voterProfile) voterCells.push({contest:"parlament",province:voterRow[0],demo:voterRow[1],amount:voterRow[2],family:voterRow[3]});
        for (var voterSide of voterSideProfile) {
            if (!voterRoutes[voterSide[2]]) continue;
            if (voterSide[0] == "congreso" && !(Q.congreso_constituencies || []).includes("catalunya")) continue;
            voterCells.push({contest:voterSide[0],province:voterSide[0] == "congreso" ? "catalunya" : null,demo:null,amount:voterSide[1],family:voterSide[2]});
        }
        for (var voterCell of voterCells) {
            var voterContest = voterCell.contest;
            var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
            var voterSignedAmount = voterCell.amount * ((1) * (1) * (voterOrigin == "cup" ? (1) : 1));
            if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
            var voterDirection = voterSignedAmount > 0 ? 1 : -1;
            for (var voterActor of voterActors) {
                var voterRouteList = voterRoutes[voterCell.family][voterOrigin == "cup" ? 1 : 0];
                for (var voterRoute of voterRouteList) {
                    var voterPair = [];
                    for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                        var voterCandidates = [voterParty];
                        if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                        if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                        if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                        if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                        if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                        if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                        var voterCarrier = null;
                        for (var voterCandidate of voterCandidates) {
                            if (!voterLineup.includes(voterCandidate)) continue;
                            if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                            if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                        }
                        voterPair.push(voterCarrier);
                    }
                    if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                    var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                    var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                    if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                    if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                    G.cardSupportTransfer(Q,voterOptions);

                }
            }
        }
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q["erc" + "_relations"]))
            Q["erc" + "_relations"] += 1 * 1 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q["psc" + "_relations"]))
            Q["psc" + "_relations"] += 2 * 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += 2 * 1 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q["cup" + "_relations"]))
            Q["cup" + "_relations"] += 2 * 1 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 0 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 0 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 0 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 0 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += 0 * (coalitionPartners.includes("vox") ? 2 : 1);
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += -2 * 1;
            Q.erc_core_dissent += -1 * 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += -4 * 1;
            Q.cup_poblelliure_dissent += -2 * 1;
            Q.cup_thirdsector_dissent += -3 * 1;
        }
    }
!}
