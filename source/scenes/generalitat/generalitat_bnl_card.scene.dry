            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        var voterCells = [];
        for (var voterRow of voterProfile) voterCells.push({contest:"parlament",province:voterRow[0],demo:voterRow[1],amount:voterRow[2],family:voterRow[3]});
        for (var voterSide of voterSideProfile) {
            if (!voterRoutes[voterSide[2]]) continue;
            if (voterSide[0] == "congreso" && !(Q.congreso_constituencies || []).includes("catalunya")) continue;
            voterCells.push({contest:voterSide[0],province:voterSide[0] == "congreso" ? "catalunya" : null,demo:null,amount:voterSide[1],family:voterSide[2]});
        }
        for (var voterCell of voterCells) {
            var voterContest = voterCell.contest;
            var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
            var voterSignedAmount = voterCell.amount * ((1) * (Q.bnl_union_level) * (voterOrigin == "cup" ? (1) : 1));
            if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
            var voterDirection = voterSignedAmount > 0 ? 1 : -1;
            for (var voterActor of voterActors) {
                var voterRouteList = voterRoutes[voterCell.family == "unions" && Q.bnl_union_level < 0 ? "established" : voterCell.family][voterOrigin == "cup" ? 1 : 0];
                for (var voterRoute of voterRouteList) {
                    var voterPair = [];
                    for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                        var voterCandidates = [voterParty];
                        if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                        if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                        if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                        if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                        if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                        if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                        var voterCarrier = null;
                        for (var voterCandidate of voterCandidates) {
                            if (!voterLineup.includes(voterCandidate)) continue;
                            if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                            if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                        }
                        voterPair.push(voterCarrier);
                    }
                    if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                    var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                    var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                    if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                    if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                    var voterActual = G.cardSupportTransfer(Q,voterOptions);
                    voterActualRoutes.push({contest:voterContest,province:voterCell.province,group:voterCell.demo,from:voterDirection > 0 ? voterRoute[0] : voterActor.origin,to:voterDirection > 0 ? voterActor.origin : voterRoute[0],amount:voterActual});
                }
            }
        }
        Q.bnl_union_electoral_routes = voterActualRoutes;
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q["erc" + "_relations"]))
            Q["erc" + "_relations"] += 2 * -1 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += 1 * -1 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q["psc" + "_relations"]))
            Q["psc" + "_relations"] += -3 * -1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += -2 * -1 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q["cup" + "_relations"]))
            Q["cup" + "_relations"] += 2 * -1 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q["ppc" + "_relations"]))
            Q["ppc" + "_relations"] += -2 * -1 * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q["cs" + "_relations"]))
            Q["cs" + "_relations"] += -2 * -1 * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += -1 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 2 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += -1 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 2 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += 3 * (coalitionPartners.includes("vox") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += 1 * -1 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += -1 * -1;
            Q.erc_core_dissent += -2 * -1;
            Q.erc_pragmatic_dissent += 1 * -1;
            Q.erc_civic_dissent += -2 * -1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += -3 * -1;
            Q.cup_poblelliure_dissent += -4 * -1;
            Q.cup_thirdsector_dissent += -2 * -1;
        }
    }
!}
call: generalitat_setpolicy

The Ministry of Business and Labour will now give established unions, like CCOO and UGT, greater priority in social dialogue. We'll have to see if this increased collaboration pays off in the future.

- @post_event
