call: generalitat_setpolicy

Tourist-accommodation requirements and enforcement have been relaxed. Let's see if the economic benefits of this make it really worth it...

- @post_event

@unions_sovereignty
title: Give pro-sovereignty unions greater support
subtitle: These often struggle against the historically more-established federal ones like CCOO or UGT. \[-1 resources\]
choose-if: party_resources >= 1 and bnl_union_level < 2
unavailable-subtitle: [? if party_resources < 1: Not enough resources.?] [? if party_resources >= 1: We have already supported these unions as much as we possibly can. ?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.bnl_minister_party) && !Q.cat_caretaker_gov && Q.party_resources >= 1 && Number.isInteger(Q.bnl_union_level) && Q.bnl_union_level >= -2 && Q.bnl_union_level <= 2 && Q.bnl_union_level < 2) {
        Q.party_resources -= 1;
        Q.bnl_union_level += 1;
        // Undo the realized current package before applying the new package. This prevents
        // asymmetric saturation from rewarding policy cycling; only current-package state is saved.
        for (var voterOldRoute of (Q.bnl_union_electoral_routes || []).slice().reverse()) {
            var voterContest = voterOldRoute.contest, voterProvince = voterOldRoute.province;
            var voterGroup = voterOldRoute.group;
            var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) :
                voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterProvince + "_" + voterGroup + "_support" :
                voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
            var voterPair = [];
            for (var voterParty of [voterOldRoute.to, voterOldRoute.from]) {
                var voterCandidates = voterParty == "abstain" ? ["abstain"] :
                    voterParty == "erc" || voterParty == "cup" ?
                        [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty] :
                    voterParty == "ciu" ? [voterContest == "parlament" ? Q.parlament_current_ciu : "", "jxsi", "jxcat", "junts", "pdcat", "dl", "cdc", "ciu"] :
                    voterParty == "fl" ? (voterContest == "congreso" ? ["sumar", "mpais", "up", "podemos", "iu"] :
                        voterContest == "barcelona" ? ["bcomu", "icv"] : ["ecp", "cecp", "csqp", "icv"]) :
                    voterContest == "congreso" && voterParty == "psc" ? ["psc", "psoe"] :
                    voterContest != "parlament" && voterParty == "ppc" ? ["pp"] : [voterParty];
                var voterCarrier = null;
                for (var voterCandidate of voterCandidates) {
                    if (!voterLineup.includes(voterCandidate)) continue;
                    if ((voterCandidate == "jxsi" || voterCandidate == "jxcat") && voterContest == "congreso" && !Q[voterCandidate + "_in_congreso"]) continue;
                    if ((voterCandidate == "jxsi" || voterCandidate == "jxcat") && voterContest == "barcelona" && !Q[voterCandidate + "_in_local"]) continue;
                    var voterCandidateKey = voterCandidate + voterSuffix;
                    if (Number.isFinite(Q[voterCandidateKey]) && (Q[voterCandidateKey] > 0 || voterCandidate == "abstain")) {
                        voterCarrier = voterCandidate;
                        break;
                    }
                }
                voterPair.push(voterCarrier);
            }
            if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
            var voterFromKey = voterPair[0] + voterSuffix, voterToKey = voterPair[1] + voterSuffix;
            var voterUndo = Math.min(voterOldRoute.amount, Q[voterFromKey] * 0.5);
            if (!(voterUndo > 0) || !Number.isFinite(voterUndo)) continue;
            Q[voterFromKey] -= voterUndo;
            Q[voterToKey] += voterUndo;
