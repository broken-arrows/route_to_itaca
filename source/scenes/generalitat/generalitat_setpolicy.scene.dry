title: helper set policies scene
on-arrival: {!
    var taxPolicies = {
        "-2": {id: "regional_taxes_very_low", title: "Very Low Autonomic Taxes",
            description: "Taxes and regional tax components the Generalitat can adjust are at their lowest possible levels.",
            targets: {generalitat_surplus: -0.04, gdp_growth: 0.06, social_dissent_eq: -3}},
        "-1": {id: "regional_taxes_low", title: "Low Autonomic Taxes",
            description: "Taxes and regional tax components the Generalitat can adjust have been adjusted downwards and sit now at significantly reduced levels.",
            targets: {generalitat_surplus: -0.02, gdp_growth: 0.04, social_dissent_eq: -2}},
        "0": {id: "regional_taxes_moderate", title: "Moderate Autonomic Taxes",
            description: "Taxes and regional tax components the Generalitat can adjust sit at comparatively standard levels.",
            targets: {generalitat_surplus: 0, gdp_growth: 0.02, social_dissent_eq: -1}},
        "1": {id: "regional_taxes_high", title: "High Autonomic Taxes",
            description: "Taxes and regional tax components the Generalitat can adjust have been risen as part as the " + Q.year + " fiscal measures plan.",
            targets: {generalitat_surplus: 0.02}},
        "2": {id: "regional_taxes_very_high", title: "Very High Autonomic Taxes",
            description: "Taxes and regional tax components the Generalitat can adjust sit at an all-time high.",
            targets: {generalitat_surplus: 0.04, gdp_growth: -0.02, social_dissent_eq: 1}}
    };
    var taxPolicy = typeof Q.tax_policy_level == "number" && taxPolicies[Q.tax_policy_level];
    if (taxPolicy) {
        Object.keys(taxPolicies).forEach(function (level) {
            var id = taxPolicies[level].id;
            if (id != taxPolicy.id) G.deactivateLaw(Q, id, undefined, true);
        });
        if (!Q.active_mods || !Q.active_mods[taxPolicy.id] || !Q.active_mods[taxPolicy.id].active) {
            G.registerLaw(Q, {id: taxPolicy.id, title: taxPolicy.title,
                description: taxPolicy.description, colour: "orange", icon: "img/economy_icon.svg",
                targets: taxPolicy.targets});
        }
    }

    switch (Q.education_spending) {
        case 3:
            if (!Q.education_public) {
                if (Q.education_public_ruling) {
                    G.registerLaw(Q, {id:"education_public", title:"Public-Preferential Education",
                    colour:"green", icon:"img/education_icon.svg",
                    description: "In an attempt to achieve most of the original public-only education law intent, public schools and universities cover all education needs for all residents, and efforts have been made to make those top-tier institutions. Nonetheless, some private institutions still exists for those seeking alternatives to the official circuit.",
                    targets:{welfare_index_growth: 0.45, social_dissent_eq: -0.6, generalitat_surplus: -0.1 }});
                } else {
                    G.registerLaw(Q, {id:"education_public", title:"Public-Only Education",
                    colour:"green", icon:"img/education_icon.svg",
                    description: "In a landmark law in the Parlament, private education has effectively been banned in Catalonia. Public schools and universities cover all education needs for all residents, and efforts have been made to make those top-tier institutions.",
                    targets:{welfare_index_growth: 0.5, social_dissent_eq: -0.7, generalitat_surplus: -0.1 }});
                }
                Q.education_public = true;
            }
        case 2:
            if (!Q.education_modernization) {
                Q.education_modernization = true;
                G.registerLaw(Q, {id:"education_modernization", title:"Modernized Education",
                colour:"green", icon:"img/education_icon.svg",
                description: "The public education system has received a modernization revamp, bringing dedicated caretakers for infants with diverse needs, digitalization aids for schools, and targeted training for educators facing the challenges of this century.",
                targets:{welfare_index_growth: 0.2, social_dissent_eq: -0.5, generalitat_surplus: -0.05 }});
            }
        case 1:
            if (!Q.education_expansion) {
                Q.education_expansion = true;
                G.registerLaw(Q, {id:"education_expansion", title:"Expanded Education Funding",
                colour:"green", icon:"img/education_icon.svg",
                description: "With extraordinary funding rounds and provisions, teacher-to-infant ratios have been reduced and school buildings have been refurbished.",
                targets:{welfare_index_growth: 0.15, social_dissent_eq: -0.5, generalitat_surplus: -0.03 }});
            }
            if (Q.education_spending < 3 && Q.education_public) {
                G.deactivateLaw(Q, "education_public", undefined, true);
                Q.education_public = false;
            }
            if (Q.education_spending < 2 && Q.education_modernization) {
                G.deactivateLaw(Q, "education_modernization", undefined, true);
                Q.education_modernization = false;
            }
            if (Q.education_ppp) {
                G.deactivateLaw(Q, "education_ppp", undefined, true);
                Q.education_ppp = false;
            }
            if (Q.education_cuts) {
                G.deactivateLaw(Q, "education_cuts", undefined, true);
                Q.education_cuts = false;
            }
            if(Q.education_privatized) {
                G.deactivateLaw(Q, "education_privatized", undefined, true);
                Q.education_privatized = false;
            }
            break;
        case 0:
            if (Q.education_public) {
                G.deactivateLaw(Q, "education_public", undefined, true);
                Q.education_public = false;
            }
            if (Q.education_modernization) {
                G.deactivateLaw(Q, "education_modernization", undefined, true);
                Q.education_modernization = false;
            }
            if (Q.education_expansion) {
                G.deactivateLaw(Q, "education_expansion", undefined, true);
                Q.education_expansion = false;
            }
            if (Q.education_ppp) {
                G.deactivateLaw(Q, "education_ppp", undefined, true);
                Q.education_ppp = false;
            }
            if (Q.education_cuts) {
                G.deactivateLaw(Q, "education_cuts", undefined, true);
                Q.education_cuts = false;
            }
            if(Q.education_privatized) {
                G.deactivateLaw(Q, "education_privatized", undefined, true);
                Q.education_privatized = false;
            }
            break;
        case -3:
            if(!Q.education_privatized) {
                if (Q.education_privatized_ruling) {
                    G.registerLaw(Q, {id:"education_privatized", title:"Private & Charter Education System",
                    colour:"red", icon:"img/education_icon.svg",
                    description: "The public education system is effectively a thing of the past. While some public schools exist to comply with the existing Spanish legal code, charter agreements remain the cornerstone of the education circuit, with purely-private schools gaining terrain each year.",
                    targets:{welfare_index_growth:-0.8, social_dissent_eq:5, generalitat_surplus: 0.4, gdp_growth: 0.1 }});
                } else {
                    G.registerLaw(Q, {id:"education_privatized", title:"De-facto Privatized Education System",
                    colour:"red", icon:"img/education_icon.svg",
                    description: "The public education system is effectively a thing of the past. While some guarantees for universal education access still exist via charter schools and education grants, the fact is that the most families and individuals have to bear the weight of schooling.",
                    targets:{welfare_index_growth:-0.9, social_dissent_eq:5, generalitat_surplus: 0.5, gdp_growth: 0.1 }});
                }
                Q.education_privatized = true;
            }
            if (Q.education_ppp) {
                G.deactivateLaw(Q, "education_ppp", undefined, true);
                Q.education_ppp = false;
            }
            if (Q.education_cuts) {
                G.deactivateLaw(Q, "education_cuts", undefined, true);
                Q.education_cuts = false;
            }
            if (Q.education_public) {
                G.deactivateLaw(Q, "education_public", undefined, true);
                Q.education_public = false;
            }
            if (Q.education_modernization) {
                G.deactivateLaw(Q, "education_modernization", undefined, true);
                Q.education_modernization = false;
            }
            if (Q.education_expansion) {
                G.deactivateLaw(Q, "education_expansion", undefined, true);
                Q.education_expansion = false;
            }
            break;
        case -2:
            if(!Q.education_ppp) {
                G.registerLaw(Q, {id:"education_ppp", title:"Extended Charter Education System",
                colour:"red", icon:"img/education_icon.svg",
                description: "Public spending in education has been reduced to record lows. Now, the system relies more than ever on charter schools and private family spending.",
                targets:{welfare_index_growth:-0.2, social_dissent_eq:2, generalitat_surplus: 0.05, gdp_growth: 0.05 }});
                Q.education_ppp = true;
            }
        case -1:
            if (!Q.education_cuts) {
                G.registerLaw(Q, {id:"education_cuts", title:"Education Spending Cut",
                colour:"red", icon:"img/education_icon.svg",
                description: "Education spending has been cut, lowering the number of teachers hired and the resources received by schools in the public system.",
                // Alongside Health and public pay, preserves inherited opening austerity.
                targets:{welfare_index_growth:-0.02, social_dissent_eq:0.5, generalitat_surplus: 0.01 }});
                Q.education_cuts = true;
            }
            if(Q.education_privatized) {
                G.deactivateLaw(Q, "education_privatized", undefined, true);
                Q.education_privatized = false;
            }
            if (Q.education_spending == -1 && Q.education_ppp) {
                G.deactivateLaw(Q, "education_ppp", undefined, true);
                Q.education_ppp = false;
            }
            if (Q.education_public) {
                G.deactivateLaw(Q, "education_public", undefined, true);
                Q.education_public = false;
            }
            if (Q.education_modernization) {
                G.deactivateLaw(Q, "education_modernization", undefined, true);
                Q.education_modernization = false;
            }
            if (Q.education_expansion) {
                G.deactivateLaw(Q, "education_expansion", undefined, true);
                Q.education_expansion = false;
            }
            break;

    }
    switch (Q.healthcare_spending) {
        case 3:
            if (!Q.healthcare_public) {
                if (Q.healthcare_public_ruling) {
                    G.registerLaw(Q, {id:"healthcare_public", title:"Public-Preferential Healthcare",
                    colour:"green", icon:"img/health_icon.svg",
                    description: "In trying to preserve as much as the original law's intent, public hospitals and clinics cover all the range of health needs. Nonetheless, some minor private clinics and hospitals do still exist for those seeking alternatives to the public system.",
                    targets:{welfare_index_growth: 0.2, social_dissent_eq: -4, generalitat_surplus: -0.06 }});
                } else {
                    G.registerLaw(Q, {id:"healthcare_public", title:"Public-Only Healthcare",
                    colour:"green", icon:"img/health_icon.svg",
                    description: "While some private clinics still exist for things like plastic surgery, healthcare coverage has been taken almost entirely out of private hands. Public hospitals and clinics cover all the range of health needs.",
                    targets:{welfare_index_growth: 0.25, social_dissent_eq: -5, generalitat_surplus: -0.07 }});
                }
                Q.healthcare_public = true;
            }
        case 2:
            if (!Q.healthcare_dental) {
                Q.healthcare_dental = true;
                G.registerLaw(Q, {id:"healthcare_dental", title:"Dental Coverage",
                colour:"green", icon:"img/health_icon.svg",
                description: "The Public Healthcare system has been expanded to include dental coverage. To make that happen, some private dentists have been converted into public services, while new clinics have been built specially for this purpose, guaranteeing everyone equal access to dental health.",
                targets:{welfare_index_growth: 0.15, social_dissent_eq: -2, generalitat_surplus: -0.04 }});
            }
        case 1:
            if (!Q.healthcare_expansion) {
                Q.healthcare_expansion = true;
                G.registerLaw(Q, {id:"healthcare_expansion", title:"Expanded Healthcare Funding",
                colour:"green", icon:"img/health_icon.svg",
                description: "Extra funding has been allocated to expand the numbers of doctors and nurses, and to provide more and better health services through the public system, now including dedicated and better equipped mental health spaces.",
                targets:{welfare_index_growth: 0.2, social_dissent_eq: -3, generalitat_surplus: -0.03, unemployment_recovery: 0.02 }});
            }
            if (Q.healthcare_spending < 3 && Q.healthcare_public) {
                G.deactivateLaw(Q, "healthcare_public", undefined, true);
                Q.healthcare_public = false;
            }
            if (Q.healthcare_spending < 2 && Q.healthcare_dental) {
                G.deactivateLaw(Q, "healthcare_dental", undefined, true);
                Q.healthcare_dental = false;
            }
            if (Q.healthcare_copaid) {
                G.deactivateLaw(Q, "healthcare_copaid", undefined, true);
                Q.healthcare_copaid = false;
            }
            if (Q.healthcare_cuts) {
                G.deactivateLaw(Q, "healthcare_cuts", undefined, true);
                Q.healthcare_cuts = false;
            }
            if(Q.healthcare_privatized) {
                G.deactivateLaw(Q, "healthcare_privatized", undefined, true);
                Q.healthcare_privatized = false;
            }
            break;
        case 0:
            if (Q.healthcare_public) {
                G.deactivateLaw(Q, "healthcare_public", undefined, true);
                Q.healthcare_public = false;
            }
            if (Q.healthcare_dental) {
                G.deactivateLaw(Q, "healthcare_dental", undefined, true);
                Q.healthcare_dental = false;
            }
            if (Q.healthcare_expansion) {
                G.deactivateLaw(Q, "healthcare_expansion", undefined, true);
                Q.healthcare_expansion = false;
            }
            if (Q.healthcare_copaid) {
                G.deactivateLaw(Q, "healthcare_copaid", undefined, true);
                Q.healthcare_copaid = false;
            }
            if (Q.healthcare_cuts) {
                G.deactivateLaw(Q, "healthcare_cuts", undefined, true);
                Q.healthcare_cuts = false;
            }
            if(Q.healthcare_privatized) {
                G.deactivateLaw(Q, "healthcare_privatized", undefined, true);
                Q.healthcare_privatized = false;
            }
            break;
        case -3:
            if(!Q.healthcare_privatized) {
                if (Q.healthcare_privatized_ruling) {
                    G.registerLaw(Q, {id:"healthcare_privatized", title:"PPP Healthcare System",
                    colour:"red", icon:"img/health_icon.svg",
                    description: "The Constitutional Court has upheld private provision without requiring any publicly operated hospitals or clinics. The ministry finances guaranteed basic coverage through private providers, while broader services still depend heavily on private insurance or payments by patients.",
                    targets:{welfare_index_growth:-0.5, social_dissent_eq:10, generalitat_surplus: 0.1, gdp_growth: -0.1 }});
                } else {
                    G.registerLaw(Q, {id:"healthcare_privatized", title:"De-facto Private Healthcare",
                    colour:"red", icon:"img/health_icon.svg",
                    description: "The Catalan Public Health service has been de-facto dismantled. Some provisions exist for the Generalitat to finance some procedures through private clinics, but not only there are no longer any publicly-operated health centers, in practice the vast majority of procedures are mostly paid by individual patients.",
                    targets:{welfare_index_growth:-0.7, social_dissent_eq:12, generalitat_surplus: 0.12, gdp_growth: -0.15 }});
                }
                Q.healthcare_privatized = true;
            }
            if (Q.healthcare_copaid) {
                G.deactivateLaw(Q, "healthcare_copaid", undefined, true);
                Q.healthcare_copaid = false;
            }
            if (Q.healthcare_cuts) {
                G.deactivateLaw(Q, "healthcare_cuts", undefined, true);
                Q.healthcare_cuts = false;
            }
            if (Q.healthcare_public) {
                G.deactivateLaw(Q, "healthcare_public", undefined, true);
                Q.healthcare_public = false;
            }
            if (Q.healthcare_dental) {
                G.deactivateLaw(Q, "healthcare_dental", undefined, true);
                Q.healthcare_dental = false;
            }
            if (Q.healthcare_expansion) {
                G.deactivateLaw(Q, "healthcare_expansion", undefined, true);
                Q.healthcare_expansion = false;
            }
            break;
        case -2:
            if(!Q.healthcare_copaid) {
                G.registerLaw(Q, {id:"healthcare_copaid", title:"Co-paid Health Scheme",
                colour:"red", icon:"img/health_icon.svg",
                description: "Non-urgent health procedures now need to be partially paid by the patient, allowing public spending to be further reduced.",
                targets:{welfare_index_growth:-0.15, social_dissent_eq:4, generalitat_surplus: 0.03 }});
                Q.healthcare_copaid = true;
            }
        case -1:
            if (!Q.healthcare_cuts) {
                G.registerLaw(Q, {id:"healthcare_cuts", title:"Healthcare Spending Cut",
                colour:"red", icon:"img/health_icon.svg",
                description: "Budget for Healthcare spending has been cut across the board, leading to worse working conditions, longer queues and waiting times, and overall degraded service for all those relying in the public health system.",
                targets:{welfare_index_growth:-0.04, social_dissent_eq:1, generalitat_surplus: 0.01 }});
                Q.healthcare_cuts = true;
            }
            if(Q.healthcare_privatized) {
                G.deactivateLaw(Q, "healthcare_privatized", undefined, true);
                Q.healthcare_privatized = false;
            }
            if (Q.healthcare_spending == -1 && Q.healthcare_copaid) {
                G.deactivateLaw(Q, "healthcare_copaid", undefined, true);
                Q.healthcare_copaid = false;
            }
            if (Q.healthcare_public) {
                G.deactivateLaw(Q, "healthcare_public", undefined, true);
                Q.healthcare_public = false;
            }
            if (Q.healthcare_dental) {
                G.deactivateLaw(Q, "healthcare_dental", undefined, true);
                Q.healthcare_dental = false;
            }
            if (Q.healthcare_expansion) {
                G.deactivateLaw(Q, "healthcare_expansion", undefined, true);
                Q.healthcare_expansion = false;
            }
            break;

    }

    Q.public_salary_raise_allowed = Q.public_salary_level >= -2 && Q.public_salary_level < 2;
    var salaryPolicies = [
        {id:"public_salary_cuts", applies:Q.public_salary_level < 0,
            title:"Public-Sector Pay Cuts", colour:"red",
            description:"Pay restraint and suspended double-payments have resulted in reduced salaries across the Generalitat's public workforce.",
            targets:{welfare_index_growth:-0.02, social_dissent_eq:0.5, generalitat_surplus:0.01}},
        {id:"public_salary_deep_cuts", applies:Q.public_salary_level == -2,
            title:"Severe Public-Sector Pay Reductions", colour:"red",
            description:"Additional reductions to Generalitat-controlled supplements and compensation place a further burden on public employees.",
            targets:{welfare_index_growth:-0.04, social_dissent_eq:1, generalitat_surplus:0.02}},
        {id:"public_salary_improvement", applies:Q.public_salary_level > 0,
            title:"Improved Public-Sector Pay", colour:"green",
            description:"Negotiated improvements to public-service workers have been approved.",
            targets:{welfare_index_growth:0.06, social_dissent_eq:-0.5, generalitat_surplus:-0.02}},
        {id:"public_salary_expansion", applies:Q.public_salary_level == 2,
            title:"Broad Public-Sector Pay Improvements", colour:"green",
            description:"Further improvements to Generalitat-overseen public workers have led to a betterment of conditions across the board.",
            targets:{welfare_index_growth:0.08, social_dissent_eq:-1, generalitat_surplus:-0.03}}
    ];
    salaryPolicies.forEach(function (policy) {
        if (!policy.applies) {
            G.deactivateLaw(Q, policy.id, undefined, true);
        } else if (!Q.active_mods || !Q.active_mods[policy.id] || !Q.active_mods[policy.id].active) {
            G.registerLaw(Q, {id:policy.id, title:policy.title,
                description:policy.description, colour:policy.colour,
                icon:"img/people_icon.svg", targets:policy.targets});
        }
    });
    var pendingRaises = [
        {field:"education_prepared_level", actual:"education_spending", law:"education_spending_proposal"},
        {field:"healthcare_prepared_level", actual:"healthcare_spending", law:"healthcare_spending_proposal"},
        {field:"public_salary_prepared_level", actual:"public_salary_level", law:"public_salary_proposal"}
    ];
    pendingRaises.forEach(function (raise) {
        if (Q[raise.field] != null && Q[raise.field] != Q[raise.actual] + 1) {
            Q[raise.field] = null;
            G.deactivateLaw(Q, raise.law, undefined, true);
        }
    });
    // Tourism has one current package; union preference is hidden preparation
    // for future mobilisation events, with no standing macroeconomic reward.
    var tourismTargets = {
        "-2":{gdp_growth:-0.20, welfare_index_growth:0.18, social_dissent_eq:-3},
        "-1":{gdp_growth:-0.08, welfare_index_growth:0.10, social_dissent_eq:-1.5},
        "1":{gdp_growth:0.15, welfare_index_growth:-0.15, social_dissent_eq:2},
        "2":{gdp_growth:0.18, welfare_index_growth:-0.35, social_dissent_eq:4}
    };
    var tourism = (Q.active_mods || {}).bnl_tourism;
    if (Q.bnl_tourism_level == 0) G.deactivateLaw(Q, "bnl_tourism", undefined, true);
    else if (tourismTargets[Q.bnl_tourism_level] && (!tourism || !tourism.active || tourism.def.bnl_level != Q.bnl_tourism_level)) {
        var tourismNames = ["Strongly Restrictive", "Restrictive", "Ordinary", "Permissive", "Strongly Permissive"];
        G.registerLaw(Q, {id:"bnl_tourism", title:tourismNames[Q.bnl_tourism_level + 2] + " Tourism Policy",
            colour:Q.bnl_tourism_level < 0 ? "green" : Q.bnl_tourism_level >= 2 ? "red" : "orange", icon:"img/tourism_icon.svg", bnl_level:Q.bnl_tourism_level,
            description:Q.bnl_tourism_level < 0 ? "Tourism regulation favours working conditions and environmental respect, limiting tourism expansion." :
                "The current regulatory framework favours tourism expansion, to the dismay of many residents.",
            targets:tourismTargets[Q.bnl_tourism_level]});
    }
    var unionPolicy = (Q.active_mods || {}).bnl_union_policy;
    if (Q.bnl_union_level == 0) G.deactivateLaw(Q, "bnl_union_policy", undefined, true);
    else if (Number.isInteger(Q.bnl_union_level) && Q.bnl_union_level >= -2 && Q.bnl_union_level <= 2 &&
        (!unionPolicy || !unionPolicy.active || unionPolicy.def.bnl_level != Q.bnl_union_level)) {
        G.registerLaw(Q, {id:"bnl_union_policy", title:"Union Institutional Preference", bnl_level:Q.bnl_union_level,
            description:"Institutional preference informs future union mobilization events.", targets:{}});
        Q.active_mods.bnl_union_policy.hidden = true;
    }
    // Each Territory track has one enacted package. Prepared projects have
    // their own empty-target records until funding and delivery are complete.
    var territoryPackages = [
        {id:"territory_renewables", level:Q.territory_renewables,
            title:["", "Renewable Deployment Coordination", "Broad Renewable Rollout", "Renewable Energy Priority"],
            description:["", "The Ministy of Territory now gives renewable projects greater priority. Approvals are now swifter and take less time and effort.",
                "Energy and territorial planning are coordinating a broader renewable rollout under the Climate Change Law.",
                "Renewables have priority across energy and land-use projects all across departments and ministries."],
            icon:"img/leaf_icon.svg", ramp:6,
            targets:[{}, {gdp_growth:0.005, welfare_index_growth:0.015, generalitat_surplus:-0.002},
                {gdp_growth:0.01, welfare_index_growth:0.03, generalitat_surplus:-0.004},
                {gdp_growth:0.015, welfare_index_growth:0.045, generalitat_surplus:-0.006}]},
        {id:"territory_livestock", level:Q.territory_livestock,
            title:["", "Agricultural Policy"], icon:"img/leaf_icon.svg",
            targets:{"-2":{gdp_growth:0.04, welfare_index_growth:0.05, generalitat_surplus:-0.006},
                "-1":{gdp_growth:0.02, welfare_index_growth:0.025, generalitat_surplus:-0.003},
                "1":{welfare_index_growth:-0.035, social_dissent_eq:1},
                "2":{welfare_index_growth:-0.07, social_dissent_eq:2}}},
        {id:"territory_water", level:Q.territory_water,
            title:["", "Water Management and Drought Preparedness", "Public Water Facilities", "Public Water Supply and Management"],
            description:["", "Water installations and collection systems have been refurbished, and new plans for water crisis management have been put in place.",
                "Public facilities and protocols for water management have been expanded and modernized, alongside harsher sanctioning system for private mismanagement.",
                "Supply and management of water resources has mostly been transferred away from private operators across Catalonia."],
            icon:"img/water_icon.svg",
            targets:[{},
                {welfare_index_growth:0.02, generalitat_surplus:-0.003},
                {gdp_growth:0.01, welfare_index_growth:0.05, generalitat_surplus:-0.015},
                {gdp_growth:0.02, welfare_index_growth:0.07, generalitat_surplus:-0.02}]},
        {id:"territory_tmobilitat", level:Q.territory_tmobilitat,
            title:["", "T-Mobilitat", "Catalonia-Wide T-mobilitat"],
            description:["", "A unified, contactless ticketing system for public transportation has been deployed in the Barcelona metropolitan area.",
                "Electronic ticketing technology and operation has been under public control, and has been deployed all around Catalonia."],
            icon:"img/territory_icon.svg",
            targets:[{}, {gdp_growth:0.01, welfare_index_growth:0.03, generalitat_surplus:-0.005},
                {gdp_growth:0.025, welfare_index_growth:0.06, generalitat_surplus:-0.015}]}
    ];
    for (var policy of territoryPackages) {
        var previous = (Q.active_mods || {})[policy.id];
        if (!policy.level) {
            G.deactivateLaw(Q, policy.id, undefined, true);
            continue;
        }
        if (previous && previous.active && previous.def.territory_level == policy.level) continue;
        var livestock = policy.id == "territory_livestock";
        var title = livestock ? policy.level > 0 ? "Intensive Pig-Farming Dependence" : "Diversified Agriculture" : policy.title[policy.level];
        var description = livestock ? policy.level > 0 ?
            "Agricultural policy favours intensive pig farming. Pressure on water quality and living conditions persists make this a recurring point of contention." :
            "Agricultural support and advice prioritize varied production." : policy.description[policy.level];
        if (policy.level > 0 || livestock && policy.level < 0) {
            G.registerLaw(Q, {id:policy.id, title:title, description:description,
            colour:livestock && policy.level > 0 ? "red" : "green", icon:policy.icon,
            territory_level:policy.level, ramp_ticks:livestock && policy.level < 0 ? 12 : policy.ramp,
            targets:policy.targets[policy.level]});
        }   
    }
    // Ministry levels share their law definitions across player and NPC enactment.
    // Existing investments retain their elapsed ramps.
    if (Q.economy_atc_level >= 1 && !(Q.active_mods || {}).economy_atc1) {
        G.registerLaw(Q, {id:"economy_atc1", title:"Expanded Catalan Tax Agency",
            colour:"green", icon:"img/economy_icon.svg",
            description:"With expanded staff, inspection and collection systems, the Generalitat is already improving its revenue collection with better fraud protection and more agile systems.",
            ramp_ticks:6, targets:{generalitat_surplus:0.015}});
    }
    if (Q.economy_atc_level >= 2 && !(Q.active_mods || {}).economy_atc2) {
        G.registerLaw(Q, {id:"economy_atc2", title:"State-Ready Catalan Tax Agency",
            colour:"green", icon:"img/economy_icon.svg",
            description:"A state-ready agency with a developed territorial network, staff and systems.",
            ramp_ticks:12, targets:{generalitat_surplus:0.015}});
    }
    if (Q.economy_atc_level >= 2 && (Q.active_mods || {}).economy_atc1) Q.active_mods.economy_atc1.hidden = true;
    if (Q.bnl_icf_level >= 1 && !(Q.active_mods || {}).bnl_icf1) {
        G.registerLaw(Q, {id:"bnl_icf1", title:"Expanded Public Lending", colour:"green", icon:"img/economy_icon.svg",
            description:"The ICF now offers improved access to credit for the self-employed and small business.",
            ramp_ticks:6, targets:{gdp_growth:0.08, unemployment_recovery:0.02, generalitat_surplus:-0.01}});
    }
    if (Q.bnl_inspection_level >= 1 && !(Q.active_mods || {}).bnl_inspection1) {
        G.registerLaw(Q, {id:"bnl_inspection1", title:"Strengthened labour inspections", colour:"green", icon:"img/labour_icon.svg",
            description:"Additional inspectors and enforcement resources have been deployed.",
            ramp_ticks:6, targets:{welfare_index_growth:0.06, social_dissent_eq:-1, generalitat_surplus:-0.01}});
    }
    if (Q.bnl_inspection_level >= 2 && !(Q.active_mods || {}).bnl_inspection2) {
        G.registerLaw(Q, {id:"bnl_inspection2", title:"Intensify enforcement against persistent labour violations", colour:"green", icon:"img/labour_icon.svg",
            description:"Additional inspectors and enforcement resources address labour-law violations.",
            ramp_ticks:6, targets:{welfare_index_growth:0.06, social_dissent_eq:-1, generalitat_surplus:-0.01}});
    }
    if (Q.bnl_inspection_level >= 2 && (Q.active_mods || {}).bnl_inspection1) Q.active_mods.bnl_inspection1.hidden = true;
    if (Q.healthcare_universal_level >= 1 && !(Q.active_mods || {}).healthcare_universal1) {
        G.registerLaw(Q, {id:"healthcare_universal1", title:"Broader Healthcare Access", colour:"green", icon:"img/health_icon.svg",
            description:"Healthcare access has been expanded, with better rural reach and improved administrative protocols, erasing many of the previously existing barriers.",
            targets:{welfare_index_growth:0.05, generalitat_surplus:-0.01, social_dissent_eq:-1}, ramp_ticks:6});
    }
    if (Q.healthcare_sexual_level >= 1 && !(Q.active_mods || {}).healthcare_reproductive) {
        G.registerLaw(Q, {id:"healthcare_reproductive", title:"Guaranteed Abortion and Reproductive Healthcare Access", colour:"green", icon:"img/health_icon.svg",
            description:"Better sexual education is being taught, while better protocols for both abortion and other forms of reproductive health have been deployed.",
            targets:{generalitat_surplus:-0.01, social_dissent_eq:-1}, ramp_ticks:6});
    }
    if (Q.healthcare_sexual_level >= 2 && !(Q.active_mods || {}).healthcare_trans) {
        G.registerLaw(Q, {id:"healthcare_trans", title:"Inclusive Gender Healthcare", colour:"green", icon:"img/health_icon.svg",
            description:"Gender affirming and other forms of sexual and gender care have been included into the public system into a model without a psychiatric-diagnosis requirement.",
            targets:{generalitat_surplus:-0.01, social_dissent_eq:-1}, ramp_ticks:12});
    }
    if (Q.healthcare_sexual_level >= 2 && (Q.active_mods || {}).healthcare_reproductive) Q.active_mods.healthcare_reproductive.hidden = true;
    if (Q.vp_digital_level >= 1 && !(Q.active_mods || {}).vp_digital1) {
        G.registerLaw(Q, {id:"vp_digital1", title:"Expanded Digital Administration", colour:"green", icon:"img/comms_icon.svg",
            description:"Electronic records, notifications and procedures have been further digitalized and unified.", targets:{gdp_growth:0.05, generalitat_surplus:-0.01}, ramp_ticks:6});
    }
    if (Q.vp_digital_level >= 2 && !(Q.active_mods || {}).vp_digital2) {
        G.registerLaw(Q, {id:"vp_digital2", title:"Integrated and Secure Digital Administration", colour:"green", icon:"img/comms_icon.svg",
            description:"The newly established Catalan Cybersecurity Agency has been tightly integrated with the rest of the digitalized administration, providing a wide umbrella of cyber capabilities.", targets:{gdp_growth:0.05, generalitat_surplus:-0.01}, ramp_ticks:12});
    }
    if (Q.vp_digital_level >= 2 && (Q.active_mods || {}).vp_digital1) Q.active_mods.vp_digital1.hidden = true;
    if (!Q.institutional_alignment) G.deactivateLaw(Q, "institutional_alignment", undefined, true);
    else if (!(Q.active_mods || {}).institutional_alignment || !Q.active_mods.institutional_alignment.active ||
        Q.active_mods.institutional_alignment.def.alignment != Q.institutional_alignment) {
        G.registerLaw(Q, {id:"institutional_alignment", title:"Institutional Alignment", alignment:Q.institutional_alignment,
            cooperation_probability_adjustment:Q.institutional_alignment * 0.02,
            description:"Institutional alignment informs future cooperation under political pressure.", targets:{}});
        Q.active_mods.institutional_alignment.hidden = true;
    }
    var curriculumProfiles = {
        language:{name:"Catalan-language protection",targets:{welfare_index_growth:0.05, generalitat_surplus:-0.01, social_dissent_eq:-1, cat_spa_relations:-0.10}},
        democratic:{name:"Democratic schooling and coeducation",targets:{welfare_index_growth:0.05, generalitat_surplus:-0.01, social_dissent_eq:-1}},
        humanities:{name:"Humanities and cultural education",targets:{gdp_growth:0.05, welfare_index_growth:0.04, generalitat_surplus:-0.01}},
        science:{name:"Science and digital skills",targets:{gdp_growth:0.10, unemployment_recovery:0.02, generalitat_surplus:-0.02}},
        vocational:{name:"Vocational training and industry integration",targets:{gdp_growth:0.08, unemployment_recovery:0.04, welfare_index_growth:0.02, generalitat_surplus:-0.02}},
        segregation:{name:"Anti-segregation methods",targets:{unemployment_recovery:0.02, welfare_index_growth:0.10, generalitat_surplus:-0.03, social_dissent_eq:-2}}
    };
    var main = Q.education_policy_main, secondary = Q.education_policy_secondary;
    if (curriculumProfiles[main] && curriculumProfiles[secondary]) {
        var policy = (Q.active_mods || {}).education_school_policy;
        if (!policy || !policy.active || policy.def.main_focus != main || policy.def.secondary_focus != secondary) {
            var targets = {};
            for (var item of [[main,1],[secondary,0.5]])
                for (var target of Object.keys(curriculumProfiles[item[0]].targets))
                    targets[target] = (targets[target] || 0) + curriculumProfiles[item[0]].targets[target] * item[1];
            var definition = Object.assign({}, policy && policy.def || {}, {id:"education_school_policy",
                title:"Revised Education Curriculum", colour:"green", icon:"img/education_icon.svg",
                description:"The Catalan Education Curriculum has been revised, and will now focus on " + curriculumProfiles[main].name + "; and " + curriculumProfiles[secondary].name + ". ",
                main_focus:main, secondary_focus:secondary, targets:targets, ramp_ticks:12});
            if (policy && policy.active) {
                policy.def = definition;
                delete policy.colour;
                policy.hidden = false;
                policy.live_effect = {};
                for (var target of Object.keys(targets)) policy.live_effect[target] = targets[target] * Math.min(policy.ticks_active / 12, 1);
            } else G.registerLaw(Q, definition);
        }
    }

!}

