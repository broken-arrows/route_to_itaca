                        var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                        var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                        if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                        if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                        G.cardSupportTransfer(Q,voterOptions);

                    }
                }
            }
        }
    }
!}
call: generalitat_setpolicy

The ATC has been expanded into an true state-ready agency. While it may be a bit of an overkill bureaucratic structure for an autonomy, its readiness may indeed come handy if we're ever to become independent.

- @post_event

@borrow
title: Increase borrowing
subtitle: \[ +1 budget\]
choose-if: public_debt >= 0 and public_debt <= 79
unavailable-subtitle: Public debt leaves no room for another borrowing operation.
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.economy_minister_party) && !Q.cat_caretaker_gov && Q.public_debt >= 0 && Q.public_debt <= 79) {
        Q.government_budget += 1;
        Q.public_debt += 1;
    }
!}

Borrowing from different financial institutions, including the central government, does give us more room to act. Let's hope it does not come bite us later on, though...

- @post_event

@repay
title: Reduce public debt
subtitle: \[-1 budget\]
choose-if: government_budget >= 1 and public_debt >= 1
unavailable-subtitle: [? if government_budget < 1: Not enough budget.?][? if public_debt < 1: Catalan public debt is virtually zero!?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.economy_minister_party) && !Q.cat_caretaker_gov && Q.government_budget >= 1 && Q.public_debt >= 1) {
        Q.government_budget -= 1;
        Q.public_debt -= 1;
    }
!}

We have used part of our available budget to reduce the public debt burden.

- @post_event

@sell_assets
title: Sell public assets
view-if: economy_asset_sales < 3
subtitle: We'll have to lease them back for continued use. \[ +1 budget \]
choose-if: economy_asset_sales >= 0 and economy_asset_sales < 3
unavailable-subtitle: There's no remaining assets that can be reasonably sold.
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.economy_minister_party) && !Q.cat_caretaker_gov && Q.economy_asset_sales >= 0 && Q.economy_asset_sales < 3) {
        Q.economy_asset_sales += 1;
        if (Q.player_party == "cup") Q.burdens_broken = true;
        Q.government_budget += 1;
        // No icon, no colour = not visible, as intended
        G.registerLaw(Q, {id:"economy_asset_sale_" + Q.economy_asset_sales,
            title:"Public Buildings Sale and Leaseback " + Q.economy_asset_sales,
            description:"A package of Generalitat administrative buildings has been sold. Continued use requires ongoing rental payments.",
            targets:{generalitat_surplus: -0.01}});
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q["erc" + "_relations"]))
            Q["erc" + "_relations"] += -2 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += 2 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q["psc" + "_relations"]))
            Q["psc" + "_relations"] += -1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += -3 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q["cup" + "_relations"]))
            Q["cup" + "_relations"] += -4 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q["ppc" + "_relations"]))
            Q["ppc" + "_relations"] += 1 * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q["cs" + "_relations"]))
            Q["cs" + "_relations"] += 1 * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 2 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 2 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 1 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 1 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += 1 * (coalitionPartners.includes("vox") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += 2 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += 4;
            Q.erc_core_dissent += 1;
            Q.erc_civic_dissent += 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += 6;
            Q.cup_poblelliure_dissent += 2;
            Q.cup_thirdsector_dissent += 4;
        }
        var voterPolicies = [{demographics:{ind:0.45,young:0.4,unemployed:0.4,middle:0.2}, provinces:{barcelona:1,girona:1,lleida:1,tarragona:1}, routes:(null), sign:-1, congreso:(0.025), barcelona:(0.05)},{demographics:Q.player_party == "cup" ? {buss:0.08,middle:0.04} : {buss:0.15,middle:0.08}, provinces:{barcelona:1,girona:1,lleida:1,tarragona:1}, routes:([["ciu",0.65],["cs",0.35]]), sign:1, congreso:(0.005), barcelona:(0.01)}];

        // Policy voters: explicit demographic/province transfers, with ministry responsibility 80/20.
        var voterOrigin = Q.player_party;
        var voterCabinet = Array.from(new Set(Q.cat_coalition || []));
        // Allocate ministry responsibility once across unique Parlament ballot carriers.
        var voterActors = [];
        for (var voterParty of [voterOrigin].concat(voterCabinet)) {

            var voterCandidates = [voterParty];
            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        for (var voterPolicy of voterPolicies) {
            var voterCells = [];
            for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || []) {
                var voterAmount = (voterPolicy.demographics[voterDemo] || 0) * (voterPolicy.provinces[voterProvince] || 0);
                if (voterAmount) voterCells.push({contest:"parlament",province:voterProvince,demo:voterDemo,amount:voterAmount});
            }
            if (voterPolicy.congreso && (Q.congreso_constituencies || []).includes("catalunya")) voterCells.push({contest:"congreso",province:"catalunya",demo:null,amount:voterPolicy.congreso});
            if (voterPolicy.barcelona) voterCells.push({contest:"barcelona",province:null,demo:null,amount:voterPolicy.barcelona});
            for (var voterCell of voterCells) {
                var voterContest = voterCell.contest;
                var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
                var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
                var voterSignedAmount = voterCell.amount * (Math.abs(voterPolicy.sign));
                if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
                var voterDirection = voterPolicy.sign > 0 ? 1 : -1;
                for (var voterActor of voterActors) {
                    var voterRouteList = voterPolicy.routes || (voterActor.origin == "erc" ? [["cup",0.45],["fl",0.35],["abstain",0.20]] : voterActor.origin == "cup" ? [["fl",0.45],["erc",0.35],["abstain",0.20]] : voterActor.origin == "psc" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : ["ecp","cecp","csqp","icv"].includes(voterActor.origin) ? [["cup",0.40],["erc",0.30],["abstain",0.30]] : [["erc",0.40],["fl",0.35],["abstain",0.25]]);
                    for (var voterRoute of voterRouteList) {
                        var voterPair = [];
                        for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                            var voterCandidates = [voterParty];
                            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                            if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                            if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                            if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                            var voterCarrier = null;
                            for (var voterCandidate of voterCandidates) {
                                if (!voterLineup.includes(voterCandidate)) continue;
                                if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                                if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                            }
                            voterPair.push(voterCarrier);
                        }
                        if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                        var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                        var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                        if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                        if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                        G.cardSupportTransfer(Q,voterOptions);

                    }
                }
            }
        }
    }
!}

The sale of administrative buildings gives us has given us some breathing room financially, but the Generalitat will now have to use them as tenant... It's not like rentals are going to be an issue ever, right?

- @post_event

@raise_pay
title: [? if public_salary_level < 0: Revert public salary cuts ?][? if public_salary_level >= 0: Improve public-salaries ?]
view-if: public_salary_level < 2 and economy_cuts <= 0
subtitle: \[-1 budget [? if public_salary_level >= social_spending_cap: on spending cap increase approval ?] \]
choose-if: public_salary_level >= -2 and public_salary_level < 2 and government_budget > 0 and not public_salary_raise_pending
unavailable-subtitle: [? if government_budget <= 0: Not enough budget.?][? if public_salary_raise_pending: This pay increase is already awaiting budget authorization.?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.economy_minister_party) && !Q.cat_caretaker_gov && Q.public_salary_level >= -2 && Q.public_salary_level < 2 && Q.economy_cuts <= 0 && Q.government_budget > 0 && (Q.public_salary_prepared_level == null || Q.public_salary_prepared_level !== Q.public_salary_level + 1)) {
        var previousLevel = Q.public_salary_level;
        Q.government_budget -= 1;
        Q.economy_pay_delivered = Q.public_salary_level + 1 <= Q.social_spending_cap;
        if (Q.economy_pay_delivered) {
            Q.public_salary_level += 1;
            if (Q.burdens_start_countdown > 0 || Q.burdens_start_trigger || Q.burdens_goal > 0 && Q.burdens_time > 0) Q.burdens_done += 1;
            Q.public_salary_prepared_level = null;
            G.deactivateLaw(Q, "public_salary_proposal", undefined, true);
        } else {
            Q.public_salary_prepared_level = Q.public_salary_level + 1;
            G.registerLaw(Q, {id:"public_salary_proposal", electoral_origin:Q.player_party, electoral_cabinet:Array.from(new Set(Q.cat_coalition || [])), title:"Public-Sector Pay Proposal",
                colour:"gray", icon:"img/people_icon.svg",
                description:"Pending budget approval: " + (Q.public_salary_level < 0 ? "Restoration" : "Increase") + " of Generalitat-controlled public salaries.",
                targets:{}});
        }
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations += 1 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations += 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += 2 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations += 1 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 0 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 0 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("vox") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += (previousLevel < 0 ? 0 : -1) * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent -= 2;
            Q.erc_core_dissent -= 1;
            Q.erc_pragmatic_dissent += previousLevel < 0 ? -1 : 0;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent -= 2;
            Q.cup_poblelliure_dissent -= 1;
            Q.cup_thirdsector_dissent -= 2;
        }
        if (Q.economy_pay_delivered) {
            var voterPolicies = [{demographics:previousLevel < 0 ? {middle:0.6,ind:0.4,unemployed:0.15,retired:0.1} : {middle:0.5,ind:0.35,unemployed:0.1,retired:0.1}, provinces:{barcelona:1,girona:1,lleida:1,tarragona:1}, routes:(Q.player_party == "cup" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : [["psc",0.45],["fl",0.30],["abstain",0.25]]), sign:1, congreso:(previousLevel < 0 ? 0.025 : 0.02), barcelona:(previousLevel < 0 ? 0.05 : 0.04)}];

            // Policy voters: explicit demographic/province transfers, with ministry responsibility 80/20.
            var voterOrigin = Q.player_party;
            var voterCabinet = Array.from(new Set(Q.cat_coalition || []));
            // Allocate ministry responsibility once across unique Parlament ballot carriers.
            var voterActors = [];
            for (var voterParty of [voterOrigin].concat(voterCabinet)) {

                var voterCandidates = [voterParty];
                if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
                var voterCarrier = null;
                for (var voterCandidate of voterCandidates) {
                    if (!(Q.parties || []).includes(voterCandidate)) continue;
                    for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                        if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                    if (voterCarrier) break;
                }
                if (voterParty == voterOrigin && !voterCarrier) break;
                if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
            }
            for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
                voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
            for (var voterPolicy of voterPolicies) {
                var voterCells = [];
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || []) {
                    var voterAmount = (voterPolicy.demographics[voterDemo] || 0) * (voterPolicy.provinces[voterProvince] || 0);
                    if (voterAmount) voterCells.push({contest:"parlament",province:voterProvince,demo:voterDemo,amount:voterAmount});
                }
                if (voterPolicy.congreso && (Q.congreso_constituencies || []).includes("catalunya")) voterCells.push({contest:"congreso",province:"catalunya",demo:null,amount:voterPolicy.congreso});
                if (voterPolicy.barcelona) voterCells.push({contest:"barcelona",province:null,demo:null,amount:voterPolicy.barcelona});
                for (var voterCell of voterCells) {
                    var voterContest = voterCell.contest;
                    var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
                    var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
                    var voterSignedAmount = voterCell.amount * (Math.abs(voterPolicy.sign));
                    if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
                    var voterDirection = voterPolicy.sign > 0 ? 1 : -1;
                    for (var voterActor of voterActors) {
                        var voterRouteList = voterPolicy.routes || (voterActor.origin == "erc" ? [["cup",0.45],["fl",0.35],["abstain",0.20]] : voterActor.origin == "cup" ? [["fl",0.45],["erc",0.35],["abstain",0.20]] : voterActor.origin == "psc" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : ["ecp","cecp","csqp","icv"].includes(voterActor.origin) ? [["cup",0.40],["erc",0.30],["abstain",0.30]] : [["erc",0.40],["fl",0.35],["abstain",0.25]]);
                        for (var voterRoute of voterRouteList) {
                            var voterPair = [];
                            for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                                var voterCandidates = [voterParty];
                                if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                                if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                                if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                                if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                                if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                                if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                                var voterCarrier = null;
                                for (var voterCandidate of voterCandidates) {
                                    if (!voterLineup.includes(voterCandidate)) continue;
                                    if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                                    if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                                }
                                voterPair.push(voterCarrier);
                            }
                            if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                            var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                            var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                            if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                            if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                            G.cardSupportTransfer(Q,voterOptions);

                        }
                    }
                }
            }
        }
    }
!}
call: generalitat_setpolicy

[? if economy_pay_delivered: We have [? if public_salary_level <= 0 : restored ?][? if public_salary_level > 0: increased ?]the pay components under the Generalitat's control.  ?]

[? if not economy_pay_delivered: The pay increase has been approved and awaits funding.?]

@cut_pay
title: Reduce public salaries
view-if: public_salary_level > -2
subtitle: Reduce Generalitat-controlled supplements and compensation \[ +1 budget\]
choose-if: public_salary_level > -2 and public_salary_level <= 2
unavailable-subtitle: Public-sector pay is already at its minimum.
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.economy_minister_party) && !Q.cat_caretaker_gov && Q.public_salary_level > -2 && Q.public_salary_level <= 2) {
        var previousLevel = Q.public_salary_level;
        Q.public_salary_level -= 1;
        Q.burdens_broken = true;
        Q.government_budget += 1;
        Q.public_salary_prepared_level = null;
        G.deactivateLaw(Q, "public_salary_proposal", undefined, true);
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations -= 1 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations -= 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] -= 2 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations -= 1 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 0 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 0 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("vox") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += (previousLevel > 0 ? 1 : 0) * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += 2;
            Q.erc_core_dissent += 1;
            Q.erc_pragmatic_dissent += previousLevel <= 0 ? 1 : 0;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += 2;
            Q.cup_poblelliure_dissent += 1;
            Q.cup_thirdsector_dissent += 2;
        }
        var voterPolicies = [{demographics:(previousLevel - 1) < 0 ? {middle:0.6,ind:0.4,unemployed:0.15,retired:0.1} : {middle:0.5,ind:0.35,unemployed:0.1,retired:0.1}, provinces:{barcelona:1,girona:1,lleida:1,tarragona:1}, routes:(null), sign:-1, congreso:(previousLevel <= 0 ? 0.025 : 0.02), barcelona:(previousLevel <= 0 ? 0.05 : 0.04)}];

        // Policy voters: explicit demographic/province transfers, with ministry responsibility 80/20.
        var voterOrigin = Q.player_party;
        var voterCabinet = Array.from(new Set(Q.cat_coalition || []));
        // Allocate ministry responsibility once across unique Parlament ballot carriers.
        var voterActors = [];
        for (var voterParty of [voterOrigin].concat(voterCabinet)) {

            var voterCandidates = [voterParty];
            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        for (var voterPolicy of voterPolicies) {
            var voterCells = [];
            for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || []) {
                var voterAmount = (voterPolicy.demographics[voterDemo] || 0) * (voterPolicy.provinces[voterProvince] || 0);
                if (voterAmount) voterCells.push({contest:"parlament",province:voterProvince,demo:voterDemo,amount:voterAmount});
            }
            if (voterPolicy.congreso && (Q.congreso_constituencies || []).includes("catalunya")) voterCells.push({contest:"congreso",province:"catalunya",demo:null,amount:voterPolicy.congreso});
            if (voterPolicy.barcelona) voterCells.push({contest:"barcelona",province:null,demo:null,amount:voterPolicy.barcelona});
            for (var voterCell of voterCells) {
                var voterContest = voterCell.contest;
                var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
                var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
                var voterSignedAmount = voterCell.amount * (Math.abs(voterPolicy.sign));
                if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
                var voterDirection = voterPolicy.sign > 0 ? 1 : -1;
                for (var voterActor of voterActors) {
                    var voterRouteList = voterPolicy.routes || (voterActor.origin == "erc" ? [["cup",0.45],["fl",0.35],["abstain",0.20]] : voterActor.origin == "cup" ? [["fl",0.45],["erc",0.35],["abstain",0.20]] : voterActor.origin == "psc" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : ["ecp","cecp","csqp","icv"].includes(voterActor.origin) ? [["cup",0.40],["erc",0.30],["abstain",0.30]] : [["erc",0.40],["fl",0.35],["abstain",0.25]]);
                    for (var voterRoute of voterRouteList) {
                        var voterPair = [];
                        for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                            var voterCandidates = [voterParty];
                            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                            if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                            if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                            if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                            var voterCarrier = null;
                            for (var voterCandidate of voterCandidates) {
                                if (!voterLineup.includes(voterCandidate)) continue;
                                if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                                if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                            }
                            voterPair.push(voterCarrier);
                        }
                        if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                        var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                        var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                        if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                        if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                        G.cardSupportTransfer(Q,voterOptions);

                    }
                }
            }
        }
    }
!}
call: generalitat_setpolicy

Public-sector compensation has been reduced. While this may be a necessary economic measure, fact is many will disapprove of such cuts.

@prepare_budget
title: Present the Generalitat's annual budget
unavailable-subtitle: The budget for the year [+ budget_year +] has already been approved!
choose-if: budget_year < year
on-arrival: {!
    Q.economy_budget_proposal = {
        tax_policy_level: Q.tax_policy_level,
        social_spending_cap: Q.social_spending_cap,
        projects: {county:false, b40:false, metro1:false, metro2:false, water2:false, water3:false, tmobilitat2:false, rail1:false, rail2:false, icf:false, digital:false, universal:false}
    };
!}
go-to: budget_review

@budget_review
new-page: true
on-arrival: {!
    var proposal = Q.economy_budget_proposal;
    var taxNames = ["Very low", "Low", "Moderate", "High", "Very high"];
    var capNames = ["Further austerity", "Maintain reduced services and pay",
        "Restore ordinary services and pay", "Authorize expanded services and improved pay",
        "Authorize modernized services and broader pay improvements",
        "Full spending authorization, effectively a removal of spending caps."];
    Q.economy_budget_tax_name = taxNames[proposal.tax_policy_level + 2];
    Q.economy_budget_cap_name = capNames[proposal.social_spending_cap + 2];
    Q.economy_budget_tax_lower = proposal.tax_policy_level > Math.max(-2, Q.tax_policy_level - 2);
    Q.economy_budget_tax_higher = proposal.tax_policy_level < Math.min(2, Q.tax_policy_level + 2);
    Q.economy_budget_cap_lower = proposal.social_spending_cap > -2 &&
        Q.education_spending != 3 && Q.healthcare_spending != 3;
    Q.economy_budget_cap_higher = proposal.social_spending_cap < 3;
    Q.economy_budget_valid = proposal.tax_policy_level >= Math.max(-2, Q.tax_policy_level - 2) &&
        proposal.tax_policy_level <= Math.min(2, Q.tax_policy_level + 2) &&
        proposal.social_spending_cap >= -2 && proposal.social_spending_cap <= 3 &&
        (proposal.social_spending_cap == 3 || Q.education_spending != 3 && Q.healthcare_spending != 3);
    Q.economy_budget_education_cut = Q.education_spending > proposal.social_spending_cap;
    Q.economy_budget_health_cut = Q.healthcare_spending > proposal.social_spending_cap;
    Q.economy_budget_pay_cut = Q.public_salary_level > proposal.social_spending_cap;
    var laws = Q.active_mods || {};
    function prepared(id) {
        if (!laws[id] || !laws[id].active || laws[id].def.colour != "gray") return false;
        if (id == "territory_water2") return Q.territory_water == 1;
        if (id == "territory_water3") return Q.territory_water == 2;
        if (id == "territory_tmobilitat2") return Q.territory_tmobilitat == 1;
        if (id == "territory_rail2") return Q.territory_tmobilitat == 2;
        return true;
    }
    Q.economy_budget_county_available = prepared("territory_county_roads");
    Q.economy_budget_b40_available = prepared("territory_b40");
    Q.economy_budget_metro1_available = prepared("territory_metro1");
    Q.economy_budget_metro2_available = prepared("territory_metro2");
    Q.economy_budget_county = proposal.projects.county;
    Q.economy_budget_b40 = proposal.projects.b40;
    Q.economy_budget_metro1 = proposal.projects.metro1;
    Q.economy_budget_metro2 = proposal.projects.metro2;
    Q.economy_budget_water2_available = prepared("territory_water2");
    Q.economy_budget_water2 = !!proposal.projects.water2;
    Q.economy_budget_water3_available = prepared("territory_water3");
    Q.economy_budget_water3 = !!proposal.projects.water3;
    Q.economy_budget_tmobilitat2_available = prepared("territory_tmobilitat2");
    Q.economy_budget_tmobilitat2 = !!proposal.projects.tmobilitat2;
    Q.economy_budget_rail1_available = prepared("territory_rail1");
    Q.economy_budget_rail1 = !!proposal.projects.rail1;
    Q.economy_budget_rail2_available = prepared("territory_rail2");
    Q.economy_budget_rail2 = !!proposal.projects.rail2;
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    Q.economy_budget_icf_available = prepared("bnl_icf_proposal") && Q.bnl_icf_level == 1 &&
        ["guarantees", "cooperative"].includes(Q.bnl_icf_prepared_branch) && !Q.cat_caretaker_gov &&
        controlledParties.includes(Q.bnl_minister_party) && controlledParties.includes(Q.economy_minister_party);
    Q.economy_budget_icf = !!proposal.projects.icf;
    Q.economy_budget_icf_name = Q.bnl_icf_prepared_branch == "cooperative" ? "ICF cooperative and social-economy lending" : "expanded ICF public guarantees";
    if (proposal.projects.icf && !Q.economy_budget_icf_available) Q.economy_budget_valid = false;
    Q.economy_budget_digital_available = prepared("vp_digital3_proposal") && Q.vp_digital_level == 2 && Q.vp_digital_prepared &&
        !Q.cat_caretaker_gov && controlledParties.includes(Q.vicepresident_party) && Q.parlament_digital_passed && ["generalitat", "catalonia"].includes(Q.cybersecurity_agency_scope) && (Q.active_mods || {}).digital_agency_core && Q.active_mods.digital_agency_core.active;
    Q.economy_budget_digital = !!proposal.projects.digital;
    if (proposal.projects.digital && !Q.economy_budget_digital_available) Q.economy_budget_valid = false;
    Q.economy_budget_universal_available = prepared("healthcare_universal_proposal") && Q.healthcare_universal_level == 1 && Q.healthcare_universal_introduced &&
        !Q.cat_caretaker_gov && controlledParties.includes(Q.health_minister_party);
    Q.economy_budget_universal = !!proposal.projects.universal;
    if (proposal.projects.universal && !Q.economy_budget_universal_available) Q.economy_budget_valid = false;
!}

= Prepare the annual budget

Autonomic Taxes: **[+ economy_budget_tax_name +]**.

Social spending authorization: **[+ economy_budget_cap_name +]**. This effectively caps the maximum spending of the different ministries. [? if economy_budget_education_cut: Approving this would reduce Education spending to fit the new ceiling. ?][? if economy_budget_health_cut: Approving this would reduce Healthcare spending to fit the new ceiling. ?][? if economy_budget_pay_cut: Approving this would reduce public-sector pay to fit the new ceiling. ?][? if education_spending = 3 or healthcare_spending = 3: Exceptional public-service frameworks must, however, be first removed for the ceiling to be lowered. ?]

Projects:
[? if economy_budget_county: - County roads expansion. ?]
[? if economy_budget_b40: - B-40 Fourth Belt. ?]
[? if economy_budget_metro1: - Metro L9/L10. ?]
[? if economy_budget_metro2: - Metro L1/L3. ?]
[? if economy_budget_water2: - Expansion of public Water Facilities. ?]
[? if economy_budget_water3: - Public Water Supply and Management. ?]
[? if economy_budget_tmobilitat2: - Catalonia-Wide T-mobilitat. ?]
[? if economy_budget_rail1: - Lleida-La Pobla Railway. ?]
[? if economy_budget_rail2: - Camp de Tarragona and Girona counties Train-Trams. ?]
[? if economy_budget_icf: - [+ economy_budget_icf_name +]. ?]
[? if economy_budget_digital: - Digital administrative continuity. ?]
[? if economy_budget_universal: - Universal healthcare access. ?]

While this is our proposal, passing it through the Parlament may require some tweaks to gather enough support, but we'll cross that bridge once we get there.

- @budget_tax_lower
- @budget_tax_higher
- @budget_cap_lower
- @budget_cap_higher
- @budget_county
- @budget_b40
- @budget_metro1
- @budget_metro2
- @budget_water2
- @budget_water3
- @budget_tmobilitat2
- @budget_rail1
- @budget_rail2
- @budget_icf
- @budget_digital
- @budget_universal
- @submit_budget
- @post_event: Leave this proposal unsubmitted

@budget_tax_lower
title: Lower Autonomic Taxes
choose-if: economy_budget_tax_lower
unavailable-subtitle: Our proposal is already changing Autonomic Taxes as radically as it can be done in one pass.
on-arrival: {!
    Q.economy_budget_proposal.tax_policy_level -= 1;
!}
go-to: budget_review

@budget_tax_higher
title: Raise Autonomic Taxes
choose-if: economy_budget_tax_higher
unavailable-subtitle: Our proposal is already changing Autonomic Taxes as radically as it can be done in one pass.
on-arrival: {!
    Q.economy_budget_proposal.tax_policy_level += 1;
!}
go-to: budget_review

@budget_cap_lower
title: Lower social spending authorization
choose-if: economy_budget_cap_lower
unavailable-subtitle: The proposed social spending caps are already as lower as they can be.
on-arrival: {!
    Q.economy_budget_proposal.social_spending_cap -= 1;
!}
go-to: budget_review

@budget_cap_higher
title: Raise social spending authorization
choose-if: economy_budget_cap_higher
unavailable-subtitle: The proposed social spending caps are already as high as they can be.
on-arrival: {!
    Q.economy_budget_proposal.social_spending_cap += 1;
!}
go-to: budget_review

@budget_county
title: [? if economy_budget_county: Remove ?][? if not economy_budget_county: Include ?] county roads expansion
view-if: economy_budget_county_available
on-arrival: {!
    Q.economy_budget_proposal.projects.county = !Q.economy_budget_proposal.projects.county;
!}
go-to: budget_review

@budget_b40
title: [? if economy_budget_b40: Remove ?][? if not economy_budget_b40: Include ?] the B-40 Fourth Belt
view-if: economy_budget_b40_available
on-arrival: {!
    Q.economy_budget_proposal.projects.b40 = !Q.economy_budget_proposal.projects.b40;
!}
go-to: budget_review

