@budget_tax_lower
title: Move towards a lower tax package
choose-if: economy_budget_tax_lower
unavailable-subtitle: Our proposal is already changing the tax package as radically as it can be done in one pass.
on-arrival: {!
    Q.economy_budget_proposal.tax_policy_level -= 1;
!}
go-to: budget_review

@budget_tax_higher
title: Move towards a higher yet more progressive tax package
choose-if: economy_budget_tax_higher
unavailable-subtitle: Our proposal is already changing the tax package as radically as it can be done in one pass.
on-arrival: {!
    Q.economy_budget_proposal.tax_policy_level += 1;
!}
go-to: budget_review

@budget_cap_lower
title: Lower social spending authorization
choose-if: economy_budget_cap_lower
unavailable-subtitle: The proposed social spending caps are already as lower as they can be.
on-arrival: {!
    Q.economy_budget_proposal.social_spending_cap -= 1;
!}
go-to: budget_review

@budget_cap_higher
title: Raise social spending authorization
choose-if: economy_budget_cap_higher
unavailable-subtitle: The proposed social spending caps are already as high as they can be.
on-arrival: {!
    Q.economy_budget_proposal.social_spending_cap += 1;
!}
go-to: budget_review

