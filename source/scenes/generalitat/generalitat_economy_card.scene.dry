title: Ministry of the Economy
new-page: true
view-if: generalitat_economy_timer <= 0 and (economy_minister_party == player_party or (player_in_jxsi and economy_minister_party == "jxsi") or (player_in_jxcat and economy_minister_party == "jxcat"))
on-arrival: {!
    Q.month_actions += 1;
    Q.generalitat_economy_timer += 3;
!}
is-card: true
card-image: img/economy_icon.svg
face-image: img/economy_icon.svg
frequency: 100
tags: generalitat
role: card-gov

