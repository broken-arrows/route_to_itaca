title: Ministry of the Economy
new-page: true
view-if: generalitat_economy_timer <= 0 and (economy_minister_party == player_party or (player_in_jxsi and economy_minister_party == "jxsi") or (player_in_jxcat and economy_minister_party == "jxcat")) and not cat_caretaker_gov
on-arrival: {!
    Q.month_actions += 1;
    Q.generalitat_economy_timer += 4;
    Q.public_salary_raise_pending = Q.public_salary_prepared_level != null &&
        Q.public_salary_prepared_level === Q.public_salary_level + 1;
!}
is-card: true
card-image: img/economy_icon.svg
frequency: 100
tags: generalitat
role: card-gov

= Ministry of the Economy

TODO: more things to do here!

