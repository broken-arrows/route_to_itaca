title: Ministry of Education
new-page: true
view-if: generalitat_education_timer <= 0 and (education_minister_party == player_party or (player_in_jxsi and education_minister_party = "jxsi") or (player_in_jxcat and education_minister_party = "jxcat")) and not cat_caretaker_gov
on-arrival: {!
    Q.month_actions += 1;
    Q.generalitat_education_timer += 4;
    Q.education_raise_pending = Q.education_prepared_level != null &&
        Q.education_prepared_level === Q.education_spending + 1;
!}
call: generalitat_education_card.policy_prepare
is-card: true
card-image: img/generalitat/educacio.jpg
face-image: img/generalitat/educacio.jpg
frequency: 100
tags: generalitat
role: card-gov

= Ministry of Education

The Ministry of Education handles the second-largest budget in the Generalitat. What should we do here?

- @school_policy
- @education_public
- @education_expand
- @revert_cuts
- @education_de_public
- @education_cuts
- @education_privatize
- @education_de_privatize
- @post_event: We don't want to do anything in this ministry at the moment
- @easy_discard

@education_public
title: Roll out a Public-only Educational system
subtitle: Such a landmark policy would ultimately need the Parlament's approval \[-2 budget if passed\]\[-1 resources\]
view-if: education_spending >= 2
choose-if: education_spending = 2 and social_spending_cap = 3 and not education_public_introduced and government_budget >= 2 and party_resources > 0
unavailable-subtitle: [? if education_spending = 3: Public education already covers the whole system.?][? if social_spending_cap < 3: The current social spending cap does not allow for this level of investment. ?][? if education_public_introduced: This proposal is waiting on the Parlament's approval. ?][? if government_budget < 2: Not enough budget. ?][? if party_resources <= 0: Not enough resources. ?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.education_minister_party) && !Q.cat_caretaker_gov && Q.education_spending == 2 && Q.social_spending_cap == 3 && !Q.education_public_introduced && Q.government_budget >= 2 && Q.party_resources > 0) {
        Q.education_public_introduced = true;
        Q.party_resources -= 1;
        G.registerLaw(Q, {id:"education_public_proposal", title:"Public-Only Education Proposal",
                    colour:"gray", icon:"img/education_icon.svg",
                    description:"Pending parliamentary approval: Public schools and universities would cover all education needs, while private circuits would be severely restricted, if not de-facto outlawed.",
                    targets:{}});
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations += 2 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] -= 4 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations -= 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += 3 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations += 4 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations -= 3 * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations -= 3 * (coalitionPartners.includes("cs") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += -4 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += -4 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += -3 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += -3 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += -3 * (coalitionPartners.includes("vox") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] -= 4 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent -= 5;
            Q.erc_core_dissent -= 1;
            Q.erc_pragmatic_dissent += 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent -= 6;
            Q.cup_poblelliure_dissent -= 2;
            Q.cup_thirdsector_dissent -= 4;
        }
    }
!}

All executive preparations have been made, and a landmark law is ready to make it so that public schools and universities would cover all education needs. Private and charter circuits are to be be severely restricted, which in practical terms means they will exist only as a ridiculously small niche in a grey legal area. The Parlament must, nonetheless, approve of such a policy first. [? if education_public_ruling: The existing Constitutional ruling, however, does mean that private institutions will still have to be allowed to operate alongside the public system. ?]

@education_de_public
title: Re-introduce some private-circuit Education
view-if: education_spending = 3
subtitle: Requires the Parlament's approval \[ +1 budget if passed\]\[-1 resources\]
choose-if: not education_de_public_introduced and party_resources > 0
unavailable-subtitle: [? if education_de_public_introduced: This proposal is waiting on the Parlament's approval. ?][? if party_resources <= 0: Not enough resources. ?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.education_minister_party) && !Q.cat_caretaker_gov && Q.education_spending == 3 && !Q.education_de_public_introduced && Q.party_resources > 0) {
        Q.education_de_public_introduced = true;
        Q.party_resources -= 1;
        G.registerLaw(Q, {id:"education_de_public_proposal", title:"Mixed Education System Proposal",
                    colour:"gray", icon:"img/education_icon.svg",
                    description:"Pending parliamentary approval: Private and charter schools would operate alongside the modernized public education system.",
                    targets:{}});
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations -= 2 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += 4 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations += 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] -= 3 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations -= 4 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += 3 * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations += 3 * (coalitionPartners.includes("cs") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 4 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 4 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 3 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 3 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += 3 * (coalitionPartners.includes("vox") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += 4 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += 5;
            Q.erc_core_dissent += 1;
            Q.erc_pragmatic_dissent -= 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += 6;
            Q.cup_poblelliure_dissent += 2;
            Q.cup_thirdsector_dissent += 4;
        }
    }
!}

We are asking the Parlament to replace the public-only education framework with a mixed system. Public schools will retain their expanded funding and modernization, while private and charter institutions will again have a place in the education circuit.

@education_expand
title: Expand Education funding
view-if: education_spending >= 0 and education_spending < 2
subtitle: \[-1 budget [? if education_spending >= social_spending_cap: on spending cap increase approval ?] \]
choose-if: government_budget > 0 and not education_raise_pending
unavailable-subtitle: [? if government_budget <= 0: Not enough budget.?][? if education_raise_pending: This increase is already awaiting budget authorization.?]
go-to: approve_raise

@education_cuts
title: Cut Education funding
subtitle: This goes against the party line, but money does have to come from somewhere \[ +1 budget\]
choose-if: education_spending < 3 and education_spending > -2
unavailable-subtitle: There's nothing left to cut...
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.education_minister_party) && !Q.cat_caretaker_gov && Q.education_spending > -2 && Q.education_spending < 3) {
        var previousLevel = Q.education_spending;
        Q.education_spending -= 1;
        Q.burdens_broken = true;
        Q.education_prepared_level = null;
        G.deactivateLaw(Q, "education_spending_proposal", undefined, true);
        Q.government_budget += 1;
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations += (previousLevel > 0 ? -2 : -1) * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations += (previousLevel > 0 ? -2 : -1) * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += (previousLevel > 0 ? -3 : -2) * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations -= 2 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("cs") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 0 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 0 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += (previousLevel > 0 ? 1 : 0) * (coalitionPartners.includes("vox") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += (previousLevel > 0 ? 1 : 0) * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += previousLevel <= 0 ? 2 : 3;
            Q.erc_core_dissent += 1;
            Q.erc_pragmatic_dissent += previousLevel <= 0 ? 1 : 0;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += 3;
            Q.cup_poblelliure_dissent += 1;
            Q.cup_thirdsector_dissent += 3;
        }
        var voterPolicies = [{demographics:(previousLevel - 1) < 0 ? {young:0.9,ind:0.8,unemployed:0.7,middle:0.7,retired:0.15} : (previousLevel - 1) == 0 ? {young:0.65,ind:0.5,unemployed:0.5,middle:0.5,retired:0.1} : {young:0.85,ind:0.6,unemployed:0.5,middle:0.65,retired:0.1}, provinces:{barcelona:1,girona:0.95,lleida:0.95,tarragona:1.05}, routes:(null), sign:-1, congreso:(previousLevel <= 0 ? 0.045 : previousLevel == 1 ? 0.035 : 0.04), barcelona:(previousLevel <= 0 ? 0.09 : previousLevel == 1 ? 0.07 : 0.08)}];

        // Policy voters: explicit demographic/province transfers, with ministry responsibility 80/20.
        var voterOrigin = Q.player_party;
        var voterCabinet = Array.from(new Set(Q.cat_coalition || []));
        // Allocate ministry responsibility once across unique Parlament ballot carriers.
        var voterActors = [];
        for (var voterParty of [voterOrigin].concat(voterCabinet)) {

            var voterCandidates = [voterParty];
            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        for (var voterPolicy of voterPolicies) {
            var voterCells = [];
            for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || []) {
                var voterAmount = (voterPolicy.demographics[voterDemo] || 0) * (voterPolicy.provinces[voterProvince] || 0);
                if (voterAmount) voterCells.push({contest:"parlament",province:voterProvince,demo:voterDemo,amount:voterAmount});
            }
            if (voterPolicy.congreso && (Q.congreso_constituencies || []).includes("catalunya")) voterCells.push({contest:"congreso",province:"catalunya",demo:null,amount:voterPolicy.congreso});
            if (voterPolicy.barcelona) voterCells.push({contest:"barcelona",province:null,demo:null,amount:voterPolicy.barcelona});
            for (var voterCell of voterCells) {
                var voterContest = voterCell.contest;
                var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
                var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
                var voterSignedAmount = voterCell.amount * (Math.abs(voterPolicy.sign));
                if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
                var voterDirection = voterPolicy.sign > 0 ? 1 : -1;
                for (var voterActor of voterActors) {
                    var voterRouteList = voterPolicy.routes || (voterActor.origin == "erc" ? [["cup",0.45],["fl",0.35],["abstain",0.20]] : voterActor.origin == "cup" ? [["fl",0.45],["erc",0.35],["abstain",0.20]] : voterActor.origin == "psc" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : ["ecp","cecp","csqp","icv"].includes(voterActor.origin) ? [["cup",0.40],["erc",0.30],["abstain",0.30]] : [["erc",0.40],["fl",0.35],["abstain",0.25]]);
                    for (var voterRoute of voterRouteList) {
                        var voterPair = [];
                        for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                            var voterCandidates = [voterParty];
                            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                            if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                            if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                            if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                            var voterCarrier = null;
                            for (var voterCandidate of voterCandidates) {
                                if (!voterLineup.includes(voterCandidate)) continue;
                                if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                                if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                            }
                            voterPair.push(voterCarrier);
                        }
                        if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                        var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                        var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                        if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                        if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                        G.cardSupportTransfer(Q,voterOptions);

                    }
                }
            }
        }
    }
!}
call: generalitat_setpolicy

Going against the historic party line, we've had no other choice but to cut back some spending in Education. This is understandably disliked by many, let's hope this is a necessary sacrifice.

@education_de_privatize
title: Re-introduce public schooling in-force
subtitle: This will require the Parlament's approval \[-2 budget if passed\]\[-1 resources\]
view-if: education_spending = -3
choose-if: not education_de_privatization_introduced and government_budget >= 2 and party_resources > 0
unavailable-subtitle: [? if education_de_privatization_introduced: This proposal is waiting on the Parlament's approval. ?][? if government_budget < 2: Not enough budget. ?][? if party_resources <= 0: Not enough resources. ?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.education_minister_party) && !Q.cat_caretaker_gov && Q.education_spending == -3 && !Q.education_de_privatization_introduced && Q.government_budget >= 2 && Q.party_resources > 0) {
        Q.education_de_privatization_introduced = true;
        Q.party_resources -= 1;
        G.registerLaw(Q, {id:"education_de_privatization_proposal", title:"Restored Public Education",
                    colour:"gray", icon:"img/education_icon.svg",
                    description:"Pending parliamentary approval: Public schools would reopen alongside the remaining charter and private institutions, reversing full privatization.",
                    targets:{}});
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations += 3 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += 1 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations += 2 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += 3 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations += 3 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += ((Q.cat_coalition || []).includes("cs") ? -1 : 1) * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations -= 2 * (coalitionPartners.includes("cs") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 1 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 1 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += -2 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += -2 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += -2 * (coalitionPartners.includes("vox") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += 1 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent -= 8;
            Q.erc_core_dissent -= 3;
            Q.erc_pragmatic_dissent -= 2;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent -= 5;
            Q.cup_poblelliure_dissent -= 2;
            Q.cup_thirdsector_dissent -= 5;
        }
    }
!}

Reverting course after the disastrous policy of education privatization, we are getting the Education Ministry ready for re-opening many public schools across Catalonia. The final kick forward for this will have to come from the Parlament though, as the previous legislative changes introduced to make this possible in the first place need to be voted away.

@education_privatize
title: Work towards fully privatizing Education
subtitle: This is considered extremely radical by much of the Catalan population, and will ultimately require approval from the Parlament. \[ +2 budget if passed\]\[-1 resources\]
view-if: education_spending <= -2
choose-if: education_spending = -2 and not education_privatization_introduced and player_party != "cup" and party_resources > 0
unavailable-subtitle: [? if education_spending = -3: Education has already been privatized! ?][? if education_privatization_introduced and not education_spending = -3: This proposal is waiting on the Parlament's approval. ?][? if player_party = "cup": There's no way our party can embark on this path. ?][? if party_resources <= 0: Not enough resources. ?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.education_minister_party) && !Q.cat_caretaker_gov && Q.education_spending == -2 && !Q.education_privatization_introduced && Q.player_party != "cup" && Q.party_resources > 0) {
        Q.education_privatization_introduced = true;
        Q.party_resources -= 1;
        G.registerLaw(Q, {id:"education_privatization_proposal", title:"Fully Privatized Education",
                    colour:"gray", icon:"img/education_icon.svg",
                    description: "Pending parliamentary approval: The public education system is to effectively be a thing of the past. While some guarantees for universal education access will still exist via charter schools and education grants, the fact is that the most families and individuals will have to bear the weight of schooling.",
                    targets:{}});
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations -= 4 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]) && Q.parlament_current_ciu != "pdcat")
            Q[Q.parlament_current_ciu + "_relations"] -= 1 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations -= 4 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] -= 5 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations -= 6 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += ((Q.cat_coalition || []).includes("cs") ? 1 : -1) * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations += 3 * (coalitionPartners.includes("cs") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 0 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 0 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 3 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 3 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += 3 * (coalitionPartners.includes("vox") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] -= 1 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += 12;
            Q.erc_core_dissent += 6;
            Q.erc_pragmatic_dissent += 4;
            Q.erc_civic_dissent += 2;
        }
    }
!}

Against the wishes of big parts of the party, who accuse us of going against everything [+ player_party +] has stood for, we have put together a proposal for pushing the Catalan education system as close as possible to full privatization. This will, nonetheless, require approval from the Parlament.

@revert_cuts
title: Revert Education spending cuts
view-if: education_spending < 0 and education_spending > -3
subtitle: \[-1 budget budget [? if education_spending >= social_spending_cap: on spending cap increase approval ?] \]
choose-if: government_budget > 0 and not education_raise_pending
unavailable-subtitle: [? if government_budget <= 0: Not enough budget.?][? if education_raise_pending: This increase is already awaiting budget authorization.?]
go-to: approve_raise

@approve_raise
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.education_minister_party) && !Q.cat_caretaker_gov && Q.education_spending >= -2 && Q.education_spending < 2 && Q.government_budget > 0 && (Q.education_prepared_level == null || Q.education_prepared_level !== Q.education_spending + 1)) {
        var previousLevel = Q.education_spending;
        Q.government_budget -= 1;
        Q.education_raise_delivered = Q.education_spending + 1 <= Q.social_spending_cap;
        if (Q.education_raise_delivered) {
            Q.education_spending += 1;
            if (Q.burdens_start_countdown > 0 || Q.burdens_start_trigger || Q.burdens_goal > 0 && Q.burdens_time > 0) Q.burdens_done += 1;
            Q.education_prepared_level = null;
            G.deactivateLaw(Q, "education_spending_proposal", undefined, true);
        } else {
            Q.education_prepared_level = Q.education_spending + 1;
            G.registerLaw(Q, {id:"education_spending_proposal", electoral_origin:Q.player_party, electoral_cabinet:Array.from(new Set(Q.cat_coalition || [])), title:"Education Spending Increase",
                colour:"gray", icon:"img/education_icon.svg",
                description:"Pending budget approval: will take effect the moment a higher spending cap authorizes it.", targets:{}});
        }
        // Cabinet partners include the constituents of their unity lists.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations += (previousLevel < 0 ? 1 : 2) * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations += (previousLevel < 0 ? 1 : 2) * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += (previousLevel < 0 ? 2 : 3) * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations += 2 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("cs") ? 2 : 1);
        // An outside cabinet list follows its CiU-family leadership.
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 0 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 0 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += (previousLevel < 0 ? 0 : -1) * (coalitionPartners.includes("vox") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += (previousLevel < 0 ? 0 : -1) * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += previousLevel < 0 ? -2 : -3;
            Q.erc_core_dissent -= 1;
            Q.erc_pragmatic_dissent += previousLevel < 0 ? -1 : 0;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent -= 3;
            Q.cup_poblelliure_dissent -= 1;
            Q.cup_thirdsector_dissent -= 3;
        }
        if (Q.education_raise_delivered) {
            var voterPolicies = [{demographics:previousLevel < 0 ? {young:0.9,ind:0.8,unemployed:0.7,middle:0.7,retired:0.15} : previousLevel == 0 ? {young:0.65,ind:0.5,unemployed:0.5,middle:0.5,retired:0.1} : {young:0.85,ind:0.6,unemployed:0.5,middle:0.65,retired:0.1}, provinces:{barcelona:1,girona:0.95,lleida:0.95,tarragona:1.05}, routes:(Q.player_party == "cup" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : [["psc",0.45],["fl",0.30],["abstain",0.25]]), sign:1, congreso:(previousLevel < 0 ? 0.045 : previousLevel == 0 ? 0.035 : 0.04), barcelona:(previousLevel < 0 ? 0.09 : previousLevel == 0 ? 0.07 : 0.08)}];

            // Policy voters: explicit demographic/province transfers, with ministry responsibility 80/20.
            var voterOrigin = Q.player_party;
            var voterCabinet = Array.from(new Set(Q.cat_coalition || []));
            // Allocate ministry responsibility once across unique Parlament ballot carriers.
            var voterActors = [];
            for (var voterParty of [voterOrigin].concat(voterCabinet)) {

                var voterCandidates = [voterParty];
                if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
                var voterCarrier = null;
                for (var voterCandidate of voterCandidates) {
                    if (!(Q.parties || []).includes(voterCandidate)) continue;
                    for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                        if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                    if (voterCarrier) break;
                }
                if (voterParty == voterOrigin && !voterCarrier) break;
                if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
            }
            for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
                voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
            for (var voterPolicy of voterPolicies) {
                var voterCells = [];
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || []) {
                    var voterAmount = (voterPolicy.demographics[voterDemo] || 0) * (voterPolicy.provinces[voterProvince] || 0);
                    if (voterAmount) voterCells.push({contest:"parlament",province:voterProvince,demo:voterDemo,amount:voterAmount});
                }
                if (voterPolicy.congreso && (Q.congreso_constituencies || []).includes("catalunya")) voterCells.push({contest:"congreso",province:"catalunya",demo:null,amount:voterPolicy.congreso});
                if (voterPolicy.barcelona) voterCells.push({contest:"barcelona",province:null,demo:null,amount:voterPolicy.barcelona});
                for (var voterCell of voterCells) {
                    var voterContest = voterCell.contest;
                    var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
                    var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
                    var voterSignedAmount = voterCell.amount * (Math.abs(voterPolicy.sign));
                    if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
                    var voterDirection = voterPolicy.sign > 0 ? 1 : -1;
                    for (var voterActor of voterActors) {
                        var voterRouteList = voterPolicy.routes || (voterActor.origin == "erc" ? [["cup",0.45],["fl",0.35],["abstain",0.20]] : voterActor.origin == "cup" ? [["fl",0.45],["erc",0.35],["abstain",0.20]] : voterActor.origin == "psc" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : ["ecp","cecp","csqp","icv"].includes(voterActor.origin) ? [["cup",0.40],["erc",0.30],["abstain",0.30]] : [["erc",0.40],["fl",0.35],["abstain",0.25]]);
                        for (var voterRoute of voterRouteList) {
                            var voterPair = [];
                            for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                                var voterCandidates = [voterParty];
                                if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                                if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                                if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                                if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                                if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                                if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                                var voterCarrier = null;
                                for (var voterCandidate of voterCandidates) {
                                    if (!voterLineup.includes(voterCandidate)) continue;
                                    if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                                    if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                                }
                                voterPair.push(voterCarrier);
                            }
                            if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                            var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                            var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                            if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                            if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                            G.cardSupportTransfer(Q,voterOptions);

                        }
                    }
                }
            }
        }
    }
!}
call: generalitat_setpolicy

[? if education_raise_delivered and education_spending <= 0: Austerity measures affecting public education have been reversed, but years of spending cuts have left a mark. Significant effort remains to recover and improve the system.?][? if education_raise_delivered and education_spending > 0: We've invested further in Education, giving the system much needed breathing room and modernization.?][? if not education_raise_delivered: While the increase has been approved, it will only take effect when a passed budget raises the social spending cap. ?]

@policy_prepare
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    var month = Q.year * 12 + Q.month;
    Q.education_policy_controls_education = controlledParties.includes(Q.education_minister_party) && !Q.cat_caretaker_gov;
    Q.education_policy_controls_bnl = controlledParties.includes(Q.bnl_minister_party);
    Q.education_policy_revision_ready = Q.education_policy_next_revision_month == null || month >= Q.education_policy_next_revision_month;
    Q.education_policy_can_edit = Q.education_policy_controls_education && Q.education_policy_revision_ready && Q.government_budget >= 1 && Q.education_spending >= 0;
    var available = {language:Q.education_spending >= 0, democratic:Q.education_spending >= 0, humanities:Q.education_spending >= 0,
        science:Q.education_spending >= 1, vocational:Q.education_spending >= 1 && Q.education_policy_controls_bnl,
        segregation:Q.education_spending >= 2};
    for (var focus of Object.keys(available)) Q["education_policy_" + focus + "_available"] = available[focus];
    var names = {language:"Catalan-language protection", democratic:"Democratic schooling and coeducation", humanities:"Humanities and cultural education",
        science:"Science and digital skills", vocational:"Vocational training", segregation:"Anti-segregation"};
    Q.education_policy_main_name = names[Q.education_policy_draft_main] || "Not selected";
    Q.education_policy_secondary_name = names[Q.education_policy_draft_secondary] || "Not selected";
    Q.education_policy_draft_valid = !!available[Q.education_policy_draft_main] && !!available[Q.education_policy_draft_secondary] &&
        Q.education_policy_draft_main != Q.education_policy_draft_secondary;
    Q.education_policy_draft_changed = Q.education_policy_draft_main != Q.education_policy_main || Q.education_policy_draft_secondary != Q.education_policy_secondary;
    Q.education_policy_can_apply = Q.education_policy_can_edit && Q.education_policy_draft_valid && Q.education_policy_draft_changed;
!}

@school_policy
title: Revise the Education Curriculum
subtitle: \[-1 budget\]
choose-if: education_policy_can_edit
unavailable-subtitle: [? if not education_policy_controls_education: The current government is in caretaking capacity.?][? if not education_policy_revision_ready: We'd be rewriting the recently-revised curriculum too soon. ?][? if education_spending < 0: Cuts to Education funding need to be reversed first. ?][? if government_budget < 1: Not enough budget.?]
on-arrival: {!
    Q.education_policy_draft_main = Q.education_policy_main || null;
    Q.education_policy_draft_secondary = Q.education_policy_secondary || null;
!}
go-to: policy_review

@policy_review
new-page: true
call: generalitat_education_card.policy_prepare

= School policy

Main focus: **[+ education_policy_main_name +]**.

Secondary focus: **[+ education_policy_secondary_name +]**.

- @policy_main
- @policy_secondary
- @policy_apply

@policy_main
title: Choose the new curriculum's main focus
choose-if: education_policy_can_edit
on-arrival: education_policy_stage = "main"
go-to: policy_focus

@policy_secondary
title: Choose the new curriculum's secondary focus
choose-if: education_policy_can_edit and education_policy_draft_main != null
on-arrival: education_policy_stage = "secondary"
go-to: policy_focus

@policy_focus
new-page: true
call: generalitat_education_card.policy_prepare

Choose the [? if education_policy_stage = "main": main?][? if education_policy_stage = "secondary": secondary?] focus of our new Education curriculum.

- @policy_language
- @policy_democratic
- @policy_humanities
- @policy_science
- @policy_vocational
- @policy_segregation
- @policy_review: Return to the draft

@policy_language
title: Catalan-language protection
subtitle: Strengthen the Catalan model of language immersion, with better teacher preparation and inclusion for the newly arrived.
view-if: education_policy_stage != "secondary" or education_policy_draft_main != "language"
choose-if: education_policy_can_edit and education_policy_language_available
unavailable-subtitle: Cuts to Education funding need to be reversed first.
on-arrival: education_policy_selection = "language"
go-to: policy_select

@policy_democratic
title: Democratic schooling and coeducation
subtitle: Develop critical thinking, equality and student participation.
view-if: education_policy_stage != "secondary" or education_policy_draft_main != "democratic"
choose-if: education_policy_can_edit and education_policy_democratic_available
unavailable-subtitle: Cuts to Education funding need to be reversed first.
on-arrival: education_policy_selection = "democratic"
go-to: policy_select

@policy_humanities
title: Humanities and cultural education
subtitle: Develop arts, literature, history and Catalan-cenered cultural education.
view-if: education_policy_stage != "secondary" or education_policy_draft_main != "humanities"
choose-if: education_policy_can_edit and education_policy_humanities_available
unavailable-subtitle: Cuts to Education funding need to be reversed first.
on-arrival: education_policy_selection = "humanities"
go-to: policy_select

@policy_science
title: Science and digital skills
subtitle: Strengthen laboratory teaching, scientific literacy and digital skills.
view-if: education_policy_stage != "secondary" or education_policy_draft_main != "science"
choose-if: education_policy_can_edit and education_policy_science_available
unavailable-subtitle: We'd need further funding for Education to do this.
on-arrival: education_policy_selection = "science"
go-to: policy_select

@policy_vocational
title: Vocational training and industry integration
subtitle: Expand higher-education pathways, practical training and routes into employment.
view-if: education_policy_stage != "secondary" or education_policy_draft_main != "vocational"
choose-if: education_policy_can_edit and education_policy_vocational_available
unavailable-subtitle: [? if education_spending < 1: We'd need further funding for Education to do this.?][? if not education_policy_controls_bnl: We don't control the Business and Labour Ministry.?]
on-arrival: education_policy_selection = "vocational"
go-to: policy_select

@policy_segregation
title: Anti-segregation methods
subtitle: Public funding would stop flowing into gender-segregated schools, and more resources would be put against such religious-promoted discriminatory systems.
view-if: education_policy_stage != "secondary" or education_policy_draft_main != "segregation"
choose-if: education_policy_can_edit and education_policy_segregation_available
unavailable-subtitle: We'd need further funding for Education to do this.
on-arrival: education_policy_selection = "segregation"
go-to: policy_select

@policy_select
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    var minimum = {language:0, democratic:0, humanities:0, science:1, vocational:1, segregation:2};
    var focus = Q.education_policy_selection;
    var month = Q.year * 12 + Q.month;
    if (controlledParties.includes(Q.education_minister_party) && !Q.cat_caretaker_gov && Q.government_budget >= 1 &&
        (Q.education_policy_next_revision_month == null || month >= Q.education_policy_next_revision_month) &&
        Object.prototype.hasOwnProperty.call(minimum, focus) && Q.education_spending >= minimum[focus] &&
        (focus != "vocational" || controlledParties.includes(Q.bnl_minister_party))) {
        if (Q.education_policy_stage == "main") {
            Q.education_policy_draft_main = focus;
            if (Q.education_policy_draft_secondary == focus) Q.education_policy_draft_secondary = null;
        } else if (Q.education_policy_stage == "secondary" && Q.education_policy_draft_main && Q.education_policy_draft_main != focus) {
            Q.education_policy_draft_secondary = focus;
        }
    }
    Q.education_policy_selection = null;
    Q.education_policy_stage = null;
!}
go-to: policy_review

@policy_apply
title: Enact this Curriculum!
subtitle: \[-1 budget\]
choose-if: education_policy_can_apply
unavailable-subtitle: [? if not education_policy_draft_valid: Two focuses need to be chosen.?][? if not education_policy_draft_changed: This is already our Curriculum.?][? if not education_policy_controls_education: The government is currently in caretaking capacity, how did you reach this point? ?][? if not education_policy_revision_ready: It's not possible to enact this proposed Curriculum.?][? if government_budget < 1: Not enough budget.?]
on-arrival: {!
    // Relations order: ERC, CiU family, PSC, ICV family, CUP, PPC, Cs,
    // independent Unio, split PDeCAT, Vox, FNC, PxC. Values are main-focus affinities.
    var focuses = {
        language:{name:"Catalan-language protection", minimum:0,
            description:"Strengthen the Catalan model of language immersion, with better teacher preparation and inclusion for the newly arrived.",
            relations:[2,2,0,1,2,-3,-4,1,2,-4,3,-3], erc:[-1,-2,0,-3], cup:[-1,-3,-1]},
        democratic:{name:"Democratic schooling and coeducation", minimum:0,
            relations:[2,-1,2,3,2,-2,1,-2,0,-4,-2,-3], erc:[-2,-2,0,0], cup:[-2,-1,-2]},
        humanities:{name:"Humanities and cultural education", minimum:0,
            relations:[1,1,1,1,1,0,0,1,1,0,1,0], erc:[-1,-1,0,0], cup:[-1,-1,-1]},
        science:{name:"Science and digital skills", minimum:1,
            relations:[1,2,1,1,0,1,2,1,2,1,1,1], erc:[-1,0,-1,0], cup:[0,0,-1]},
        vocational:{name:"Vocational training and industry integration", minimum:1,
            relations:[2,2,2,1,1,1,2,2,2,1,1,1], erc:[-1,0,-2,0], cup:[-1,-1,-2]},
        segregation:{name:"Anti-segregation methods", minimum:2,
            relations:[3,-2,3,3,4,-1,1,-2,-1,-3,-3,-4], erc:[-4,-1,1,0], cup:[-4,-1,-4]}
    };
    var main = Q.education_policy_draft_main;
    var secondary = Q.education_policy_draft_secondary;
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    var month = Q.year * 12 + Q.month;
    var valid = Object.prototype.hasOwnProperty.call(focuses, main) && Object.prototype.hasOwnProperty.call(focuses, secondary) && main != secondary;
    Q.education_policy_applied = false;
    if (valid && controlledParties.includes(Q.education_minister_party) && !Q.cat_caretaker_gov && Q.government_budget >= 1 &&
        (Q.education_policy_next_revision_month == null || month >= Q.education_policy_next_revision_month) &&
        Q.education_spending >= focuses[main].minimum && Q.education_spending >= focuses[secondary].minimum &&
        (main != "vocational" && secondary != "vocational" || controlledParties.includes(Q.bnl_minister_party)) &&
        (main != Q.education_policy_main || secondary != Q.education_policy_secondary)) {
        var relations = Array(12).fill(0);
        var erc = Array(4).fill(0);
        var cup = Array(3).fill(0);
        // React to a change in emphasis, not to re-awarding the whole package.
        var packages = [{focus:main, weight:1}, {focus:secondary, weight:0.5},
            {focus:Q.education_policy_main, weight:-1}, {focus:Q.education_policy_secondary, weight:-0.5}];
        for (var item of packages) {
            if (!Object.prototype.hasOwnProperty.call(focuses, item.focus)) continue;
            var focus = focuses[item.focus];
            for (var i = 0; i < relations.length; i++) relations[i] += focus.relations[i] * item.weight;
            for (var i = 0; i < erc.length; i++) erc[i] += focus.erc[i] * item.weight;
            for (var i = 0; i < cup.length; i++) cup[i] += focus.cup[i] * item.weight;
        }

        // Replace the current curriculum's realized voter response before applying its new 1 / 0.5 package.
        // Store only the current law's response: revisiting packages cannot accumulate saturation differences.
        var voterPrevious = (Q.active_mods || {}).education_school_policy;
        for (var voterTransfer of voterPrevious && voterPrevious.def.electoral_transfers || []) {
            var voterLineup = voterTransfer.contest == "parlament" ? (Q.parties || []).concat(["abstain"]) :
                voterTransfer.contest == "congreso" ? (Q["congreso_parties_" + voterTransfer.province] || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterTransfer.contest == "parlament" ? "_parlament_" + voterTransfer.province + "_" + voterTransfer.demo + "_support" :
                voterTransfer.contest == "congreso" ? "_congreso_" + voterTransfer.province + "_support" : "_local_barcelona_support";
            var voterResolved = [];
            for (var voterRequested of [voterTransfer.from, voterTransfer.to]) {
                var voterCandidates = [voterRequested];
                if (["erc","cup"].includes(voterRequested)) voterCandidates =
                    (Q[voterRequested + "_in_jxsi"] ? ["jxsi"] : []).concat(Q[voterRequested + "_in_jxcat"] ? ["jxcat"] : [], [voterRequested]);
                if (voterRequested == "ciu") voterCandidates = Array.from(new Set([Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"]));
                if (voterRequested == "fl") voterCandidates = voterTransfer.contest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : voterTransfer.contest == "barcelona" ? ["bcomu","icv"] : ["ecp","cecp","csqp","icv"];
                if (voterRequested == "psc" && voterTransfer.contest == "congreso") voterCandidates = ["psc","psoe"];
                if (voterRequested == "ppc" && voterTransfer.contest != "parlament") voterCandidates = ["pp"];
                var voterCarrier = null;
                for (var voterCandidate of voterCandidates) {
                    if (["jxsi","jxcat"].includes(voterCandidate) && (voterTransfer.contest == "congreso" && !Q[voterCandidate + "_in_congreso"] || voterTransfer.contest == "barcelona" && !Q[voterCandidate + "_in_local"])) continue;
                    if (voterLineup.includes(voterCandidate) && Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                }
                voterResolved.push(voterCarrier);
            }
            if (!voterResolved[0] || !voterResolved[1] || voterResolved[0] == voterResolved[1]) continue;
            var voterUndo = Math.min(voterTransfer.amount, Q[voterResolved[1] + voterSuffix]);
            if (!(voterUndo > 0)) continue;
            Q[voterResolved[1] + voterSuffix] -= voterUndo;
            Q[voterResolved[0] + voterSuffix] += voterUndo;
        }
        var voterRecord = [];
        var voterFocuses = {
            language:[{demographics:{young:0.5,middle:0.4,rural:0.45,ind:0.25}, provinces:{barcelona:0.8,girona:1.15,lleida:1.15,tarragona:0.9}, routes:(Q.player_party == "cup" ? [["erc",0.45],["ciu",0.25],["abstain",0.30]] : [["ciu",0.45],["cup",0.30],["abstain",0.25]]), sign:1, congreso:0.02, barcelona:0.04}, {demographics:Q.player_party == "cup" ? {middle:0.04,retired:0.05} : {middle:0.08,retired:0.12}, provinces:{barcelona:1,girona:0.8,lleida:0.8,tarragona:1}, routes:[["ppc",0.4],["cs",0.4],["abstain",0.2]], sign:-1, congreso:0.004, barcelona:0.008}],
            democratic:[{demographics:{young:0.5,middle:0.3,ind:0.35}, provinces:{barcelona:1,girona:0.9,lleida:0.9,tarragona:1}, routes:(Q.player_party == "cup" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : [["fl",0.40],["psc",0.35],["abstain",0.25]]), sign:1, congreso:0.02, barcelona:0.04}, {demographics:Q.player_party == "cup" ? {rural:0.02,retired:0.02} : {rural:0.04,retired:0.04}, provinces:{barcelona:1,girona:1,lleida:1,tarragona:1}, routes:null, sign:-1, backlash:true, congreso:0.002, barcelona:0.004}],
            humanities:[{demographics:{young:0.25,middle:0.2,rural:0.1}, provinces:{barcelona:1,girona:1.1,lleida:1,tarragona:1}, routes:(Q.player_party == "cup" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : [["psc",0.45],["fl",0.30],["abstain",0.25]]), sign:1, congreso:0.01, barcelona:0.02}],
            science:[{demographics:{young:0.65,middle:0.45,buss:0.15}, provinces:{barcelona:1,girona:1,lleida:1,tarragona:1}, routes:(Q.player_party == "cup" ? [["fl",0.40],["erc",0.35],["abstain",0.25]] : [["psc",0.40],["ciu",0.35],["abstain",0.25]]), sign:1, congreso:0.025, barcelona:0.05}],
            vocational:[{demographics:{young:0.9,ind:0.7,unemployed:0.8,buss:0.2}, provinces:{barcelona:1,girona:0.85,lleida:0.85,tarragona:1.05}, routes:(Q.player_party == "cup" ? [["fl",0.40],["erc",0.35],["abstain",0.25]] : [["psc",0.40],["ciu",0.35],["abstain",0.25]]), sign:1, congreso:0.04, barcelona:0.08}],
            segregation:[{demographics:{young:0.8,ind:0.85,unemployed:0.8,middle:0.35}, provinces:{barcelona:1,girona:0.8,lleida:0.8,tarragona:1}, routes:(Q.player_party == "cup" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : [["fl",0.40],["psc",0.35],["abstain",0.25]]), sign:1, congreso:0.035, barcelona:0.07}, {demographics:Q.player_party == "cup" ? {buss:0.04,middle:0.04} : {buss:0.1,middle:0.1}, provinces:{barcelona:1,girona:0.8,lleida:0.8,tarragona:1}, routes:null, sign:-1, backlash:true, congreso:0.003, barcelona:0.006}]
        };
        var voterPolicies = [];
        for (var voterItem of [{focus:main,weight:1},{focus:secondary,weight:0.5}]) {
            for (var voterFocusPolicy of voterFocuses[voterItem.focus])
                voterPolicies.push({demographics:voterFocusPolicy.demographics,provinces:voterFocusPolicy.provinces,routes:voterFocusPolicy.routes,backlash:voterFocusPolicy.backlash,sign:voterItem.weight * voterFocusPolicy.sign, congreso:voterFocusPolicy.congreso, barcelona:voterFocusPolicy.barcelona});
        }

        // Policy voters: explicit demographic/province transfers, with ministry responsibility 80/20.
        var voterOrigin = Q.player_party;
        var voterCabinet = Array.from(new Set(Q.cat_coalition || []));
        // Allocate ministry responsibility once across unique Parlament ballot carriers.
        var voterActors = [];
        for (var voterParty of [voterOrigin].concat(voterCabinet)) {

            var voterCandidates = [voterParty];
            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        for (var voterPolicy of voterPolicies) {
            var voterCells = [];
            for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || []) {
                var voterAmount = (voterPolicy.demographics[voterDemo] || 0) * (voterPolicy.provinces[voterProvince] || 0);
                if (voterAmount) voterCells.push({contest:"parlament",province:voterProvince,demo:voterDemo,amount:voterAmount});
            }
            if (voterPolicy.congreso && (Q.congreso_constituencies || []).includes("catalunya")) voterCells.push({contest:"congreso",province:"catalunya",demo:null,amount:voterPolicy.congreso});
            if (voterPolicy.barcelona) voterCells.push({contest:"barcelona",province:null,demo:null,amount:voterPolicy.barcelona});
            for (var voterCell of voterCells) {
                var voterContest = voterCell.contest;
                var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
                var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
                var voterSignedAmount = voterCell.amount * (Math.abs(voterPolicy.sign));
                if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
                var voterDirection = voterPolicy.sign > 0 ? 1 : -1;
                for (var voterActor of voterActors) {
                    var voterRouteList = voterPolicy.routes || (voterPolicy.backlash ? (voterActor.origin == "cup" ? [["erc",0.60],["ciu",0.25],["abstain",0.15]] : voterActor.origin == "erc" ? [["ciu",0.60],["cs",0.25],["abstain",0.15]] : [["ciu",0.45],["cs",0.35],["abstain",0.20]]) : (voterActor.origin == "erc" ? [["cup",0.45],["fl",0.35],["abstain",0.20]] : voterActor.origin == "cup" ? [["fl",0.45],["erc",0.35],["abstain",0.20]] : voterActor.origin == "psc" ? [["fl",0.45],["erc",0.30],["abstain",0.25]] : ["ecp","cecp","csqp","icv"].includes(voterActor.origin) ? [["cup",0.40],["erc",0.30],["abstain",0.30]] : [["erc",0.40],["fl",0.35],["abstain",0.25]]));
                    for (var voterRoute of voterRouteList) {
                        var voterPair = [];
                        for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                            var voterCandidates = [voterParty];
                            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                            if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                            if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                            if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                            var voterCarrier = null;
                            for (var voterCandidate of voterCandidates) {
                                if (!voterLineup.includes(voterCandidate)) continue;
                                if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                                if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                            }
                            voterPair.push(voterCarrier);
                        }
                        if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                        var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                        var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                        if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                        if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                        var voterActual = G.cardSupportTransfer(Q,voterOptions);
                        voterRecord.push({contest:voterContest,province:voterCell.province,demo:voterCell.demo,from:voterDirection > 0 ? voterRoute[0] : voterActor.origin,to:voterDirection > 0 ? voterActor.origin : voterRoute[0],amount:voterActual});
                    }
                }
            }
        }
        Q.government_budget -= 1;
        if (Q.burdens_start_countdown > 0 || Q.burdens_start_trigger || Q.burdens_goal > 0 && Q.burdens_time > 0) Q.burdens_done += 1;
        Q.education_policy_main = main;
        Q.education_policy_secondary = secondary;
        Q.education_policy_next_revision_month = month + 12;
        var policy = (Q.active_mods || {}).education_school_policy;
        if (!policy || !policy.active) {
            G.registerLaw(Q, {id:"education_school_policy", targets:{}});
            policy = Q.active_mods.education_school_policy;
        }
        policy.def.electoral_origin = Q.player_party;
        policy.def.electoral_cabinet = Array.from(new Set(Q.cat_coalition || []));
        policy.def.electoral_transfers = voterRecord;
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) if (Q[party + "_in_" + list]) coalitionPartners.push(party);
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations += relations[0] * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += relations[Q.parlament_current_ciu == "unio" ? 7 : 1] * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations += relations[2] * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += relations[3] * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations += relations[4] * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += relations[5] * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations += relations[6] * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += relations[7] * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += relations[8] * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += relations[9] * (coalitionPartners.includes("vox") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc")) {
            // Older saves predate the neutral FNC relations initialization.
            if (Q.fnc_relations == null) Q.fnc_relations = 0;
            if (Number.isFinite(Q.fnc_relations)) Q.fnc_relations += relations[10] * (coalitionPartners.includes("fnc") ? 2 : 1);
        }
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += relations[11] * (coalitionPartners.includes("pxc") ? 2 : 1);
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += relations[1] * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += erc[0];
            Q.erc_core_dissent += erc[1];
            Q.erc_pragmatic_dissent += erc[2];
            Q.erc_civic_dissent += erc[3];
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += cup[0];
            Q.cup_poblelliure_dissent += cup[1];
            Q.cup_thirdsector_dissent += cup[2];
        }
        Q.education_policy_applied = true;
    }
!}
call: generalitat_setpolicy
go-to: wishmaking if not education_policy_applied; education_done if education_policy_applied

@education_done

The Catalan Education system will now prioritize [+ education_policy_main_name +]; and [+ education_policy_secondary_name +]. While it make take a bit, schools and teachers will gradually adopt these principles throughout the country.

- @post_event

