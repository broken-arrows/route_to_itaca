title: Ministry of Education
new-page: true
view-if: generalitat_education_timer <= 0 and (education_minister_party == player_party)
on-arrival: month_actions += 1; generalitat_education_timer += 3;
is-card: true
card-image: img/education_icon.svg
face-image: img/education_icon.svg
frequency: 100
tags: generalitat
role: card-gov

= Ministry of Education

TODO: More things other than funding

