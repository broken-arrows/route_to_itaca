@independence_demand
new-page: true
on-arrival: {!
    Q.coalition_affairs_indy_kind = Q.coalition_affairs_indy_demand.kind;
    Q.coalition_affairs_indy_roadmap = Q.coalition_affairs_indy_demand.roadmap || 0;
    Q.coalition_affairs_indy_law = Q.coalition_affairs_indy_demand.law || "";
!}

[+ coalition_affairs_concession_target +] demands [? if coalition_affairs_indy_kind = "roadmap": that we move towards a [+ coalition_affairs_indy_roadmap : roadmap +] roadmap.?][? if coalition_affairs_indy_kind = "law": that we pass the [? if coalition_affairs_indy_law = "parlament_non_binding_consultations": Law on Non-Binding Consultations?][? if coalition_affairs_indy_law = "parlament_referendum_law": Law on the Referendum?] within six months.?]

- @accept_independence: Accept this new commitment
- @no_change: We refuse to change our goals!

@accept_independence
on-arrival: {!
    var target = Q.coalition_affairs_concession_target;
    var demand = Q.coalition_affairs_indy_demand;
    if (demand && demand.kind == "roadmap") {
        Q[Q.player_party + "_roadmap"] = demand.roadmap;
        Q.player_roadmap = demand.roadmap;
        Q.independence_trust += demand.direction > 0 ? 5 : -15;
        if (Q.player_party == "erc") {
            if (demand.direction > 0) {
                Q.erc_pragmatic_dissent += 10;
                Q.erc_civic_dissent -= 5;
                Q.erc_civic_strength += 5;
            } else {
                Q.erc_civic_dissent += 10;
                Q.erc_pragmatic_dissent -= 5;
                Q.erc_pragmatic_strength += 5;
            }
        } else if (Q.player_party == "cup") {
            if (demand.direction > 0) {
                Q.cup_thirdsector_dissent += 10;
                Q.cup_endavant_dissent -= 5;
                Q.cup_endavant_strength += 5;
            } else {
                Q.cup_endavant_dissent += 10;
                Q.cup_thirdsector_dissent -= 5;
                Q.cup_thirdsector_strength += 5;
            }
        }
        Q.player_roadmap_change_countdown = 9;
        Q.player_roadmap_change_trigger = false;
        if (!Q.countdowns.includes("player_roadmap_change")) Q.countdowns.push("player_roadmap_change");
        Q[target + "_relations"] += 8;
    } else if (demand && demand.kind == "law" && !Q[demand.law]) {
        if (!Q.coalition_indy_commitments) Q.coalition_indy_commitments = [];
        if (!Q.coalition_indy_commitments.some(function(record) { return record.target == target && record.status == "pending"; })) {
            Q.coalition_indy_commitments.push({target: target, law: demand.law, deadline: Q.year * 12 + Q.month + 12, status: "pending"});
            Q[target + "_relations"] += 8;
        }
    }
!}

We have accepted their demand. [? if coalition_affairs_indy_kind = "law": Failure to deliver within a year will heavily damage our relations.?]

@go_chill_demands
title: TODO: if government in Moncloa shares parties with coalition, relax demands to appease
view-if: 1==0

@resources
title: Mobilize our party, focusing on calming them down
subtitle: \[-2 resources\]
view-if: difficulty < 1
choose-if: party_resources > 1
on-arrival: {!
    Q.party_resources -= 2;
    var playerVehicle = Q[Q.player_party + "_in_jxsi"] ? "jxsi" : Q[Q.player_party + "_in_jxcat"] ? "jxcat" : Q.player_party;
    for (var p of Q.cat_coalition) {
        if (p != playerVehicle) {
            if (Q[p + "_relations"] < 55) {
                Q[p + "_relations"] += Q.difficulty < 0 ? 5 : 3;
            }
        }
    }
!}

In a mix of party resource transfers, heartfelt one-on-ones, and an overall party membership mobilization to repair the bonds between our coalition partners, it seems like we've managed to improve the situation, at least somewhat.


@new_elections
title: Call for new elections!
subtitle: While this may be disliked by some partners, we may come back stronger with a new Parlament behind us.
choose-if: president_party = player_party or (player_in_jxsi and president_party = "jxsi") or (player_in_jxcat and president_party = "jxcat")
unavailable-subtitle: We do not control the presidency.
on-arrival: {!
    var playerVehicle = Q[Q.player_party + "_in_jxsi"] ? "jxsi" : Q[Q.player_party + "_in_jxcat"] ? "jxcat" : Q.player_party;
    for (var p of Q.cat_coalition) {
        if (p != playerVehicle) {
            Q[p + "_relations"] -= 7;
        }
    }
!}
go-to: snap_election

@kick_them_out
title: Instead, preemptively kick them out of the government
subtitle: We'll become the heads of a <span class="generalitat-coalition" data-parties="[? if player_in_jxsi: jxsi?][? if player_in_jxcat: jxcat?][? if not (player_in_jxcat or player_in_jxsi): [+ player_party +]?]" data-summary="Minority government - [+ player_parlament_s +]/[+ parlament_s_majority +]"><span style='color: [+ player_party +]; font-weight: bold; font-style: italic'>minority government</span></span> instead.
choose-if: president_party = player_party or (player_in_jxsi and president_party = "jxsi") or (player_in_jxcat and president_party = "jxcat")
unavailable-subtitle: We do not control the presidency.
on-arrival: {!
    var playerVehicle = Q[Q.player_party + "_in_jxsi"] ? "jxsi" : Q[Q.player_party + "_in_jxcat"] ? "jxcat" : Q.player_party;
    for (var p of Q.cat_coalition) {
        if (p != playerVehicle) {
            Q[p + "_relations"] -= 15;
        }
    }
    Q.parlament_coalition_proposal_vp = playerVehicle;
    Q.parlament_coalition_proposal_economy = playerVehicle;
    Q.parlament_coalition_proposal_interior = playerVehicle;
    Q.parlament_coalition_proposal_health = playerVehicle;
    Q.parlament_coalition_proposal_education = playerVehicle;
    Q.parlament_coalition_proposal_bnl = playerVehicle;
    Q.parlament_coalition_proposal_territory = playerVehicle;
    Q.parlament_coalition_proposal_foreign = playerVehicle;
!}
set-jump: post_kick
go-to: parlament_coalition_setnames

We've chosen the nuclear option, and the [+ cat_coalition_disp +] will be no more. Naturally, this greatly displeases all of the coalition members, to put it lightly. Our new government looks as follows:

@post_kick
on-arrival: {!
    for (var record of Q.coalition_policy_commitments || []) {
        if (record.status == "pending_budget" || record.status == "applied") record.status = "retired";
        G.deactivateLaw(Q, "coalition_pending_" + record.kind, undefined, true);
    }
    var playerVehicle = Q[Q.player_party + "_in_jxsi"] ? "jxsi" : Q[Q.player_party + "_in_jxcat"] ? "jxcat" : Q.player_party;
    Q.historical_event = "After heavy coalition disagreements, " +  Q.cat_coalition_disp + " will be no more. " + (Q.president_gender = "m" ? "President " : "Presidenta ") + Q.president + " has reconfigured the government, leaving only " + playerVehicle + " governing at the Generalitat.";
    Q.cat_coalition = [playerVehicle];
    Q.cat_coalition_support = [];
    Q.cat_coalition_abstain = [];
    Q.cat_coalition_disp = '<span class="generalitat-coalition" data-parties="' + playerVehicle + '" data-summary="Minority government - ' + Q.player_parlament_s + '/' + Q.parlament_s_majority + '"><span style="color: ' + playerVehicle + '; font-weight: bold; font-style: italic">minority government</span></span>"'

    Q.president_party = Q.parlament_coalition_proposal_president;
    Q.president_gender = Q.parlament_coalition_proposal_president_gender;
    Q.president = Q.parlament_coalition_proposal_president_name;
    
    Q.vicepresident_party = Q.parlament_coalition_proposal_vp;
    Q.vicepresident = Q.parlament_coalition_proposal_vp_name;
    Q.vicepresident_gender = Q.parlament_coalition_proposal_vp_gender;
    
    Q.economy_minister_party = Q.parlament_coalition_proposal_economy;
    Q.economy_minister = Q.parlament_coalition_proposal_economy_name;
    Q.economy_minister_gender = Q.parlament_coalition_proposal_economy_gender;

    Q.interior_minister_party = Q.parlament_coalition_proposal_interior;
    Q.interior_minister = Q.parlament_coalition_proposal_interior_name;
    Q.interior_minister_gender = Q.parlament_coalition_proposal_interior_gender;

    Q.health_minister_party = Q.parlament_coalition_proposal_health;
    Q.health_minister = Q.parlament_coalition_proposal_health_name;
    Q.health_minister_gender = Q.parlament_coalition_proposal_health_gender;

    Q.education_minister_party = Q.parlament_coalition_proposal_education;
    Q.education_minister = Q.parlament_coalition_proposal_education_name;
    Q.education_minister_gender = Q.parlament_coalition_proposal_education_gender;

    Q.territory_minister_party = Q.parlament_coalition_proposal_territory;
    Q.territory_minister = Q.parlament_coalition_proposal_territory_name;
    Q.territory_minister_gender = Q.parlament_coalition_proposal_territory_gender;

    Q.foreign_minister_party = Q.parlament_coalition_proposal_foreign;
    Q.foreign_minister = Q.parlament_coalition_proposal_foreign_name;
    Q.foreign_minister_gender = Q.parlament_coalition_proposal_foreign_gender;

    Q.bnl_minister_party = Q.parlament_coalition_proposal_bnl;
    Q.bnl_minister = Q.parlament_coalition_proposal_bnl_name;
    Q.bnl_minister_gender = Q.parlament_coalition_proposal_bnl_gender;

    
    if (Q.player_in_jxcat) {
        if (Q.cup_in_jxcat) {
            Q.cup_supporting = true;
            Q.cup_in_gob = true;
        }
        if (Q.erc_in_jxcat) {
            Q.erc_supporting = true;
            Q.erc_in_gob = true;
        }
        Q.jxcat_in_gob = true;
    } else if (Q.player_in_jxsi) {
        if (Q.cup_in_jxsi) {
            Q.cup_supporting = true;
            Q.cup_in_gob = true;
        }
        if (Q.erc_in_jxsi) {
            Q.erc_supporting = true;
            Q.erc_in_gob = true;
        }
        Q.jxsi_in_gob = true;
    } else {
        Q.erc_supporting = Q.player_party == "erc";
        Q.cup_supporting = Q.player_party == "cup";
        Q.erc_in_gob = Q.player_party == "erc";
        Q.cup_in_gob = Q.player_party == "cup";
    }
!}

Let's hope this was the right move. There's no going back now.

@no_change
title: Take none of these actions

It does not look like the issues plaguing our coalition will go away magically, but maybe we can find thinking out of the box instead?

@prepare
title: Prepare coalition concessions
on-arrival: {!
    var playerVehicle = Q[Q.player_party + "_in_jxsi"] ? "jxsi" : Q[Q.player_party + "_in_jxcat"] ? "jxcat" : Q.player_party;
    Q.player_parlament_s = Q[playerVehicle + "_parlament_s"];

    Q.parlament_current_ciu_relations = Q[Q.parlament_current_ciu + "_relations"];
    Q.coalition_affairs_includes_ciu = Q.cat_coalition.includes(Q.parlament_current_ciu) && Q.parlament_current_ciu != "jxsi" && Q.parlament_current_ciu != "jxcat";
    Q.coalition_affairs_includes_erc = Q.cat_coalition.includes("erc");
    Q.coalition_affairs_includes_cup = Q.cat_coalition.includes("cup");
    Q.coalition_affairs_includes_psc = Q.cat_coalition.includes("psc");
    Q.parlament_current_icv_relations = Q[Q.parlament_current_icv + "_relations"];
    Q.coalition_affairs_includes_icv = Q.cat_coalition.includes(Q.parlament_current_icv);
    Q.coalition_affairs_includes_jxsi = Q.cat_coalition.includes("jxsi") && !Q.player_in_jxsi;
    Q.coalition_affairs_includes_jxcat = Q.cat_coalition.includes("jxcat") && !Q.player_in_jxcat;
    Q.coalition_affairs_concession_target = "";

    Q.coalition_affairs_indy_demands = {};
    for (var target of ["erc", "cup", Q.parlament_current_ciu, "jxsi", "jxcat"]) {
        var own = Q[Q.player_party + "_roadmap"];
        var theirs = Q[target + "_roadmap"];
        var direction = Math.sign(theirs - own);
        var canMove = own >= 1 && own <= 3 && theirs >= 1 && theirs <= 3 && direction != 0
            && !Q.player_in_jxsi && !Q.player_in_jxcat
            && !Q.consultation_pending && !Q.referendum_pending
            && !(Q.congreso_decidir_countdown > 0 && own < 2)
            && Q.player_roadmap_change_trigger;
        if (Q.player_party == "erc") {
            canMove = canMove && (direction < 0 ? Q.erc_civic_strength < 30 : Q.erc_pragmatic_strength < 30);
        } else if (Q.player_party == "cup") {
            canMove = canMove && (direction < 0 ? Q.cup_endavant_strength < 30 : Q.cup_thirdsector_strength < 30);
        }
        var pending = (Q.coalition_indy_commitments || []).some(function(record) {
            return record.target == target && record.status == "pending";
        });
        if (pending) continue;
        if (canMove) {
            Q.coalition_affairs_indy_demands[target] = {kind: "roadmap", direction: direction, roadmap: own + direction};
        } else if (Q.parlament_sovereignty_declaration) {
            var law = theirs == 1 ? "parlament_non_binding_consultations" : theirs >= 2 ? "parlament_referendum_law" : "";
            if (law && !Q[law]) Q.coalition_affairs_indy_demands[target] = {kind: "law", law: law};
        }
    }
    for (var entry of [["erc", "erc"], ["cup", "cup"], ["ciu", Q.parlament_current_ciu], ["jxsi", "jxsi"], ["jxcat", "jxcat"]]) {
        var prefix = "coalition_affairs_indy_" + entry[0];
        var target = entry[1];
        var own = Q[Q.player_party + "_roadmap"];
        var theirs = Q[target + "_roadmap"];
        Q[prefix + "_pending"] = (Q.coalition_indy_commitments || []).some(function(record) {
            return record.target == target && record.status == "pending";
        });
        Q[prefix + "_aligned"] = own == theirs;
        Q[prefix + "_no_roadmap"] = !(own >= 1 && own <= 3 && theirs >= 1 && theirs <= 3);
        Q[prefix + "_faction_blocked"] = own != theirs && (Q.player_party == "erc"
            ? (theirs < own ? Q.erc_civic_strength >= 30 : Q.erc_pragmatic_strength >= 30)
            : (theirs < own ? Q.cup_endavant_strength >= 30 : Q.cup_thirdsector_strength >= 30));
        Q[prefix + "_consultations_passed"] = theirs == 1 && !!Q.parlament_non_binding_consultations;
        Q[prefix + "_referendum_passed"] = theirs >= 2 && !!Q.parlament_referendum_law;
        Q[prefix + "_no_law"] = !(theirs >= 1 && theirs <= 3);
    }
    Q.coalition_affairs_indy_erc_available = !!Q.coalition_affairs_indy_demands.erc;
    Q.coalition_affairs_indy_cup_available = !!Q.coalition_affairs_indy_demands.cup;
    Q.coalition_affairs_indy_ciu_available = !!Q.coalition_affairs_indy_demands[Q.parlament_current_ciu];
    Q.coalition_affairs_indy_jxsi_available = !!Q.coalition_affairs_indy_demands.jxsi;
    Q.coalition_affairs_indy_jxcat_available = !!Q.coalition_affairs_indy_demands.jxcat;
!}
