title: Coalition Affairs
view-if: (((player_party = "erc" and erc_in_gob) or (player_in_jxsi and jxsi_in_gob) or (player_in_jxcat and jxcat_in_gob)) or ((player_party = "cup" and cup_in_gob))) and cat_coalition_dissent > 30 and generalitat_coalition_timer <= 0 and not cat_caretaker_gov
is-card: true
face-image: img/generalitat/abracada.jpg
card-image: img/generalitat/abracada.jpg
frequency: 100
tags: generalitat
on-arrival: month_actions += 1; generalitat_coalition_timer = 5
call: generalitat_coalition_card.prepare
role: card-gov

= Coalition Disunity

The current [+ cat_coalition_disp +] is struggling with internal dissent, and there's a real chance it may all come crashing down, with partners leaving the government in protest.

- @concessions_jxcat
- @concessions_jxsi
- @concessions_ciu
- @concessions_erc
- @concessions_psc
- @concessions_icv
- @concessions_cup
- @independence_erc
- @independence_cup
- @independence_ciu
- @independence_jxsi
- @independence_jxcat
- @go_chill_demands
- @resources
- @new_elections
- @kick_them_out
- @no_change
- @easy_discard

@concessions_jxcat
title: Give policy concessions to JxCat
view-if: coalition_affairs_includes_jxcat and jxcat_relations < 55 
on-arrival: coalition_affairs_concession_target = "jxcat"
go-to: concessions_ciu

@concessions_jxsi
title: Give policy concessions to JxSí
view-if: coalition_affairs_includes_jxsi and jxsi_relations < 55
on-arrival: coalition_affairs_concession_target = "jxsi"
go-to: concessions_ciu

@concessions_ciu
title: Give policy concessions to [+ parlament_current_ciu +]
view-if: player_party != "ciu" and coalition_affairs_includes_ciu and parlament_current_ciu_relations < 55
on-arrival: {!
    if (Q.generalitat_surplus < 0) {
        var cut_round = 2
        while (cut_round > -2) {
            if (Q.education_spending == cut_round) {
                Q.education_spending -= 1;
                cut_round = -10;
            } else if (Q.healthcare_spending == cut_round) {
                Q.healthcare_spending -= 1;
                cut_round = -10
            } else if (Q.public_salary_level == cut_round) {
                Q.public_salary_level -= 1;
                cut_round = -10
            }
            cut_round -= 1;
        }
        if (cut_round == -3) {
            if (!Q.economy_cuts) Q.economy_cuts = 1;
            else Q.economy_cuts += 1;
            G.registerLaw(Q, {id:"general_cuts_" + Q.economy_cuts, title:"Extraordinary Austerity Measures of " + Q.month + " " + Q.year,
                colour:"red", icon:"img/scissors_icon.svg",
                description: "Spending cuts have been applied across the board in another round of austerity measures.",
                targets:{welfare_index_growth:-0.2, social_dissent_eq:1, generalitat_surplus: 0.1, unemployment_recovery: -0.1, gdp_growth: -0.01 }});
        }
    } else {
        if (Q.tax_policy_level > -3) {
            Q.tax_policy_level -= 1;
        } else {
            if (!Q.economy_tax_cuts) Q.economy_tax_cuts = 1;
            else Q.economy_tax_cuts += 1;
            G.registerLaw(Q, {id:"economy_tax_cuts" + Q.economy_tax_cuts, title:"Tax Reduction Package of " + Q.month + " " + Q.year,
                colour:"orange", icon:"img/economy_icon.svg",
                description: "Taxes have been more or less equally across the board, though this makes the system slightly less progressive.",
                targets:{generalitat_surplus: -0.03, gdp_growth: 0.025 }});
        }
    }
    if (Q.coalition_affairs_concession_target == "") {
        Q[Q.parlament_current_ciu + "_relations"] += 8;
        Q.burdens_done -= 1;
    } else if (Q.coalition_affairs_concession_target != 0) {
        Q[Q.coalition_affairs_concession_target + "_relations"] += 8;
        Q.burdens_done -= 1;
    }
!}
call: generalitat_setpolicy

[? if coalition_affairs_concession_target = "": [+ parlament_current_ciu +]?][? if coalition_affairs_concession_target != "": [+ coalition_affairs_concession_target +]?] has been somewhat pleased by [? if generalitat_surplus < 0: the introduction of new, "targeted" spending cuts. ?][? if generalitat_surplus >= 0: a reduction of taxes across the board and other facilities for business. ?]Let's hope this is for the better.

@concessions_erc
title: Give policy concessions to ERC
view-if: player_party != "erc" and coalition_affairs_includes_erc and erc_relations < 55
on-arrival: {!
    Q.coalition_affairs_concession_target = "erc";
!}
go-to: concessions_icv

@concessions_psc
title: Give concessions to the PSC
view-if: coalition_affairs_includes_psc and psc_relations < 55
on-arrival: {!
    Q.coalition_affairs_concession_target = "psc";
    Q.random_seed = Math.random();
!}
go-to: concessions_ciu if random_seed <= 0.5; concessions_icv

@concessions_icv
title: Give concessions to [+ parlament_current_icv +]
view-if: coalition_affairs_includes_icv and parlament_current_icv_relations < 55
choose-if: (tax_policy_level >= -3 and tax_policy_level < 6) or (education_spending >= -2 and education_spending < 2 and education_spending < social_spending_cap) or (healthcare_spending >= -2 and healthcare_spending < 2 and healthcare_spending < social_spending_cap) or (public_salary_level >= -2 and public_salary_level < 2 and public_salary_level < social_spending_cap) or economy_cuts > 0
unavailable-subtitle: Taxes are already at their limit, and no further spending increase or austerity reversal is available.
on-arrival: {!
    Q.coalition_affairs_icv_concession = "";
    var raiseField = "";
    for (var field of ["education_spending", "healthcare_spending", "public_salary_level"]) {
        if (Q[field] >= -2 && Q[field] < 2 && Q[field] + 1 <= Q.social_spending_cap
            && (!raiseField || Q[field] < Q[raiseField])) {
            raiseField = field;
        }
    }
    var canSpend = !!raiseField || Q.economy_cuts > 0;
    var canTax = Q.tax_policy_level >= -3 && Q.tax_policy_level < 6;
    var spendingChance = Q.generalitat_surplus < 0 ? 0.3 : 0.7;
    spendingChance += (Q.social_dissent - 50) / 200;
    spendingChance += (50 - Q.welfare_index) / 200;
    spendingChance = Math.max(0.1, Math.min(0.9, spendingChance));

    if (canSpend && (!canTax || Math.random() < spendingChance)) {
        if (raiseField) {
            Q[raiseField] += 1;
            Q.coalition_affairs_icv_concession = "spending";
        } else if (Q.economy_cuts > 0) {
            G.deactivateLaw(Q, "general_cuts_" + Q.economy_cuts, undefined, true);
            Q.economy_cuts -= 1;
            Q.coalition_affairs_icv_concession = "austerity";
        }
    } else if (canTax) {
        Q.tax_policy_level += 1;
        Q.coalition_affairs_icv_concession = "taxes";
    }
    if (Q.coalition_affairs_icv_concession) {
        var target = Q.coalition_affairs_concession_target || Q.parlament_current_icv;
        Q[target + "_relations"] += 8;
        Q.burdens_done += 1;
    }
!}
call: generalitat_setpolicy

[? if coalition_affairs_icv_concession: [? if coalition_affairs_concession_target = "": [+ parlament_current_icv +]?][? if coalition_affairs_concession_target != "": [+ coalition_affairs_concession_target +]?] has _changebeen somewhat pleased by [? if coalition_affairs_icv_concession = "taxes": a progressive increase in taxes to fund public services. ?][? if coalition_affairs_icv_concession = "spending": an increase in funding for public services and workers. ?][? if coalition_affairs_icv_concession = "austerity": the reversal of extraordinary austerity measures. ?]Let's hope this is for the better.?]

@concessions_cup
