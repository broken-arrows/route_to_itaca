title: The burden of governance
face-image: img/events/manifestacio_st_jaume_cgt.jpg
view-if: burdens_start_trigger
tags: event
new-page: true
on-arrival: {!
    // TODO: Burden breaking consequences event + Burdens renewal when broken
    // TODO: Dynamic burdens depending on governing coalition 
    Q.burdens_goal = 4;
    Q.burdens_time = 12;
    Q.burdens_broken = 0;

    if (Q.parlament_coalition_policy_accepted) {
        var commitments = [
            {selected: Q.parlament_coalition_policy_cap, kind: "social_spending_cap", target: Q.parlament_coalition_policy_cap_target, title: "Raise on the social spending cap", icon: "img/economy_icon.svg"},
            {selected: Q.parlament_coalition_policy_education, kind: "education_spending", spending: true, target: Q.parlament_coalition_policy_education_target, title: "Education spending increase", icon: "img/education_icon.svg"},
            {selected: Q.parlament_coalition_policy_health, kind: "healthcare_spending", spending: true, target: Q.parlament_coalition_policy_health_target, title: "Health spending increase", icon: "img/health_icon.svg"},
            {selected: Q.parlament_coalition_policy_pay, kind: "public_salary_level", spending: true, target: Q.parlament_coalition_policy_pay_target, title: "Public salaries increase", icon: "img/economy_icon.svg"},
            {selected: Q.parlament_coalition_policy_tax, kind: "tax_progressivity", target: Q.parlament_coalition_policy_tax_target, title: "More progressive tax scheme", icon: "img/people_icon.svg"}
        ];
        commitments.forEach(function (item) {
            if (!item.selected) return;
            if (!item.allowed) return;
            Q.burdens_done += 1;
        });
    }

    Q.burdens_start_trigger = false;
!}
role: event

= The burden of governance

After having protested austerity politics for years, us stepping into the Generalitat means our voters and supporters expect decisive action. Fulfilling these expectations can take many different forms, from exercising Catalan sovereignty decisively or by enacting much demanded social policies. But we are expected to do *something*. 

These goals, or burdens, for our governance can be achieved by taking at least [+ burdens_goal +] of the following actions durning the coming [+ burdens_time +] months.

· Making taxes more progressive.

[? if cup_in_gob: · Raising taxes on business and the rich. ?]

[? if cup_in_gob: · Democratizing police practices. ?]

· Expanding the funding and capabilities of social services.

· Supporting workers demands.

· Enacting social protection laws in the Parlament.

· Expanding the Generalitat's governing capabilities.

[? if player_roadmap > 0 or cup_in_gob: · Exercising Catalan sovereignty in the Parlament. ?]

[? if cup_in_gob: · Making clear progress towards Catalan self-determination and independence. ?]

- @burdens_continue

@burdens_continue
title: We better do our best!
go-to: post_event
