title: Ministry of Territory
new-page: true
view-if: generalitat_territory_timer <= 0 and (territory_minister_party == player_party or (player_in_jxsi and territory_minister_party = "jxsi") or (player_in_jxcat and territory_minister_party = "jxcat")) and not cat_caretaker_gov
on-arrival: month_actions += 1; generalitat_territory_timer += 4;
card-image: img/generalitat/territori.png
face-image: img/generalitat/territori.png
frequency: 100
tags: generalitat
go-to: territory_choices
role: card-gov

@territory_choices
new-page: true
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    Q.territory_controls_ministry = controlledParties.includes(Q.territory_minister_party);
    Q.territory_controls_bnl = controlledParties.includes(Q.bnl_minister_party);
    Q.territory_controls_economy = controlledParties.includes(Q.economy_minister_party);
    // Menu availability is derived from project records, not a saved lifecycle.
    var projects = Q.active_mods || {};
    for (var key of ["water2", "water3", "tmobilitat2", "rail1", "rail2"]) {
        var project = projects["territory_" + key];
        Q["territory_" + key + "_available"] = !project || !project.active;
    }
!}
# face-image: img/territory_icon.svg

= Ministry of Territory

The Ministry of the Territory handles all Generalitat-operated infrastructure, from railways to highways and ports, as well as having dedicated Departments for the primary sector, urban planning, housing, etc.

- @renewables
- @livestock_more
- @livestock_less
- @water1
- @water2
- @water3
- @roads1
- @roads2
- @roads3
- @tmobilitat1
- @tmobilitat2
- @metro1
- @metro2
- @rail1
- @rail2
- @post_event: We don't want to do anything in this ministry at the moment
- @easy_discard

@renewables
title: [? if territory_renewables = 0: Facilitate renewable-energy deployment ?][? if territory_renewables = 1: Coordinate a broader renewable rollout ?][? if territory_renewables = 2: Prioritize renewables in every new energy and land-use project ?] 
view-if: territory_renewables < 3
subtitle: The energy grid will not de-carbonize itself \[-1 budget\]
choose-if: territory_controls_ministry and (territory_controls_bnl or territory_renewables != 1) and government_budget > 0 and (territory_renewables = 0 or parlament_climate_change_passed)
unavailable-subtitle: [? if territory_renewables == 1 and not territory_controls_bnl: We need control also over the Business and Labour Ministry. ?][? if territory_renewables > 0 and not parlament_climate_change_passed: The Climate Change Law must pass before we can deepen this programme. ?][? if government_budget <= 0: Not enough budget. ?]
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.territory_minister_party) && !Q.cat_caretaker_gov && (Q.territory_renewables != 1 || controlledParties.includes(Q.bnl_minister_party)) && Q.government_budget >= 1 &&
        Q.territory_renewables < 3 && (Q.territory_renewables == 0 || Q.parlament_climate_change_passed)) {
        Q.territory_renewables += 1;
        Q.government_budget -= 1;
        Q.climate_transition_points += 1;
        Q.burdens_done += 1;
        var voterOrigin = Q.player_party;
        var voterCabinet = [Q.player_party].concat(Q.cat_coalition || []);
        var voterProfile = [["barcelona","young",0.4,"environment"],["barcelona","middle",0.25,"environment"],["girona","young",0.4,"environment"],["girona","middle",0.25,"environment"],["lleida","young",0.4,"environment"],["lleida","middle",0.25,"environment"],["tarragona","young",0.4,"environment"],["tarragona","middle",0.25,"environment"]];
        var voterRoutes = {"environment":[[["fl",0.45],["cup",0.3],["abstain",0.25]],[["fl",0.45],["erc",0.3],["abstain",0.25]]]};
        // Side elections have small authored percentage-point profiles.
        var voterSideProfile = [["congreso",0.02,"environment"],["barcelona",0.04,"environment"]];
        // Allocate ministry responsibility once across unique Parlament ballot carriers.
        var voterActors = [];
        for (var voterParty of [voterOrigin].concat(voterCabinet)) {

            var voterCandidates = [voterParty];
            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        var voterCells = [];
        for (var voterRow of voterProfile) voterCells.push({contest:"parlament",province:voterRow[0],demo:voterRow[1],amount:voterRow[2],family:voterRow[3]});
        for (var voterSide of voterSideProfile) {
            if (!voterRoutes[voterSide[2]]) continue;
            if (voterSide[0] == "congreso" && !(Q.congreso_constituencies || []).includes("catalunya")) continue;
            voterCells.push({contest:voterSide[0],province:voterSide[0] == "congreso" ? "catalunya" : null,demo:null,amount:voterSide[1],family:voterSide[2]});
        }
        for (var voterCell of voterCells) {
            var voterContest = voterCell.contest;
            var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
            var voterSignedAmount = voterCell.amount * ((Q.territory_renewables == 1 ? 1 : Q.territory_renewables == 2 ? .75 : .5) * (1) * (voterOrigin == "cup" ? (1) : 1));
            if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
            var voterDirection = voterSignedAmount > 0 ? 1 : -1;
            for (var voterActor of voterActors) {
                var voterRouteList = voterRoutes[voterCell.family][voterOrigin == "cup" ? 1 : 0];
                for (var voterRoute of voterRouteList) {
                    var voterPair = [];
                    for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                        var voterCandidates = [voterParty];
                        if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                        if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                        if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                        if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                        if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                        if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                        var voterCarrier = null;
                        for (var voterCandidate of voterCandidates) {
                            if (!voterLineup.includes(voterCandidate)) continue;
                            if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                            if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                        }
                        voterPair.push(voterCarrier);
                    }
                    if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                    var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                    var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                    if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                    if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                    G.cardSupportTransfer(Q,voterOptions);

                }
            }
        }
        // Cabinet partners, including unity-list constituents, react twice as strongly.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations += 1 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations += 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += 2 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations += 1 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 0 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 0 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 0 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 0 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += 0 * (coalitionPartners.includes("vox") ? 2 : 1);
        if (Q.player_party == "erc") {
            Q.erc_left_dissent -= 2;
            Q.erc_pragmatic_dissent -= 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent -= 2;
            Q.cup_poblelliure_dissent -= 1;
            Q.cup_thirdsector_dissent -= 2;
        }
    }
!}
call: generalitat_setpolicy

The necessary departments will now give renewable projects greater priority. Approvals are now swifter and take less time and effort.

- @post_event

@livestock_more
title: Further support the pig-farming sector
view-if: territory_livestock < 2
subtitle: It is main agricultural export of Catalonia after all. \[-1 budget\]
choose-if: territory_controls_ministry and government_budget > 0
unavailable-subtitle: Not enough budget.
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.territory_minister_party) && !Q.cat_caretaker_gov && Q.government_budget >= 1 && Q.territory_livestock < 2) {
        Q.territory_livestock += 1;
        if (Q.player_party == "cup" || Q.territory_livestock <= 0) Q.burdens_broken = true;
        Q.government_budget -= 1;
        G.deactivateLaw(Q, "territory_livestock_boost", undefined, true);
        if (Q.territory_livestock > 0) {
            G.registerLaw(Q, {id:"territory_livestock_boost", title:"Pig-Farming Boost", colour:"orange",
                description:"Pig farming remains the cornerstone of Catalonia's agricultural exports, and more so after the recent subsidizing of the sector.", 
                targets:{gdp_growth:0.08 * Q.territory_livestock}, expires:{year:Q.year + 1, month:Q.month}});
        }
        for (var voterOldRoute of (Q.territory_livestock_electoral_routes || []).slice().reverse()) {
            var voterContest = voterOldRoute.contest, voterProvince = voterOldRoute.province;
            var voterGroup = voterOldRoute.group;
            var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) :
                voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterProvince + "_" + voterGroup + "_support" :
                voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
            var voterPair = [];
            for (var voterParty of [voterOldRoute.to, voterOldRoute.from]) {
                var voterCandidates = voterParty == "abstain" ? ["abstain"] :
                    voterParty == "erc" || voterParty == "cup" ?
                        [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty] :
                    voterParty == "ciu" ? [voterContest == "parlament" ? Q.parlament_current_ciu : "", "jxsi", "jxcat", "junts", "pdcat", "dl", "cdc", "ciu"] :
                    voterParty == "fl" ? (voterContest == "congreso" ? ["sumar", "mpais", "up", "podemos", "iu"] :
                        voterContest == "barcelona" ? ["bcomu", "icv"] : ["ecp", "cecp", "csqp", "icv"]) :
                    voterContest == "congreso" && voterParty == "psc" ? ["psc", "psoe"] :
                    voterContest != "parlament" && voterParty == "ppc" ? ["pp"] : [voterParty];
                var voterCarrier = null;
                for (var voterCandidate of voterCandidates) {
                    if (!voterLineup.includes(voterCandidate)) continue;
                    if ((voterCandidate == "jxsi" || voterCandidate == "jxcat") && voterContest == "congreso" && !Q[voterCandidate + "_in_congreso"]) continue;
                    if ((voterCandidate == "jxsi" || voterCandidate == "jxcat") && voterContest == "barcelona" && !Q[voterCandidate + "_in_local"]) continue;
                    var voterCandidateKey = voterCandidate + voterSuffix;
                    if (Number.isFinite(Q[voterCandidateKey]) && (Q[voterCandidateKey] > 0 || voterCandidate == "abstain")) {
                        voterCarrier = voterCandidate;
                        break;
                    }
                }
                voterPair.push(voterCarrier);
            }
            if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
            var voterFromKey = voterPair[0] + voterSuffix, voterToKey = voterPair[1] + voterSuffix;
            var voterUndo = Math.min(voterOldRoute.amount, Q[voterFromKey] * 0.5);
            if (!(voterUndo > 0) || !Number.isFinite(voterUndo)) continue;
            Q[voterFromKey] -= voterUndo;
            Q[voterToKey] += voterUndo;
        }
        Q.territory_livestock_electoral_routes = [];
        var voterOrigin = Q.player_party;
        var voterCabinet = [Q.player_party].concat(Q.cat_coalition || []);
        var voterProfile = [["lleida","rural",0.5,"roads"],["lleida","buss",0.4,"roads"],["lleida","young",-0.3,"environment_loss"],["lleida","middle",-0.2,"environment_loss"],["girona","rural",0.375,"roads"],["girona","buss",0.30000000000000004,"roads"],["girona","young",-0.22499999999999998,"environment_loss"],["girona","middle",-0.15000000000000002,"environment_loss"],["tarragona","rural",0.2,"roads"],["tarragona","buss",0.16000000000000003,"roads"],["tarragona","young",-0.12,"environment_loss"],["tarragona","middle",-0.08000000000000002,"environment_loss"],["barcelona","rural",0.075,"roads"],["barcelona","buss",0.06,"roads"],["barcelona","young",-0.045,"environment_loss"],["barcelona","middle",-0.03,"environment_loss"]];
        var voterRoutes = {"roads":[[["ciu",0.45],["psc",0.35],["abstain",0.2]],[["erc",0.45],["ciu",0.3],["abstain",0.25]]],"environment_loss":[[["cup",0.55],["fl",0.45]],[["fl",0.45],["erc",0.3],["abstain",0.25]]]};
        // Side elections have small authored percentage-point profiles.
        var voterSideProfile = [["congreso",0.01,"roads"],["barcelona",0.006,"roads"],["congreso",-0.008,"environment_loss"],["barcelona",-0.004,"environment_loss"]];
        var voterActualRoutes = [];
        // Allocate ministry responsibility once across unique Parlament ballot carriers.
        var voterActors = [];
        for (var voterParty of [voterOrigin].concat(voterCabinet)) {

            var voterCandidates = [voterParty];
            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        var voterCells = [];
        for (var voterRow of voterProfile) voterCells.push({contest:"parlament",province:voterRow[0],demo:voterRow[1],amount:voterRow[2],family:voterRow[3]});
        for (var voterSide of voterSideProfile) {
            if (!voterRoutes[voterSide[2]]) continue;
            if (voterSide[0] == "congreso" && !(Q.congreso_constituencies || []).includes("catalunya")) continue;
            voterCells.push({contest:voterSide[0],province:voterSide[0] == "congreso" ? "catalunya" : null,demo:null,amount:voterSide[1],family:voterSide[2]});
        }
        for (var voterCell of voterCells) {
            var voterContest = voterCell.contest;
            var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
            var voterSignedAmount = voterCell.amount * ((1) * (Q.territory_livestock) * (voterOrigin == "cup" ? (.7) : 1));
            if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
            var voterDirection = voterSignedAmount > 0 ? 1 : -1;
            for (var voterActor of voterActors) {
                var voterRouteList = voterRoutes[voterCell.family][voterOrigin == "cup" ? 1 : 0];
                for (var voterRoute of voterRouteList) {
                    var voterPair = [];
                    for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                        var voterCandidates = [voterParty];
                        if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                        if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                        if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                        if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                        if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                        if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                        var voterCarrier = null;
                        for (var voterCandidate of voterCandidates) {
                            if (!voterLineup.includes(voterCandidate)) continue;
                            if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                            if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                        }
                        voterPair.push(voterCarrier);
                    }
                    if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                    var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                    var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                    if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                    if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                    var voterActual = G.cardSupportTransfer(Q,voterOptions);
                    voterActualRoutes.push({contest:voterContest,province:voterCell.province,group:voterCell.demo,from:voterDirection > 0 ? voterRoute[0] : voterActor.origin,to:voterDirection > 0 ? voterActor.origin : voterRoute[0],amount:voterActual});
                }
            }
        }
        Q.territory_livestock_electoral_routes = voterActualRoutes;
        // Cabinet partners, including unity-list constituents, react twice as strongly.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations -= 1 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] += 2 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations += 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] -= 3 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations -= 3 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations += 1 * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations += 1 * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += 2 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += 2 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += 1 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += 1 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += 1 * (coalitionPartners.includes("vox") ? 2 : 1);
        // An outside cabinet unity list follows its CiU-family leadership.
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] += 2 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent += 3;
            Q.erc_pragmatic_dissent -= 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent += 4;
            Q.cup_poblelliure_dissent += 2;
            Q.cup_thirdsector_dissent += 3;
        }
    }
!}
call: generalitat_setpolicy

Our agricultural policy has now further subsidized intensive pig production. [? if territory_livestock > 0: While it is forecasted to provide some economic boost, ecologist pressure groups are already complaining about water quality issues... ?][? if territory_livestock <= 0: This does mean that some of the previous diversification initiatives have been relaxed. ?]

- @post_event

@livestock_less
title: Diversify agricultural production
view-if: territory_livestock > -2
subtitle: Reorient existing support and advice toward a wider range of crops and farming models. \[-1 budget\]
choose-if: territory_controls_ministry and government_budget > 0
unavailable-subtitle: Not enough government budget.
on-arrival: {!
    var controlledParties = [Q.player_party].concat(Q.player_in_jxsi ? ["jxsi"] : [], Q.player_in_jxcat ? ["jxcat"] : []);
    if (controlledParties.includes(Q.territory_minister_party) && !Q.cat_caretaker_gov && Q.government_budget >= 1 && Q.territory_livestock > -2) {
        Q.territory_livestock -= 1;
        Q.government_budget -= 1;
        G.deactivateLaw(Q, "territory_livestock_boost", undefined, true);
        for (var voterOldRoute of (Q.territory_livestock_electoral_routes || []).slice().reverse()) {
            var voterContest = voterOldRoute.contest, voterProvince = voterOldRoute.province;
            var voterGroup = voterOldRoute.group;
            var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) :
                voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterProvince + "_" + voterGroup + "_support" :
                voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
            var voterPair = [];
            for (var voterParty of [voterOldRoute.to, voterOldRoute.from]) {
                var voterCandidates = voterParty == "abstain" ? ["abstain"] :
                    voterParty == "erc" || voterParty == "cup" ?
                        [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty] :
                    voterParty == "ciu" ? [voterContest == "parlament" ? Q.parlament_current_ciu : "", "jxsi", "jxcat", "junts", "pdcat", "dl", "cdc", "ciu"] :
                    voterParty == "fl" ? (voterContest == "congreso" ? ["sumar", "mpais", "up", "podemos", "iu"] :
                        voterContest == "barcelona" ? ["bcomu", "icv"] : ["ecp", "cecp", "csqp", "icv"]) :
                    voterContest == "congreso" && voterParty == "psc" ? ["psc", "psoe"] :
                    voterContest != "parlament" && voterParty == "ppc" ? ["pp"] : [voterParty];
                var voterCarrier = null;
                for (var voterCandidate of voterCandidates) {
                    if (!voterLineup.includes(voterCandidate)) continue;
                    if ((voterCandidate == "jxsi" || voterCandidate == "jxcat") && voterContest == "congreso" && !Q[voterCandidate + "_in_congreso"]) continue;
                    if ((voterCandidate == "jxsi" || voterCandidate == "jxcat") && voterContest == "barcelona" && !Q[voterCandidate + "_in_local"]) continue;
                    var voterCandidateKey = voterCandidate + voterSuffix;
                    if (Number.isFinite(Q[voterCandidateKey]) && (Q[voterCandidateKey] > 0 || voterCandidate == "abstain")) {
                        voterCarrier = voterCandidate;
                        break;
                    }
                }
                voterPair.push(voterCarrier);
            }
            if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
            var voterFromKey = voterPair[0] + voterSuffix, voterToKey = voterPair[1] + voterSuffix;
            var voterUndo = Math.min(voterOldRoute.amount, Q[voterFromKey] * 0.5);
            if (!(voterUndo > 0) || !Number.isFinite(voterUndo)) continue;
            Q[voterFromKey] -= voterUndo;
            Q[voterToKey] += voterUndo;
        }
        Q.territory_livestock_electoral_routes = [];
        var voterOrigin = Q.player_party;
        var voterCabinet = [Q.player_party].concat(Q.cat_coalition || []);
        var voterProfile = [["lleida","rural",0.5,"roads"],["lleida","buss",0.4,"roads"],["lleida","young",-0.3,"environment_loss"],["lleida","middle",-0.2,"environment_loss"],["girona","rural",0.375,"roads"],["girona","buss",0.30000000000000004,"roads"],["girona","young",-0.22499999999999998,"environment_loss"],["girona","middle",-0.15000000000000002,"environment_loss"],["tarragona","rural",0.2,"roads"],["tarragona","buss",0.16000000000000003,"roads"],["tarragona","young",-0.12,"environment_loss"],["tarragona","middle",-0.08000000000000002,"environment_loss"],["barcelona","rural",0.075,"roads"],["barcelona","buss",0.06,"roads"],["barcelona","young",-0.045,"environment_loss"],["barcelona","middle",-0.03,"environment_loss"]];
        var voterRoutes = {"roads":[[["ciu",0.45],["psc",0.35],["abstain",0.2]],[["erc",0.45],["ciu",0.3],["abstain",0.25]]],"environment_loss":[[["cup",0.55],["fl",0.45]],[["fl",0.45],["erc",0.3],["abstain",0.25]]]};
        // Side elections have small authored percentage-point profiles.
        var voterSideProfile = [["congreso",0.01,"roads"],["barcelona",0.006,"roads"],["congreso",-0.008,"environment_loss"],["barcelona",-0.004,"environment_loss"]];
        var voterActualRoutes = [];
        // Allocate ministry responsibility once across unique Parlament ballot carriers.
        var voterActors = [];
        for (var voterParty of [voterOrigin].concat(voterCabinet)) {

            var voterCandidates = [voterParty];
            if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
            if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
            if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = [Q.parlament_current_icv,"ecp","cecp","csqp","icv"];
            var voterCarrier = null;
            for (var voterCandidate of voterCandidates) {
                if (!(Q.parties || []).includes(voterCandidate)) continue;
                for (var voterProvince of Q.parlament_constituencies || []) for (var voterDemo of Q.parlament_demographics || [])
                    if (Q[voterCandidate + "_parlament_" + voterProvince + "_" + voterDemo + "_support"] > 0) voterCarrier = voterCandidate;
                if (voterCarrier) break;
            }
            if (voterParty == voterOrigin && !voterCarrier) break;
            if (voterCarrier && !voterActors.some(function (actor) { return actor.party == voterCarrier; })) voterActors.push({party:voterCarrier,origin:voterParty});
        }
        for (var voterActorIndex = 0; voterActorIndex < voterActors.length; voterActorIndex++)
            voterActors[voterActorIndex].weight = voterActors.length == 1 ? 1 : voterActorIndex == 0 ? 0.8 : 0.2 / (voterActors.length - 1);
        var voterCells = [];
        for (var voterRow of voterProfile) voterCells.push({contest:"parlament",province:voterRow[0],demo:voterRow[1],amount:voterRow[2],family:voterRow[3]});
        for (var voterSide of voterSideProfile) {
            if (!voterRoutes[voterSide[2]]) continue;
            if (voterSide[0] == "congreso" && !(Q.congreso_constituencies || []).includes("catalunya")) continue;
            voterCells.push({contest:voterSide[0],province:voterSide[0] == "congreso" ? "catalunya" : null,demo:null,amount:voterSide[1],family:voterSide[2]});
        }
        for (var voterCell of voterCells) {
            var voterContest = voterCell.contest;
            var voterLineup = voterContest == "parlament" ? (Q.parties || []).concat(["abstain"]) : voterContest == "congreso" ? (Q.congreso_parties_catalunya || []).concat(["abstain"]) : Q.parties_bcn || [];
            var voterSuffix = voterContest == "parlament" ? "_parlament_" + voterCell.province + "_" + voterCell.demo + "_support" : voterContest == "congreso" ? "_congreso_catalunya_support" : "_local_barcelona_support";
            var voterSignedAmount = voterCell.amount * ((1) * (Q.territory_livestock) * (voterOrigin == "cup" ? (.7) : 1));
            if (!Number.isFinite(voterSignedAmount) || voterSignedAmount == 0) continue;
            var voterDirection = voterSignedAmount > 0 ? 1 : -1;
            for (var voterActor of voterActors) {
                var voterRouteList = voterRoutes[voterCell.family][voterOrigin == "cup" ? 1 : 0];
                for (var voterRoute of voterRouteList) {
                    var voterPair = [];
                    for (var voterParty of [voterContest == "parlament" ? voterActor.party : voterActor.origin, voterRoute[0]]) {
                        var voterCandidates = [voterParty];
                        if (voterParty == "erc" || voterParty == "cup") voterCandidates = [Q[voterParty + "_in_jxsi"] ? "jxsi" : "", Q[voterParty + "_in_jxcat"] ? "jxcat" : "", voterParty];
                        if (["ciu","cdc","dl","junts"].includes(voterParty) || voterParty == "pdcat" && !Q.pdcat_split) voterCandidates = [Q.parlament_current_ciu,"jxsi","jxcat","junts","pdcat","dl","cdc","ciu"];
                        if (["fl","federal_left","icv","csqp","cecp","ecp"].includes(voterParty)) voterCandidates = voterContest == "parlament" ? [Q.parlament_current_icv,"ecp","cecp","csqp","icv"] : voterContest == "congreso" ? ["sumar","mpais","up","podemos","iu"] : ["bcomu","icv"];
                        if (voterParty == "psc" && voterContest == "congreso") voterCandidates = ["psoe"];
                        if (voterParty == "ppc" && voterContest != "parlament") voterCandidates = ["pp"];
                        if (["jxsi","jxcat"].includes(voterParty) && voterContest != "parlament" && !Q[voterParty + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) voterCandidates = [voterOrigin,Q.parlament_current_ciu,"junts","pdcat","dl","cdc","ciu"];
                        var voterCarrier = null;
                        for (var voterCandidate of voterCandidates) {
                            if (!voterLineup.includes(voterCandidate)) continue;
                            if (["jxsi","jxcat"].includes(voterCandidate) && voterContest != "parlament" && !Q[voterCandidate + (voterContest == "congreso" ? "_in_congreso" : "_in_local")]) continue;
                            if (Number.isFinite(Q[voterCandidate + voterSuffix]) && (Q[voterCandidate + voterSuffix] > 0 || voterCandidate == "abstain")) { voterCarrier = voterCandidate; break; }
                        }
                        voterPair.push(voterCarrier);
                    }
                    if (!voterPair[0] || !voterPair[1] || voterPair[0] == voterPair[1]) continue;
                    var voterFrom = voterPair[voterDirection > 0 ? 1 : 0], voterTo = voterPair[voterDirection > 0 ? 0 : 1];
                    var voterOptions = {contest:voterContest,from:voterFrom,to:voterTo,amount:Math.abs(voterSignedAmount) * voterActor.weight * voterRoute[1],maxDonorFraction:0.5};
                    if (voterContest == "parlament") { voterOptions.constituencies = [voterCell.province]; voterOptions.demographics = [voterCell.demo]; }
                    if (voterContest == "congreso") voterOptions.constituencies = ["catalunya"];
                    var voterActual = G.cardSupportTransfer(Q,voterOptions);
                    voterActualRoutes.push({contest:voterContest,province:voterCell.province,group:voterCell.demo,from:voterDirection > 0 ? voterRoute[0] : voterActor.origin,to:voterDirection > 0 ? voterActor.origin : voterRoute[0],amount:voterActual});
                }
            }
        }
        Q.territory_livestock_electoral_routes = voterActualRoutes;
        // Cabinet partners, including unity-list constituents, react twice as strongly.
        var coalitionPartners = (Q.cat_coalition || []).slice();
        for (var list of ["jxsi", "jxcat"]) {
            if (coalitionPartners.includes(list)) {
                for (var party of Q.parties || []) {
                    if (Q[party + "_in_" + list]) coalitionPartners.push(party);
                }
            }
        }
        if (!controlledParties.includes("erc") && Number.isFinite(Q.erc_relations))
            Q.erc_relations += 1 * (coalitionPartners.includes("erc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_ciu) && Number.isFinite(Q[Q.parlament_current_ciu + "_relations"]))
            Q[Q.parlament_current_ciu + "_relations"] -= 2 * (coalitionPartners.includes(Q.parlament_current_ciu) ? 2 : 1);
        if (!controlledParties.includes("psc") && Number.isFinite(Q.psc_relations))
            Q.psc_relations -= 1 * (coalitionPartners.includes("psc") ? 2 : 1);
        if (!controlledParties.includes(Q.parlament_current_icv) && Number.isFinite(Q[Q.parlament_current_icv + "_relations"]))
            Q[Q.parlament_current_icv + "_relations"] += 3 * (coalitionPartners.includes(Q.parlament_current_icv) ? 2 : 1);
        if (!controlledParties.includes("cup") && Number.isFinite(Q.cup_relations))
            Q.cup_relations += 3 * (coalitionPartners.includes("cup") ? 2 : 1);
        if (!controlledParties.includes("ppc") && Number.isFinite(Q.ppc_relations))
            Q.ppc_relations -= 1 * (coalitionPartners.includes("ppc") ? 2 : 1);
        if (!controlledParties.includes("cs") && Number.isFinite(Q.cs_relations))
            Q.cs_relations -= 1 * (coalitionPartners.includes("cs") ? 2 : 1);
        if (Q.pdcat_split && Q.parlament_current_ciu != "pdcat" && !controlledParties.includes("pdcat") && Number.isFinite(Q.pdcat_relations))
            Q.pdcat_relations += -2 * (coalitionPartners.includes("pdcat") ? 2 : 1);
        if (Q.unio_split && !Q.unio_dissolved && Q.parlament_current_ciu != "unio" && !controlledParties.includes("unio") && Number.isFinite(Q.unio_relations))
            Q.unio_relations += -2 * (coalitionPartners.includes("unio") ? 2 : 1);
        if (Q.fnc_formed && !controlledParties.includes("fnc") && Number.isFinite(Q.fnc_relations))
            Q.fnc_relations += -1 * (coalitionPartners.includes("fnc") ? 2 : 1);
        if (!Q.pxc_dissolved && !controlledParties.includes("pxc") && Number.isFinite(Q.pxc_relations))
            Q.pxc_relations += -1 * (coalitionPartners.includes("pxc") ? 2 : 1);
        if (Q.vox_active && !controlledParties.includes("vox") && Number.isFinite(Q.vox_relations))
            Q.vox_relations += -1 * (coalitionPartners.includes("vox") ? 2 : 1);
        // An outside cabinet unity list follows its CiU-family leadership.
        for (var list of ["jxsi", "jxcat"]) {
            if ((Q.cat_coalition || []).includes(list) && !controlledParties.includes(list) &&
                list != Q.parlament_current_ciu && Number.isFinite(Q[list + "_relations"]))
                Q[list + "_relations"] -= 2 * 2;
        }
        if (Q.player_party == "erc") {
            Q.erc_left_dissent -= 3;
            Q.erc_pragmatic_dissent += 1;
        }
        if (Q.player_party == "cup") {
            Q.cup_endavant_dissent -= 4;
            Q.cup_poblelliure_dissent -= 2;
            Q.cup_thirdsector_dissent -= 3;
        }
    }
