@roads1
title: Work on removing tool roads
subtitle: Tolls in Catalonia have been remarkably more extensive and expensive than in Spain for a while now. \[-1 budget \]
choose-if: government_budget > 0
view-if: not territory_roads or territory_roads < 1
unavailable-subtitle: Not enough government budget.
on-arrival: {!
    Q.territory_roads = 1;
    Q.government_budget -= 1;
    Q.burdens_done += 1;
    G.registerLaw(Q, {id:"toll_free_roads",colour:"green",description:"All Generalitat-administered roads and highways are toll-free.",title:"Toll-free roads",icon:"img/car_icon.svg",targets:{gdp_growth:0.01,generalitat_surplus:-0.02,welfare_index_growth:-0.01}});

    // Toll removal is enacted now, with most of the electoral credit outside Barcelona.
    var target = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    for (var province of Q.parlament_constituencies) {
        var ruralCredit = province == "barcelona" ? 0.08 : 0.18;
        G.cardSupportTransfer(Q, {contest:"parlament", from:"abstain", to:target,
            amount:ruralCredit, maxDonorFraction:0.5,
            constituencies:[province], demographics:["rural"]});
        G.cardSupportTransfer(Q, {contest:"parlament", from:"abstain", to:target,
            amount:ruralCredit * 0.6, maxDonorFraction:0.5,
            constituencies:[province], demographics:["middle"]});
    }
    // Interior local races use the player party's score even when it runs in a unity list.
    if (Q.player_party == "erc" || Q.player_party == "cup")
        Q[Q.player_party + "_interior_mod"] += 0.5;
!}

While some private concessions, and some state-administered roads are beyond our capabilities to change, we have invested heavily on removing tolls where we have been able to. This has ended up including the long-time demanded removal of the tolls in the AP-7 highway, one of the main arteries of our country. 

@roads2
title: Expand and duplicate county roads
subtitle: Including links considered critical like the C-17 Vic-Ripoll and the A-27 Valls-Montblanc. \[-1 budget\]
view-if: territory_roads = 1
choose-if: government_budget > 0
unavailable-subtitle: Not enough budget.
on-arrival: {!
    Q.territory_roads = 2;
    Q.government_budget -= 1;

    G.registerLaw(Q, {id:"territory_county_roads",colour:"gray",description:"Pending budget approval: expansion of critical road links like the C-17 and the A-27.",title:"County roads expansion",icon:"img/car_icon.svg",targets:{generalitat_surplus:-0.005}});
    
    var target = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    for (var province of ["girona", "tarragona"]) {
        G.cardSupportTransfer(Q, {contest:"parlament", from:"abstain", to:target,
            amount:0.10, maxDonorFraction:0.5,
            constituencies:[province], demographics:["rural", "middle"]});
    }
    if (Q.player_party == "erc" || Q.player_party == "cup")
        Q[Q.player_party + "_interior_mod"] += 0.3;
!}

While construction will not be able to start until the Generalitat's budget is approved, we have already set in motion all the necessary studies to make the road expansion happen.

@roads3
title: Build the B-40 "Fourth Belt" highway
subtitle: The final Barcelona-bypass highway may have been shelved away for too long. \[-2 budget\]
view-if: territory_roads = 2 and territory_roads_approved < 2 and not territory_b40_proposed
choose-if: government_budget > 1 and player_party != "cup"
unavailable-subtitle: [? if player_party == "cup": Our party line is firmly against this project. ?] [? if player_party != "cup": Not enough budget. ?]
on-arrival: {!
    Q.territory_b40_proposed = true;
    Q.climate_transition_points -= 1;
    Q.government_budget -= 2;

    G.registerLaw(Q, {id:"territory_b40",colour:"gray",description:"Pending budget approval: build out of the B-40, Barcelona's final bypass highway.",title:"Barcelona's Fourth Belt",icon:"img/car_icon.svg",targets:{generalitat_surplus:-0.005, welfare_index: -0.05}});
    Q.social_dissent += 10;

    // The bypass appeals to business voters but costs the proposer green votes.
    var target = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    var targetLocal = (Q.player_in_jxsi && Q.jxsi_in_local) ? "jxsi" :
        (Q.player_in_jxcat && Q.jxcat_in_local) ? "jxcat" : Q.player_party;
    G.cardSupportTransfer(Q, {contest:"parlament", from:"abstain", to:target,
        amount:0.14, maxDonorFraction:0.5,
        constituencies:["barcelona"], demographics:["buss"]});
    G.cardSupportTransfer(Q, {contest:"parlament", from:"abstain", to:target,
        amount:0.08, maxDonorFraction:0.5,
        constituencies:["barcelona"], demographics:["middle"]});
    G.cardSupportTransfer(Q, {contest:"parlament", from:target, to:"federal_left",
        amount:0.14, maxDonorFraction:0.5,
        constituencies:["barcelona"], demographics:["young"]});
    G.cardSupportTransfer(Q, {contest:"parlament", from:target, to:"federal_left",
        amount:0.08, maxDonorFraction:0.5,
        constituencies:["barcelona"], demographics:["unemployed"]});
    if ((Q.parties_bcn || []).includes(targetLocal)) {
        G.cardSupportTransfer(Q, {contest:"barcelona", from:"cs", to:targetLocal,
            amount:0.06, maxDonorFraction:0.5});
        G.cardSupportTransfer(Q, {contest:"barcelona", from:targetLocal, to:"federal_left",
            amount:0.10, maxDonorFraction:0.5});
    }
!}

Passing a budget with this divisive project may be difficult, but be it as it may we have now included it.

@metro1
title: Restart construction on the L9 Metro line
subtitle: The "pharaonic" project has sat unfinished for almost a decade. \[-2 budget\]
view-if: not territory_metro or territory_metro < 1
choose-if: government_budget > 1
unavailable-subtitle: Not enough budget.
on-arrival: {!
    Q.climate_transition_points += 1;
    Q.territory_metro = 1;
    Q.government_budget -= 2;
    G.registerLaw(Q, {id:"territory_metro1",colour:"gray",description:"Pending budget approval: restart construction of Barcelona's longest metro line.",title:"Metro L9/L10",icon:"img/subway_icon.svg",targets:{generalitat_surplus:-0.005, unemployment_recovery: 0.005}});

    // A prepared project earns modest Barcelona credit before it is funded.
    var target = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    var targetLocal = (Q.player_in_jxsi && Q.jxsi_in_local) ? "jxsi" :
        (Q.player_in_jxcat && Q.jxcat_in_local) ? "jxcat" : Q.player_party;
    for (var group of ["young", "middle", "unemployed"]) {
        G.cardSupportTransfer(Q, {contest:"parlament", from:"abstain", to:target,
            amount:group == "young" ? 0.12 : group == "middle" ? 0.10 : 0.08,
            maxDonorFraction:0.5, constituencies:["barcelona"], demographics:[group]});
    }
    if ((Q.parties_bcn || []).includes(targetLocal))
        G.cardSupportTransfer(Q, {contest:"barcelona", from:"psc", to:targetLocal,
            amount:0.10, maxDonorFraction:0.5});
!}

@metro2
title: Expand Barcelona's Metro lines L1 and L3
subtitle: "Periphery" neighbourhoods will benefit from better connections. \[-1 budget\]
view-if: territory_metro = 1 and territory_metro_approved = 1
choose-if: government_budget > 0
unavailable-subtitle: Not enough budget.
on-arrival: {!
    Q.climate_transition_points += 1;
    Q.territory_metro = 2;
    Q.government_budget -= 1;
    G.registerLaw(Q, {id:"territory_metro2",colour:"gray",description:"Pending budget approval: expansion of Barcelona's metro lines L1 and L3",title:"Metro L1&L3",icon:"img/subway_icon.svg",targets:{generalitat_surplus:-0.005, unemployment_recovery: 0.005}});

    var target = Q.player_in_jxsi ? "jxsi" : Q.player_in_jxcat ? "jxcat" : Q.player_party;
    var targetLocal = (Q.player_in_jxsi && Q.jxsi_in_local) ? "jxsi" :
        (Q.player_in_jxcat && Q.jxcat_in_local) ? "jxcat" : Q.player_party;
    for (var group of ["young", "middle", "unemployed"]) {
        G.cardSupportTransfer(Q, {contest:"parlament", from:"abstain", to:target,
            amount:group == "young" ? 0.20 : group == "middle" ? 0.14 : 0.16,
            maxDonorFraction:0.5, constituencies:["barcelona"], demographics:[group]});
    }
    if ((Q.parties_bcn || []).includes(targetLocal)) {
        G.cardSupportTransfer(Q, {contest:"barcelona", from:"psc", to:targetLocal,
            amount:0.08, maxDonorFraction:0.5});
        G.cardSupportTransfer(Q, {contest:"barcelona", from:"federal_left", to:targetLocal,
            amount:0.08, maxDonorFraction:0.5});
    }
    Q.erc_redbelt_mod += 5;
!}


