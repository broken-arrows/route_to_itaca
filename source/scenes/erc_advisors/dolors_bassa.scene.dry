title: ​Dolors Bassa
tags: advisor
card-image: img/erc/bassa.jpg
face-image: img/erc/bassa.jpg
view-if: dolors_bassa_advisor = 1
new-page: true
role: pinned-advisor

= Dolors Bassa i Coll

Dolors Bassa is the former Secretary General of the UGT syndicate in Girona, and enjoys a strong link with many progressive social movements.

- @open_campaigning
- @open_disunity
- @root: Return to hand

# TODO: Widening the Base access

@open_campaigning
title: Build support through unions and social movements
choose-if: player_party = "erc" and dolors_bassa_advisor and advisor_action_timer <= 0 and not erc_advisor_action
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.dolors_bassa_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action) {
        Q.erc_advisor_action = {target:"erc_campaigning", actions:Q.month_actions || 0, timer:Q.erc_campaigning_timer || 0, visits:this.state.visits["erc_campaigning"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_campaigning_timer = Q.rubicon ? 2 : 0;
    }
!}
go-to: erc_campaigning.union_networks if erc_advisor_action; root if not erc_advisor_action

@open_disunity
title: Defend the social commitments of the current government
choose-if: player_party = "erc" and dolors_bassa_advisor and advisor_action_timer <= 0 and not erc_advisor_action and (((erc_in_gob or erc_supporting) and burdens_time > 0 and not burdens_broken))
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?][? if advisor_action_timer <= 0: We are not governing nor giving government support. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.dolors_bassa_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action && (((Q.erc_in_gob || Q.erc_supporting) && Q.burdens_time > 0 && !Q.burdens_broken))) {
        Q.erc_advisor_action = {target:"erc_disunity", actions:Q.month_actions || 0, timer:Q.erc_disunity_timer || 0, visits:this.state.visits["erc_disunity"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_disunity_timer = 4;
    }
!}
go-to: erc_disunity.social_agreement if erc_advisor_action and ((erc_in_gob or erc_supporting) and burdens_time > 0 and not burdens_broken); root if not erc_advisor_action
