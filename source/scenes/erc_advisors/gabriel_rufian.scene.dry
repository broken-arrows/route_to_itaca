title: ​Gabriel Rufián
tags: advisor
card-image: img/erc/rufian.png
face-image: img/erc/rufian.png
view-if: gabriel_rufian_advisor = 1
new-page: true
role: pinned-advisor

= ​Gabriel Rufián i Romero

Of Andalusian descent, Gabriel Rufián has a strong tie to the industrial hinterlands of Barcelona and a strong combative communication style.

- @open_campaigning
- @open_reachout
- @root: Return to hand

# TODO: Widening the Base access

@open_campaigning
title: Campaign in Barcelona's Red Belt
choose-if: player_party = "erc" and gabriel_rufian_advisor and advisor_action_timer <= 0 and not erc_advisor_action
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.gabriel_rufian_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action) {
        Q.erc_advisor_action = {target:"erc_campaigning", actions:Q.month_actions || 0, timer:Q.erc_campaigning_timer || 0, visits:this.state.visits["erc_campaigning"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_campaigning_timer = Q.rubicon ? 2 : 0;
    }
!}
go-to: erc_campaigning.redbelt if erc_advisor_action; root if not erc_advisor_action

@open_reachout
title: Reach out to other parties in the Congreso
choose-if: player_party = "erc" and gabriel_rufian_advisor and advisor_action_timer <= 0 and not erc_advisor_action
unavailable-subtitle: Next advisor action available in [+ advisor_action_timer +] [? if rubicon and advisor_action_timer > 1: weeks?][? if rubicon and advisor_action_timer = 1: week?][? if not rubicon and advisor_action_timer > 1: months?][? if not rubicon and advisor_action_timer = 1: month?].
on-arrival: {!
    if (Q.player_party === "erc" && Q.gabriel_rufian_advisor && (Q.advisor_action_timer || 0) <= 0 && !Q.erc_advisor_action) {
        Q.erc_advisor_action = {target:"erc_reachout", actions:Q.month_actions || 0, timer:Q["erc_reachout_timer"] || 0, visits:this.state.visits["erc_reachout"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        Q["erc_reachout_timer"] = 0;
    }
!}
go-to: erc_reachout if erc_advisor_action; root if not erc_advisor_action
