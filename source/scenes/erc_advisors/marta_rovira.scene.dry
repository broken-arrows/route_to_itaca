title: ​Marta Rovira
tags: advisor
card-image: img/erc/martarovira.jpg
face-image: img/erc/martarovira.jpg
view-if: marta_rovira_advisor = 1
new-page: true
role: pinned-advisor

= ​Marta Rovira i Vergés

A lawyer by profession, Marta Rovira has been ERC's secretary general since 2011.

- @open_campaigning
- @open_inter_party
- @open_cup
- @root: Return to hand

# TODO: Widening the Base access

@open_campaigning
title: Coordinate the party's territorial organization
choose-if: player_party = "erc" and marta_rovira_advisor and advisor_action_timer <= 0 and not erc_advisor_action
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.marta_rovira_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action) {
        Q.erc_advisor_action = {target:"erc_campaigning", actions:Q.month_actions || 0, timer:Q.erc_campaigning_timer || 0, visits:this.state.visits["erc_campaigning"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_campaigning_timer = Q.rubicon ? 2 : 0;
    }
!}
go-to: erc_campaigning.territorial_networks if erc_advisor_action; root if not erc_advisor_action

@open_inter_party
title: Build national unity with [+ parlament_current_ciu +]
choose-if: player_party = "erc" and marta_rovira_advisor and advisor_action_timer <= 0 and not erc_advisor_action and ((parlament_current_ciu = "ciu" and (not unio_split)) or (parlament_current_ciu = "cdc" and (unio_split and not cdc_in_jxsi and not cdc_in_jxcat)) or (parlament_current_ciu = "dl" and (dl_formed and not pdcat_formed and not dl_in_jxcat and not dl_in_jxsi)) or (parlament_current_ciu = "pdcat" and (pdcat_formed and not pdcat_split and not pdcat_in_jxcat and not pdcat_in_jxsi)) or (parlament_current_ciu = "junts" and (junts_formed)) or (parlament_current_ciu = "jxsi" and (jxsi_formed and not jxsi_dissolved)) or (parlament_current_ciu = "jxcat" and erc_in_jxcat and jxcat_formed and not jxcat_dissolved) or (parlament_current_ciu = "jxcat" and not erc_in_jxcat and jxcat_formed and not jxcat_dissolved))
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.marta_rovira_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action && ((Q.parlament_current_ciu === "ciu" && (!Q.unio_split)) || (Q.parlament_current_ciu === "cdc" && (Q.unio_split && !Q.cdc_in_jxsi && !Q.cdc_in_jxcat)) || (Q.parlament_current_ciu === "dl" && (Q.dl_formed && !Q.pdcat_formed && !Q.dl_in_jxcat && !Q.dl_in_jxsi)) || (Q.parlament_current_ciu === "pdcat" && (Q.pdcat_formed && !Q.pdcat_split && !Q.pdcat_in_jxcat && !Q.pdcat_in_jxsi)) || (Q.parlament_current_ciu === "junts" && (Q.junts_formed)) || (Q.parlament_current_ciu === "jxsi" && (Q.jxsi_formed && !Q.jxsi_dissolved)) || (Q.parlament_current_ciu === "jxcat" && Q.erc_in_jxcat && Q.jxcat_formed && !Q.jxcat_dissolved) || (Q.parlament_current_ciu === "jxcat" && !Q.erc_in_jxcat && Q.jxcat_formed && !Q.jxcat_dissolved))) {
        Q.erc_advisor_action = {target:"erc_inter_party", actions:Q.month_actions || 0, timer:Q.erc_inter_party_timer || 0, visits:this.state.visits["erc_inter_party"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_inter_party_timer = 6;
    }
!}
go-to: erc_inter_party.ciu_relations if erc_advisor_action and (parlament_current_ciu = "ciu" and (not unio_split)); erc_inter_party.cdc_relations if erc_advisor_action and (parlament_current_ciu = "cdc" and (unio_split and not cdc_in_jxsi and not cdc_in_jxcat)); erc_inter_party.dl_relations if erc_advisor_action and (parlament_current_ciu = "dl" and (dl_formed and not pdcat_formed and not dl_in_jxcat and not dl_in_jxsi)); erc_inter_party.pdcat_nosplit_relations if erc_advisor_action and (parlament_current_ciu = "pdcat" and (pdcat_formed and not pdcat_split and not pdcat_in_jxcat and not pdcat_in_jxsi)); erc_inter_party.junts_relations if erc_advisor_action and (parlament_current_ciu = "junts" and (junts_formed)); erc_inter_party.jxsi_relations if erc_advisor_action and (parlament_current_ciu = "jxsi" and (jxsi_formed and not jxsi_dissolved)); erc_inter_party.jxcat_relations if erc_advisor_action and (parlament_current_ciu = "jxcat" and erc_in_jxcat and jxcat_formed and not jxcat_dissolved); erc_inter_party.jxcat_noerc_relations if erc_advisor_action and (parlament_current_ciu = "jxcat" and not erc_in_jxcat and jxcat_formed and not jxcat_dissolved); root if not erc_advisor_action

@open_cup
title: Build bridges with the CUP
choose-if: player_party = "erc" and marta_rovira_advisor and advisor_action_timer <= 0 and not erc_advisor_action and (not cup_in_jxsi and not cup_in_jxcat)
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?]
role: card-party
on-arrival: {!
    Q.erc_advisor_action = {target:"erc_inter_party", actions:Q.month_actions || 0, timer:Q.erc_inter_party_timer || 0, visits:this.state.visits["erc_inter_party"] || 0};
    Q.last_advisor_action = 1;
    Q.advisor_action_timer = 6;
    if (Q.difficulty >= 0) Q.month_actions += 1;
    Q.erc_inter_party_timer = 6;
!}
go-to: erc_inter_party.cup_relations if erc_advisor_action; root if not erc_advisor_action
