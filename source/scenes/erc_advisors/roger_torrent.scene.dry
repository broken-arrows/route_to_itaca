title: ​Roger Torrent
tags: advisor
card-image: img/erc/rogertorrent.jpg
face-image: img/erc/rogertorrent.jpg
view-if: roger_torrent_advisor = 1
new-page: true
role: pinned-advisor

= Roger Torrent i Ramió

Roger Torrent is a former mayor with strong local government experience.

- @open_campaigning
- @open_inter_party
- @root: Return to hand

# TODO: Widening the Base access

@open_campaigning
title: Coordinate the party's territorial organization
choose-if: player_party = "erc" and roger_torrent_advisor and advisor_action_timer <= 0 and not erc_advisor_action
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.roger_torrent_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action) {
        Q.erc_advisor_action = {target:"erc_campaigning", actions:Q.month_actions || 0, timer:Q.erc_campaigning_timer || 0, visits:this.state.visits["erc_campaigning"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_campaigning_timer = Q.rubicon ? 2 : 0;
    }
!}
go-to: erc_campaigning.territorial_networks if erc_advisor_action; root if not erc_advisor_action

@open_inter_party
title:  Defend the current governing agreement
choose-if: player_party = "erc" and roger_torrent_advisor and advisor_action_timer <= 0 and not erc_advisor_action and ((erc_in_gob or erc_supporting))
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?][? if advisor_action_timer <= 0: We are not governing nor giving government support. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.roger_torrent_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action && ((Q.erc_in_gob || Q.erc_supporting))) {
        Q.erc_advisor_action = {target:"erc_disunity", actions:Q.month_actions || 0, timer:Q.erc_disunity_timer || 0, visits:this.state.visits["erc_disunity"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_disunity_timer = 4;
    }
!}
go-to: erc_disunity.defend_agreement if erc_advisor_action and (erc_in_gob or erc_supporting); root if not erc_advisor_action
