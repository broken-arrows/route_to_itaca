title: ​Joan Laporta
tags: advisor
card-image: img/erc/laporta.jpg
face-image: img/erc/laporta.jpg
view-if: joan_laporta_advisor = 1
new-page: true
role: pinned-advisor

= Joan Laporta i Estruch

Former FC Barcelona president, Joan Laporta left the SI coalition he co-founded to instead support ERC.

- @open_campaigning
- @open_barcelona
- @root: Return to hand

@open_campaigning
title: Campaign among business owners and the self-employed
choose-if: player_party = "erc" and joan_laporta_advisor and advisor_action_timer <= 0 and not erc_advisor_action
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.joan_laporta_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action) {
        Q.erc_advisor_action = {target:"erc_campaigning", actions:Q.month_actions || 0, timer:Q.erc_campaigning_timer || 0, visits:this.state.visits["erc_campaigning"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_campaigning_timer = Q.rubicon ? 2 : 0;
    }
!}
go-to: erc_campaigning.business if erc_advisor_action; root if not erc_advisor_action

@open_barcelona
title: Campaign across Barcelona
choose-if: player_party = "erc" and joan_laporta_advisor and advisor_action_timer <= 0 and not erc_advisor_action
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?][? if advisor_action_timer <= 0: The political conditions for this action are not met. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.joan_laporta_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action) {
        Q.erc_advisor_action = {target:"erc_campaigning", actions:Q.month_actions || 0, timer:Q.erc_campaigning_timer || 0, visits:this.state.visits["erc_campaigning"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_campaigning_timer = Q.rubicon ? 2 : 0;
    }
!}
go-to: erc_campaigning.barcelona_province if erc_advisor_action; root if not erc_advisor_action
