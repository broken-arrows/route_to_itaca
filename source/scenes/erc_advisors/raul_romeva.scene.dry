title: ​Raül Romeva
tags: advisor
card-image: img/erc/romeva.jpg
face-image: img/erc/romeva.jpg
view-if: raul_romeva_advisor = 1
new-page: true
role: pinned-advisor

= ​Raül Romeva i Rueda

Raül Romeva was an MEP for ICV-EUiA who is well versed in international diplomacy.

- @open_international
- @open_inter_party
- @root: Return to hand

@open_international
title: Gather international support
choose-if: player_party = "erc" and raul_romeva_advisor and advisor_action_timer <= 0 and not erc_advisor_action
unavailable-subtitle: Next advisor action available in [+ advisor_action_timer +] [? if rubicon and advisor_action_timer > 1: weeks?][? if rubicon and advisor_action_timer = 1: week?][? if not rubicon and advisor_action_timer > 1: months?][? if not rubicon and advisor_action_timer = 1: month?].
on-arrival: {!
    if (Q.player_party === "erc" && Q.raul_romeva_advisor && (Q.advisor_action_timer || 0) <= 0 && !Q.erc_advisor_action) {
        Q.erc_advisor_action = {target:"erc_international", actions:Q.month_actions || 0, timer:Q["erc_international_timer"] || 0, visits:this.state.visits["erc_international"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        Q["erc_international_timer"] = 0;
    }
!}
go-to: erc_international if erc_advisor_action; root if not erc_advisor_action

@open_inter_party
title: Build national unity with [+ parlament_current_ciu +]
choose-if: player_party = "erc" and raul_romeva_advisor and advisor_action_timer <= 0 and not erc_advisor_action and ((parlament_current_ciu = "ciu" and (not unio_split)) or (parlament_current_ciu = "cdc" and (unio_split and not cdc_in_jxsi and not cdc_in_jxcat)) or (parlament_current_ciu = "dl" and (dl_formed and not pdcat_formed and not dl_in_jxcat and not dl_in_jxsi)) or (parlament_current_ciu = "pdcat" and (pdcat_formed and not pdcat_split and not pdcat_in_jxcat and not pdcat_in_jxsi)) or (parlament_current_ciu = "junts" and (junts_formed)) or (parlament_current_ciu = "jxsi" and (jxsi_formed and not jxsi_dissolved)) or (parlament_current_ciu = "jxcat" and erc_in_jxcat and jxcat_formed and not jxcat_dissolved) or (parlament_current_ciu = "jxcat" and not erc_in_jxcat and jxcat_formed and not jxcat_dissolved))
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.raul_romeva_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action && ((Q.parlament_current_ciu === "ciu" && (!Q.unio_split)) || (Q.parlament_current_ciu === "cdc" && (Q.unio_split && !Q.cdc_in_jxsi && !Q.cdc_in_jxcat)) || (Q.parlament_current_ciu === "dl" && (Q.dl_formed && !Q.pdcat_formed && !Q.dl_in_jxcat && !Q.dl_in_jxsi)) || (Q.parlament_current_ciu === "pdcat" && (Q.pdcat_formed && !Q.pdcat_split && !Q.pdcat_in_jxcat && !Q.pdcat_in_jxsi)) || (Q.parlament_current_ciu === "junts" && (Q.junts_formed)) || (Q.parlament_current_ciu === "jxsi" && (Q.jxsi_formed && !Q.jxsi_dissolved)) || (Q.parlament_current_ciu === "jxcat" && Q.erc_in_jxcat && Q.jxcat_formed && !Q.jxcat_dissolved) || (Q.parlament_current_ciu === "jxcat" && !Q.erc_in_jxcat && Q.jxcat_formed && !Q.jxcat_dissolved))) {
        Q.erc_advisor_action = {target:"erc_inter_party", actions:Q.month_actions || 0, timer:Q.erc_inter_party_timer || 0, visits:this.state.visits["erc_inter_party"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_inter_party_timer = 6;
    }
!}
go-to: erc_inter_party.ciu_relations if erc_advisor_action and (parlament_current_ciu = "ciu" and (not unio_split)); erc_inter_party.cdc_relations if erc_advisor_action and (parlament_current_ciu = "cdc" and (unio_split and not cdc_in_jxsi and not cdc_in_jxcat)); erc_inter_party.dl_relations if erc_advisor_action and (parlament_current_ciu = "dl" and (dl_formed and not pdcat_formed and not dl_in_jxcat and not dl_in_jxsi)); erc_inter_party.pdcat_nosplit_relations if erc_advisor_action and (parlament_current_ciu = "pdcat" and (pdcat_formed and not pdcat_split and not pdcat_in_jxcat and not pdcat_in_jxsi)); erc_inter_party.junts_relations if erc_advisor_action and (parlament_current_ciu = "junts" and (junts_formed)); erc_inter_party.jxsi_relations if erc_advisor_action and (parlament_current_ciu = "jxsi" and (jxsi_formed and not jxsi_dissolved)); erc_inter_party.jxcat_relations if erc_advisor_action and (parlament_current_ciu = "jxcat" and erc_in_jxcat and jxcat_formed and not jxcat_dissolved); erc_inter_party.jxcat_noerc_relations if erc_advisor_action and (parlament_current_ciu = "jxcat" and not erc_in_jxcat and jxcat_formed and not jxcat_dissolved); root if not erc_advisor_action
