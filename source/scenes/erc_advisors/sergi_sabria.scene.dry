title: ​Sergi Sabrià
tags: advisor
card-image: img/erc/sergisabria.jpg
face-image: img/erc/sergisabria.jpg
view-if: sergi_sabria_advisor = 1
new-page: true
role: pinned-advisor

= Sergi Sabrià i Benito

Sergi Sabrià is a rising strategist with a strong background in communications.

- @open_campaign
- @open_social
- @open_media
- @root: Return to hand

@open_media
title: Commission an unofficial PR campaign
subtitle: This may have unintended consequences.
choose-if: player_party = "erc" and sergi_sabria_advisor and advisor_action_timer <= 0 and not erc_advisor_action and ((not erc_bside_pending))
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.sergi_sabria_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action && ((!Q.erc_bside_pending))) {
        Q.erc_advisor_action = {target:"erc_media", actions:Q.month_actions || 0, timer:Q.erc_media_timer || 0, visits:this.state.visits["erc_media"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_media_timer = 6;
    }
!}
go-to: erc_media.unofficial if erc_advisor_action and (not erc_bside_pending); root if not erc_advisor_action

@open_campaign
title: Get the party media to work on expanding the voter base
choose-if: player_party = "erc" and sergi_sabria_advisor and advisor_action_timer <= 0 and not erc_advisor_action
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?][? if advisor_action_timer <= 0: The political conditions for this action are not met. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.sergi_sabria_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action) {
        Q.erc_advisor_action = {target:"erc_media", actions:Q.month_actions || 0, timer:Q.erc_media_timer || 0, visits:this.state.visits["erc_media"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_media_timer = 6;
    }
!}
go-to: erc_media.campaign if erc_advisor_action; root if not erc_advisor_action

@open_social
title: Develop our established social-media operations
choose-if: player_party = "erc" and sergi_sabria_advisor and advisor_action_timer <= 0 and not erc_advisor_action and (social_media = 1 or (social_media = 2 and year >= 2015) or (social_media >= 3 and year >= 2016))
unavailable-subtitle: [? if advisor_action_timer > 0: Next advisor action available in [+ advisor_action_timer +] [? if rubicon: weeks?][? if not rubicon: months?]. ?][? if social_media = 0: We don't have any sort of serious social media operations yet. ?][? if social_media > 0 and advisor_action_timer <= 0: We have already developed our operations in that directions as much as we're able to for the moment. ?]
role: card-party
on-arrival: {!
    if (Q.player_party === "erc" && Q.sergi_sabria_advisor && Q.advisor_action_timer <= 0 && !Q.erc_advisor_action && (Q.social_media === 1 || (Q.social_media === 2 && Q.year >= 2015) || (Q.social_media >= 3 && Q.year >= 2016))) {
        Q.erc_advisor_action = {target:"erc_media", actions:Q.month_actions || 0, timer:Q.erc_media_timer || 0, visits:this.state.visits["erc_media"] || 0};
        Q.last_advisor_action = 1;
        Q.advisor_action_timer = 6;
        if (Q.difficulty >= 0) Q.month_actions += 1;
        Q.erc_media_timer = 6;
    }
!}
go-to: erc_media.social_media_2 if erc_advisor_action and social_media = 1; erc_media.social_media_3 if erc_advisor_action and social_media = 2 and year >= 2015; erc_media.social_media_4 if erc_advisor_action and social_media >= 3 and year >= 2016; root if not erc_advisor_action
