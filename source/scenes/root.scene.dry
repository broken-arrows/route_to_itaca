  Q.congreso_parties_galicia = ["pp", "psoe", "podemos", "cs", "iu", "vox", "up", "sumar", "upyd", "mpais", "bng"];
  Q.congreso_parties_rest = ["pp", "psoe", "podemos", "cs", "iu", "vox", "up", "sumar", "upyd", "mpais", "cc", "fac", "prc", "te"];

  Q.congreso_parties = [];
  for (var c of Q.congreso_constituencies) {
    for (var p of Q["congreso_parties_" + c]) {
      if (!Q.congreso_parties.includes(p)) {
        Q.congreso_parties.push(p);
      }
    }
  }

  Q.congreso_rural_bias = {
      'pp': 1.15,      // PP is dominant in rural Castilla
      'psoe': 1.05,    // PSOE holds up well in rural South
      'podemos': 0.75, // Podemos struggles significantly in rural areas
      'cs': 0.85,      // Cs also struggles in rural areas
  };

  Q.congreso_urban_bias = {
      'pp': 0.95,
      'psoe': 0.95,
      'podemos': 1.15,
      'cs': 1.0
  };

  // As of congreso 2011

  Q.abstain_congreso_pv = 31.06;
  Q.ciu_congreso_s = 16; // Was CiU
  Q.ciu_congreso_pv = 4.17;
  Q.ciu_congreso_pv_cat = 29.35;
  Q.erc_congreso_s = 3;
  Q.erc_congreso_pv = 1.05;
  Q.erc_congreso_pv_cat = 7.06;
  Q.pp_congreso_s = 186;
  Q.pp_congreso_pv = 44.63;
  Q.pp_congreso_pv_cat = 20.71;
  Q.psoe_congreso_s = 110;
  Q.psoe_congreso_pv = 28.76;
  Q.psoe_congreso_pv_cat = 26.63;
  Q.iu_congreso_s = 11;
  Q.iu_congreso_pv = 6.92;
  Q.iu_congreso_pv_cat = 8.09;
  Q.upyd_congreso_s = 5;
  Q.upyd_congreso_pv = 4.7;
  Q.upyd_congreso_pv_cat = 1.14;
  Q.pnv_congreso_s = 5;
  Q.pnv_congreso_pv = 1.33;
  Q.bng_congreso_s = 2; // Was BNG
  Q.bng_congreso_pv = 0.75;
  Q.bng_congreso_pv_true = 11.18;
  Q.cc_congreso_s = 2;
  Q.cc_congreso_pv = 0.59;
  Q.compromis_congreso_s = 1;
  Q.compromis_congreso_pv = 0.51;
  Q.fac_congreso_s = 1;
  Q.fac_congreso_pv = 0.41;
  Q.prc_congreso_s = 0;
  Q.prc_congreso_pv = 0.18;
  Q.gbai_congreso_s = 1;
  Q.gbai_congreso_pv = 0.17;
  Q.amaiur_congreso_s = 7;
  Q.amaiur_congreso_pv = 1.37;

  // Initialize ALL party suppports to zero
  for (var c of Q.parlament_constituencies) {
    for (var d of Q.parlament_demographics) {
      for (var p of Q.parties) {
        Q[p + "_parlament_" + c + "_" + d + "_support"] = 0.0;
      }
    }
  }
  for (var c of Q.congreso_constituencies) {
    for (var p of Q["congreso_parties_" + c]) {
      Q[p + "_congreso_" + c + "_support"] = 0.0;
    }
  }
  for (var p of Q.parties_bcn) {
    Q[p + "_local_barcelona_support"] = 0.0;
  }
!}
