  // check origin 
  // TODO: allow via url
  const valid_urls = [
    // "https://broken-arrows.github.io/route_to_itaca",
  ];

  var local_file = window.location.protocol === 'file:' || window.location.hostname === 'localhost';
  var valid_url = valid_urls.some(url => window.location.href.startsWith(url));

