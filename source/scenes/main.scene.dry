@party_erc
title: Party Affairs
card-image: img/erc/araerc.jpg
is-deck: true
view-if: player_party = "erc"
role: deck-party

- #erc_party

@party_cup
title: Party Affairs
card-image: img/cup/seunacional.jpg
is-deck: true
view-if: player_party = "cup"
role: deck-party

- #cup_party

@cat_gov
title: Generalitat
view-if: (player_party = "erc" and erc_in_gob) or (player_party = 'cup' and cup_in_gob)
card-image: img/generalitat.jpg
is-deck: true
role: deck-gov

- #generalitat

@debug_deck
title: DEBUG!
view-if: debug
card-image: img/flags/estelada.png
is-deck: true
role: deck

- #debug_card
